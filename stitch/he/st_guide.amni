// Amni-Stitch sewing guide: finished sizes, cutting list, fabric needed, stitch settings and steps.
import math;

var UNITS = 0;   // 0 cm, 1 in
fn len_str(out byte[>..]&, cm real) {
	if UNITS == 1 { format_flt(out, cm / 2.54, 1); out.append(" in"); } else { format_flt(out, cm, 1); out.append(" cm"); }
}
fn m_str(out byte[>..]&, cm real) {
	if UNITS == 1 { format_flt(out, cm / 91.44, 2); out.append(" yd"); } else { format_flt(out, cm / 100.0, 2); out.append(" m"); }
}
// fabric length for a fabric width, pieces packed in shelves on fabric folded in half lengthwise
struct Box { w real, h real }
fn fabric_len(fw real, interfacing bool) real {
	var boxes Box[>..] = [];
	let half = fw * 0.5;
	var open_extra = 0.0;
	for pc, k in PIECES {
		if interfacing && !pc.interfacing { continue; }
		var w = piece_w(k) + 1.0; var h = piece_h(k) + 1.0;
		let n = if interfacing { 1 } else if pc.fold { max(pc.cut, 1) } else { (pc.cut + 1) / 2 };
		if w > half && h <= half { let t = w; w = h; h = t; }
		if w > half {
			// too wide for the folded layout: cut single layer at full width
			open_extra += h * (if pc.fold { pc.cut * 2 } else { pc.cut }) as real * (if w > fw { 2.0 } else { 1.0 });
			continue;
		}
		for i in n { boxes.push(Box { w, h }); }
	}
	sort(boxes) { a, b => a.h > b.h };
	var x = 0.0; var row = 0.0; var total = 0.0;
	for b in boxes {
		if x + b.w > half { total += row; x = 0.0; row = 0.0; }
		x += b.w; row = max(row, b.h);
	}
	total += row + open_extra;
	if total <= 0.0 { return 0.0; }
	total * 1.1 + 10.0
}
fn seam_edges() real {
	var l = 0.0;
	for pc, k in PIECES { l += piece_edge_len(k, 1) * (pc.cut * (if pc.fold { 2 } else { 1 })) as real; }
	l
}
fn count_buttons() int {
	var n = 0;
	for pc in PIECES {
		var i = pc.mfirst;
		while i < pc.mfirst + pc.mn { if MARKS[i].kind == MK_BUTTON { n += pc.cut / 2 + (if pc.cut == 1 { 1 } else { 0 }); } i += 1; }
	}
	n
}
fn put(out byte[>..]&, s const byte[:]) { out.append(s); }
fn li(out byte[>..]&, s const byte[:]) { out.append("<li>"); out.append(s); out.append("</li>"); }
fn stitch_seam() const byte[:] {
	if O.knit { "a narrow zigzag (0.5 mm wide, 2.5 mm long) or a stretch stitch; or a 4-thread overlock with differential feed 1.0 to 1.3" } else { "a straight stitch 2.5 mm long" }
}
fn stitch_finish() const byte[:] {
	if O.knit { "Knits do not fray: overlock the edges together, or leave them." } else { "Finish each seam allowance with a 3-thread overlock or a zigzag (3.5 mm wide, 1.5 mm long), then press it open (or to one side for topstitched seams)." }
}
fn stitch_hem() const byte[:] {
	if O.knit { "Press the hem up, then stitch from the right side with a twin needle (4 mm, stitch 3 mm) or a coverstitch; a long narrow zigzag also works." } else { "Press the hem up, turn the raw edge under 1 cm, and edgestitch with a 2.5 to 3 mm straight stitch (or blind hem)." }
}
fn guide_html(out byte[>..]&) {
	out.append("<h3>Finished garment</h3><table class=\"kv\">");
	fn row(label const byte[:], cm real) { if cm > 0.0 { out.append("<tr><th>"); out.append(label); out.append("</th><td>"); len_str(out, cm); out.append("</td></tr>"); } }
	if D.has_top {
		row("Chest", D.chest_w); row("Ease at chest", D.ease_c);
		if D.below_waist != 0.0 { row("Hem width (around)", D.hem_circ); row("Back length, nape to hem", D.top_len - 2.0); }
		else { row("Back length, nape to waist", M[M_BACKLEN]); }
		if D.sleeve_len > 0.0 { row("Sleeve length", D.sleeve_len); row("Sleeve at upper arm", D.bicep_w); }
	}
	if D.has_skirt { row("Skirt length", D.skirt_len); row("Skirt hem (around)", D.skirt_hem); }
	if D.has_legs { row("Inseam", D.inseam); row("Leg opening", D.leg_hem); }
	if D.waist_w > 0.0 { row("Waist", D.waist_w); }
	if D.hip_w > 0.0 { row("Hip", D.hip_w); }
	out.append("</table>");

	out.append("<h3>Cutting list</h3><table class=\"cut\"><tr><th>Piece</th><th>Cut</th><th>Size (with allowance)</th></tr>");
	for pc, k in PIECES {
		out.append("<tr><td>"); esc(out, pc.name[..]); out.append("</td><td>"); esc(out, pc.note[..]); out.append("</td><td>");
		len_str(out, piece_w(k)); out.append(" &times; "); len_str(out, piece_h(k)); out.append("</td></tr>");
	}
	out.append("</table>");

	out.append("<h3>Fabric</h3><ul>");
	let widths = [112.0, 140.0, 150.0];
	for fw in widths {
		var s byte[>..] = [];
		m_str(s, fabric_len(fw, false)); s.append(" of fabric ");
		len_str(s, fw); s.append(" wide, folded in half lengthwise");
		li(out, s[..]);
	}
	var any_if = false; for pc in PIECES { if pc.interfacing { any_if = true; } }
	if any_if { var s byte[>..] = []; m_str(s, fabric_len(90.0, true)); s.append(" of fusible interfacing (90 cm wide)"); li(out, s[..]); }
	li(out, if O.knit { "Knit fabric with at least 30% stretch across the grain (jersey, interlock, French terry, sweatshirt fleece)." } else { "Woven fabric: cotton, linen, chambray, poplin, light wool or rayon challis. Pre-wash it the way you will wash the garment." });
	out.append("</ul>");

	out.append("<h3>Notions and thread</h3><ul>");
	let seams = seam_edges() * 0.5;
	{
		var s byte[>..] = [];
		s.append("Stitching: about "); m_str(s, seams * 1.1); s.append(" of seams and hems, roughly ");
		format(s, ((seams * 1.1 / 0.25) as int / 100) * 100, " stitches at 2.5 mm. Thread: about ");
		format(s, ((seams * 1.1 * 2.75 / 100.0) as int + 1), " m for the machine");
		s.append(", plus "); format(s, ((seams * 0.5 * 14.0 / 100.0) as int + 1), " m per cone if you overlock (4-thread)");
		s.append(". One 100 m spool is enough for most garments; buy two for overlock or topstitching.");
		li(out, s[..]);
	}
	let nb = count_buttons();
	if nb > 0 { var s byte[>..] = []; format(s, nb + (if O.sleeve == 3 { 2 } else { 0 }), " buttons, 1 to 1.2 cm across."); li(out, s[..]); }
	if !O.elastic && (O.garment == G_SKIRT || O.garment == G_DRESS || O.garment == G_TROUSERS || O.garment == G_SHORTS) {
		li(out, if O.garment == G_DRESS { "An invisible zip, 50 to 55 cm, for the centre back (side seam for circle skirts)." } else { "A zip, 18 to 20 cm (invisible for skirts, fly zip for trousers), and a hook and bar or a button for the waistband." });
	}
	if O.garment == G_HOODIE { li(out, if O.hood { "Ribbing for the cuffs and waistband (about 0.3 m), and optionally cord and two eyelets for the hood." } else { "Ribbing for the neckband, cuffs and waistband (about 0.3 m)." }); }
	if O.elastic { var s byte[>..] = []; s.append("Elastic "); len_str(s, 3.0); s.append(" wide, "); len_str(s, M[M_WAIST] * 0.9); s.append(" long."); li(out, s[..]); }
	if O.cuff { li(out, "Ribbing for the ankle cuffs (about 0.2 m)."); }
	out.append("</ul>");

	out.append("<h3>Machine settings</h3><table class=\"kv\">");
	out.append("<tr><th>Seams</th><td>"); out.append(stitch_seam()); out.append("</td></tr>");
	out.append("<tr><th>Edge finish</th><td>"); out.append(stitch_finish()); out.append("</td></tr>");
	out.append("<tr><th>Hems</th><td>"); out.append(stitch_hem()); out.append("</td></tr>");
	out.append("<tr><th>Topstitching</th><td>3 mm straight stitch, 0.6 cm from the edge, longer stitch and a size 90/14 needle for heavier fabric.</td></tr>");
	out.append("<tr><th>Basting / gathering</th><td>Longest straight stitch (4 to 5 mm), no backstitching.</td></tr>");
	out.append("<tr><th>Needle</th><td>"); out.append(if O.knit { "Ballpoint or stretch, 75/11 to 90/14." } else { "Universal 70/10 to 80/12 (90/14 for denim or canvas)." }); out.append("</td></tr></table>");

	out.append("<h3>Steps</h3><ol class=\"steps\">");
	var sa byte[>..] = []; format_flt(sa, O.sa, 1); sa.append(" cm");
	fn step(s const byte[:]) { li(out, s); }
	step("Pre-wash and press the fabric. Fold it in half lengthwise, right sides together, selvedges matching.");
	step("Pin the pieces with each grainline parallel to the selvedge; pieces marked \"on fold\" go against the fold. Cut, then snip every notch 0.5 cm into the allowance and mark darts and dots with chalk.");
	if D.has_top || O.garment == G_DRESS {
		if O.garment == G_BODICE || O.garment == G_DRESS || O.fit == 0 { step("Sew the darts from the wide end to the point, tie off the threads at the point (no backstitch), and press bust darts down and waist darts toward the centre."); }
		if O.garment == G_SHIRT {
			step("Sew the back to the yoke (and the yoke lining, sandwiching the back). Sew the fronts to the outer yoke at the shoulders, then roll the lining yoke over and topstitch.");
			step("Fold the front facings back along the fold line, press, and stitch them down at the neck. Interface and sew the collar, turn, press, topstitch; sew it into the collar stand, then the stand to the neckline.");
		} else {
			step("Sew the front to the back at the shoulders, right sides together.");
		}
		if O.garment == G_TEE || (O.garment == G_HOODIE && !O.hood) { step(if O.knit { "Fold the neckband in half lengthwise, quarter-mark it and the neckline, and sew it on stretching only the band (not the neckline). Press the seam toward the body and topstitch with a twin needle." } else { "Press the bias binding in half, sew it to the neckline right sides together, wrap it to the inside and edgestitch." }); }
		if O.garment == G_HOODIE && O.hood { step("Sew the two hood pieces along the back curve (and the lining the same way). Put lining inside hood, right sides together, sew along the front edge, turn, and baste the neck edges together. Sew the hood to the neckline, matching the centre back."); step("Sew the kangaroo pocket: hem the angled openings, press the other edges under, and topstitch it to the front 6 cm above the hem."); }
		if O.sleeve > 0 || O.garment == G_HOODIE {
			step("Set the sleeves: match the single notch to the front, the double notch to the back and the top notch to the shoulder seam. Ease the cap in (woven: run two rows of long stitches over the cap first) and sew.");
			step("Sew each side seam and sleeve seam in one pass, from the hem through the underarm to the cuff.");
		} else { step("Sew the side seams. Finish the armholes with the binding or facing, understitch, and turn it inside."); }
		if O.garment == G_SHIRT && O.sleeve == 3 { step("Cut the sleeve placket on the dashed line and bind it. Interface the cuffs, fold them right sides together, sew the ends, turn, and attach to the sleeve with the pleats toward the placket. Make the buttonholes."); }
		if O.garment == G_HOODIE { step("Fold the cuffs and waistband in half, quarter-mark, and sew them on, stretching the rib to fit."); }
	}
	if D.has_skirt {
		if O.skirt == 4 { step(if O.elastic { "Sew the side seams." } else { "Sew the skirt side seams. Run two rows of long stitches along the skirt waist, pull them up to fit the bodice, and sew the bodice to the skirt." }); }
		else if O.garment == G_DRESS { step("Sew the skirt darts (if any) and the skirt side seams. Sew the bodice to the skirt at the waist, matching side seams and darts."); }
		else { step("Sew the darts, then the side seams."); }
		if !O.elastic { if O.skirt == 4 { step("Leave the left side seam open 20 cm below the waist and put in the zip."); } else if O.skirt < 2 { step("Put the zip in the centre back seam, then sew the rest of the seam below it."); } else { step("Leave the left side seam open 20 cm below the waist for the zip. Hang the circle skirt for a day before hemming: the bias stretches."); } }
	}
	if D.has_legs {
		step(if O.elastic { "Sew each front to its back along the side seam and the inseam." } else { "Sew the darts. Sew each front to its back along the side seam and the inseam." });
		step(if O.elastic { "Turn one leg right side out and slip it inside the other. Sew the crotch seam from the centre front through to the centre back; sew it twice through the curve and clip the allowance." } else { "Turn one leg right side out and slip it inside the other. Sew the crotch seam from the centre front through to the centre back, leaving the zip opening; sew it twice through the curve and clip the allowance." });
		if !O.elastic { step("Put in the zip (fly or invisible)."); }
		if O.cuff { step("Sew each ankle cuff into a loop, fold it in half, quarter-mark it and the leg hem, and sew it on, stretching the rib to fit."); }
	}
	if O.garment == G_SKIRT || D.has_legs { step(if O.elastic { "Sew the casing into a loop, fold it in half along the dashed line, and sew it to the waist, leaving 5 cm open. Thread the elastic through, overlap the ends 2 cm, stitch them, and close the gap." } else { "Interface the waistband, sew it to the waist, fold it along the dashed line, and stitch in the ditch from the outside. Add the hook and bar or a buttonhole and button." }); }
	if O.garment == G_DRESS { step("Finish the neckline with the facing, understitch it, and tack it to the zip tape."); }
	step(stitch_hem());
	step("Press everything, with a press cloth on the right side.");
	out.append("</ol>");
}
