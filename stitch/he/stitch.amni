let T_MEAS: i32 = 100;
let T_PRESET: i32 = 2; let T_UNITS: i32 = 3; let T_STYLE: i32 = 200; let T_CAT: i32 = 300; let T_OPT: i32 = 5; let T_COLOR: i32 = 6;
let T_TAB_PAT: i32 = 7; let T_TAB_3D: i32 = 8; let T_TAB_GUIDE: i32 = 9;
let T_DL_SVG: i32 = 10; let T_PRINT_A4: i32 = 11; let T_PRINT_LTR: i32 = 12; let T_DL_GUIDE: i32 = 13;
let T_GEN: i32 = 20; let T_GEN_DONE: i32 = 21; let T_POLL: i32 = 22; let T_POLL_DONE: i32 = 23; let T_QUOTA: i32 = 24;
let T_TRACE: i32 = 30; let T_PIXELS: i32 = 31; let T_UPLOAD: i32 = 32; let T_PICKED: i32 = 33; let T_DL_IMG: i32 = 34; let T_ADD_TRACED: i32 = 35;
let T_BUY: i32 = 40; let T_BUY_DONE: i32 = 41; let T_CLAIM: i32 = 42; let T_CLAIM_DONE: i32 = 43; let T_KEY_SAVE: i32 = 44; let T_BILLING: i32 = 45; let T_BILLING_DONE: i32 = 46; let T_KEY_FORGET: i32 = 47; let T_RENEW_DONE: i32 = 48;
let T_PDOWN: i32 = 50; let T_PMOVE: i32 = 51; let T_PUP: i32 = 52; let T_FRONT: i32 = 53; let T_SIDE: i32 = 54; let T_BACK: i32 = 55;
let T_FABRIC: i32 = 80; let T_FAB_PIXELS: i32 = 81; let T_FAB_DL: i32 = 82; let T_FAB_ON: i32 = 83; let T_FAB_SIZE: i32 = 84;
let T_RESIZE: i32 = 60; let T_SCALE: i32 = 61; let T_IGNORE: i32 = 99;
let T_ACCT_ME: i32 = 120; let T_ACCT_LIST: i32 = 121; let T_ACCT_SAVE: i32 = 122; let T_ACCT_SAVED: i32 = 123; let T_ACCT_PICK: i32 = 124;
let T_CUT_OPT: i32 = 70; let T_CUT_PREV: i32 = 71; let T_CUT_NEXT: i32 = 72; let T_CUT_DL: i32 = 73; let T_CUT_ALL: i32 = 74; let T_CUT_Q: i32 = 75;
var GATE byte[>..];
var PRO byte[>..];
var PIC byte[>..];
var ACCT byte[>..];
var ACCT_IDS byte[>..][>..];
var ACCT_NAMES byte[>..][>..];
var ACCT_STATES byte[>..][>..];
var ACCT_CUR byte[>..];
var ACCT_WHO byte[>..];
var HOST: i32 = 0;
var TAB = 0;
var PRESET = 2;
var SCALE_PCT = 0.0;
var BASE real[18];
var ADD_TRACED = true;
var JOB byte[>..];
var POLLS = 0;
var SHOT byte[>..];       // the current picture (data URL)
var KEY byte[>..];
var FAB_URL byte[>..];
var DEVICE byte[>..];
var CLAIM_ID byte[>..];
var CLAIM_TRIES = 0;
var DRAG = false;
var DRAG_X = 0.0; var DRAG_Y = 0.0;
var BUSY = false;
var CUT_VIEW = 0;
var CUT_Q = 0;
fn el(id const byte[:]) i32 { web::el(id) }
fn set_text(id const byte[:], s const byte[:]) { web::text(el(id), s); }
fn show(id const byte[:], on bool) { web::cls(el(id), "hidden", !on); }
fn fmt1(out byte[>..]&, v real) { format_flt(out, v, 1); }
fn disp(cm real) real { if UNITS == 1 { cm / 2.54 } else { cm } }
fn from_disp(v real) real { if UNITS == 1 { v * 2.54 } else { v } }
fn unit_label() const byte[:] { if UNITS == 1 { "in" } else { "cm" } }
fn get_value(id const byte[:], out byte[>..]&) { out.clear(); let _ok = web::get_prop(el(id), "value", out); }
fn get_num(id const byte[:], dflt real) real {
	var s byte[>..] = []; get_value(id, s);
	let v, ok = parse_flt(trim(s[..]));
	if ok { v } else { dflt }
}
fn get_int(id const byte[:]) int { var s byte[>..] = []; get_value(id, s); let v, ok = parse_int(trim(s[..]), 10); if ok { v } else { 0 } }
fn set_value(id const byte[:], s const byte[:]) { web::prop(el(id), "value", s); }
fn set_num(id const byte[:], v real) { var s byte[>..] = []; fmt1(s, v); set_value(id, s[..]); }
fn get_chk(id const byte[:]) bool { web::get_bool(el(id), "checked") }
fn fill_cut_inputs() {
	set_text("cut-mu", unit_label()); set_text("cut-gu", unit_label());
	for id, i in ["cut-margin", "cut-gap"] { var s byte[>..] = []; format_flt(s, disp((if i == 0 { CU.margin } else { CU.gap }) / 10.0), 2); set_value(id, s[..]); }
}
fn read_cut() {
	CU.fmt = clamp(get_int("cut-fmt"), 0, 2); CU.sheet = clamp(get_int("cut-sheet"), 0, CU_PRESETS - 1);
	let k = if get_int("cut-cu") == 1 { 25.4 } else { 1.0 };
	CU.cw = max(get_num("cut-w", 12.0) * k, 20.0); CU.ch = max(get_num("cut-h", 18.0) * k, 20.0);
	CU.margin = clamp(from_disp(get_num("cut-margin", disp(CU.margin / 10.0))) * 10.0, 0.0, 70.0); CU.gap = clamp(from_disp(get_num("cut-gap", disp(CU.gap / 10.0))) * 10.0, 0.0, 70.0);
	CU.grain = get_chk("cut-grain"); CU.seam = get_chk("cut-seam"); CU.layers = get_chk("cut-layers");
	show("row-cut-custom", CU.sheet == 12);
}
fn save_state() { var s byte[>..] = []; state_text(s); web::store_set("amni.stitch.v2", s[..]); }
fn state_text(s byte[>..]&) {
	s.clear();
	for i in NM { s.append(M_KEYS[i]); s.push('='); format_flt(s, BASE[i], 1); s.push(';'); }
	format(s, "o_preset=", PRESET, ";o_units=", UNITS, ";o_scale="); format_flt(s, SCALE_PCT, 1);
	format(s, ";o_garment=", O.garment, ";o_fit=", O.fit, ";o_knit=", if O.knit { 1 } else { 0 }, ";o_sleeve=", O.sleeve, ";o_neck=", O.neck, ";o_skirt=", O.skirt, ";o_leg=", O.leg, ";o_sex=", O.sex, ";o_style=", O.style, ";o_hood=", if O.hood { 1 } else { 0 }, ";o_cuff=", if O.cuff { 1 } else { 0 }, ";o_elastic=", if O.elastic { 1 } else { 0 }, ";o_length=");
	format_flt(s, O.length, 1); s.append(";o_sa="); format_flt(s, O.sa, 2); s.append(";o_hem="); format_flt(s, O.hem, 2); s.push(';');
}
fn load_state() bool { var s byte[>..] = []; if !web::store_get("amni.stitch.v2", s) { return false; } apply_state(s[..]) }
fn apply_state(s const byte[:]) bool {
	var seen bool[18];
	each_split(s, ';') {
		let eq = find_index(it) { c => c == '=' };
		if eq >= 0 {
			let k = it[..eq]; let vs = it[eq + 1..];
			let v, ok = parse_flt(vs);
			if ok {
				for i in NM { if k == M_KEYS[i] { BASE[i] = v; seen[i] = true; } }
				if k == "o_preset" { PRESET = v as int; } else if k == "o_units" { UNITS = v as int; } else if k == "o_scale" { SCALE_PCT = v; }
				else if k == "o_garment" { O.garment = clamp(v as int, 0, NG - 1); } else if k == "o_fit" { O.fit = clamp(v as int, 0, 3); } else if k == "o_knit" { O.knit = v > 0.5; }
				else if k == "o_sleeve" { O.sleeve = clamp(v as int, 0, 3); } else if k == "o_neck" { O.neck = clamp(v as int, 0, 2); } else if k == "o_skirt" { O.skirt = clamp(v as int, 0, 4); }
				else if k == "o_leg" { O.leg = clamp(v as int, 0, 2); } else if k == "o_sex" { O.sex = clamp(v as int, 0, 1); } else if k == "o_length" { O.length = clamp(v, -20.0, 200.0); }
				else if k == "o_sa" { O.sa = clamp(v, 0.0, 4.0); } else if k == "o_hem" { O.hem = clamp(v, 0.0, 8.0); }
				else if k == "o_style" { O.style = clamp(v as int, 0, NS - 1); } else if k == "o_hood" { O.hood = v > 0.5; } else if k == "o_cuff" { O.cuff = v > 0.5; } else if k == "o_elastic" { O.elastic = v > 0.5; }
			}
		}
	};
	var all_seen = true;
	for b in seen { if !b { all_seen = false; } }
	all_seen
}
fn apply_scale() {
	for i in NM { M[i] = BASE[i]; }
	if SCALE_PCT != 0.0 { grade(1.0 + SCALE_PCT / 100.0); }
	clamp_measurements();
}
fn fill_measure_inputs() {
	for i in NM { set_num(str("m-", M_KEYS[i])[..], disp(BASE[i])); }
	let units = web::query_all(web::DOCUMENT, ".unit");
	for i in units { web::text(web::list_at(i as i32), unit_label()); }
	set_num("fab-size", disp(TEX_CM));
	set_num("length", disp(length_or_default()));
	set_num("sa", disp(O.sa)); set_num("hem", disp(O.hem));
	fill_cut_inputs();
}
fn build_measure_form() {
	let box = el("meas");
	web::clear(box);
	for i in NM {
		let row = web::create("label"); web::cls(row, "m", true);
		web::attr(row, "title", M_HINTS[i]);
		let name = web::create("span"); web::text(name, M_LABELS[i]); web::append(row, name);
		let inp = web::create("input");
		web::attr(inp, "type", "number"); web::attr(inp, "step", "0.5"); web::attr(inp, "inputmode", "decimal");
		web::attr(inp, "id", str("m-", M_KEYS[i])[..]);
		web::attr(inp, "aria-describedby", str("h-", M_KEYS[i])[..]);
		web::append(row, inp);
		let u = web::create("span"); web::cls(u, "unit", true); web::text(u, unit_label()); web::append(row, u);
		let hint = web::create("small"); web::attr(hint, "id", str("h-", M_KEYS[i])[..]); web::text(hint, M_HINTS[i]); web::append(row, hint);
		web::append(box, row);
		web::listen(inp, "input", T_MEAS + i as i32, 0);
	}
}
fn fill_select(id const byte[:], names const byte[:][:], sel int) {
	let s = el(id);
	web::clear(s);
	for nm, i in names {
		let o = web::create("option"); web::attr(o, "value", str(i)[..]); web::text(o, nm);
		if i == sel { web::attr(o, "selected", ""); }
		web::append(s, o);
	}
}
fn read_options() {
	O.fit = clamp(get_int("fit"), 0, 3);
	O.knit = get_int("fabric") == 1;
	O.sleeve = clamp(get_int("sleeve"), 0, 3);
	O.neck = clamp(get_int("neck"), 0, 2);
	O.skirt = clamp(get_int("skirt"), 0, 4);
	O.leg = clamp(get_int("leg"), 0, 2);
	O.sex = clamp(get_int("shape"), 0, 1);
	let l = from_disp(get_num("length", 0.0));
	O.length = if abs(l - default_length(O.garment)) < 0.06 { 0.0 } else { clamp(l, if O.garment == G_TEE || O.garment == G_HOODIE { -20.0 } else { 0.0 }, 200.0) };
	O.sa = clamp(from_disp(get_num("sa", 1.5)), 0.0, 4.0);
	O.hem = clamp(from_disp(get_num("hem", 3.0)), 0.0, 8.0);
}
fn write_options() {
	set_value("fit", str(O.fit)[..]); set_value("fabric", if O.knit { "1" } else { "0" });
	set_value("sleeve", str(O.sleeve)[..]); set_value("neck", str(O.neck)[..]); set_value("skirt", str(O.skirt)[..]);
	set_value("leg", str(O.leg)[..]); set_value("shape", str(O.sex)[..]);
	set_num("length", disp(length_or_default()));
	set_num("sa", disp(O.sa)); set_num("hem", disp(O.hem));
}
fn show_rows() {
	let g = O.garment;
	let top = g == G_TEE || g == G_SHIRT || g == G_BODICE || g == G_DRESS || g == G_HOODIE;
	show("row-fit", g != G_TRACED);
	show("row-sleeve", g == G_TEE || g == G_SHIRT || g == G_BODICE || g == G_DRESS);
	show("row-neck", g == G_TEE || g == G_BODICE || g == G_DRESS);
	show("row-skirt", g == G_SKIRT || g == G_DRESS);
	show("row-leg", g == G_TROUSERS);
	show("row-length", g != G_BODICE && g != G_TRACED);
	show("row-shape", top);
	set_text("length-label", match g { 3 => "Skirt length", 4 => "Inseam", 5 => "Inseam", 6 => "Skirt length", _ => "Length below waist" });
}
fn cut_render() {
	var s byte[>..] = []; cu_info(s); set_text("cut-info", s[..]);
	let n = CUS.len;
	CUT_VIEW = clamp(CUT_VIEW, 0, max(n - 1, 0));
	web::prop_bool(el("cut-prev"), "disabled", CUT_VIEW == 0); web::prop_bool(el("cut-next"), "disabled", CUT_VIEW + 1 >= n);
	web::prop_bool(el("cut-dl"), "disabled", n == 0); web::prop_bool(el("cut-all"), "disabled", n == 0);
	if n == 0 { web::html(el("cut-preview"), "<p class=\"empty\">No pieces to cut yet.</p>"); set_text("cut-which", ""); set_text("cut-all", "Download all sheets"); return; }
	s.clear(); cu_preview(s, CUT_VIEW); web::html(el("cut-preview"), s[..]);
	let sh = CUS[CUT_VIEW];
	var w byte[>..] = []; format(w, "Sheet ", CUT_VIEW + 1, " of ", n, " · "); format_flt(w, sh.w / 25.4, 1); w.append(" × "); format_flt(w, sh.h / 25.4, 1); w.append(" in ("); format_flt(w, sh.w, 0); w.append(" × "); format_flt(w, sh.h, 0); w.append(" mm)");
	set_text("cut-which", w[..]);
	var a byte[>..] = []; format(a, "Download all sheets (", n, ")"); set_text("cut-all", a[..]);
}
fn cut_refresh() { cu_build(); cut_render(); }
fn cut_download(i int) { var s byte[>..] = []; cu_file(s, i); var st byte[>..] = []; file_stem(st); var n byte[>..] = []; cu_filename(n, st[..], i); download(n[..], cu_mime(), s[..]); }
fn title() {
	TITLE.clear();
	TITLE.append("Amni-Stitch: "); TITLE.append(style_name());
	if O.garment != G_TRACED { TITLE.append(" ("); TITLE.append(FIT_NAMES[O.fit]); TITLE.append(if O.knit { ", knit" } else { ", woven" }); TITLE.push(')'); }
	TITLE.append(" for chest "); len_str(TITLE, M[M_CHEST]); TITLE.append(", waist "); len_str(TITLE, M[M_WAIST]); TITLE.append(", hip "); len_str(TITLE, M[M_HIP]);
}
fn show_scale() { var s byte[>..] = []; if SCALE_PCT > 0.0 { s.push('+'); } fmt1(s, SCALE_PCT); s.push('%'); set_text("scale-val", s[..]); }
fn rebuild() {
	apply_scale();
	draft_all();
	if TRACE_OK && (O.garment == G_TRACED || ADD_TRACED) {
		add_traced_pieces(O.garment == G_TRACED);
		offset_all();
	}
	if PIECES.len == 0 {
		web::html(el("pattern"), str(str("<p class=\"empty\">", PIC[..])[..], " a picture of a garment, then press <b>Trace into a pattern</b>. The traced outline becomes a pattern at your size.</p>")[..]);
		web::html(el("guide"), "");
		show_rows();
		cut_refresh();
		return;
	}
	title();
	layout(150.0);
	var s byte[>..] = [];
	svg_screen(s);
	web::html(el("pattern"), s[..]);
	s.clear();
	guide_html(s);
	web::html(el("guide"), s[..]);
	var info byte[>..] = [];
	format(info, PIECES.len, " pieces · layout ");
	len_str(info, LAY_W); info.append(" × "); len_str(info, LAY_H);
	set_text("pat-info", info[..]);
	show_rows();
	view_shape();
	if TAB == 1 { view_draw(); }
	cut_refresh();
	save_state();
}
fn set_tab(t int) {
	TAB = t;
	show("pattern-pane", t == 0); show("view-pane", t == 1); show("guide-pane", t == 2);
	web::attr(el("tab-pat"), "aria-selected", if t == 0 { "true" } else { "false" });
	web::attr(el("tab-3d"), "aria-selected", if t == 1 { "true" } else { "false" });
	web::attr(el("tab-guide"), "aria-selected", if t == 2 { "true" } else { "false" });
	if t == 1 { if !V_OK { if !view_init(el("c3d")) { set_text("view-msg", "3D needs WebGL 2, which this browser does not offer."); } } view_shape(); view_draw(); }
}
fn host_call(method const byte[:], args const byte[:], tag i32) { let _id = web::js_call(HOST, method, args, tag); }
fn json_str(out byte[>..]&, s const byte[:]) { json::format_string(out, s); }
fn file_stem(out byte[>..]&) {
	out.append("amni-stitch-");
	for c in style_name() { if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') { out.push(to_lower_c(c)); } else if c == ' ' || c == '-' { out.push('-'); } }
}
fn to_lower_c(c byte) byte { if c >= 'A' && c <= 'Z' { c + 32 } else { c } }
fn load_pixels(max int, tag i32) { var a byte[>..] = []; a.push('['); json_str(a, SHOT[..]); format(a, ",", max, "]"); host_call("pixels", a[..], tag); }
fn save_url(suffix const byte[:], url const byte[:]) { var a byte[>..] = []; a.push('['); var n byte[>..] = []; file_stem(n); n.append(suffix); json_str(a, n[..]); a.push(','); json_str(a, url); a.push(']'); host_call("saveUrl", a[..], T_IGNORE); }
fn read_pixels() bool {
	var r byte[>..] = [];
	if !web::js_result(web::ev_id(), r) { return false; }
	var w byte[>..] = []; var h byte[>..] = []; var b byte[>..] = [];
	if !jget(r[..], "w", w) || !jget(r[..], "h", h) || !jget(r[..], "b64", b) { return false; }
	let wi, okw = parse_int(w[..], 10); let hi, okh = parse_int(h[..], 10);
	IMG.clear();
	if !okw || !okh || !base64::decode(IMG, b[..]) || IMG.len != wi * hi * 4 { return false; }
	IW = wi; IH = hi;
	true
}
fn fabric_build() {
	if !read_pixels() { set_text("fab-msg", "Could not read that picture."); return; }
	let ok = tex_build();
	set_text("fab-msg", TEX_MSG[..]);
	show("fab-out", ok);
	if !ok { return; }
	var ov byte[>..] = []; tex_overlay_svg(ov); web::html(el("shot-ov"), ov[..]);
	tex_data_url(FAB_URL);
	var css byte[>..] = []; format(css, "url(", FAB_URL[..], ")");
	web::style(el("fab-rep"), "background-image", css[..]);
	var ar byte[>..] = []; format(ar, "1 / "); format_flt(ar, TEX_AR, 3);
	web::style(el("fab-rep"), "aspect-ratio", ar[..]);
	view_fabric_new();
	for id in ["fab-on", "fab-size"] { web::prop_bool(el(id), "disabled", false); }
	web::prop_bool(el("fab-on"), "checked", true);
	set_num("fab-size", disp(TEX_CM));
	if TAB == 1 { view_draw(); }
}
fn download(name const byte[:], mime const byte[:], body const byte[:]) {
	var a byte[>..] = [];
	a.push('['); json_str(a, name); a.push(','); json_str(a, mime); a.push(','); json_str(a, body); a.push(']');
	host_call("save", a[..], T_IGNORE);
}
fn post(base const byte[:], path const byte[:], body const byte[:], tag i32, ms real) {
	var u byte[>..] = []; u.append(base); u.append(path);
	let _id = web::request(u[..], "POST", "{\"content-type\":\"application/json\"}", body, tag, ms);
}
fn take(out byte[>..]&) int {
	out.clear();
	let id = web::ev_id();
	let _ok = web::fetch_take(id, out);
	web::fetch_free(id);
	web::ev_status() as int
}
fn jget(text const byte[:], key const byte[:], out byte[>..]&) bool {
	out.clear();
	var d = json::Doc {};
	let root, err = json::parse(text, d);
	if err.len > 0 || root < 0 { return false; }
	var k byte[>..] = []; k.append(key);
	let n = json::member(d, root, k[..]);
	if n < 0 { return false; }
	let s, ok = json::as_string(d, n);
	if ok { out.append(s); return true; }
	let v, okn = json::as_f64(d, n);
	if okn { format(out, v as int); return true; }
	let b, okb = json::as_bool(d, n);
	if okb { out.append(if b { "true" } else { "false" }); return true; }
	false
}
fn ident(out byte[>..]&) {
	out.append("\"device\":"); json_str(out, DEVICE[..]);
	if KEY.len > 0 { out.append(",\"key\":"); json_str(out, KEY[..]); }
}
fn ask_quota() {
	if GATE.len == 0 || ACCT_WHO.len == 0 { return; }
	acct_request(GATE[..], "/quota", "POST", "{}", T_QUOTA);
}
fn status(s const byte[:]) { set_text("gen-status", s); }
fn generate() {
	if BUSY { return; }
	if GATE.len == 0 { status("The generator is not configured on this site yet."); return; }
	if ACCT_WHO.len == 0 { status("Sign in first."); return; }
	var p byte[>..] = []; get_value("prompt", p);
	let pt = trim(p[..]);
	if pt.len < 3 { status("Describe a garment first."); return; }
	var style byte[>..] = []; get_value("style", style);
	var b byte[>..] = [];
	b.append("{\"prompt\":"); json_str(b, pt[..min(pt.len, 400)]);
	b.append(",\"garment\":"); json_str(b, G_NAMES[O.garment]);
	b.append(",\"fabric\":"); json_str(b, if O.knit { "knit" } else { "woven" });
	b.append(",\"style\":"); json_str(b, style[..]);
	b.push('}');
	BUSY = true;
	web::prop_bool(el("gen"), "disabled", true);
	status("Sending…");
	acct_request(GATE[..], "/generate", "POST", b[..], T_GEN_DONE);
}
fn gen_done(ok bool) { BUSY = false; web::prop_bool(el("gen"), "disabled", false); if ok { web::cls(el("shot"), "fresh", true); } }
fn poll() {
	acct_request(GATE[..], str("/job?id=", JOB[..])[..], "GET", "", T_POLL_DONE);
}
fn show_shot(src const byte[:]) {
	SHOT.clear(); SHOT.append(src);
	web::prop_bool(el("fab-use"), "disabled", false);
	web::attr(el("shot-img"), "src", src);
	web::html(el("shot-ov"), "");
	show("shot", true);
	set_text("trace-msg", "");
}
fn b64url_json(tok const byte[:], out byte[>..]&) bool {
	out.clear();
	let parts = split(tok, '.');
	var i = 0; var payload byte[>..] = [];
	for p in parts { if i == 1 { payload.append(p); } i += 1; }
	if payload.len == 0 { return false; }
	for &c in payload { if c == '-' { c = '+'; } else if c == '_' { c = '/'; } }
	while payload.len % 4 != 0 { payload.push('='); }
	base64::decode(out, payload[..])
}
fn show_key() {
	if KEY.len == 0 {
		set_text("sub-status", "Free: 3 samples a day. A subscription key raises the limit.");
		show("key-box", true); show("billing", false); show("key-forget", false);
		return;
	}
	var js byte[>..] = [];
	var s byte[>..] = [];
	if b64url_json(KEY[..], js) {
		var exp byte[>..] = [];
		if jget(js[..], "exp", exp) {
			let e, ok = parse_flt(exp[..]);
			if ok {
				let days = ((e - web::epoch_ms()) / 86400000.0) as int;
				if days >= 0 { format(s, "Subscription active, renews or ends in ", days, " days."); } else { s.append("This subscription key has expired. Renew it below."); }
			}
		}
	}
	if s.len == 0 { s.append("Subscription key saved on this device."); }
	set_text("sub-status", s[..]);
	show("key-box", false); show("billing", true); show("key-forget", true);
}
fn key_days() real {
	var js byte[>..] = []; var exp byte[>..] = [];
	if KEY.len == 0 || !b64url_json(KEY[..], js) || !jget(js[..], "exp", exp) { return 1.0e9; }
	let e, ok = parse_flt(exp[..]);
	if ok { (e - web::epoch_ms()) / 86400000.0 } else { 1.0e9 }
}
fn renew_if_due() {
	if KEY.len == 0 || PRO.len == 0 || key_days() > 10.0 { return; }
	var b byte[>..] = []; b.append("{\"key\":"); json_str(b, KEY[..]); b.push('}');
	post(PRO[..], "/renew", b[..], T_RENEW_DONE, 20000.0);
}
fn claim() {
	if PRO.len == 0 || CLAIM_ID.len == 0 { return; }
	var u byte[>..] = []; u.append(PRO[..]); u.append("/license?session="); u.append(CLAIM_ID[..]);
	let _id = web::request(u[..], "GET", "", "", T_CLAIM_DONE, 20000.0);
}
var CHIPS i32[>..] = [];
var CARDS i32[>..] = [];
var CAT = 0;
fn mark_picker() {
	for b, c in CHIPS { web::attr(b, "aria-pressed", if c == CAT { "true" } else { "false" }); }
	for b, s in CARDS { web::attr(b, "aria-pressed", if s == O.style && si(s, 1) == O.garment { "true" } else { "false" }); web::cls(b, "hidden", si(s, 0) != CAT); }
}
fn build_picker() {
	for nm, c in CAT_NAMES { let b = web::create("button"); web::attr(b, "type", "button"); web::text(b, nm); web::listen(b, "click", T_CAT + c as i32, 0); web::append(el("cats"), b); CHIPS.push(b); }
	for s in NS {
		let b = web::create("button"); web::attr(b, "type", "button");
		var h byte[>..] = []; style_svg(h, s); h.append("<span>"); esc(h, S_NAMES[s]); h.append("</span>"); web::html(b, h[..]);
		web::listen(b, "click", T_STYLE + s as i32, 0); web::append(el("styles"), b); CARDS.push(b);
	}
	CAT = si(style_of(O.garment), 0);
	mark_picker();
}
export fn he_event(tag i32, kind i32) {
	if tag >= T_STYLE && tag < T_STYLE + NS as i32 { apply_style((tag - T_STYLE) as int); write_options(); mark_picker(); rebuild(); return; }
	if tag >= T_CAT && tag < T_CAT + 7 { CAT = (tag - T_CAT) as int; mark_picker(); return; }
	if tag >= T_MEAS && tag < T_MEAS + NM as i32 {
		let i = (tag - T_MEAS) as int;
		var s byte[>..] = []; web::ev_value(s);
		let v, ok = parse_flt(trim(s[..]));
		if ok && v > 0.0 { BASE[i] = clamp(from_disp(v), M_MIN[i], M_MAX[i]); set_text("preset-note", "Custom measurements"); rebuild(); }
		return;
	}
	match tag {
		2 => {
			PRESET = get_int("preset");
			if PRESET >= 0 && PRESET < NPRESET { apply_preset(PRESET); for i in NM { BASE[i] = M[i]; } O.sex = if preset_kind(PRESET) == 1 { 1 } else { 0 }; set_value("shape", str(O.sex)[..]); }
			set_text("preset-note", "");
			fill_measure_inputs(); rebuild();
		},
		3 => { UNITS = get_int("units"); fill_measure_inputs(); write_options(); rebuild(); },
		5 => { read_options(); rebuild(); },
		6 => { var c byte[>..] = []; get_value("color", c); view_color(c[..]); if TAB == 1 { view_draw(); } },
		7 => set_tab(0), 8 => set_tab(1), 9 => set_tab(2),
		10 => { var s byte[>..] = []; svg_file(s); var n byte[>..] = []; file_stem(n); n.append(".svg"); download(n[..], "image/svg+xml", s[..]); },
		11 => { var s byte[>..] = []; print_html(s, 0); web::html(el("print"), s[..]); host_call("print", "[\"A4\"]", T_IGNORE); },
		12 => { var s byte[>..] = []; print_html(s, 1); web::html(el("print"), s[..]); host_call("print", "[\"letter\"]", T_IGNORE); },
		13 => {
			var s byte[>..] = [];
			s.append("<!doctype html><meta charset=\"utf-8\"><title>"); esc(s, TITLE[..]); s.append("</title><style>body{font:15px/1.5 system-ui,sans-serif;max-width:760px;margin:24px auto;padding:0 16px}table{border-collapse:collapse}th,td{text-align:left;padding:3px 10px 3px 0;vertical-align:top}</style><h1>");
			esc(s, TITLE[..]); s.append("</h1>"); guide_html(s);
			var n byte[>..] = []; file_stem(n); n.append("-guide.html");
			download(n[..], "text/html", s[..]);
		},
		20 => generate(),
		21 => {
			var r byte[>..] = []; let st = take(r);
			var v byte[>..] = [];
			if st == 200 && jget(r[..], "job", JOB) {
				POLLS = 0;
				if jget(r[..], "remaining", v) { var q byte[>..] = []; q.append(v[..]); q.append(" left today"); set_text("quota", q[..]); }
				status("In line…");
				let _t = web::timer(1500.0, T_POLL);
			} else {
				gen_done(false);
				if jget(r[..], "error", v) { status(v[..]); } else if st == 0 { status("Can't reach the generator. Try again."); } else { status(str("The generator answered ", st, ".")[..]); }
				ask_quota();
			}
		},
		22 => poll(),
		23 => {
			var r byte[>..] = []; let st = take(r);
			var state byte[>..] = []; var v byte[>..] = [];
			POLLS += 1;
			if st == 200 && jget(r[..], "state", state) {
				if state[..] == "done" {
					if jget(r[..], "image", v) { show_shot(v[..]); status("Done! Press Trace to make a pattern."); }
					gen_done(true); ask_quota();
				} else if state[..] == "blocked" {
					gen_done(false);
					if jget(r[..], "error", v) { status(v[..]); } else { status("Blocked by the safety check."); }
					ask_quota();
				} else if state[..] == "error" {
					gen_done(false);
					if jget(r[..], "error", v) { status(v[..]); } else { status("That didn't work. It wasn't counted."); }
					ask_quota();
				} else {
					var m byte[>..] = [];
					if state[..] == "running" { m.append("Drawing… about 30 seconds"); }
					else if jget(r[..], "detail", v) { m.append("Waiting for the GPU…"); }
					else if jget(r[..], "position", v) { m.append("In line: #"); m.append(v[..]); m.append("…"); }
					else { m.append("Waiting…"); }
					status(m[..]);
					if POLLS < 340 { let _t = web::timer(2000.0, T_POLL); } else { gen_done(false); status("Taking too long. Try again later."); }
				}
			} else if POLLS < 340 { let _t = web::timer(3000.0, T_POLL); }
			else { gen_done(false); status("Lost track of the request. Try again."); }
		},
		24 => {
			var r byte[>..] = []; let st = take(r);
			var v byte[>..] = [];
			if st == 200 {
				var q byte[>..] = [];
				if jget(r[..], "remaining", v) { q.append(v[..]); q.append(" left today"); }
				var on byte[>..] = [];
				if jget(r[..], "online", on) && on[..] == "false" { q.append(" · offline now"); }
				else if jget(r[..], "busy", on) && on[..] == "true" { q.append(" · busy, may wait"); }
				set_text("quota", q[..]);
			} else if st == 402 && jget(r[..], "error", v) {
				set_text("sub-status", v[..]); set_text("quota", "");
			} else if st == 403 && jget(r[..], "error", v) { status(v[..]); set_text("quota", ""); web::prop_bool(el("gen"), "disabled", true); }
		},
		30 => {
			if SHOT.len == 0 { set_text("trace-msg", str(PIC[..], " a picture first.")[..]); return; }
			set_text("trace-msg", "Tracing…");
			load_pixels(320, T_PIXELS);
		},
		31 => {
			if !read_pixels() { set_text("trace-msg", "Could not read that picture."); return; }
			let want = O.garment;
			if trace_image(want) {
				var ov byte[>..] = []; overlay_svg(ov); web::html(el("shot-ov"), ov[..]);
				write_options();
				set_text("trace-msg", TRACE_MSG[..]);
				rebuild();
				set_tab(0);
			} else { set_text("trace-msg", TRACE_MSG[..]); }
		},
		32 => host_call("pick", "[]", T_PICKED),
		33 => {
			var r byte[>..] = [];
			if web::js_result(web::ev_id(), r) && r.len > 12 {
				show_shot(r[1..r.len - 1]);
				status("Picture loaded. Press Trace to make a pattern.");
			}
		},
		34 => { if SHOT.len > 0 { save_url("-sample.webp", SHOT[..]); } },
		35 => { ADD_TRACED = web::get_bool(el("add-traced"), "checked"); rebuild(); },
		40 => {
			if PRO.len == 0 { set_text("sub-status", "Subscriptions are not open yet."); return; }
			set_text("sub-status", "Opening secure checkout…");
			post(PRO[..], "/checkout", "{\"plan\":\"monthly\"}", T_BUY_DONE, 20000.0);
		},
		41 => {
			var r byte[>..] = []; let st = take(r); var u byte[>..] = [];
			if st == 200 && jget(r[..], "url", u) && starts_with(u[..], "https://checkout.stripe.com/") { web::navigate(u[..]); }
			else { var e byte[>..] = []; if jget(r[..], "error", e) { set_text("sub-status", e[..]); } else { set_text("sub-status", "Checkout did not start. Try again."); } }
		},
		42 => claim(),
		43 => {
			var r byte[>..] = []; let st = take(r); var k byte[>..] = [];
			if st == 200 && jget(r[..], "key", k) {
				KEY.clear(); KEY.append(k[..]); web::store_set("amni.stitch.key", KEY[..]);
				web::set_url("./", true); CLAIM_ID.clear(); show_key(); ask_quota();
			} else if st == 409 && CLAIM_TRIES < 8 {
				CLAIM_TRIES += 1; set_text("sub-status", "Payment received, waiting for Stripe to confirm…");
				let _t = web::timer(1500.0 * CLAIM_TRIES as real, T_CLAIM);
			} else { var e byte[>..] = []; if jget(r[..], "error", e) { set_text("sub-status", e[..]); } else { set_text("sub-status", "Could not fetch your key yet. Reload this page in a minute."); } }
		},
		44 => {
			var k byte[>..] = []; get_value("key", k);
			var t byte[>..] = []; for c in k { if c != ' ' && c != '\n' && c != '\r' && c != '\t' { t.push(c); } }
			if !starts_with(t[..], "AMNIPRO") { set_text("sub-status", "Keys start with AMNIPRO. Copy the whole key from your receipt page or email."); return; }
			KEY.clear(); KEY.append(t[..]); web::store_set("amni.stitch.key", KEY[..]); show_key(); ask_quota();
		},
		45 => {
			if KEY.len == 0 || PRO.len == 0 { return; }
			var b byte[>..] = []; b.append("{\"key\":"); json_str(b, KEY[..]); b.push('}');
			post(PRO[..], "/portal", b[..], T_BILLING_DONE, 20000.0);
		},
		46 => { var r byte[>..] = []; let st = take(r); var u byte[>..] = []; if st == 200 && jget(r[..], "url", u) { web::navigate(u[..]); } else { var e byte[>..] = []; if jget(r[..], "error", e) { set_text("sub-status", e[..]); } } },
		47 => { KEY.clear(); web::store_del("amni.stitch.key"); show_key(); ask_quota(); },
		48 => {
			var r byte[>..] = []; let st = take(r); var k byte[>..] = [];
			if st == 200 && jget(r[..], "key", k) && starts_with(k[..], "AMNIPRO") { KEY.clear(); KEY.append(k[..]); web::store_set("amni.stitch.key", KEY[..]); show_key(); ask_quota(); }
			else if key_days() < 0.0 { var e byte[>..] = []; if jget(r[..], "error", e) { set_text("sub-status", e[..]); } }
		},
		50 => { DRAG = true; DRAG_X = web::ev_x(); DRAG_Y = web::ev_y(); web::capture_pointer(el("c3d"), web::ev_pointer()); },
		51 => {
			if DRAG {
				let x = web::ev_x(); let y = web::ev_y();
				V_YAW -= (x - DRAG_X) * 0.01; V_PITCH = clamp(V_PITCH + (y - DRAG_Y) * 0.005, -0.3, 0.6);
				DRAG_X = x; DRAG_Y = y; view_draw();
			}
		},
		52 => { DRAG = false; },
		53 => { V_YAW = 0.0; view_draw(); }, 54 => { V_YAW = PI * 0.5; view_draw(); }, 55 => { V_YAW = PI; view_draw(); },
		80 => { if SHOT.len == 0 { set_text("fab-msg", str(PIC[..], " a picture first.")[..]); return; } set_text("fab-msg", "Reading the picture…"); load_pixels(1024, T_FAB_PIXELS); },
		81 => fabric_build(),
		82 => { if TEX_OK { save_url("-fabric.png", FAB_URL[..]); } },
		83 => { view_fabric_on(web::get_bool(el("fab-on"), "checked")); if TAB == 1 { view_draw(); } },
		84 => { TEX_CM = clamp(from_disp(get_num("fab-size", disp(TEX_CM))), 3.0, 120.0); if TAB == 1 { view_draw(); } },
		60 => { if TAB == 1 { view_draw(); } },
		61 => { SCALE_PCT = clamp(get_num("scale", 0.0), -20.0, 20.0); show_scale(); rebuild(); },
		120 => { var r byte[>..] = []; let st = take(r); var nm byte[>..] = []; if st == 200 && acct_me(r[..], nm) { ACCT_WHO.clear(); ACCT_WHO.append(nm[..]); set_text("acct-who", str("Signed in as ", nm[..])[..]); web::cls(el("acct-in"), "hidden", true); web::cls(el("acct-save"), "hidden", false); web::cls(el("gen-in"), "hidden", true); web::cls(el("gen"), "hidden", false); acct_request(ACCT[..], "/v1/profiles?app=stitch", "GET", "", T_ACCT_LIST); ask_quota(); } else if st == 200 { set_text("acct-who", "Keep your measurements in an Amni account."); var here byte[>..] = []; web::location("href", here); var u byte[>..] = []; acct_signin_url(ACCT[..], here[..], u); web::attr(el("acct-in"), "href", u[..]); web::cls(el("acct-in"), "hidden", false); web::attr(el("gen-in"), "href", u[..]); web::cls(el("gen-in"), "hidden", false); web::cls(el("gen"), "hidden", true); set_text("quota", "Free: 3 a day"); } else { set_text("acct-who", "Your Amni account is unreachable right now. Measurements stay saved in this browser."); } },
		121 => { var r byte[>..] = []; let _st = take(r); let n = acct_profiles(r[..], ACCT_IDS, ACCT_NAMES, ACCT_STATES); let s = el("acct-list"); web::clear(s); let o = web::create("option"); web::attr(o, "value", "-1"); web::text(o, "Load saved measurements…"); web::append(s, o); for nm, i in ACCT_NAMES { let p = web::create("option"); web::attr(p, "value", str(i)[..]); web::text(p, nm[..]); if ACCT_IDS[i][..] == ACCT_CUR[..] { web::attr(p, "selected", ""); } web::append(s, p); } web::cls(s, "hidden", n == 0); },
		122 => { var s byte[>..] = []; state_text(s); var nm byte[>..] = []; for id, i in ACCT_IDS { if id[..] == ACCT_CUR[..] { nm.append(ACCT_NAMES[i][..]); } } if nm.len == 0 { nm.append("My measurements"); if ACCT_NAMES.len > 0 { format(nm, " ", ACCT_NAMES.len + 1); } } var b byte[>..] = []; acct_profile_body(ACCT_CUR[..], nm[..], s[..], b); set_text("acct-who", "Saving…"); acct_request(ACCT[..], "/v1/profiles", "POST", b[..], T_ACCT_SAVED); },
		123 => { var r byte[>..] = []; let st = take(r); if st == 200 { let _ok = acct_saved_id(r[..], ACCT_CUR); set_text("acct-who", str("Signed in as ", ACCT_WHO[..], " · saved")[..]); acct_request(ACCT[..], "/v1/profiles?app=stitch", "GET", "", T_ACCT_LIST); } else { var e byte[>..] = []; if !jget(r[..], "error", e) { e.append("your account did not answer"); } set_text("acct-who", str("Not saved: ", e[..])[..]); } },
		124 => { let i = get_int("acct-list"); if i >= 0 && i < ACCT_STATES.len && apply_state(ACCT_STATES[i][..]) { ACCT_CUR.clear(); ACCT_CUR.append(ACCT_IDS[i][..]); set_value("preset", str(PRESET)[..]); set_value("units", str(UNITS)[..]); set_value("scale", str(SCALE_PCT as int)[..]); show_scale(); fill_measure_inputs(); write_options(); set_text("preset-note", "Loaded from your Amni account"); rebuild(); } },
		70 => { read_cut(); CUT_VIEW = 0; cut_refresh(); },
		71 => { CUT_VIEW -= 1; cut_render(); },
		72 => { CUT_VIEW += 1; cut_render(); },
		73 => { if CUT_VIEW < CUS.len { cut_download(CUT_VIEW); } },
		74 => { CUT_Q = 1; if CUS.len > 0 { cut_download(0); if CUS.len > 1 { let _t = web::timer(400.0, T_CUT_Q); } } },
		75 => { if CUT_Q < CUS.len { cut_download(CUT_Q); CUT_Q += 1; if CUT_Q < CUS.len { let _t = web::timer(400.0, T_CUT_Q); } } },
		_ => {},
	}
}
fn listen_id(id const byte[:], ev const byte[:], tag i32) { let h = el(id); if h != 0 { web::listen(h, ev, tag, 0); } }
fn main() {
	let app = el("app");
	let _g = web::get_attr(app, "data-gate", GATE);
	let _p = web::get_attr(app, "data-pro", PRO);
	acct_base(ACCT);
	while ACCT.len > 0 && ACCT[ACCT.len - 1] == '/' { let _c = ACCT.pop(); }
	while GATE.len > 0 && GATE[GATE.len - 1] == '/' { let _c = GATE.pop(); }
	while PRO.len > 0 && PRO[PRO.len - 1] == '/' { let _c = PRO.pop(); }
	let gen = GATE.len > 0; if gen { PIC.append("Generate or upload"); } else { PIC.append("Upload"); } show("gen-box", gen); show("gen-fine", gen); show("trace-note", !gen); show("sub-box", gen && PRO.len > 0); if !gen { set_text("h-ai-t", "Trace a picture"); }
	HOST = web::js_global("stitchHost");
	if !web::store_get("amni.stitch.dev", DEVICE) || DEVICE.len < 8 {
		DEVICE.clear();
		var x = (web::epoch_ms() as int) ^ ((web::now() * 1000003.0) as int);
		for i in 16 { x = x * 6364136223846793005 + 1442695040888963407; DEVICE.push("0123456789abcdef"[((x >> 33) & 15) as int]); }
		web::store_set("amni.stitch.dev", DEVICE[..]);
	}
	let _k = web::store_get("amni.stitch.key", KEY);
	fill_select("preset", PRESET_NAMES[..], PRESET);
	if !load_state() { apply_preset(PRESET); for i in NM { BASE[i] = M[i]; } var u byte[>..] = []; if web::get_attr(app, "data-units", u) && u.len > 0 && u[0] == '1' { UNITS = 1; } }
	set_value("preset", str(PRESET)[..]);
	set_value("units", str(UNITS)[..]);
	set_value("scale", str(SCALE_PCT as int)[..]); show_scale();
	build_measure_form();
	fill_measure_inputs();
	apply_scale(); write_options();
	listen_id("preset", "change", T_PRESET);
	listen_id("units", "change", T_UNITS);
	build_picker();
	let opts = ["fit", "fabric", "sleeve", "neck", "skirt", "leg", "shape", "length", "sa", "hem"];
	for id in opts { listen_id(id, "change", T_OPT); }
	listen_id("color", "input", T_COLOR);
	listen_id("scale", "input", T_SCALE);
	listen_id("tab-pat", "click", T_TAB_PAT); listen_id("tab-3d", "click", T_TAB_3D); listen_id("tab-guide", "click", T_TAB_GUIDE);
	listen_id("dl-svg", "click", T_DL_SVG); listen_id("print-a4", "click", T_PRINT_A4); listen_id("print-letter", "click", T_PRINT_LTR); listen_id("dl-guide", "click", T_DL_GUIDE);
	listen_id("gen", "click", T_GEN); listen_id("trace", "click", T_TRACE); listen_id("upload", "click", T_UPLOAD); listen_id("dl-img", "click", T_DL_IMG);
	listen_id("add-traced", "change", T_ADD_TRACED);
	listen_id("fab-use", "click", T_FABRIC); listen_id("fab-dl", "click", T_FAB_DL); listen_id("fab-on", "change", T_FAB_ON); listen_id("fab-size", "change", T_FAB_SIZE);
	listen_id("buy", "click", T_BUY); listen_id("key-save", "click", T_KEY_SAVE); listen_id("billing", "click", T_BILLING); listen_id("key-forget", "click", T_KEY_FORGET);
	listen_id("c3d", "pointerdown", T_PDOWN); listen_id("c3d", "pointermove", T_PMOVE); listen_id("c3d", "pointerup", T_PUP); listen_id("c3d", "pointercancel", T_PUP);
	listen_id("v-front", "click", T_FRONT); listen_id("v-side", "click", T_SIDE); listen_id("v-back", "click", T_BACK);
	listen_id("acct-save", "click", T_ACCT_SAVE); listen_id("acct-list", "change", T_ACCT_PICK);
	acct_request(ACCT[..], "/v1/me", "GET", "", T_ACCT_ME);
	fill_select("cut-sheet", CU_NAMES[..], CU.sheet);
	for id in ["cut-fmt", "cut-sheet", "cut-w", "cut-h", "cut-cu", "cut-margin", "cut-gap", "cut-grain", "cut-seam", "cut-layers"] { listen_id(id, "change", T_CUT_OPT); }
	listen_id("cut-prev", "click", T_CUT_PREV); listen_id("cut-next", "click", T_CUT_NEXT); listen_id("cut-dl", "click", T_CUT_DL); listen_id("cut-all", "click", T_CUT_ALL);
	web::listen(web::WINDOW, "resize", T_RESIZE, 0);
	var c byte[>..] = []; get_value("color", c); view_color(c[..]);
	var h byte[>..] = []; web::location("hash", h);
	let at = find(h[..], "pro-session=");
	if at >= 0 { CLAIM_ID.append(h[at + 12..]); CLAIM_TRIES = 0; set_text("sub-status", "Fetching your subscription key…"); claim(); }
	show_key();
	renew_if_due();
	set_tab(0);
	rebuild();
	ask_quota();
	web::cls(el("app"), "ready", true);
}
