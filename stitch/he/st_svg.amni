// Amni-Stitch rendering: the pattern as SVG (1 user unit = 1 cm), and tiled print pages.
import math;

var LAY_W = 0.0;
var LAY_H = 0.0;
let HEAD = 9.0;   // top band for the title and the test squares
var TITLE byte[>..];

fn num(out byte[>..]&, v real) { format_flt(out, v, 2); }
fn esc(out byte[>..]&, s const byte[:]) {
	for c in s {
		if c == '&' { out.append("&amp;"); } else if c == '<' { out.append("&lt;"); } else if c == '>' { out.append("&gt;"); } else if c == '"' { out.append("&quot;"); } else { out.push(c); }
	}
}
// lays the pieces out in shelves no wider than lw; sets each piece's origin
fn layout(lw real) {
	var order int[>..] = [];
	for k in PIECES.len { order.push(k); }
	sort(order) { a, b => piece_h(a) > piece_h(b) };
	var width = lw;
	for k in PIECES.len { width = max(width, piece_w(k) + 4.0); }
	var x = 2.0; var y = HEAD + 2.0; var row = 0.0; var wmax = 0.0;
	for k in order {
		let w = piece_w(k); let h = piece_h(k);
		if x + w > width - 2.0 && x > 2.0 { x = 2.0; y += row + 3.0; row = 0.0; }
		PIECES[k].ox = x; PIECES[k].oy = y;
		x += w + 3.0; row = max(row, h); wmax = max(wmax, x);
	}
	LAY_W = max(wmax + 1.0, 40.0);
	LAY_H = y + row + 3.0;
}
fn path_of(out byte[>..]&, pts const Pt[:], f int, n int, dx real, dy real) {
	for i in n {
		let p = pts[f + i];
		out.push(if i == 0 { 'M' } else { 'L' });
		num(out, p.x + dx); out.push(' '); num(out, p.y + dy); out.push(' ');
	}
	out.push('Z');
}
fn line(out byte[>..]&, a Pt, b Pt, cls const byte[:]) {
	out.append("<line class=\""); out.append(cls); out.append("\" x1=\""); num(out, a.x); out.append("\" y1=\""); num(out, a.y);
	out.append("\" x2=\""); num(out, b.x); out.append("\" y2=\""); num(out, b.y); out.append("\"/>");
}
fn circle(out byte[>..]&, c Pt, r real, cls const byte[:]) {
	out.append("<circle class=\""); out.append(cls); out.append("\" cx=\""); num(out, c.x); out.append("\" cy=\""); num(out, c.y);
	out.append("\" r=\""); num(out, r); out.append("\"/>");
}
fn text(out byte[>..]&, at Pt, size real, cls const byte[:], s const byte[:], rot real) {
	out.append("<text class=\""); out.append(cls); out.append("\" x=\""); num(out, at.x); out.append("\" y=\""); num(out, at.y);
	out.append("\" font-size=\""); num(out, size); out.append("\"");
	if rot != 0.0 { out.append(" transform=\"rotate("); num(out, rot); out.push(' '); num(out, at.x); out.push(' '); num(out, at.y); out.append(")\""); }
	out.push('>'); esc(out, s); out.append("</text>");
}
fn arrow_head(out byte[>..]&, tip Pt, dir Pt, s real, cls const byte[:]) {
	let d = pnorm(dir); let n = pperp(d);
	line(out, tip, padd(psub(tip, pmul(d, s)), pmul(n, s * 0.5)), cls);
	line(out, tip, psub(psub(tip, pmul(d, s)), pmul(n, s * 0.5)), cls);
}
fn style(out byte[>..]&) {
	out.append("<style>.cut{fill:#fbfaf6;stroke:#16181d;stroke-width:.07}.st{fill:none;stroke:#2f6fed;stroke-width:.045;stroke-dasharray:.35 .22}");
	out.append(".fold{stroke:#c43c3c;stroke-width:.14;stroke-dasharray:1.2 .35 .25 .35}.mk{stroke:#16181d;stroke-width:.06;fill:none}.mkf{fill:#16181d}");
	out.append(".dart{stroke:#7a3fd1;stroke-width:.05;fill:none}.gr{stroke:#16181d;stroke-width:.06}.pl{stroke:#16181d;stroke-width:.04;stroke-dasharray:.6 .3}");
	out.append(".t{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;fill:#16181d}.tb{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;fill:#16181d;font-weight:700}");
	out.append(".tf{font-family:system-ui,sans-serif;fill:#c43c3c;font-weight:600}.sq{fill:none;stroke:#16181d;stroke-width:.05}.tile{fill:none;stroke:#9aa1ad;stroke-width:.03;stroke-dasharray:.5 .5}</style>");
}
// the pattern drawing (no outer <svg>), in layout coordinates
fn pattern_body(out byte[>..]&) {
	// title and test squares
	text(out, P(2.0, 2.6), 1.4, "tb", TITLE[..], 0.0);
	var sub byte[>..] = [];
	format(sub, "Seam allowance "); format_flt(sub, O.sa, 1); format(sub, " cm included (hems "); format_flt(sub, O.hem, 1); format(sub, " cm). Print at 100% and check the squares.");
	text(out, P(2.0, 4.3), 0.75, "t", sub[..], 0.0);
	out.append("<rect class=\"sq\" x=\"2\" y=\"5.2\" width=\"5\" height=\"5\"/>");
	text(out, P(4.5, 8.1), 0.9, "tb", "5 cm", 0.0);
	out.append("<rect class=\"sq\" x=\"8.5\" y=\"5.2\" width=\"5.08\" height=\"5.08\"/>");
	text(out, P(11.04, 8.1), 0.9, "tb", "2 in", 0.0);
	for &pc in PIECES {
		let k = PIECES.index_of(pc);
		let dx = pc.ox - pc.minx; let dy = pc.oy - pc.miny;
		out.append("<g transform=\"translate("); num(out, dx); out.push(' '); num(out, dy); out.append(")\">");
		out.append("<path class=\"cut\" d=\""); path_of(out, OFF[..], pc.first, pc.n, 0.0, 0.0); out.append("\"/>");
		out.append("<path class=\"st\" d=\""); path_of(out, PTS[..], pc.first, pc.n, 0.0, 0.0); out.append("\"/>");
		// fold edges
		for i in pc.n {
			if SAS[pc.first + i] <= 0.0 { line(out, PTS[pc.first + i], PTS[pc.first + (i + 1) % pc.n], "fold"); }
		}
		// marks
		var mi = pc.mfirst;
		while mi < pc.mfirst + pc.mn {
			let m = MARKS[mi];
			match m.kind {
				1 => line(out, m.a, padd(m.a, pmul(m.b, min(O.sa, 1.2))), "mk"),
				2 => { line(out, m.a, m.b, "dart"); line(out, m.b, m.c, "dart"); circle(out, m.b, 0.15, "mkf"); },
				3 => { circle(out, m.a, 0.55, "mk"); line(out, P(m.a.x - 0.35, m.a.y), P(m.a.x + 0.35, m.a.y), "mk"); },
				4 => line(out, m.a, m.b, "pl"),
				5 => circle(out, m.a, 0.18, "mkf"),
				6 => {
					let d = psub(m.b, m.a); let l = plen(d); let u = pnorm(d); let nrm = pperp(u);
					let side = if nrm.x > 0.0 || (nrm.x == 0.0 && nrm.y > 0.0) { 1.0 } else { -1.0 };
					let inward = pmul(nrm, side * 1.4);
					let a = padd(padd(m.a, pmul(u, l * 0.15)), inward); let b = padd(padd(m.a, pmul(u, l * 0.85)), inward);
					line(out, padd(m.a, pmul(u, l * 0.15)), a, "mk"); line(out, a, b, "mk"); line(out, b, padd(m.a, pmul(u, l * 0.85)), "mk");
					arrow_head(out, padd(m.a, pmul(u, l * 0.15)), pmul(inward, -1.0), 0.6, "mk");
					arrow_head(out, padd(m.a, pmul(u, l * 0.85)), pmul(inward, -1.0), 0.6, "mk");
					let mid = padd(padd(m.a, pmul(u, l * 0.5)), pmul(inward, 1.7));
					let ang = atan2(u.y, u.x) * 180.0 / PI;
					text(out, mid, 0.7, "tf", "PLACE ON FOLD", if abs(ang) > 90.0 { ang + 180.0 } else { ang });
				},
				7 => {
					if mi + 1 < pc.mfirst + pc.mn {
						let lo = MARKS[mi + 1].a;
						line(out, m.a, m.b, "dart"); line(out, m.b, lo, "dart"); line(out, lo, m.c, "dart"); line(out, m.c, m.a, "dart");
						mi += 1;
					}
				},
				_ => {},
			}
			mi += 1;
		}
		// grainline
		if pdist(pc.g0, pc.g1) > 1.0 {
			line(out, pc.g0, pc.g1, "gr");
			arrow_head(out, pc.g0, psub(pc.g0, pc.g1), 0.8, "gr");
			arrow_head(out, pc.g1, psub(pc.g1, pc.g0), 0.8, "gr");
		}
		// labels in the middle of the piece
		var cx = 0.0; var cy = 0.0;
		for i in pc.n { cx += PTS[pc.first + i].x; cy += PTS[pc.first + i].y; }
		cx /= pc.n as real; cy /= pc.n as real;
		let fs = clamp(min(piece_w(k), piece_h(k)) * 0.09, 0.7, 2.0);
		let tx = if pdist(pc.g0, pc.g1) > 1.0 { (pc.g0.x + pc.g1.x) * 0.5 + fs * 0.6 } else { cx };
		text(out, P(tx, cy - fs * 0.6), fs, "tb", pc.name[..], 0.0);
		text(out, P(tx, cy + fs * 0.6), fs * 0.62, "t", pc.note[..], 0.0);
		if pc.interfacing { text(out, P(tx, cy + fs * 1.5), fs * 0.55, "t", "Interfacing: cut 1 per piece", 0.0); }
		out.append("</g>");
	}
}
fn svg_open(out byte[>..]&, x real, y real, w real, h real, mm bool) {
	out.append("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"");
	num(out, x); out.push(' '); num(out, y); out.push(' '); num(out, w); out.push(' '); num(out, h); out.append("\"");
	if mm { out.append(" width=\""); num(out, w * 10.0); out.append("mm\" height=\""); num(out, h * 10.0); out.append("mm\""); }
	out.append(">");
}
// a complete SVG file at true size
fn svg_file(out byte[>..]&) {
	out.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
	svg_open(out, 0.0, 0.0, LAY_W, LAY_H, true);
	style(out);
	out.append("<rect x=\"0\" y=\"0\" width=\""); num(out, LAY_W); out.append("\" height=\""); num(out, LAY_H); out.append("\" fill=\"#fff\"/>");
	pattern_body(out);
	out.append("</svg>\n");
}
// the on-screen preview (scales to its box)
fn svg_screen(out byte[>..]&) {
	out.append("<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"pat\" role=\"img\" aria-label=\"Sewing pattern pieces\" viewBox=\"0 0 ");
	num(out, LAY_W); out.push(' '); num(out, LAY_H); out.append("\">");
	style(out);
	pattern_body(out);
	out.append("</svg>");
}
// print pages: paper 0 = A4, 1 = US Letter; 10 mm margins, 1 cm overlap between tiles
fn tiles(paper int) real, real, int, int {
	let tw = if paper == 0 { 19.0 } else { 19.59 };
	let th = if paper == 0 { 27.7 } else { 25.94 };
	let cols = max(((LAY_W - 1.0) / (tw - 1.0)) as int + 1, 1);
	let rows = max(((LAY_H - 1.0) / (th - 1.0)) as int + 1, 1);
	return tw, th, cols, rows;
}
fn print_html(out byte[>..]&, paper int) {
	let tw, th, cols, rows = tiles(paper);
	// the drawing once, reused by every tile
	out.append("<svg class=\"pdefs\" width=\"0\" height=\"0\" aria-hidden=\"true\"><defs><g id=\"st-pat\">");
	pattern_body(out);
	out.append("</g></defs>");
	style(out);
	out.append("</svg>");
	// a cover page with the tile map
	out.append("<section class=\"page cover\"><h1>");
	esc(out, TITLE[..]);
	out.append("</h1><p>Print every page at <b>100% / actual size</b> (no \"fit to page\"). Check the 5 cm square on page A1, then trim each page along the grey dashed line on its right and bottom edges, overlap the next page by 1 cm and tape. Letters are rows, numbers are columns.</p>");
	format(out, "<p>", rows * cols, " pages, ", rows, " rows by ", cols, " columns.</p>");
	out.append("<div class=\"map\">");
	svg_open(out, 0.0, 0.0, LAY_W, LAY_H, false);
	out.append("<use href=\"#st-pat\"/>");
	for r in rows {
		for c in cols {
			let x = c as real * (tw - 1.0); let y = r as real * (th - 1.0);
			out.append("<rect class=\"tile\" x=\""); num(out, x); out.append("\" y=\""); num(out, y); out.append("\" width=\""); num(out, tw); out.append("\" height=\""); num(out, th); out.append("\"/>");
			var lab byte[>..] = []; lab.push(('A' + r) as byte); format(lab, c + 1);
			text(out, P(x + tw * 0.5, y + th * 0.5), 3.0, "tf", lab[..], 0.0);
		}
	}
	out.append("</svg></div></section>");
	for r in rows {
		for c in cols {
			let x = c as real * (tw - 1.0); let y = r as real * (th - 1.0);
			out.append("<section class=\"page\">");
			out.append("<svg viewBox=\""); num(out, x); out.push(' '); num(out, y); out.push(' '); num(out, tw); out.push(' '); num(out, th);
			out.append("\" width=\""); num(out, tw * 10.0); out.append("mm\" height=\""); num(out, th * 10.0); out.append("mm\">");
			out.append("<use href=\"#st-pat\"/>");
			// overlap guides and the page label
			line(out, P(x + tw - 1.0, y), P(x + tw - 1.0, y + th), "tile");
			line(out, P(x, y + th - 1.0), P(x + tw, y + th - 1.0), "tile");
			var lab byte[>..] = []; lab.push(('A' + r) as byte); format(lab, c + 1);
			text(out, P(x + 0.4, y + th - 0.3), 0.6, "tf", lab[..], 0.0);
			out.append("</svg></section>");
		}
	}
}
var SK_X0 = 0.0; var SK_Y0 = 0.0; var SK_X1 = 0.0; var SK_Y1 = 0.0;
fn sk_pt(out byte[>..]&, x real, y real) { format_flt(out, x, 1); out.push(','); format_flt(out, y, 1); out.push(' '); SK_X0 = min(SK_X0, x); SK_Y0 = min(SK_Y0, y); SK_X1 = max(SK_X1, x); SK_Y1 = max(SK_Y1, y); }
fn sk_m(out byte[>..]&, cls const byte[:], x real, y real) { out.append("<path class=\""); out.append(cls); out.append("\" d=\"M"); sk_pt(out, x, y); }
fn sk_l(out byte[>..]&, x real, y real) { out.push('L'); sk_pt(out, x, y); }
fn sk_c(out byte[>..]&, ax real, ay real, bx real, by real, x real, y real) { out.push('C'); sk_pt(out, ax, ay); sk_pt(out, bx, by); sk_pt(out, x, y); }
fn sk_z(out byte[>..]&, closed bool) { if closed { out.push('Z'); } out.append("\"/>"); }
fn sk_rect(out byte[>..]&, x0 real, y0 real, x1 real, y1 real) { sk_m(out, "pc", x0, y0); sk_l(out, x1, y0); sk_l(out, x1, y1); sk_l(out, x0, y1); sk_z(out, true); }
var FIT_SY = 1.0; var FIT_SX = 1.0;
fn sv(s int, k int) int { if s >= 0 { return si(s, k); } match k { 1 => O.garment, 2 => O.fit, 3 => if O.knit { 1 } else { 0 }, 4 => O.sleeve, 5 => O.neck, 6 => O.skirt, 7 => O.leg, 8 => if O.hood { 1 } else { 0 }, 9 => if O.cuff { 1 } else { 0 }, 10 => if O.elastic { 1 } else { 0 }, _ => 0 } }
fn sk_len(s int) real { if s < 0 { return length_or_default() / FIT_SY; } let f = S_DEF[s * 13 + 12]; match si(s, 11) { 1 => 41.0 * f, 2 => 58.0 * f, 3 => 104.0 * f, 4 => 79.0 * f, _ => 0.0 } }
fn sk_hem(out byte[>..]&, x0 real, x1 real, y real, n int, dip real) { let q = (x1 - x0) / n as real; for i in n { let a = x0 + q * i as real; sk_c(out, a + q * 0.3, y + dip, a + q * 0.7, y + dip, a + q, y); } }
fn sk_ripples(out byte[>..]&, w0 real, y0 real) { for i in 7 { let x = -w0 + (i as real + 0.5) * w0 * 2.0 / 7.0; line(out, P(x, y0 - 3.3), P(x, y0 - 0.7), "ln"); } }
fn sk_skirt(out byte[>..]&, kind int, len real, elastic bool, band bool) {
	let y0 = 41.0; let w0 = 17.0; let y1 = y0 + len; let yh = y0 + min(19.0, len * 0.5);
	let hh = match kind { 0 => 21.5, 1 => 23.0 + len * 0.15, 2 => 22.0 + len * 0.22, 3 => 22.0 + len * 0.32, _ => 21.0 + len * 0.2 };
	let n = match kind { 2 => 3, 3 => 5, 4 => 4, _ => 1 };
	sk_m(out, "pc", -w0, y0);
	if kind <= 1 { sk_c(out, -21.0, y0 + 3.0, -23.5, yh - 9.0, -23.5, yh); }
	sk_l(out, -hh, y1);
	sk_hem(out, -hh, hh, y1, n, if n == 1 { 1.5 } else { 3.5 });
	if kind <= 1 { sk_l(out, 23.5, yh); sk_c(out, 23.5, yh - 9.0, 21.0, y0 + 3.0, w0, y0); } else { sk_l(out, w0, y0); }
	sk_z(out, true);
	for j in n - 1 { let t = (j + 1) as real / n as real; line(out, P(-w0 + 2.0 * w0 * t, y0 + 1.0), P(-hh + 2.0 * hh * t, y1 - 0.5), "ln"); }
	if band { sk_rect(out, -w0 - 0.5, y0 - 4.0, w0 + 0.5, y0); if elastic { sk_ripples(out, w0, y0); } }
}
fn sk_pants(out byte[>..]&, s int) {
	let fit = sv(s, 2) as real; let leg = sv(s, 7); let shorts = sv(s, 1) == G_SHORTS; let elastic = sv(s, 10) == 1;
	let y0 = 41.0; let w0 = 17.0 + (if elastic { 1.0 } else { 0.0 }); let yh = 60.0; let hw = 24.0 + fit * 0.7; let yc = 67.0; let y1 = yc + sk_len(s);
	let lw = if shorts { 12.0 + fit * 0.7 } else { (match leg { 1 => 7.0, 2 => 13.5, _ => 9.5 }) + fit * 0.5 };
	let cx = max(14.0, lw + 4.5);
	sk_m(out, "pc", -w0, y0); sk_l(out, w0, y0); sk_c(out, w0 + 4.0, y0 + 3.0, hw, yh - 9.0, hw, yh);
	sk_l(out, cx + lw, y1); sk_l(out, cx - lw, y1); sk_l(out, 0.0, yc); sk_l(out, -cx + lw, y1); sk_l(out, -cx - lw, y1);
	sk_l(out, -hw, yh); sk_c(out, -hw, yh - 9.0, -w0 - 4.0, y0 + 3.0, -w0, y0); sk_z(out, true);
	sk_rect(out, -w0 - 0.3, y0 - 4.0, w0 + 0.3, y0);
	if elastic { sk_ripples(out, w0, y0); } else { line(out, P(0.0, y0), P(0.0, yc - 3.0), "ln"); sk_m(out, "ln", 3.5, y0); sk_l(out, 3.5, yc - 8.0); sk_c(out, 3.5, yc - 5.0, 2.0, yc - 3.5, 0.0, yc - 3.5); sk_z(out, false); }
	if sv(s, 9) == 1 { for side in 2 { let sg = if side == 0 { -1.0 } else { 1.0 }; sk_rect(out, sg * cx - lw + 0.3, y1 - 5.0, sg * cx + lw - 0.3, y1); } }
}
fn sk_top(out byte[>..]&, s int) {
	let g = sv(s, 1); let fit = sv(s, 2) as real; let sl = sv(s, 4); let nk = sv(s, 5);
	let hoodie = g == G_HOODIE; let shirt = g == G_SHIRT; let hood = hoodie && sv(s, 8) == 1;
	let fitted = sv(s, 2) == 0 || g == G_BODICE || g == G_DRESS;
	let below = if g == G_DRESS || g == G_BODICE { 0.0 } else { sk_len(s) };
	let nw = 7.0 + (if nk == 2 { 3.0 } else { 0.0 }) + (if hoodie { 1.0 } else { 0.0 });
	let fx = 1.0 / FIT_SX; let so = M[M_SHOULDER] * 0.55 + (if fit >= 3.0 { 2.0 } else { 0.0 }) + fit * 0.5 + (if hoodie { 1.0 } else { 0.0 }); let aw = M[M_CHEST] * 0.087;
	let sw = if s < 0 { (if sl == 0 && !shirt { so - aw * 0.8 } else { so }) * fx } else if sl == 0 && !shirt { 14.0 } else { 18.0 + (if fit >= 3.0 { 4.0 } else { 0.0 }) + (if hoodie { 2.0 } else { 0.0 }) };
	let sy = if fit >= 3.0 { 7.0 } else { 4.0 };
	let ay = 21.0 + fit * 1.5 + (if hoodie { 2.0 } else { 0.0 });
	let bw = if s < 0 { (so - aw + fit * 1.2 + (if hoodie { 1.0 } else { 0.0 })) * fx } else { 21.0 + fit * 1.7 + (if hoodie { 2.0 } else { 0.0 }) };
	let ww = if !fitted { bw } else if s < 0 { min(bw, (M[M_WAIST] * 0.19 + 1.0) * fx) } else { 17.0 };
	let hp = if s < 0 { (M[M_HIP] * 0.18 + 1.0 + fit) * fx } else { 24.0 };
	let hy = 41.0 + below;
	let hw = if below <= 0.0 { bw + (ww - bw) * (hy - ay) / (41.0 - ay) } else if below < 19.0 { ww + (max(bw, hp) - ww) * below / 19.0 } else { max(bw, hp) + (below - 19.0) * 0.12 };
	if hood && s >= 0 {
		sk_m(out, "pc", -nw - 1.0, 2.0); sk_c(out, -15.0, -5.0, -11.0, -23.0, 0.0, -23.0); sk_c(out, 11.0, -23.0, 15.0, -5.0, nw + 1.0, 2.0); sk_z(out, true);
		sk_m(out, "ln", -nw + 1.0, 1.0); sk_c(out, -9.0, -9.0, -5.0, -17.0, 0.0, -17.0); sk_c(out, 5.0, -17.0, 9.0, -9.0, nw - 1.0, 1.0); sk_z(out, false);
	}
	if sl > 0 {
		let th = if s < 0 { 1.52 } else { match sl { 1 => 0.44, 2 => 0.7, _ => 0.87 } };
		let ex = match sl { 1 => 9.0, 2 => 22.0, _ => 38.0 };
		for side in 2 {
			let sg = if side == 0 { -1.0 } else { 1.0 };
			let dx = sg * cos(th); let dy = sin(th); let nx = -sg * sin(th); let ny = cos(th);
			let ax = sg * (bw - sw); let ad = ay - sy;
			let along = ax * dx + ad * dy; let top = ax * nx + ad * ny;
			let ln = if s < 0 { M[M_ARMLEN] / FIT_SY * (match sl { 1 => 0.33, 2 => 0.73, _ => 1.02 }) } else { along + ex };
			let w = if s < 0 { (match sl { 1 => aw + 2.5 + fit, 2 => 8.0 + fit * 0.7, _ => 7.0 + fit * 0.7 }) * fx } else if sl == 1 { top * 0.88 } else { (if sl == 2 { 9.5 } else { 7.5 }) + fit * 0.7 };
			let ox = sg * sw + ln * dx; let oy = sy + ln * dy; let ix = ox + w * nx; let iy = oy + w * ny;
			sk_m(out, "pc", sg * sw, sy); sk_l(out, ox, oy); sk_l(out, ix, iy); sk_l(out, sg * bw, ay); sk_z(out, true);
			if hoodie || (shirt && sl == 3) { line(out, P(ox - 5.0 * dx, oy - 5.0 * dy), P(ix - 5.0 * dx, iy - 5.0 * dy), "ln"); }
		}
	}
	sk_m(out, "pc", -nw, 0.0); sk_l(out, -sw, sy);
	if sl == 0 && !shirt { sk_c(out, -sw + 1.0, ay - 9.0, -bw + 3.0, ay - 1.0, -bw, ay); } else { sk_l(out, -bw, ay); }
	if below > 0.0 { sk_l(out, -ww, 41.0); }
	sk_l(out, -hw, hy); sk_l(out, hw, hy);
	if below > 0.0 { sk_l(out, ww, 41.0); }
	if sl == 0 && !shirt { sk_l(out, bw, ay); sk_c(out, bw - 3.0, ay - 1.0, sw - 1.0, ay - 9.0, sw, sy); } else { sk_l(out, bw, ay); sk_l(out, sw, sy); }
	sk_l(out, nw, 0.0);
	let nd = match nk { 1 => 17.0, 2 => 13.0, _ => if shirt { 4.0 } else { 7.0 } };
	if nk == 1 { sk_l(out, 0.0, nd); sk_l(out, -nw, 0.0); } else { sk_c(out, nw * 0.55, nd * 1.33, -nw * 0.55, nd * 1.33, -nw, 0.0); }
	sk_z(out, true); if s < 0 { sk_m(out, "nk", -nw - 0.5, -1.0); sk_l(out, nw + 0.5, -1.0); sk_l(out, nw + 0.5, nd); sk_l(out, -nw - 0.5, nd); sk_z(out, true); }
	if hoodie {
		sk_rect(out, -hw + 1.0, hy, hw - 1.0, hy + 5.0);
		if hood { sk_m(out, "pc", -13.0, hy - 1.0); sk_l(out, -9.0, hy - 13.0); sk_l(out, 9.0, hy - 13.0); sk_l(out, 13.0, hy - 1.0); sk_z(out, true); line(out, P(-3.0, 2.0), P(-3.5, 13.0), "ln"); line(out, P(3.0, 2.0), P(3.5, 13.0), "ln"); }
	}
	if shirt {
		line(out, P(0.0, 5.0), P(0.0, hy), "ln");
		var y = 9.0; while y < hy - 2.0 { circle(out, P(0.0, y), 0.9, "bt"); y += 8.0; }
		for side in 2 { let sg = if side == 0 { -1.0 } else { 1.0 }; sk_m(out, "pc", sg * (nw + 0.5), -0.8); sk_l(out, sg * 0.3, 5.0); sk_l(out, sg * 4.5, 10.0); sk_z(out, true); }
	}
	if g == G_BODICE { for side in 2 { let sg = if side == 0 { -1.0 } else { 1.0 }; sk_m(out, "ln", sg * 10.5, 41.0); sk_l(out, sg * 9.0, 28.0); sk_l(out, sg * 7.5, 41.0); sk_z(out, false); } }
}
fn sk_picture(out byte[>..]&) { sk_rect(out, 0.0, 0.0, 60.0, 46.0); sk_m(out, "ln", 5.0, 40.0); sk_l(out, 20.0, 21.0); sk_l(out, 30.0, 32.0); sk_l(out, 38.0, 25.0); sk_l(out, 55.0, 40.0); sk_z(out, false); circle(out, P(44.0, 13.0), 5.0, "ln"); }
fn style_svg(out byte[>..]&, s int) {
	SK_X0 = 1.0e9; SK_Y0 = 1.0e9; SK_X1 = -1.0e9; SK_Y1 = -1.0e9;
	var b byte[>..] = []; sk_body(b, s);
	out.append("<svg class=\"sk\" viewBox=\""); num(out, SK_X0 - 2.0); out.push(' '); num(out, SK_Y0 - 2.0); out.push(' '); num(out, SK_X1 - SK_X0 + 4.0); out.push(' '); num(out, SK_Y1 - SK_Y0 + 4.0);
	out.append("\" aria-hidden=\"true\" focusable=\"false\">"); out.append(b[..]); out.append("</svg>");
}
fn sk_body(b byte[>..]&, s int) { let g = sv(s, 1); if g == G_TRACED { sk_picture(b); } else if g == G_SKIRT { sk_skirt(b, sv(s, 6), sk_len(s), sv(s, 10) == 1, true); } else if g == G_TROUSERS || g == G_SHORTS { sk_pants(b, s); } else { if g == G_DRESS { sk_skirt(b, sv(s, 6), sk_len(s), false, false); } sk_top(b, s); } }
fn hexv(c byte) int { if c >= '0' && c <= '9' { (c - '0') as int } else if c >= 'a' && c <= 'f' { (c - 'a') as int + 10 } else if c >= 'A' && c <= 'F' { (c - 'A') as int + 10 } else { 0 } }
fn hex_rgb(hex const byte[:]) int, int, int { if hex.len < 7 { return 109, 143, 191; } return hexv(hex[1]) * 16 + hexv(hex[2]), hexv(hex[3]) * 16 + hexv(hex[4]), hexv(hex[5]) * 16 + hexv(hex[6]); }
let CN_NAMES const byte[:][27] = ["black", "charcoal", "gray", "light gray", "white", "cream", "beige", "tan", "brown", "burgundy", "red", "coral", "pink", "hot pink", "orange", "mustard", "yellow", "olive", "green", "sage green", "teal", "sky blue", "dusty blue", "blue", "navy", "lavender", "purple"];
let CN_RGB const int[81] = [25, 25, 25, 64, 64, 70, 128, 128, 128, 200, 200, 200, 245, 245, 245, 240, 232, 205, 215, 195, 160, 190, 150, 100, 110, 70, 40, 120, 25, 45, 200, 35, 45, 240, 120, 100, 240, 165, 190, 230, 60, 140, 240, 130, 40, 205, 165, 40, 245, 220, 70, 110, 115, 50, 45, 140, 70, 155, 175, 135, 30, 128, 128, 135, 195, 235, 110, 140, 180, 45, 90, 190, 25, 35, 80, 185, 165, 220, 110, 50, 140];
fn color_name(hex const byte[:]) const byte[:] { let r, g, b = hex_rgb(hex); var best = 0; var bd = 1 << 40; for i in 27 { let dr = r - CN_RGB[i * 3]; let dg = g - CN_RGB[i * 3 + 1]; let db = b - CN_RGB[i * 3 + 2]; let d = 2 * dr * dr + 4 * dg * dg + 3 * db * db; if d < bd { bd = d; best = i; } } CN_NAMES[best] }
fn fit_tf(out byte[>..]&, x real, y real, k real) { FIT_SY = max(0.834 * M[M_HEIGHT] - waist_height(), 25.0) / 41.0; FIT_SX = (M[M_CHEST] + M[M_WAIST] + M[M_HIP]) / 266.0 * 0.87; let sx = FIT_SX; out.append("translate("); num(out, x); out.push(' '); num(out, y); out.append(") scale("); num(out, k * sx); out.push(' '); num(out, k * FIT_SY); out.push(')'); }
fn fit_svg(out byte[>..]&, x real, y real, k real, hex const byte[:], fab const byte[:], tile real, ar real) {
	let r, g, b = hex_rgb(hex); var sh byte[>..] = []; format(sh, "rgb(", r * 11 / 20, ",", g * 11 / 20, ",", b * 11 / 20, ")");
	out.append("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 768 1152\" width=\"768\" height=\"1152\"><style>.pc{fill:"); out.append(if fab.len > 0 { "url(#fab)" } else if hex.len >= 7 { hex[..7] } else { "#6d8fbf" });
	out.append(";stroke:"); out.append(sh[..]); out.append(";stroke-width:.3;stroke-linejoin:round}.ln{fill:none;stroke:"); out.append(sh[..]); out.append(";stroke-width:.3}.bt{fill:"); out.append(sh[..]); out.append("}.nk{fill:none}</style>");
	if fab.len > 0 { out.append("<defs><pattern id=\"fab\" patternUnits=\"userSpaceOnUse\" width=\""); num(out, tile); out.append("\" height=\""); num(out, tile * ar); out.append("\"><image href=\""); out.append(fab); out.append("\" width=\""); num(out, tile); out.append("\" height=\""); num(out, tile * ar); out.append("\" preserveAspectRatio=\"none\"/></pattern></defs>"); }
	out.append("<g id=\"try-g\" transform=\""); fit_tf(out, x, y, k); out.append("\">"); sk_body(out, -1); out.append("</g></svg>");
}
