        (id: "teacup_dive", kind: Canvas, at: P(6, -7.6, -14), needs: [Ability("murk_dive")], moment: "Murk Dive into the Teacup Lagoon and swim down into the drowned teacup glowing with algae."),
        (id: "pot_tower", kind: Canvas, at: P(-47.5, 23.1, -4.5), moment: "Shove loose brick chunks into steps and climb the stack of upturned planters."),
        (id: "lily_hop", kind: Canvas, at: P(-40, 2.0, -44), reward_of: Some("challenge:lilyhop"), moment: "Hop across the Duckweed Pond and light all eight lily pads before the bog swallows them."),
