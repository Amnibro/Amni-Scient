/lib/amni-llm/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/update
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/update.sh
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/game/revamp/pkg/*
  Cache-Control: public, max-age=31536000, immutable

/game/revamp/revamp/*
  Cache-Control: public, max-age=31536000, immutable
