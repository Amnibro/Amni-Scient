struct Rule { layer i32, geom i32, classes u64, brunnel i32, ramp i32, amin i32, amax i32, minz f32, maxz f32, color u32, dark u32, alpha f32, za f32, wa f32, zb f32, wb f32, zc f32, wc f32, base f32, dash f32, gap f32 }
struct Attrs { cls i32 = -1, cls_s const byte[:] = "", sub_s const byte[:] = "", brunnel i32 = 0, ramp bool = false, admin i32 = 0, maritime bool = false, rank i32 = 0, capital i32 = 0, ele_ft int = -1, name const byte[:] = "", name_latin const byte[:] = "", name_en const byte[:] = "", hn const byte[:] = "", ref const byte[:] = "" }
struct LabelStyle { ok bool = false, pri i32 = 0, minz f32 = 0.0, maxz f32 = 24.0, font i32 = 0, size f32 = 12.0, color u32 = 0, dark u32 = 0, dot u32 = 0, line bool = false }
var rules Rule[>..] = [];
