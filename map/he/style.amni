let CLASS_NAMES = ["wood", "grass", "wetland", "sand", "ice", "farmland", "rock", "residential", "pitch", "track", "cemetery", "hospital", "school", "university", "college", "kindergarten", "river", "canal", "stream", "ditch", "drain", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "path", "rail", "transit", "raceway", "busway", "pier", "ferry", "runway", "taxiway"];
fn class_id(name const byte[:]) int {
	for n, i in CLASS_NAMES { if n == name { return i; } }
	return -1;
}
fn layer_id(name const byte[:]) i32 {
	if name == "water" { return L_WATER; }
	if name == "waterway" { return L_WATERWAY; }
	if name == "landcover" { return L_LANDCOVER; }
	if name == "landuse" { return L_LANDUSE; }
	if name == "park" { return L_PARK; }
	if name == "boundary" { return L_BOUNDARY; }
	if name == "aeroway" { return L_AEROWAY; }
	if name == "transportation" { return L_TRANSPORTATION; }
	if name == "building" { return L_BUILDING; }
	if name == "water_name" { return L_WATER_NAME; }
	if name == "transportation_name" { return L_TRANSPORTATION_NAME; }
	if name == "place" { return L_PLACE; }
	if name == "housenumber" { return L_HOUSENUMBER; }
	if name == "poi" { return L_POI; }
	if name == "mountain_peak" { return L_MOUNTAIN_PEAK; }
	if name == "aerodrome_label" { return L_AERODROME_LABEL; }
	return -1;
}
fn style_init() {
	if rules.len > 0 { return; }
	let rs = rows();
	let one u64 = 1;
	for &r in rs {
		let g i32 = if r.geom == "fill" { GEOM_FILL } else if r.geom == "line" { GEOM_LINE } else { GEOM_EDGE };
		var mask u64 = 0;
		for w in words(r.classes) {
			if w == "any" { continue; }
			let c = class_id(w);
			if c >= 0 { mask |= one << (c as u64); }
		}
		let b i32 = if r.brunnel == "surface" { 1 } else if r.brunnel == "bridge" { 2 } else { 0 };
		let rp i32 = if r.ramp == "no" { 1 } else if r.ramp == "yes" { 2 } else { 0 };
		rules.push(Rule { layer_id(r.layer), g, mask, b, rp, r.amin, r.amax, r.minz, r.maxz, r.color, r.dark, r.alpha, r.za, r.wa, r.zb, r.wb, r.zc, r.wc, r.base, r.dash, r.gap });
	}
}
fn rule_matches(r Rule, layer i32, gtype i32, a Attrs) bool {
	if r.layer != layer { return false; }
	if r.geom == GEOM_LINE { if gtype != G_LINE { return false; } } else if gtype != G_POLY { return false; }
	if r.classes != 0 {
		if a.cls < 0 { return false; }
		let one u64 = 1;
		if (r.classes & (one << (a.cls as u64))) == 0 { return false; }
	}
	if r.brunnel == 1 && a.brunnel == 1 { return false; }
	if r.brunnel == 2 && a.brunnel != 1 { return false; }
	if r.ramp == 1 && a.ramp { return false; }
	if r.ramp == 2 && !a.ramp { return false; }
	if layer == L_BOUNDARY {
		if a.admin < r.amin || a.admin > r.amax || a.maritime { return false; }
	}
	true
}
fn feature_mask(layer i32, gtype i32, a Attrs) u64 {
	var m u64 = 0;
	let one u64 = 1;
	for i in rules.len { if rule_matches(rules[i], layer, gtype, a) { m |= one << (i as u64); } }
	m
}
fn expo(p real, d real, base real) real {
	if d <= 0.0 { return 1.0; }
	if base == 1.0 { return p / d; }
	(pow(base, p) - 1.0) / (pow(base, d) - 1.0)
}
fn rule_width(r Rule, z real) real {
	let za real = r.za;
	let zb real = r.zb;
	let zc real = r.zc;
	let wa real = r.wa;
	let wb real = r.wb;
	let wc real = r.wc;
	let base real = r.base;
	var w real = wc;
	if z < za { w = wa; }
	else if z > zc { w = wc; }
	else if za != zb && z <= zb { w = wa + (wb - wa) * expo(z - za, zb - za, base); }
	else { w = wb + (wc - wb) * expo(z - zb, zc - zb, base); }
	max(w, 0.0)
}
fn rule_color(r Rule, dark bool) u32 { if dark { r.dark } else { r.color } }
fn label_text(layer i32, a Attrs, out byte[>..]&) {
	if layer == L_HOUSENUMBER { out.append(a.hn); return; }
	if a.name_latin.len > 0 { out.append(a.name_latin); }
	else if a.name.len > 0 { out.append(a.name); }
	else if a.name_en.len > 0 { out.append(a.name_en); }
	else if layer == L_TRANSPORTATION_NAME { out.append(a.ref); }
	if layer == L_MOUNTAIN_PEAK && a.ele_ft >= 0 {
		out.push('\n');
		let s = str(a.ele_ft);
		for i in s.len {
			if i > 0 && (s.len - i) % 3 == 0 { out.push(','); }
			out.push(s[i]);
		}
		out.append(" ft");
	}
}
fn poi_dot(cls const byte[:]) u32 {
	if cls == "restaurant" || cls == "fast_food" || cls == "cafe" || cls == "bar" || cls == "pub" || cls == "ice_cream" || cls == "bakery" || cls == "beer" || cls == "food" { return 0xe07b3a; }
	if cls == "shop" || cls == "grocery" || cls == "supermarket" || cls == "clothing_store" || cls == "convenience" || cls == "mall" || cls == "alcohol_shop" || cls == "department_store" || cls == "jewelry" { return 0x9b59c7; }
	if cls == "hospital" || cls == "pharmacy" || cls == "doctors" || cls == "dentist" || cls == "clinic" || cls == "veterinary" { return 0xd9534f; }
	if cls == "school" || cls == "college" || cls == "university" || cls == "library" || cls == "kindergarten" || cls == "museum" { return 0x9c7a4a; }
	if cls == "bus" || cls == "railway" || cls == "airport" || cls == "ferry_terminal" || cls == "fuel" || cls == "parking" || cls == "bicycle_rental" || cls == "car" || cls == "aerialway" || cls == "harbor" { return 0x3b7dd8; }
	if cls == "park" || cls == "playground" || cls == "garden" || cls == "sports" || cls == "pitch" || cls == "zoo" || cls == "campsite" || cls == "golf" || cls == "swimming" || cls == "stadium" || cls == "attraction" { return 0x4a9e5c; }
	if cls == "lodging" { return 0x8a5cc7; }
	if cls == "place_of_worship" { return 0x777777; }
	0x8a8f99
}
fn mk_label(pri i32, size f32, minz f32, maxz f32, color u32, dark u32, font i32) LabelStyle {
	LabelStyle { ok: true, pri: pri, minz: minz, maxz: maxz, font: font, size: size, color: color, dark: dark, dot: 0, line: false }
}
fn label_style(layer i32, gtype i32, a Attrs) LabelStyle {
	let c = a.cls_s;
	let r i32 = if a.rank == 0 { 10 } else { a.rank };
	if layer == L_PLACE {
		if c == "continent" { return mk_label(0, 14.0, 0.0, 2.0, 0x333333, 0xe6e8eb, F_BOLD); }
		if c == "country" {
			let sz f32 = if r <= 2 { 15.0 } else { 13.0 };
			let mz f32 = if r == 1 { 1.0 } else if r == 2 { 2.0 } else { 3.0 };
			return mk_label(10 + r, sz, mz, 9.0, 0x334455, 0xd8dde4, F_BOLD);
		}
		if c == "state" || c == "province" { return mk_label(30 + r, 12.0, 5.0, 10.0, 0x667788, 0xa9b2bd, F_REGULAR); }
		if c == "city" {
			let p i32 = if a.capital == 2 { 20 + r - 1 } else { 20 + r };
			let sz f32 = if r <= 3 { 16.0 } else { 14.0 };
			let mz f32 = if r <= 3 { 3.0 } else if r <= 7 { 5.0 } else if r <= 9 { 7.0 } else { 8.0 };
			return mk_label(p, sz, mz, 15.0, 0x333333, 0xe6e8eb, F_REGULAR);
		}
		if c == "town" { return mk_label(40 + r, 13.0, 7.0, 17.0, 0x333333, 0xe6e8eb, F_REGULAR); }
		if c == "village" { return mk_label(50 + r, 12.0, 9.0, 18.0, 0x333333, 0xe6e8eb, F_REGULAR); }
		if c == "suburb" || c == "quarter" { return mk_label(60 + r, 12.0, 11.0, 18.0, 0x555555, 0xc5cad1, F_REGULAR); }
		if c == "neighbourhood" { return mk_label(65, 11.0, 13.0, 19.0, 0x666666, 0xb2b8c0, F_REGULAR); }
		if c == "hamlet" || c == "isolated_dwelling" || c == "locality" { return mk_label(70, 11.0, 12.0, 19.0, 0x333333, 0xe6e8eb, F_REGULAR); }
		if c == "island" { return mk_label(55, 12.0, 9.0, 24.0, 0x333333, 0xe6e8eb, F_ITALIC); }
		return LabelStyle { .. };
	}
	if layer == L_WATER_NAME {
		if c == "ocean" { return mk_label(5, 14.0, 0.0, 8.0, 0x495e91, 0x8fb4d8, F_ITALIC); }
		if c == "sea" || c == "bay" || c == "strait" { return mk_label(35, 12.0, 3.0, 14.0, 0x495e91, 0x8fb4d8, F_ITALIC); }
		return mk_label(45, 12.0, 9.0, 24.0, 0x495e91, 0x8fb4d8, F_ITALIC);
	}
	if layer == L_TRANSPORTATION_NAME {
		var s = LabelStyle { .. };
		if c == "motorway" || c == "trunk" { s = mk_label(100, 12.0, 13.0, 24.0, 0x555555, 0xc8ccd2, F_REGULAR); }
		else if c == "primary" { s = mk_label(101, 12.0, 13.0, 24.0, 0x555555, 0xc8ccd2, F_REGULAR); }
		else if c == "secondary" || c == "tertiary" { s = mk_label(103, 12.0, 13.0, 24.0, 0x555555, 0xc8ccd2, F_REGULAR); }
		else if c == "minor" || c == "service" { s = mk_label(110, 11.0, 15.0, 24.0, 0x555555, 0xc8ccd2, F_REGULAR); }
		else if c == "path" || c == "track" { s = mk_label(120, 11.0, 16.0, 24.0, 0x555555, 0xc8ccd2, F_REGULAR); }
		else { return s; }
		s.line = true;
		return s;
	}
	if layer == L_POI {
		let mz f32 = if r <= 7 { 15.0 } else if r <= 20 { 16.0 } else { 17.0 };
		var s = mk_label(200 + r, 11.0, mz, 24.0, 0x666666, 0xb8bcc4, F_REGULAR);
		s.dot = poi_dot(c);
		return s;
	}
	if layer == L_HOUSENUMBER { return mk_label(400, 10.0, 17.0, 24.0, 0x888888, 0x9aa0a8, F_REGULAR); }
	if layer == L_MOUNTAIN_PEAK {
		var s = mk_label(150 + r, 11.0, 12.0, 24.0, 0x725a3a, 0xc9b08a, F_REGULAR);
		s.dot = 0x8a6a44;
		return s;
	}
	if layer == L_AERODROME_LABEL {
		var s = mk_label(140, 11.0, 10.0, 24.0, 0x555555, 0xc5cad1, F_REGULAR);
		s.dot = 0x3b7dd8;
		return s;
	}
	LabelStyle { .. }
}
