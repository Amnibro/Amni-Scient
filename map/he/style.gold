use std
into style.amni
lang amni

Module header: the single line "import math;". No namespace. The Helium has no blank lines and no comments anywhere, and keeps statements short and dense. This module is the map look of Amni-Map on the web: which OpenMapTiles features get drawn, in what order, colors for the light and the dark look, line widths by zoom, and how labels are chosen.

```amni
let L_WATER i32 = 0;
let L_WATERWAY i32 = 1;
let L_LANDCOVER i32 = 2;
let L_LANDUSE i32 = 3;
let L_PARK i32 = 4;
let L_BOUNDARY i32 = 5;
let L_AEROWAY i32 = 7;
let L_TRANSPORTATION i32 = 8;
let L_BUILDING i32 = 9;
let L_WATER_NAME i32 = 10;
let L_TRANSPORTATION_NAME i32 = 11;
let L_PLACE i32 = 12;
let L_HOUSENUMBER i32 = 13;
let L_POI i32 = 14;
let L_MOUNTAIN_PEAK i32 = 15;
let L_AERODROME_LABEL i32 = 17;
let G_POINT i32 = 1;
let G_LINE i32 = 2;
let G_POLY i32 = 3;
let GEOM_FILL i32 = 1;
let GEOM_LINE i32 = 2;
let GEOM_EDGE i32 = 3;
let F_REGULAR i32 = 0;
let F_BOLD i32 = 1;
let F_ITALIC i32 = 2;
struct Row { name byte[..24], layer byte[..24], geom byte[..8], classes byte[..64], brunnel byte[..8], ramp byte[..4], amin i32, amax i32, minz f32, maxz f32, color u32, dark u32, alpha f32, za f32, wa f32, zb f32, wb f32, zc f32, wc f32, base f32, dash f32, gap f32 }
struct Rule { layer i32, geom i32, classes u64, brunnel i32, ramp i32, amin i32, amax i32, minz f32, maxz f32, color u32, dark u32, alpha f32, za f32, wa f32, zb f32, wb f32, zc f32, wc f32, base f32, dash f32, gap f32 }
struct Attrs { cls i32 = -1, cls_s const byte[:] = "", sub_s const byte[:] = "", brunnel i32 = 0, ramp bool = false, admin i32 = 0, maritime bool = false, rank i32 = 0, capital i32 = 0, ele_ft int = -1, name const byte[:] = "", name_latin const byte[:] = "", name_en const byte[:] = "", hn const byte[:] = "", ref const byte[:] = "" }
struct LabelStyle { ok bool = false, pri i32 = 0, minz f32 = 0.0, maxz f32 = 24.0, font i32 = 0, size f32 = 12.0, color u32 = 0, dark u32 = 0, dot u32 = 0, line bool = false }
var rules Rule[>..] = [];
```

