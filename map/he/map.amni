struct Area { id int = 0, name byte[..64] = "", w real = 0.0, s real = 0.0, e real = 0.0, n real = 0.0, tpl byte[..200] = "", tiles int = 0, failed int = 0, saved real = 0.0 }
struct Hit { title byte[..120] = "", sub byte[..200] = "", lon real = 0.0, lat real = 0.0, ext bool = false, x1 real = 0.0, y1 real = 0.0, x2 real = 0.0, y2 real = 0.0, zoom real = 17.0 }
struct Batch { id i32, pos int, count int, tries i32 }
