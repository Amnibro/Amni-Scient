import os;
import dictionary;
fn fnv1a(s const byte[:]) u64 {
	var h u64 = 14695981039346656037;
	for c in s {
		h = (h ^ c) * 1099511628211;
	}
	h
}
fn run_lines(command const byte[:], scratch const byte[:]) byte[][>..] {
	var full byte[>..] = [];
	full.append(command);
	full.append(" > ");
	full.append(scratch);
	run_command(full);
	var data byte[>..] = [];
	read_file(scratch, data);
	delete_file(scratch);
	var out byte[][>..] = [];
	for line in split(data, '\n') {
		var l = line;
		while l.len > 0 && l[l.len - 1] == '\r' { l = l[..l.len - 1]; }
		if trim(l).len > 0 { out.push(copy(l)); }
	}
	out
}
fn bad_dir(d const byte[:]) bool {
	if d.len > 0 && (d[0] == '_' || d[0] == '.') { return true; }
	d == ".git" || d == ".github" || d == "node_modules" || d == "assets" || d == "tests" || d == "tools" || d == "scripts" || d == "docs" || d == "backups" || d == "x" || d == "_shared" || d == "vendor" || d == "pkg"
}
fn page_list() byte[][>..] {
	let lines = run_lines("git -c core.quotepath=off ls-files -co --exclude-standard -- '*.html'", "tools/.sitemap-pages");
	var out byte[][>..] = [];
	for path in lines {
		var ok = true;
		var name const byte[:] = "";
		let parts = split(path, '/');
		for p, i in parts {
			if i + 1 == parts.len { name = p; } else if bad_dir(p) { ok = false; }
		}
		if ok && name != "404.html" && !(name.len > 0 && name[0] == '_') { out.push(copy(path)); }
	}
	out
}
fn lc(c byte) byte { if c >= 'A' && c <= 'Z' { c + 32 } else { c } }
fn ieq(a const byte[:], b const byte[:]) bool {
	if a.len != b.len { return false; }
	for i in a.len { if lc(a[i]) != lc(b[i]) { return false; } }
	true
}
fn robots_rules() byte[][>..] {
	var data byte[>..] = [];
	read_file("robots.txt", data);
	var out byte[][>..] = [];
	for line in split(data, '\n') {
		let t = trim(line);
		if t.len >= 9 && ieq(t[..9], "disallow:") {
			let r = trim(t[9..]);
			if r.len > 0 { out.push(copy(r)); }
		}
	}
	out
}
recursive fn rule_match(rule const byte[:], ri int, path const byte[:], pi int) bool {
	if ri == rule.len { return true; }
	let c = rule[ri];
	if c == '*' {
		for k in pi..path.len + 1 {
			if rule_match(rule, ri + 1, path, k) { return true; }
		}
		return false;
	}
	if c == '$' && ri == rule.len - 1 { return pi == path.len; }
	if pi < path.len && path[pi] == c { return rule_match(rule, ri + 1, path, pi + 1); }
	false
}
fn disallowed(path, rules) bool {
	for r in rules {
		if rule_match(r, 0, path, 0) { return true; }
	}
	false
}
fn ws(c byte) bool { c == ' ' || c == '\t' || c == '\n' || c == '\r' }
fn tag_attr(html const byte[:], tag const byte[:], key const byte[:], value const byte[:], want const byte[:]) byte[>..] {
	var out byte[>..] = [];
	let n = html.len;
	var i = 0;
	while i < n {
		if html[i] != '<' { i++; continue; }
		let s = i + 1;
		var e = s;
		while e < n && !ws(html[e]) && html[e] != '/' && html[e] != '>' { e++; }
		i = e;
		if !ieq(html[s..e], tag) { continue; }
		var matched = false;
		var got = false;
		var found byte[>..] = [];
		var p = e;
		while p < n && html[p] != '>' {
			if ws(html[p]) || html[p] == '/' { p++; continue; }
			let ns = p;
			while p < n && !ws(html[p]) && html[p] != '=' && html[p] != '>' && html[p] != '/' { p++; }
			let name = html[ns..p];
			while p < n && ws(html[p]) { p++; }
			var vs = p;
			var ve = p;
			if p < n && html[p] == '=' {
				p++;
				while p < n && ws(html[p]) { p++; }
				if p < n && (html[p] == '"' || html[p] == '\'') {
					let q = html[p];
					p++;
					vs = p;
					while p < n && html[p] != q { p++; }
					ve = p;
					if p < n { p++; }
				} else {
					vs = p;
					while p < n && !ws(html[p]) && html[p] != '>' { p++; }
					ve = p;
				}
			}
			let val = html[vs..ve];
			if ieq(name, key) && ieq(val, value) { matched = true; }
			if ieq(name, want) && !got {
				got = true;
				found.append(val);
			}
		}
		i = p;
		if matched {
			out.append(found);
			return out;
		}
	}
	out
}
fn served(address const byte[:]) byte[>..] {
	var out byte[>..] = [];
	if ends_with(address, "index.html") {
		out.append(address[..address.len - 10]);
	} else if ends_with(address, ".html") {
		out.append(address[..address.len - 5]);
	} else {
		out.append(address);
	}
	out
}
fn date_num(s const byte[:]) int {
	var n = 0;
	for c in s {
		if c >= '0' && c <= '9' { n = n * 10 + (c as int) - 48; }
	}
	n
}
fn find_at(s const byte[:], sub const byte[:], from int) int {
	if s.len < sub.len { return -1; }
	for i in from..s.len - sub.len + 1 {
		if s[i..i + sub.len] == sub { return i; }
	}
	-1
}
fn commit_dates(today const byte[:]) dictionary<u64, int> {
	var m = dictionary<u64, int> {};
	let log = run_lines("git -c core.quotepath=off log --format=@%cs --name-only -- '*.html'", "tools/.sitemap-log");
	var cur = 0;
	for line in log {
		if line[0] == '@' {
			cur = date_num(line[1..]);
		} else if !m.contains(fnv1a(line)) {
			m.insert(fnv1a(line), cur);
		}
	}
	let tn = date_num(today);
	let st = run_lines("git -c core.quotepath=off status --porcelain --untracked-files=all -- '*.html'", "tools/.sitemap-status");
	for line in st {
		if line.len < 4 { continue; }
		var p = line[3..];
		let a = find_at(line, " -> ", 0);
		if a >= 0 { p = line[a + 4..]; }
		update(m, fnv1a(p), 0) { it = tn; };
	}
	m
}
fn sm_inner(s const byte[:], a const byte[:], b const byte[:]) const byte[:] {
	let i = find_at(s, a, 0);
	if i < 0 { return s[0..0]; }
	let st = i + a.len;
	let j = find_at(s, b, st);
	if j < 0 { return s[0..0]; }
	s[st..j]
}
fn sm_entries(text const byte[:], flat byte[][>..]&) {
	var pos = 0;
	loop {
		let u = find_at(text, "<url>", pos);
		if u < 0 { break; }
		let ue = find_at(text, "</url>", u);
		let end = if ue < 0 { text.len } else { ue };
		let seg = text[u..end];
		flat.push(copy(sm_inner(seg, "<loc>", "</loc>")));
		flat.push(copy(sm_inner(seg, "<lastmod>", "</lastmod>")));
		pos = end;
	}
}
fn ping(state const byte[:]) {
	var cur byte[>..] = [];
	if file_exists("sitemap.xml") { read_file("sitemap.xml", cur); }
	var old byte[>..] = [];
	if file_exists(state) { read_file(state, old); }
	var curl_list byte[][>..] = [];
	sm_entries(cur, curl_list);
	var oldl byte[][>..] = [];
	sm_entries(old, oldl);
	var seen = dictionary<u64, u64> {};
	var oaddr const byte[:] = "";
	for a, i in oldl {
		if i % 2 == 0 {
			oaddr = a;
		} else {
			seen.insert(fnv1a(oaddr), fnv1a(a));
		}
	}
	var picked byte[][>..] = [];
	var addr const byte[:] = "";
	for a, i in curl_list {
		if i % 2 == 0 {
			addr = a;
		} else {
			var pick = true;
			let g = seen.get(fnv1a(addr));
			if g {
				if g == fnv1a(a) { pick = false; }
			}
			if pick { picked.push(copy(addr)); }
		}
	}
	if picked.len == 0 {
		print("indexnow: nothing new");
		return;
	}
	var keyfile byte[>..] = [];
	read_file("indexnow.txt", keyfile);
	var key byte[>..] = [];
	for l in split(keyfile, '\n') {
		key.append(trim(l));
		break;
	}
	var endpoint byte[>..] = [];
	let env_lines = run_lines("printf %s \"$INDEXNOW_ENDPOINT\"", "tools/.indexnow-endpoint");
	for l in env_lines {
		endpoint.append(l);
		break;
	}
	if endpoint.len == 0 {
		endpoint.append("https://api.indexnow.org/indexnow");
	}
	var body byte[>..] = [];
	body.append("{\"host\":\"amni-scient.com\",\"key\":\"");
	body.append(key);
	body.append("\",\"keyLocation\":\"https://amni-scient.com/indexnow.txt\",\"urlList\":[");
	for a, i in picked {
		if i > 0 { body.push(','); }
		body.push('"');
		body.append(a);
		body.push('"');
	}
	body.append("]}");
	write_file("tools/.indexnow-body.json", body);
	var cmd byte[>..] = [];
	cmd.append("curl -s -o /dev/null -w '%{http_code}' -m 37 -H 'Content-Type: application/json; charset=utf-8' --data-binary @tools/.indexnow-body.json '");
	cmd.append(endpoint);
	cmd.push('\'');
	let lines = run_lines(cmd, "tools/.indexnow-status");
	var status byte[>..] = [];
	for l in lines {
		status.append(l);
		break;
	}
	if status.len == 0 { status.append("000"); }
	delete_file("tools/.indexnow-body.json");
	if status == "200" || status == "202" {
		write_file(state, cur);
		print("indexnow: ", picked.len, " urls sent, status ", status);
	} else {
		print("indexnow: failed, status ", status);
		exit(1);
	}
}
struct Ent { o int, n int, d int }
fn ent_less(buf const byte[:], a Ent, b Ent) bool {
	if a.n != b.n { return a.n < b.n; }
	compare(buf[a.o..a.o + a.n], buf[b.o..b.o + b.n]) < 0
}
fn lower_of(s const byte[:]) byte[>..] {
	var out byte[>..] = [];
	for c in s { out.push(lc(c)); }
	out
}
fn put_date(out byte[>..]&, d int) {
	format_int(out, d / 10000, 10, 4, '0');
	out.push('-');
	format_int(out, (d / 100) % 100, 10, 2, '0');
	out.push('-');
	format_int(out, d % 100, 10, 2, '0');
}
fn locs_of(text const byte[:], out byte[][>..]&) {
	var pos = 0;
	loop {
		let i = find_at(text, "<loc>", pos);
		if i < 0 { break; }
		let st = i + 5;
		let j = find_at(text, "</loc>", st);
		if j < 0 { break; }
		out.push(copy(text[st..j]));
		pos = j;
	}
}
fn main() {
	var a0 byte[>..] = [];
	var a1 byte[>..] = [];
	for a, i in args() {
		if i == 1 { a0.append(a); }
		if i == 2 { a1.append(a); }
	}
	if a0 == "--ping" {
		ping(a1);
		return;
	}
	let check = a0 == "--check";
	var today byte[>..] = [];
	for l in run_lines("date +%F", "tools/.sitemap-today") {
		today.append(l);
		break;
	}
	let tn = date_num(today);
	let pages = page_list();
	let rules = robots_rules();
	let dates = commit_dates(today);
	var buf byte[>..] = [];
	var ents Ent[>..] = [];
	var index = dictionary<u64, int> {};
	var problems = 0;
	for path in pages {
		var full byte[>..] = [];
		full.push('/');
		full.append(path);
		if disallowed(full, rules) { continue; }
		var html byte[>..] = [];
		read_file(path, html);
		let robots = lower_of(tag_attr(html, "meta", "name", "robots", "content"));
		if find_at(robots, "noindex", 0) >= 0 { continue; }
		let lh = lower_of(html);
		if find_at(lh, "<title", 0) < 0 { continue; }
		let canon = tag_attr(html, "link", "rel", "canonical", "href");
		let ogurl = tag_attr(html, "meta", "property", "og:url", "content");
		if check {
			if ends_with(canon, ".html") {
				print("canonical points at a redirect: ", path, " ", canon);
				problems += 1;
			}
			if ends_with(ogurl, ".html") {
				print("canonical points at a redirect: ", path, " ", ogurl);
				problems += 1;
			}
		}
		var addr byte[>..] = [];
		if starts_with(canon, "https://amni-scient.com") {
			addr.append(canon);
		} else {
			addr.append("https://amni-scient.com/");
			addr.append(path);
		}
		let s = served(addr);
		var date = tn;
		let g = dates.get(fnv1a(path));
		if g { date = g; }
		let h = fnv1a(s);
		let prev = index.get(h);
		if prev {
			if date > ents[prev].d { ents[prev].d = date; }
		} else {
			let off = buf.len;
			buf.append(s);
			index.insert(h, ents.len);
			ents.push(Ent { o: off, n: s.len, d: date });
		}
	}
	sort(ents) { a, b => ent_less(buf, a, b) };
	var text byte[>..] = [];
	text.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
	text.append("<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");
	for e in ents {
		text.append("<url><loc>");
		text.append(buf[e.o..e.o + e.n]);
		text.append("</loc><lastmod>");
		put_date(text, e.d);
		text.append("</lastmod></url>\n");
	}
	text.append("</urlset>\n");
	if !check {
		write_file("sitemap.xml", text);
		print("sitemap: ", ents.len, " urls");
		return;
	}
	var cur byte[>..] = [];
	if file_exists("sitemap.xml") { read_file("sitemap.xml", cur); }
	var olds byte[][>..] = [];
	locs_of(cur, olds);
	var oldset = dictionary<u64, int> {};
	for a in olds { oldset.insert(fnv1a(a), 1); }
	var newset = dictionary<u64, int> {};
	for e in ents { newset.insert(fnv1a(buf[e.o..e.o + e.n]), 1); }
	for e in ents {
		let a = buf[e.o..e.o + e.n];
		if !oldset.contains(fnv1a(a)) {
			print("sitemap is missing ", a);
			problems += 1;
		}
	}
	for a in olds {
		if !newset.contains(fnv1a(a)) {
			print("sitemap has extra ", a);
			problems += 1;
		}
	}
	if problems > 0 {
		print("rebuild with: hc run tools/build-sitemap.amni");
		exit(1);
	}
	print("sitemap: ok, ", ents.len, " urls");
}
