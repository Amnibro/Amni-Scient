<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AmniTest" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@color/ink</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- Launch theme for MainActivity (androidx core-splashscreen). -->
    <style name="Theme.AmniTest.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AmniTest</item>
    </style>

    <style name="AmniButton" parent="android:Widget.Material.Button.Colored">
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AmniLink" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/gold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
