import math;
fn main() {}
extern fn ms_view_f64(id i32, xs real[:]) = "ms_view_f64";
extern fn ms_view_i32(id i32, xs i32[:]) = "ms_view_i32";
extern fn ms_view_u8(id i32, xs u8[:]) = "ms_view_u8";
extern fn ms_acos(x real) real = "ms_acos";
extern fn ms_log2(x real) real = "ms_log2";
extern fn ms_pow(x real, y real) real = "ms_pow";
var NT int = 0;
var NG int = 0;
var NN int = 0;
var P real[>..];
var V real[>..];
var N real[>..];
var AR real[>..];
var C real[>..];
var VN real[>..];
var NL real[>..];
var NH real[>..];
var GA real[>..];
var GNL real[>..];
var GNH real[>..];
var BL real[>..];
var BH real[>..];
var CE real[>..];
var KX real[>..];
var KY real[>..];
var KZ real[>..];
var HS real[>..];
var TH real[>..];
var TC real[>..];
var R real[>..];
var I i32[>..];
var T i32[>..];
var TT i32[>..];
var ORD i32[>..];
var BS i32[>..];
var BC i32[>..];
var GL i32[>..];
var GO i32[>..];
var GS i32[>..];
var GC i32[>..];
var TJ i32[>..];
var ST i32[>..<];
var W i32[>..];
var VM i32[>..];
var HT i32[>..];
var EV i32[>..];
var EK int[>..];
var MK u8[>..];
fn zf(xs real[>..]&, n int) {
	xs.clear();
	xs.reserve(n);
	xs.resize(n, 0.0);
}
fn zi(xs i32[>..]&, n int, x int) {
	xs.clear();
	xs.reserve(n);
	xs.resize(n, x as i32);
}
fn zk(xs int[>..]&, n int) {
	xs.clear();
	xs.reserve(n);
	xs.resize(n, -1);
}
fn zu(xs u8[>..]&, n int) {
	xs.clear();
	xs.reserve(n);
	xs.resize(n, 0);
}
let INF = 1.0 / 0.0;
fn jmin(a real, b real) real {
	if a != a || b != b { return a + b; }
	if a == b { if 1.0 / a < 0.0 { return a; } return b; }
	if a < b { a } else { b }
}
fn jmax(a real, b real) real {
	if a != a || b != b { return a + b; }
	if a == b { if a == 0.0 && 1.0 / a < 0.0 { return b; } return a; }
	if a > b { a } else { b }
}
fn hyp3(a real, b real, c real) real {
	var mx = 0.0;
	if a == a && abs(a) > mx { mx = abs(a); }
	if b == b && abs(b) > mx { mx = abs(b); }
	if c == c && abs(c) > mx { mx = abs(c); }
	if mx == INF { return INF; }
	if a != a || b != b || c != c { return a + b + c; }
	if mx == 0.0 { return 0.0; }
	var sum = 0.0;
	var comp = 0.0;
	for v in [abs(a), abs(b), abs(c)] {
		let nv = v / mx;
		let su = nv * nv - comp;
		let pre = sum + su;
		comp = (pre - sum) - su;
		sum = pre;
	}
	sqrt(sum) * mx
}
fn bad(x real) bool { x == 0.0 || x != x }
fn jround(x real) real {
	let r = floor(x);
	if x - r >= 0.5 { r + 1.0 } else { r }
}
fn cpt(ia int, ib int, ic int, px real, py real, pz real) real {
	let ax = V[ia];
	let ay = V[ia + 1];
	let az = V[ia + 2];
	let abx = V[ib] - ax;
	let aby = V[ib + 1] - ay;
	let abz = V[ib + 2] - az;
	let acx = V[ic] - ax;
	let acy = V[ic + 1] - ay;
	let acz = V[ic + 2] - az;
	let apx = px - ax;
	let apy = py - ay;
	let apz = pz - az;
	let d1 = (abx * apx + aby * apy) + abz * apz;
	let d2 = (acx * apx + acy * apy) + acz * apz;
	var u = 0.0;
	var v = 0.0;
	var r = 0;
	if d1 <= 0.0 && d2 <= 0.0 {
		r = 4;
	} else {
		let bpx = apx - abx;
		let bpy = apy - aby;
		let bpz = apz - abz;
		let d3 = (abx * bpx + aby * bpy) + abz * bpz;
		let d4 = (acx * bpx + acy * bpy) + acz * bpz;
		let vc = d1 * d4 - d3 * d2;
		if d3 >= 0.0 && d4 <= d3 {
			u = 1.0;
			r = 5;
		} else if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
			u = d1 / (d1 - d3);
			r = 1;
		} else {
			let cpx = apx - acx;
			let cpy = apy - acy;
			let cpz = apz - acz;
			let d5 = (abx * cpx + aby * cpy) + abz * cpz;
			let d6 = (acx * cpx + acy * cpy) + acz * cpz;
			let vb = d5 * d2 - d1 * d6;
			let va = d3 * d6 - d5 * d4;
			if d6 >= 0.0 && d5 <= d6 {
				v = 1.0;
				r = 6;
			} else if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 {
				v = d2 / (d2 - d6);
				r = 2;
			} else if va <= 0.0 && d4 - d3 >= 0.0 && d5 - d6 >= 0.0 {
				let w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
				u = 1.0 - w;
				v = w;
				r = 3;
			} else {
				let dn = 1.0 / ((va + vb) + vc);
				u = vb * dn;
				v = vc * dn;
			}
		}
	}
	let qx = (ax + u * abx) + v * acx;
	let qy = (ay + u * aby) + v * acy;
	let qz = (az + u * abz) + v * acz;
	R[0] = qx;
	R[1] = qy;
	R[2] = qz;
	R[3] = r;
	R[4] = u;
	R[5] = v;
	((px - qx) * (px - qx) + (py - qy) * (py - qy)) + (pz - qz) * (pz - qz)
}
fn cseg(i int, px real, py real, pz real) real {
	let ax = GA[6 * i];
	let ay = GA[6 * i + 1];
	let az = GA[6 * i + 2];
	let bx = GA[6 * i + 3];
	let by = GA[6 * i + 4];
	let bz = GA[6 * i + 5];
	let ex = bx - ax;
	let ey = by - ay;
	let ez = bz - az;
	let l2 = (ex * ex + ey * ey) + ez * ez;
	let t = if l2 > 0.0 { jmin(1.0, jmax(0.0, (((px - ax) * ex + (py - ay) * ey) + (pz - az) * ez) / l2)) } else { 0.0 };
	let qx = ax + t * ex;
	let qy = ay + t * ey;
	let qz = az + t * ez;
	R[0] = qx;
	R[1] = qy;
	R[2] = qz;
	R[4] = t;
	((px - qx) * (px - qx) + (py - qy) * (py - qy)) + (pz - qz) * (pz - qz)
}
fn rtri(ia int, ib int, ic int, ox real, oy real, oz real, dx real, dy real, dz real, eps real) real {
	let e1x = V[ib] - V[ia];
	let e1y = V[ib + 1] - V[ia + 1];
	let e1z = V[ib + 2] - V[ia + 2];
	let e2x = V[ic] - V[ia];
	let e2y = V[ic + 1] - V[ia + 1];
	let e2z = V[ic + 2] - V[ia + 2];
	let px = dy * e2z - dz * e2y;
	let py = dz * e2x - dx * e2z;
	let pz = dx * e2y - dy * e2x;
	let det = (e1x * px + e1y * py) + e1z * pz;
	if abs(det) < 1e-300 { return INF; }
	let iv = 1.0 / det;
	let tx = ox - V[ia];
	let ty = oy - V[ia + 1];
	let tz = oz - V[ia + 2];
	let u = ((tx * px + ty * py) + tz * pz) * iv;
	if u < -eps || u > 1.0 + eps { return INF; }
	let qx = ty * e1z - tz * e1y;
	let qy = tz * e1x - tx * e1z;
	let qz = tx * e1y - ty * e1x;
	let v = ((dx * qx + dy * qy) + dz * qz) * iv;
	if v < -eps || u + v > 1.0 + eps { return INF; }
	let t = ((e2x * qx + e2y * qy) + e2z * qz) * iv;
	if t > 0.0 { t } else { INF }
}
fn bnode(s int, c int, ord i32[>..]&, nl real[>..]&, nh real[>..]&, bs i32[>..]&, bc i32[>..]&) int {
	let q = NN;
	NN += 1;
	bs[q] = s as i32;
	bc[q] = max(c, 1) as i32;
	let e = s + c;
	for k in 3 {
		var a = INF;
		var b = -INF;
		for i in s..e {
			let p = 3 * (ord[i] as int) + k;
			a = jmin(a, BL[p]);
			b = jmax(b, BH[p]);
		}
		nl[3 * q + k] = a;
		nh[3 * q + k] = b;
	}
	q
}
fn msort(ord i32[>..]&, s int, c int, ax int) {
	let end = s + c;
	var w = 1;
	while w < c {
		var lo = s;
		while lo < end {
			let mid = min(lo + w, end);
			let hi = min(lo + 2 * w, end);
			var i = lo;
			var j = mid;
			var k = lo;
			while k < hi {
				if j < hi && (i == mid || CE[3 * (ord[j] as int) + ax] < CE[3 * (ord[i] as int) + ax]) {
					W[k] = ord[j];
					j += 1;
				} else {
					W[k] = ord[i];
					i += 1;
				}
				k += 1;
			}
			for k2 in lo..hi { ord[k2] = W[k2]; }
			lo += 2 * w;
		}
		w *= 2;
	}
}
fn bvh(n int, ord i32[>..]&, nl real[>..]&, nh real[>..]&, bs i32[>..]&, bc i32[>..]&) {
	let cap = max(2, 2 * n);
	zi(ord, n, 0);
	zf(nl, 3 * cap);
	zf(nh, 3 * cap);
	zi(bs, cap, 0);
	zi(bc, cap, 0);
	zf(CE, 3 * n);
	zi(W, n, 0);
	for i in n {
		ord[i] = i as i32;
		for k in 3 { CE[3 * i + k] = BL[3 * i + k] + BH[3 * i + k]; }
	}
	NN = 0;
	bnode(0, n, ord, nl, nh, bs, bc);
	ST.clear();
	if n > 0 { ST.push(0); } else { bc[0] = 0; }
	while ST.len > 0 {
		let q = ST.pop() as int;
		let s = bs[q] as int;
		let c = bc[q] as int;
		if c <= 4 { continue; }
		let e = s + c;
		var ax = 0;
		var best = -1.0;
		for k in 3 {
			var a = INF;
			var b = -INF;
			for i in s..e {
				let v = CE[3 * (ord[i] as int) + k];
				if v < a { a = v; }
				if v > b { b = v; }
			}
			if b - a > best {
				best = b - a;
				ax = k;
			}
		}
		if !(best > 0.0) { continue; }
		msort(ord, s, c, ax);
		let h = c / 2;
		let l = bnode(s, h, ord, nl, nh, bs, bc);
		bnode(s + h, c - h, ord, nl, nh, bs, bc);
		bs[q] = l as i32;
		bc[q] = 0;
		ST.push(l as i32);
		ST.push((l + 1) as i32);
	}
}
fn bd(q int, nl real[>..]&, nh real[>..]&, px real, py real, pz real) real {
	let a = jmax(jmax(nl[3 * q] - px, 0.0), px - nh[3 * q]);
	let b = jmax(jmax(nl[3 * q + 1] - py, 0.0), py - nh[3 * q + 1]);
	let c = jmax(jmax(nl[3 * q + 2] - pz, 0.0), pz - nh[3 * q + 2]);
	(a * a + b * b) + c * c
}
fn slab(q int, ox real, oy real, oz real, ix real, iy real, iz real, best real) real {
	var a = (NL[3 * q] - ox) * ix;
	var b = (NH[3 * q] - ox) * ix;
	var t0 = jmin(a, b);
	var t1 = jmax(a, b);
	a = (NL[3 * q + 1] - oy) * iy;
	b = (NH[3 * q + 1] - oy) * iy;
	t0 = jmax(t0, jmin(a, b));
	t1 = jmin(t1, jmax(a, b));
	a = (NL[3 * q + 2] - oz) * iz;
	b = (NH[3 * q + 2] - oz) * iz;
	t0 = jmax(jmax(t0, jmin(a, b)), 0.0);
	t1 = jmin(jmin(t1, jmax(a, b)), best);
	if t0 <= t1 * (1.0 + 1e-12) + 1e-12 { t0 } else { INF }
}
fn rej(t int, m int, sk int, nf bool, nx real, ny real, nz real, thr real) bool {
	if m >= 0 && MK[m * NT + t] == 0 { return true; }
	if t == sk { return true; }
	if nf {
		let dn = (N[3 * t] * nx + N[3 * t + 1] * ny) + N[3 * t + 2] * nz;
		return !(dn > thr);
	}
	false
}
fn tnear(px real, py real, pz real, m int, sk int, nf bool, nx real, ny real, nz real, thr real) int {
	var best = INF;
	var bi = -1;
	if NT == 0 {
		R[6] = best;
		return -1;
	}
	ST.clear();
	ST.push(0);
	while ST.len > 0 {
		let q = ST.pop() as int;
		if bd(q, NL, NH, px, py, pz) >= best { continue; }
		let c = BC[q] as int;
		if c != 0 {
			let s = BS[q] as int;
			let e = s + c;
			for i in s..e {
				let t = ORD[i] as int;
				let d = if rej(t, m, sk, nf, nx, ny, nz, thr) { INF } else { cpt(3 * (T[3 * t] as int), 3 * (T[3 * t + 1] as int), 3 * (T[3 * t + 2] as int), px, py, pz) };
				if d < best {
					best = d;
					bi = t;
				}
			}
		} else {
			let l = BS[q] as int;
			let dl = bd(l, NL, NH, px, py, pz);
			let dr = bd(l + 1, NL, NH, px, py, pz);
			if dl < dr {
				ST.push((l + 1) as i32);
				ST.push(l as i32);
			} else {
				ST.push(l as i32);
				ST.push((l + 1) as i32);
			}
		}
	}
	R[6] = best;
	if bi >= 0 { cpt(3 * (T[3 * bi] as int), 3 * (T[3 * bi + 1] as int), 3 * (T[3 * bi + 2] as int), px, py, pz); }
	bi
}
fn tray(ox real, oy real, oz real, dx real, dy real, dz real, tmax real, m int, sk int, eps real) int {
	var best = tmax;
	var bi = -1;
	if NT == 0 {
		R[6] = best;
		return -1;
	}
	let ix = 1.0 / (if abs(dx) > 1e-15 { dx } else { 1e-15 });
	let iy = 1.0 / (if abs(dy) > 1e-15 { dy } else { 1e-15 });
	let iz = 1.0 / (if abs(dz) > 1e-15 { dz } else { 1e-15 });
	ST.clear();
	ST.push(0);
	while ST.len > 0 {
		let q = ST.pop() as int;
		if slab(q, ox, oy, oz, ix, iy, iz, best) == INF { continue; }
		let c = BC[q] as int;
		if c != 0 {
			let s = BS[q] as int;
			let e = s + c;
			for i in s..e {
				let t = ORD[i] as int;
				let d = if rej(t, m, sk, false, 0.0, 0.0, 0.0, 0.0) { INF } else { rtri(3 * (T[3 * t] as int), 3 * (T[3 * t + 1] as int), 3 * (T[3 * t + 2] as int), ox, oy, oz, dx, dy, dz, eps) };
				if d < best {
					best = d;
					bi = t;
				}
			}
		} else {
			ST.push(BS[q]);
			ST.push(BS[q] + 1);
		}
	}
	R[6] = best;
	bi
}
fn gnear(px real, py real, pz real, lab int, lf bool) int {
	var best = INF;
	var bi = -1;
	if NG == 0 {
		R[6] = best;
		return -1;
	}
	ST.clear();
	ST.push(0);
	while ST.len > 0 {
		let q = ST.pop() as int;
		if bd(q, GNL, GNH, px, py, pz) >= best { continue; }
		let c = GC[q] as int;
		if c != 0 {
			let s = GS[q] as int;
			let e = s + c;
			for i in s..e {
				let g = GO[i] as int;
				let d = if lf && (GL[g] as int) != lab { INF } else { cseg(g, px, py, pz) };
				if d < best {
					best = d;
					bi = g;
				}
			}
		} else {
			let l = GS[q] as int;
			let dl = bd(l, GNL, GNH, px, py, pz);
			let dr = bd(l + 1, GNL, GNH, px, py, pz);
			if dl < dr {
				ST.push((l + 1) as i32);
				ST.push(l as i32);
			} else {
				ST.push(l as i32);
				ST.push((l + 1) as i32);
			}
		}
	}
	R[6] = best;
	if bi >= 0 { cseg(bi, px, py, pz); }
	bi
}
fn sdf1(px real, py real, pz real) real {
	let t = tnear(px, py, pz, -1, -1, false, 0.0, 0.0, 0.0, 0.0);
	if t < 0 {
		R[7] = -1.0;
		return INF;
	}
	R[7] = t;
	let r = R[3] as int;
	var nx = N[3 * t];
	var ny = N[3 * t + 1];
	var nz = N[3 * t + 2];
	if r >= 4 {
		let v = 3 * (T[3 * t + r - 4] as int);
		nx = VN[v];
		ny = VN[v + 1];
		nz = VN[v + 2];
	} else if r >= 1 {
		let k = if r == 1 { 0 } else if r == 2 { 2 } else { 1 };
		let u = TT[3 * t + k] as int;
		if u >= 0 {
			nx = nx + N[3 * u];
			ny = ny + N[3 * u + 1];
			nz = nz + N[3 * u + 2];
		}
	}
	let ex = px - R[0];
	let ey = py - R[1];
	let ez = pz - R[2];
	let d = hyp3(ex, ey, ez);
	if (ex * nx + ey * ny) + ez * nz > 0.0 { d } else { -d }
}
fn keq(a real, b real) bool { a == b || (a != a && b != b) }
fn lo32(x real) int {
	let v = if abs(x) < 1e15 { x as int } else { 0 };
	v & 4294967295
}
fn hk(x real, y real, z real) int {
	let m = ((lo32(x) * 73856093) ^ (lo32(y) * 19349663)) ^ (lo32(z) * 83492791);
	m ^ (m >> 21)
}
fn he(key int) int {
	let h = (key & 4294967295) ^ (key >> 32);
	(h * 40503) ^ (h >> 15)
}
fn weld(np int, q real) int {
	var hs = 16;
	while hs < 2 * np { hs *= 2; }
	zi(HT, hs, -1);
	KX.clear();
	KX.reserve(np);
	KY.clear();
	KY.reserve(np);
	KZ.clear();
	KZ.reserve(np);
	V.clear();
	V.reserve(3 * np);
	zi(VM, np, 0);
	var nv = 0;
	for i in np {
		let rx = jround(P[3 * i] / q);
		let ry = jround(P[3 * i + 1] / q);
		let rz = jround(P[3 * i + 2] / q);
		var s = hk(rx, ry, rz) & (hs - 1);
		var j = -1;
		while HT[s] != -1 && j == -1 {
			let e = HT[s] as int;
			if keq(KX[e], rx) && keq(KY[e], ry) && keq(KZ[e], rz) {
				j = e;
			} else {
				s = (s + 1) & (hs - 1);
			}
		}
		if j == -1 {
			j = nv;
			HT[s] = nv as i32;
			KX.push(rx);
			KY.push(ry);
			KZ.push(rz);
			V.push(P[3 * i]);
			V.push(P[3 * i + 1]);
			V.push(P[3 * i + 2]);
			nv += 1;
		}
		VM[i] = j as i32;
	}
	nv
}
fn tris(nt int, np int) {
	zi(T, 3 * nt, 0);
	for i in 3 * nt {
		let x = I[i] as int;
		if x >= 0 && x < np { T[i] = VM[x]; } else { T[i] = 0; }
	}
	zf(N, 3 * nt);
	zf(AR, nt);
	zf(C, 3 * nt);
	zf(BL, 3 * nt);
	zf(BH, 3 * nt);
	for t in nt {
		let a = 3 * (T[3 * t] as int);
		let b = 3 * (T[3 * t + 1] as int);
		let c = 3 * (T[3 * t + 2] as int);
		let ux = V[b] - V[a];
		let uy = V[b + 1] - V[a + 1];
		let uz = V[b + 2] - V[a + 2];
		let wx = V[c] - V[a];
		let wy = V[c + 1] - V[a + 1];
		let wz = V[c + 2] - V[a + 2];
		let nx = uy * wz - uz * wy;
		let ny = uz * wx - ux * wz;
		let nz = ux * wy - uy * wx;
		let l = hyp3(nx, ny, nz);
		AR[t] = l / 2.0;
		if bad(l) {
			N[3 * t] = 0.0;
			N[3 * t + 1] = 0.0;
			N[3 * t + 2] = 0.0;
		} else {
			N[3 * t] = nx / l;
			N[3 * t + 1] = ny / l;
			N[3 * t + 2] = nz / l;
		}
		for k in 3 {
			C[3 * t + k] = ((V[a + k] + V[b + k]) + V[c + k]) / 3.0;
			BL[3 * t + k] = jmin(jmin(V[a + k], V[b + k]), V[c + k]);
			BH[3 * t + k] = jmax(jmax(V[a + k], V[b + k]), V[c + k]);
		}
	}
}
fn adj(nt int) {
	zi(TT, 3 * nt, -1);
	var es = 16;
	while es < 6 * nt { es *= 2; }
	zk(EK, es);
	zi(EV, es, 0);
	for t in nt {
		for k in 3 {
			let a = T[3 * t + k] as int;
			let b = T[3 * t + (k + 1) % 3] as int;
			if a == b { continue; }
			let key = min(a, b) * 67108864 + max(a, b);
			var s = he(key) & (es - 1);
			while EK[s] != -1 && EK[s] != key { s = (s + 1) & (es - 1); }
			if EK[s] == -1 {
				EK[s] = key;
				EV[s] = (3 * t + k) as i32;
			} else {
				let o = EV[s] as int;
				if o >= 0 {
					TT[3 * t + k] = (o / 3) as i32;
					TT[o] = t as i32;
					EV[s] = -1;
				}
			}
		}
	}
}
fn vnorm(nt int, nv int) {
	zf(VN, 3 * nv);
	for t in nt {
		for k in 3 {
			let a = 3 * (T[3 * t + k] as int);
			let b = 3 * (T[3 * t + (k + 1) % 3] as int);
			let c = 3 * (T[3 * t + (k + 2) % 3] as int);
			let ux = V[b] - V[a];
			let uy = V[b + 1] - V[a + 1];
			let uz = V[b + 2] - V[a + 2];
			let wx = V[c] - V[a];
			let wy = V[c + 1] - V[a + 1];
			let wz = V[c + 2] - V[a + 2];
			var dn = hyp3(ux, uy, uz) * hyp3(wx, wy, wz);
			if bad(dn) { dn = 1.0; }
			let an = ms_acos(jmax(-1.0, jmin(1.0, ((ux * wx + uy * wy) + uz * wz) / dn)));
			for j in 3 { VN[a + j] = VN[a + j] + an * N[3 * t + j]; }
		}
	}
}
fn full(nt int) {
	zu(MK, 7 * nt);
	zf(HS, nt);
	zf(TH, nt);
	zi(TJ, nt, 0);
	zf(TC, nt);
	ms_view_u8(23, MK);
	ms_view_f64(24, HS);
	ms_view_f64(25, TH);
	ms_view_i32(26, TJ);
	ms_view_f64(27, TC);
}
export fn ms_init() {
	zf(R, 16);
	ST.clear();
	ST.reserve(256);
	ms_view_f64(15, R);
}
export fn ms_bin(np i32, nt i32) {
	zf(P, 3 * (np as int));
	zi(I, 3 * (nt as int), 0);
	ms_view_f64(1, P);
	ms_view_i32(2, I);
}
export fn ms_surf(np0 i32, nt0 i32) i32 {
	let np = np0 as int;
	let nt = nt0 as int;
	var lo real[3] = [INF; 3];
	var hi real[3] = [-INF; 3];
	for i in np {
		for k in 3 {
			lo[k] = jmin(lo[k], P[3 * i + k]);
			hi[k] = jmax(hi[k], P[3 * i + k]);
		}
	}
	var diag = hyp3(hi[0] - lo[0], hi[1] - lo[1], hi[2] - lo[2]);
	if bad(diag) { diag = 1.0; }
	let nv = weld(np, diag * 1e-7);
	tris(nt, np);
	adj(nt);
	vnorm(nt, nv);
	bvh(nt, ORD, NL, NH, BS, BC);
	full(nt);
	NT = nt;
	var area = 0.0;
	for t in nt { area += AR[t]; }
	for k in 3 {
		R[8 + k] = lo[k];
		R[11 + k] = hi[k];
	}
	R[14] = diag;
	R[15] = area;
	ms_view_f64(3, V);
	ms_view_i32(4, T);
	ms_view_f64(5, N);
	ms_view_f64(6, AR);
	ms_view_f64(7, C);
	ms_view_i32(8, TT);
	ms_view_f64(9, VN);
	ms_view_i32(10, ORD);
	ms_view_f64(11, NL);
	ms_view_f64(12, NH);
	ms_view_i32(13, BS);
	ms_view_i32(14, BC);
	nv as i32
}
export fn ms_tl(nv0 i32, nt0 i32, fl i32) {
	let nv = nv0 as int;
	let nt = nt0 as int;
	let cap = max(2, 2 * nt);
	zf(V, 3 * nv);
	zi(T, 3 * nt, 0);
	zi(ORD, nt, 0);
	zf(NL, 3 * cap);
	zf(NH, 3 * cap);
	zi(BS, cap, 0);
	zi(BC, cap, 0);
	NT = nt;
	if fl != 0 {
		zf(N, 3 * nt);
		zf(C, 3 * nt);
		zi(TT, 3 * nt, -1);
		zf(VN, 3 * nv);
		full(nt);
		ms_view_f64(5, N);
		ms_view_f64(7, C);
		ms_view_i32(8, TT);
		ms_view_f64(9, VN);
	}
	ms_view_f64(3, V);
	ms_view_i32(4, T);
	ms_view_i32(10, ORD);
	ms_view_f64(11, NL);
	ms_view_f64(12, NH);
	ms_view_i32(13, BS);
	ms_view_i32(14, BC);
}
export fn ms_tbvh(nt0 i32) {
	let nt = nt0 as int;
	zf(BL, 3 * nt);
	zf(BH, 3 * nt);
	for t in nt {
		for k in 3 {
			BL[3 * t + k] = jmin(jmin(V[3 * (T[3 * t] as int) + k], V[3 * (T[3 * t + 1] as int) + k]), V[3 * (T[3 * t + 2] as int) + k]);
			BH[3 * t + k] = jmax(jmax(V[3 * (T[3 * t] as int) + k], V[3 * (T[3 * t + 1] as int) + k]), V[3 * (T[3 * t + 2] as int) + k]);
		}
	}
	bvh(nt, ORD, NL, NH, BS, BC);
	NT = nt;
	ms_view_i32(10, ORD);
	ms_view_f64(11, NL);
	ms_view_f64(12, NH);
	ms_view_i32(13, BS);
	ms_view_i32(14, BC);
}
export fn ms_gl(ns0 i32) {
	let ns = ns0 as int;
	let gcap = max(2, 2 * ns);
	zf(GA, 6 * ns);
	zi(GL, ns, 0);
	zi(GO, ns, 0);
	zf(GNL, 3 * gcap);
	zf(GNH, 3 * gcap);
	zi(GS, gcap, 0);
	zi(GC, gcap, 0);
	NG = ns;
	ms_view_f64(16, GA);
	ms_view_i32(17, GL);
	ms_view_i32(18, GO);
	ms_view_f64(19, GNL);
	ms_view_f64(20, GNH);
	ms_view_i32(21, GS);
	ms_view_i32(22, GC);
}
export fn ms_gbvh(ns0 i32) {
	let ns = ns0 as int;
	zf(BL, 3 * ns);
	zf(BH, 3 * ns);
	for i in ns {
		for k in 3 {
			BL[3 * i + k] = jmin(GA[6 * i + k], GA[6 * i + 3 + k]);
			BH[3 * i + k] = jmax(GA[6 * i + k], GA[6 * i + 3 + k]);
		}
	}
	bvh(ns, GO, GNL, GNH, GS, GC);
	NG = ns;
	ms_view_i32(18, GO);
	ms_view_f64(19, GNL);
	ms_view_f64(20, GNH);
	ms_view_i32(21, GS);
	ms_view_i32(22, GC);
}
export fn ms_cl(px real, py real, pz real, m i32, sk i32, nx real, ny real, nz real, thr real, nf i32) i32 {
	tnear(px, py, pz, m as int, sk as int, nf != 0, nx, ny, nz, thr) as i32
}
export fn ms_ray(ox real, oy real, oz real, dx real, dy real, dz real, tmax real, m i32, sk i32, eps real) i32 {
