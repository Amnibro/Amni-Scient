fn hzf(l int) real { OEX / ((1 << l) as real) }
fn okey(l int, i int, j int, k int) int { ((l * 4096 + i) * 4096 + j) * 4096 + k }
fn onk(i int, j int, k int) int { (i * (OGR + 1) + j) * (OGR + 1) + k }
fn ocls(l int, i int, j int, k int) real {
	let h = hzf(l);
	let cx = OX + ((i as real) + 0.5) * h;
	let cy = OY + ((j as real) + 0.5) * h;
	let cz = OZ + ((k as real) + 0.5) * h;
	let r = (h * 0.8660254) * 1.0001;
	ms_cls(cx, cy, cz, r)
}
fn oadd(l int, i int, j int, k int, c real) int {
	let q = OQ;
	pi(LV, l);
	pi(CI, i);
	pi(CJ, j);
	pi(CK, k);
	pf(BDV, c);
	pb(AL, 1);
	OQ += 1;
	OIU = mput(IK, IV, okey(l, i, j, k), q, OIU);
	q
}
fn oup(l int, i int, j int, k int, m0 int) int {
	var m = m0;
	while m >= 0 {
		let s = l - m;
		let q = mget(IK, IV, okey(m, i >> s, j >> s, k >> s));
		if q >= 0 { return q; }
		m -= 1;
	}
	-1
}
fn osplit(q int, out i32[>..]&) {
	AL[q] = 0;
	let l0 = LV[q] as int;
	let ci = CI[q] as int;
	let cj = CJ[q] as int;
	let ck = CK[q] as int;
	mdel(IK, okey(l0, ci, cj, ck));
	let l = l0 + 1;
	for a in 8 {
		let i = 2 * ci + (a & 1);
		let j = 2 * cj + ((a >> 1) & 1);
		let k = 2 * ck + (a >> 2);
		let c = ocls(l, i, j, k);
		if c != 0.0 {
			let n = oadd(l, i, j, k, c);
			pi(out, n);
		}
	}
}
fn obal() {
	while WK.len > 0 {
		let q = WK.pop() as int;
		if AL[q] == 0 || LV[q] < 2 { continue; }
		let l = LV[q] as int;
		let n = 1 << l;
		var hit = false;
		var d = 0;
		while d < 27 && !hit {
			if d != 13 {
				let i = (CI[q] as int) + (d % 3) - 1;
				let j = (CJ[q] as int) + ((d / 3) % 3) - 1;
				let k = (CK[q] as int) + (d / 9) - 1;
				if !(i < 0 || j < 0 || k < 0 || i >= n || j >= n || k >= n) {
					let p = oup(l, i, j, k, l - 2);
					if p >= 0 {
						osplit(p, WK);
						pi(WK, q);
						hit = true;
					}
				}
			}
			d += 1;
		}
	}
}
fn onbr(q int, f int) int {
	NBR.clear();
	let dx = dirk(f, 0);
	let dy = dirk(f, 1);
	let dz = dirk(f, 2);
	let l = LV[q] as int;
	let n = 1 << l;
	let i = (CI[q] as int) + dx;
	let j = (CJ[q] as int) + dy;
	let k = (CK[q] as int) + dz;
	if i < 0 || j < 0 || k < 0 || i >= n || j >= n || k >= n { return 0; }
	var p = mget(IK, IV, okey(l, i, j, k));
	if p >= 0 {
		pi(NBR, p);
		return 0;
	}
	p = oup(l, i, j, k, l - 1);
	if p >= 0 {
		pi(NBR, p);
		return -1;
	}
	for a in 8 {
		let ii = 2 * i + (a & 1);
		let jj = 2 * j + ((a >> 1) & 1);
		let kk = 2 * k + (a >> 2);
		let sx = dx != 0 && (ii & 1) == (if dx > 0 { 1 } else { 0 });
		let sy = dy != 0 && (jj & 1) == (if dy > 0 { 1 } else { 0 });
		let sz = dz != 0 && (kk & 1) == (if dz > 0 { 1 } else { 0 });
		if sx || sy || sz { continue; }
		let c = mget(IK, IV, okey(l + 1, ii, jj, kk));
		if c >= 0 { pi(NBR, c); }
	}
	1
}
fn oisc(q int) bool { q >= 0 && LI[q] >= 0 && CR[LI[q] as int] == 1 }
fn onid(i int, j int, k int) int {
	let kk = onk(i, j, k);
	var n = mget(NMK, NMV, kk);
	if n < 0 {
		n = XP.len / 3;
		ONU = mput(NMK, NMV, kk, n, ONU);
		pk(NKK, kk);
		pf(XP, OX + ((i as real) * OEX) / (OGR as real));
		pf(XP, OY + ((j as real) * OEX) / (OGR as real));
		pf(XP, OZ + ((k as real) * OEX) / (OGR as real));
	}
	n
}
fn onodes(dl real) {
	LF.clear();
	ONB = 0;
	for q in OQ {
		if AL[q] != 0 {
			pi(LF, q);
			if BDV[q] > 0.0 { ONB += 1; }
		}
	}
	ONL = LF.len;
	mnew(NMK, NMV, 1024);
	ONU = 0;
	XP.clear();
	NKK.clear();
	zi(E0, 8 * ONL, 0);
	for e in ONL {
		let q = LF[e] as int;
		let s = OL - (LV[q] as int);
		let z = 1 << s;
		for a in 8 {
			let ni = ((CI[q] as int) << s) + (if hxn(a, 0) > 0 { z } else { 0 });
			let nj = ((CJ[q] as int) << s) + (if hxn(a, 1) > 0 { z } else { 0 });
			let nk = ((CK[q] as int) << s) + (if hxn(a, 2) > 0 { z } else { 0 });
			let id = onid(ni, nj, nk);
			E0[8 * e + a] = id as i32;
		}
	}
	ON0 = XP.len / 3;
	zf(SD, ON0);
	for n in ON0 {
		let kk = NKK[n];
		var x = mget(SDK, SDI, kk);
		if x < 0 {
			x = SDV.len;
			let sv = sdf1(XP[3 * n], XP[3 * n + 1], XP[3 * n + 2]);
			pf(SDV, sv);
			OSU = mput(SDK, SDI, kk, x, OSU);
		}
		SD[n] = SDV[x];
	}
	zu(CR, ONL);
	for e in ONL {
		let h = hzf(LV[LF[e] as int] as int);
		var c = 1;
		var a = 0;
		while a < 8 && c == 1 {
			if !(SD[E0[8 * e + a] as int] < (-dl) * h) { c = 0; }
			a += 1;
		}
		CR[e] = c as u8;
	}
	zi(LI, OQ, -1);
	for e in ONL { LI[LF[e] as int] = e as i32; }
}
fn orefine() bool {
	WK.clear();
	SP.clear();
	for e in ONL {
		if CR[e] == 0 { continue; }
		let q = LF[e] as int;
		for f in 6 {
			if onbr(q, f) != 1 { continue; }
			var nc = 0;
			for x in NBR { if oisc(x as int) { nc += 1; } }
			if nc > 0 && nc < 4 {
				pi(SP, q);
				break;
			}
		}
	}
	if SP.len == 0 { return false; }
	ORF += SP.len;
	for q in SP { osplit(q as int, WK); }
	obal();
	true
}
fn ocore() {
	var ch = true;
	var iter = 0;
	while ch && iter < 20 {
		ch = false;
		for e in ONL {
			if CR[e] == 0 { continue; }
			let q = LF[e] as int;
			for f in 6 {
				if onbr(q, f) != 1 { continue; }
				NCL.clear();
				for x in NBR { if oisc(x as int) { pi(NCL, x as int); } }
				if NCL.len > 0 && NCL.len < 4 {
					for x in NCL { CR[LI[x as int] as int] = 0; }
					ch = true;
				}
			}
		}
		iter += 1;
	}
	CEL.clear();
	for e in ONL { if CR[e] == 1 { pi(CEL, e); } }
	ONC = CEL.len;
	zu(CM, ONL);
	for e in ONL { CM[e] = CR[e]; }
}
fn ohang() {
	HN.clear();
	HC.clear();
	HM.clear();
	HW.clear();
	zi(HX, ON0, -1);
	for e in ONL {
		let q = LF[e] as int;
		if CM[e] == 0 || (LV[q] as int) >= OL { continue; }
		let s = OL - (LV[q] as int);
		let z = 1 << s;
		let hz = z >> 1;
		let i0 = (CI[q] as int) << s;
		let j0 = (CJ[q] as int) << s;
		let k0 = (CK[q] as int) << s;
		for g in 12 {
			let a = hed(g, 0);
			let b = hed(g, 1);
			let n = mget(NMK, NMV, onk(i0 + ((hxn(a, 0) + hxn(b, 0)) + 2) * hz / 2, j0 + ((hxn(a, 1) + hxn(b, 1)) + 2) * hz / 2, k0 + ((hxn(a, 2) + hxn(b, 2)) + 2) * hz / 2));
			if n >= 0 && HX[n] == -1 {
				HX[n] = HN.len as i32;
				pi(HN, n);
				pi(HC, 2);
				pi(HM, E0[8 * e + a] as int);
				pi(HM, E0[8 * e + b] as int);
				pi(HM, -1);
				pi(HM, -1);
				pf(HW, 0.5);
				pf(HW, 0.5);
				pf(HW, 0.0);
				pf(HW, 0.0);
			}
		}
		for f in 6 {
			var sx = 0;
			var sy = 0;
			var sz = 0;
			for i in 4 {
				let c = hfc(f, i);
				sx += hxn(c, 0);
				sy += hxn(c, 1);
				sz += hxn(c, 2);
			}
			let n = mget(NMK, NMV, onk(i0 + (sx / 4 + 1) * hz, j0 + (sy / 4 + 1) * hz, k0 + (sz / 4 + 1) * hz));
			if n >= 0 && HX[n] == -1 {
				HX[n] = HN.len as i32;
				pi(HN, n);
				pi(HC, 4);
				for i in 4 { pi(HM, E0[8 * e + hfc(f, i)] as int); }
				for i in 4 { pf(HW, 0.25); }
			}
		}
	}
	zu(UZ, ON0);
	for e in ONL {
		if CM[e] != 0 {
			for a in 8 { UZ[E0[8 * e + a] as int] = 1; }
		}
	}
	zu(HA, HN.len);
	for x in HN.len {
		if UZ[HN[x] as int] == 1 { HA[x] = 1; } else { HX[HN[x] as int] = -1; }
	}
}
fn obq() {
	BQ.clear();
	zf(NB, 3 * ON0);
	zu(IB, ON0);
	for ei in CEL.len {
		let e = CEL[ei] as int;
		let q = LF[e] as int;
		for f in 6 {
			onbr(q, f);
			var has = false;
			for x in NBR { if oisc(x as int) { has = true; } }
			if has { continue; }
			let n0 = E0[8 * e + hfc(f, 0)] as int;
			let n1 = E0[8 * e + hfc(f, 1)] as int;
			let n2 = E0[8 * e + hfc(f, 2)] as int;
			let n3 = E0[8 * e + hfc(f, 3)] as int;
			pi(BQ, n0);
			pi(BQ, n1);
			pi(BQ, n2);
			pi(BQ, n3);
			pi(BQ, e);
			let ux = XP[3 * n2] - XP[3 * n0];
			let uy = XP[3 * n2 + 1] - XP[3 * n0 + 1];
			let uz = XP[3 * n2 + 2] - XP[3 * n0 + 2];
			let wx = XP[3 * n3] - XP[3 * n1];
			let wy = XP[3 * n3 + 1] - XP[3 * n1 + 1];
			let wz = XP[3 * n3 + 2] - XP[3 * n1 + 2];
			let nx = uy * wz - uz * wy;
			let ny = uz * wx - ux * wz;
			let nz = ux * wy - uy * wx;
			for n in [n0, n1, n2, n3] {
				NB[3 * n] = NB[3 * n] + nx;
				NB[3 * n + 1] = NB[3 * n + 1] + ny;
				NB[3 * n + 2] = NB[3 * n + 2] + nz;
				IB[n] = 1;
			}
		}
	}
	ONQ = BQ.len / 5;
}
fn oadj(nsm int) {
	BP.clear();
	for b in ONQ {
		for k in 4 {
			let a = BQ[5 * b + k] as int;
			let c = BQ[5 * b + (k + 1) % 4] as int;
			pi(BP, a);
			pi(BP, c);
			pi(BP, c);
			pi(BP, a);
		}
	}
	zi(BO, ON0 + 1, 0);
	let np = BP.len / 2;
	for p in np {
		let u = BP[2 * p] as int;
		BO[u + 1] = BO[u + 1] + 1;
	}
	for n in 1..(ON0 + 1) { BO[n] = BO[n] + BO[n - 1]; }
	zi(BJ, np, 0);
	zi(BN, ON0, 0);
	for p in np {
		let u = BP[2 * p] as int;
		let v = BP[2 * p + 1];
		let s = BO[u] as int;
		let cnt = BN[u] as int;
		var found = false;
		for x in s..(s + cnt) { if BJ[x] == v { found = true; } }
		if !found {
			BJ[s + cnt] = v;
			BN[u] = (cnt + 1) as i32;
		}
	}
	for n in ON0 {
		if IB[n] != 0 {
			var l = hyp3(NB[3 * n], NB[3 * n + 1], NB[3 * n + 2]);
			if bad(l) { l = 1.0; }
			NB[3 * n] = NB[3 * n] / l;
			NB[3 * n + 1] = NB[3 * n + 1] / l;
			NB[3 * n + 2] = NB[3 * n + 2] / l;
		}
	}
	for r in nsm {
		zf(NW, 3 * ON0);
		for n in ON0 {
			if IB[n] == 0 { continue; }
			var x = NB[3 * n];
			var y = NB[3 * n + 1];
			var z = NB[3 * n + 2];
			let s = BO[n] as int;
			let e = s + (BN[n] as int);
			for mi in s..e {
				let m = BJ[mi] as int;
				x = x + NB[3 * m];
				y = y + NB[3 * m + 1];
				z = z + NB[3 * m + 2];
			}
			var l = hyp3(x, y, z);
			if bad(l) { l = 1.0; }
			NW[3 * n] = x / l;
			NW[3 * n + 1] = y / l;
			NW[3 * n + 2] = z / l;
		}
		for n in ON0 {
			if IB[n] != 0 {
				NB[3 * n] = NW[3 * n];
				NB[3 * n + 1] = NW[3 * n + 1];
				NB[3 * n + 2] = NW[3 * n + 2];
			}
		}
	}
}
fn oproj() {
	zi(TLB, ON0, -1);
	zi(TP, ON0, -1);
	zu(TF, ON0);
	zf(HBV, ON0);
	TX.clear();
	TE.clear();
	ONT = 0;
	ORY = 0;
	for ei in CEL.len {
		let e = CEL[ei] as int;
		let h = hzf(LV[LF[e] as int] as int);
		for a in 8 {
			let n = E0[8 * e + a] as int;
			HBV[n] = jmax(HBV[n], h);
		}
	}
	for n in ON0 {
		if IB[n] == 0 { continue; }
		TP[n] = ONT as i32;
		ONT += 1;
		let x = HX[n] as int;
		if x >= 0 {
			var all = true;
			for i in (HC[x] as int) {
				if IB[HM[4 * x + i] as int] != 1 { all = false; }
			}
			if all {
				pf(TX, 0.0);
				pf(TX, 0.0);
				pf(TX, 0.0);
				pi(TE, x);
				TF[n] = 1;
				continue;
			}
		}
		let px = XP[3 * n];
		let py = XP[3 * n + 1];
		let pz = XP[3 * n + 2];
		var l = hyp3(NB[3 * n], NB[3 * n + 1], NB[3 * n + 2]);
		if bad(l) { l = 1.0; }
		let dx = NB[3 * n] / l;
		let dy = NB[3 * n + 1] / l;
		let dz = NB[3 * n + 2] / l;
		var j = tray(px, py, pz, dx, dy, dz, 4.0 * HBV[n], -1, -1, 1e-9);
		var qx = 0.0;
		var qy = 0.0;
		var qz = 0.0;
		if j >= 0 {
			qx = px + R[6] * dx;
			qy = py + R[6] * dy;
			qz = pz + R[6] * dz;
		} else {
			j = tnear(px, py, pz, -1, -1, false, 0.0, 0.0, 0.0, 0.0);
			qx = R[0];
			qy = R[1];
			qz = R[2];
			ORY += 1;
		}
		pf(TX, qx);
		pf(TX, qy);
		pf(TX, qz);
		if j >= 0 { TLB[TP[n] as int] = PT[j]; } else { TLB[TP[n] as int] = -1; }
	}
}
fn ofd(i int) real {
	let g = gnear(TX[3 * i], TX[3 * i + 1], TX[3 * i + 2], 0, false);
	if g < 0 { INF } else { sqrt(R[6]) }
}
fn ofeat(fe bool) {
	zf(TX0, TX.len);
	for i in TX.len { TX0[i] = TX[i]; }
	zu(FMK, ONT);
	OFE = 0;
	OCO = 0;
	if !fe { return; }
	for a in ON0 {
		if IB[a] == 0 { continue; }
		let s = BO[a] as int;
		let e = s + (BN[a] as int);
		for ci in s..e {
			let c = BJ[ci] as int;
			if c < a || TF[a] != 0 || TF[c] != 0 { continue; }
			let ta = TP[a] as int;
			let tc = TP[c] as int;
			if TLB[ta] == TLB[tc] || TLB[ta] < 0 || TLB[tc] < 0 { continue; }
			let da = ofd(ta);
			let dc = ofd(tc);
			if jmin(da, dc) < HBV[a] {
				let tt = if da <= dc { ta } else { tc };
				FMK[tt] = 1;
			}
		}
	}
	zf(DS, ONT);
	for i in ONT { if FMK[i] != 0 { DS[i] = ofd(i); } }
	for b in ONQ {
		let t0 = TP[BQ[5 * b] as int] as int;
		let t1 = TP[BQ[5 * b + 1] as int] as int;
		let t2 = TP[BQ[5 * b + 2] as int] as int;
		let t3 = TP[BQ[5 * b + 3] as int] as int;
		let ts = [t0, t1, t2, t3];
		loop {
			var w = -1;
			var cnt = 0;
			for ti in ts {
				if FMK[ti] != 0 {
					cnt += 1;
					if w == -1 || DS[ti] > DS[w] { w = ti; }
				}
			}
			if cnt < 3 { break; }
			FMK[w] = 0;
		}
	}
	for i in ONT {
		if FMK[i] != 0 {
			ofd(i);
			TX[3 * i] = R[0];
			TX[3 * i + 1] = R[1];
			TX[3 * i + 2] = R[2];
			OFE += 1;
		}
	}
	for cj in CO.len {
		let v = CO[cj] as int;
		var bi = -1;
		var bd2 = INF;
		for i in ONT {
			if FMK[i] != 0 {
				let ex = TX[3 * i] - V[3 * v];
				let ey = TX[3 * i + 1] - V[3 * v + 1];
				let ez = TX[3 * i + 2] - V[3 * v + 2];
				let d = (ex * ex + ey * ey) + ez * ez;
				if d < bd2 {
					bd2 = d;
					bi = i;
				}
			}
		}
		if bi >= 0 && bd2 < OHC * OHC {
			FMK[bi] = 2;
			TX[3 * bi] = V[3 * v];
			TX[3 * bi + 1] = V[3 * v + 1];
			TX[3 * bi + 2] = V[3 * v + 2];
			OCO += 1;
		}
	}
}
export fn ms_tint() {
	for xi in TE.len {
		let x = TE[xi] as int;
		let n = HN[x] as int;
		var sx = 0.0;
		var sy = 0.0;
		var sz = 0.0;
		for i in (HC[x] as int) {
			let v = HM[4 * x + i] as int;
			let w = HW[4 * x + i];
			let tp = 3 * (TP[v] as int);
			sx = sx + w * TX[tp];
			sy = sy + w * TX[tp + 1];
			sz = sz + w * TX[tp + 2];
		}
		let tn = 3 * (TP[n] as int);
		TX[tn] = sx;
		TX[tn + 1] = sy;
		TX[tn + 2] = sz;
	}
}
fn orn(n int) int {
	if US[n] < 0 {
		US[n] = ONN as i32;
		ONN += 1;
		pf(XO, XP[3 * n]);
		pf(XO, XP[3 * n + 1]);
		pf(XO, XP[3 * n + 2]);
	}
	US[n] as int
}
fn oasm() {
	zi(US, ON0, -1);
	XO.clear();
	EL.clear();
	CU.clear();
	BF.clear();
	ONN = 0;
	for ei in CEL.len {
		let e = CEL[ei] as int;
		for a in 8 {
			let v = orn(E0[8 * e + a] as int);
			pi(EL, v);
		}
		pf(CU, hzf(LV[LF[e] as int] as int));
	}
	for n in ON0 {
		if IB[n] != 0 { orn(n); }
	}
	OT0 = ONN;
	for i in 3 * ONT { pf(XO, 0.0); }
	for n in ON0 {
		if IB[n] != 0 {
			for c in 3 { XO[3 * (OT0 + (TP[n] as int)) + c] = TX[3 * (TP[n] as int) + c]; }
		}
	}
	ONN += ONT;
	for b in ONQ {
		for i in 4 {
			let v = orn(BQ[5 * b + i] as int);
			pi(EL, v);
		}
		for i in 4 { pi(EL, OT0 + (TP[BQ[5 * b + i] as int] as int)); }
		pf(CU, 0.0);
		pi(BF, 6 * (ONC + b) + 1);
	}
	ONE = EL.len / 8;
}
fn ohout() {
	HNO.clear();
	HMO.clear();
	HWO.clear();
	OHD = 0;
	for x in HN.len {
		if HA[x] != 1 { continue; }
		let n = HN[x] as int;
		let m = HC[x] as int;
		var ok = US[n] >= 0 && m <= 8;
		if ok {
			for i in m {
				if US[HM[4 * x + i] as int] < 0 { ok = false; }
			}
		}
		if ok {
			pi(HNO, US[n] as int);
			for j in 8 {
				pi(HMO, if j < m { US[HM[4 * x + j] as int] as int } else { -1 });
				pf(HWO, if j < m { HW[4 * x + j] } else { 0.0 });
			}
		} else {
			OHD += 1;
		}
	}
	for xi in TE.len {
		let x = TE[xi] as int;
		let n = HN[x] as int;
		let m = HC[x] as int;
		pi(HNO, OT0 + (TP[n] as int));
		for j in 8 {
			pi(HMO, if j < m { OT0 + (TP[HM[4 * x + j] as int] as int) } else { -1 });
			pf(HWO, if j < m { HW[4 * x + j] } else { 0.0 });
		}
	}
}
fn ohat(x real, y real, z real) real {
	var l = OL;
	while l >= 0 {
		let h = hzf(l);
		let q = mget(IK, IV, okey(l, floor((x - OX) / h) as int, floor((y - OY) / h) as int, floor((z - OZ) / h) as int));
		if q >= 0 { return h; }
		l -= 1;
	}
	OHC
}
fn tsort(n int) {
	zi(TRW, n, 0);
	var w = 1;
	while w < n {
		var lo = 0;
		while lo < n {
			let mid = min(lo + w, n);
			let hi = min(lo + 2 * w, n);
			var i = lo;
			var j = mid;
			var k = lo;
			while k < hi {
				if j < hi && (i == mid || TRR[TRO[j] as int] < TRR[TRO[i] as int]) {
					TRW[k] = TRO[j];
					j += 1;
				} else {
					TRW[k] = TRO[i];
					i += 1;
				}
				k += 1;
			}
			for k2 in lo..hi { TRO[k2] = TRW[k2]; }
			lo += 2 * w;
		}
		w *= 2;
	}
}
fn ostats() {
	TRR.clear();
	TRA.clear();
	TRT.clear();
	var at = 0.0;
	for t in NT {
		let th = TH[t];
		if th != th || th == INF || th == -INF || !(AR[t] > 0.0) { continue; }
		let e = jmin(th / 2.0, OHM / 4.0);
		let h = ohat(C[3 * t] - N[3 * t] * e, C[3 * t + 1] - N[3 * t + 1] * e, C[3 * t + 2] - N[3 * t + 2] * e);
		pf(TRR, th / h);
		pf(TRA, AR[t]);
		pf(TRT, th);
		at = at + AR[t];
	}
	let nr = TRR.len;
	zi(TRO, nr, 0);
	for x in nr { TRO[x] = x as i32; }
	tsort(nr);
	let nan = INF - INF;
	var thr = nan;
	if nr > 0 { thr = TRR[TRO[0] as int]; }
	var acc = 0.0;
	for xi in nr {
		let x = TRO[xi] as int;
		acc = acc + TRA[x];
		if acc >= 0.02 * at {
			thr = TRR[x];
			break;
		}
	}
	var tmin = INF;
	for xi in nr { tmin = jmin(tmin, TRT[TRO[xi] as int]); }
	var hmn = INF;
	var lmin = 99;
	var lmax = 0;
	for qi in LF.len {
		let q = LF[qi] as int;
		let lv = LV[q] as int;
		hmn = jmin(hmn, hzf(lv));
		lmin = min(lmin, lv);
		lmax = max(lmax, lv);
	}
	zf(ORS, 24);
	ORS[0] = OT0 as real;
	ORS[1] = ONC as real;
	ORS[2] = ONT as real;
	ORS[3] = ONL as real;
	ORS[4] = ONB as real;
	ORS[5] = ORF as real;
	ORS[6] = ORY as real;
	ORS[7] = OFE as real;
	ORS[8] = OCO as real;
	ORS[9] = HNO.len as real;
	ORS[10] = OHD as real;
	ORS[11] = thr;
	ORS[12] = tmin;
	ORS[13] = hmn;
	ORS[14] = lmin as real;
	ORS[15] = lmax as real;
	ORS[16] = ONE as real;
	ORS[17] = ONN as real;
	ORS[18] = OL as real;
}
export fn ms_ofeat(nt i32, nc i32) {
	zi(PT, nt as int, 0);
	zi(CO, nc as int, 0);
	ms_view_i32(30, PT);
	ms_view_i32(31, CO);
}
export fn ms_obudget(tgt i32, fixed i32) {
	OBT = tgt as int;
	OBG = jmin(1500000.0, 4.0 * (tgt as real)) as int;
	OFX = fixed as int;
}
export fn ms_one() i32 {
	ONE as i32
}
var OSN i32[>..];
var OPK real[>..];
export fn ms_osize(lx real, ly real, lz real, hx real, hy real, hz real, hv real, res real, hard real, nlay real, sc0 real, fixed i32, hmn real, dl real, refine i32, nsm i32, fe i32) i32 {
	var sc = sc0;
	var st = 1.0;
	var sp = 1.0;
	var have = false;
	var bsc = sc0;
	var bst = 1.0;
	var bdist = INF;
	var bp = -1;
	var lastp = -1;
	var passes = 0;
	OSN.clear();
	for ps in 6 {
		let hc = hv * sc;
		let hm = if hmn > 0.0 { hmn } else { hc / 64.0 };
		let ne = ms_oct(lx, ly, lz, hx, hy, hz, hc, nlay, st, hm, dl, refine, nsm, fe) as int;
		passes += 1;
		if ne < 0 { return ne as i32; }
		let usc = sc;
		let ust = st;
		lastp = ps;
		st *= OFS;
		sc *= OFH;
		if have && ne == 0 {
			st = (st + sp) / 2.0;
			continue;
		}
		have = true;
		sp = st;
		let r = (ne as real) / res;
		let d = abs(ms_log2(r));
		if d < bdist {
			bdist = d;
			bsc = usc;
			bst = ust;
			bp = ps;
		}
		let conv = fixed != 0 || (r <= 1.6 && r >= 0.5) || (r > 1.6 && (ne as real) <= hard && sc > 8.0);
		if conv {
			bsc = usc;
			bst = ust;
			bp = ps;
			break;
		}
		var seen = false;
		for x in OSN { if (x as int) == ne { seen = true; } }
		if ps == 5 || seen { break; }
		pi(OSN, ne);
		if r > 1.0 {
			if (ne as real) > hard && ORS[4] > 0.5 * ORS[3] {
				st *= ms_pow((ne as real) / hard, 0.5);
			} else {
				sc *= ms_pow(r, 0.4);
			}
		} else {
			if st > 1.0 {
				st = jmax(1.0, st * ms_pow(r, 0.5));
			} else {
				sc *= ms_pow(r, 0.4);
			}
		}
	}
	OPK.clear();
	pf(OPK, bsc);
	pf(OPK, bst);
	pf(OPK, passes as real);
	pf(OPK, if bp == lastp { 1.0 } else { 0.0 });
	ms_view_f64(43, OPK);
	passes as i32
}
export fn ms_oct(lx real, ly real, lz real, hx real, hy real, hz real, hc0 real, nlay real, stc0 real, hmin real, dl real, refine i32, nsm i32, fe i32) i32 {
	var hc = hc0;
	var stc = stc0;
	OFS = 1.0;
	OFH = 1.0;
	var rounds = 0;
	var again = true;
	while again {
		rounds += 1;
		let ex0 = jmax(jmax(hx - lx, hy - ly), hz - lz) * 1.02 + 1e-9;
		let p = jmax(0.0, ceil(ms_log2(ex0 / hc) - 1e-9)) as int;
		var pw = 1.0;
		for i in p { pw *= 2.0; }
		OEX = hc * pw;
		OX = (lx + hx) / 2.0 - OEX / 2.0;
		OY = (ly + hy) / 2.0 - OEX / 2.0;
		OZ = (lz + hz) / 2.0 - OEX / 2.0;
		OHC = hc;
		OHM = INF;
		for t in NT {
			HS[t] = jmax(hmin, jmin(hc, (stc * TH[t]) / jmax(2.5, nlay + 0.5)));
			OHM = jmin(OHM, HS[t]);
		}
		OL = jmin(12.0, jmax(1.0, ceil(ms_log2(OEX / OHM - 1e-9)))) as int;
		OGR = 1 << OL;
		OQ = 0;
		LV.clear();
		CI.clear();
		CJ.clear();
		CK.clear();
		BDV.clear();
		AL.clear();
		SDV.clear();
		OS.clear();
		WK.clear();
		mnew(IK, IV, 1024);
		mnew(SDK, SDI, 1024);
		OIU = 0;
		OSU = 0;
		for r in 4 { pi(OS, 0); }
		while OS.len > 0 {
			let k = OS.pop() as int;
			let j = OS.pop() as int;
			let i = OS.pop() as int;
			let l = OS.pop() as int;
			let c = ocls(l, i, j, k);
			if c == 0.0 { continue; }
			let lim = (if c > 0.0 { c } else { hc }) * 1.0001;
			if hzf(l) > lim && l < OL {
				for a in 8 {
					pi(OS, l + 1);
					pi(OS, 2 * i + (a & 1));
					pi(OS, 2 * j + ((a >> 1) & 1));
					pi(OS, 2 * k + (a >> 2));
				}
			} else {
				oadd(l, i, j, k, c);
				if OBG > 0 && OQ > OBG { OS.clear(); }
			}
		}
		again = false;
		if OBG > 0 && OQ > OBG && rounds < 4 {
			let f = sqrt((OQ as real) / (OBT as real));
			stc *= f;
			OFS *= f;
			if rounds >= 2 && OFX == 0 {
				let g = exp(0.8 * log(f));
				hc *= g;
				OFH *= g;
			}
			again = true;
		}
	}
	if OBG > 0 && OQ > OBG { return (-OQ) as i32; }
	for q in OQ { pi(WK, q); }
	obal();
	ORF = 0;
	var rf = 0;
	loop {
		onodes(dl);
		if rf >= (refine as int) { break; }
		if !orefine() { break; }
		rf += 1;
	}
	ocore();
	ohang();
	obq();
	oadj(nsm as int);
	oproj();
	ofeat(fe != 0);
	ms_tint();
	oasm();
	ohout();
	ostats();
	ORS[20] = OFS;
	ORS[21] = OFH;
	ms_view_i32(32, EL);
	ms_view_f64(33, XO);
	ms_view_f64(34, CU);
	ms_view_i32(35, BF);
	ms_view_f64(36, TX);
	ms_view_f64(37, TX0);
	ms_view_u8(38, FMK);
	ms_view_i32(39, HNO);
	ms_view_i32(40, HMO);
	ms_view_f64(41, HWO);
	ms_view_f64(42, ORS);
	ONE as i32
}
