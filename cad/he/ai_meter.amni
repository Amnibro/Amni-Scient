// Server AI prompt entitlement. Integer codes match cad/ai_meter.js.
// plan: 0 free, 1 pro, 2 student, 3 enterprise, 4 lifetime
// The Cloudflare worker cannot run this program. It runs cad/ai_meter.js,
// which keeps the same answers. Build with hc when the compiler is present.
fn main() {}

fn pack(allow i32, count i32, unlim i32, reason i32, left i32) i32 {
	var n = left;
	if n < 0 { n = 0; }
	return allow + count * 2 + unlim * 4 + reason * 8 + n * 256;
}

// reason: 0 counted, 1 local, 2 unlimited, 3 sign-in required, 4 daily limit, 5 errored (not counted)
export fn meter_decide(plan i32, share i32, used i32, cap i32, ok i32, local i32, signed i32) i32 {
	if local != 0 { return pack(1, 0, 1, 1, cap); }
	if signed == 0 { return pack(0, 0, 0, 3, 0); }
	var unlim = 0;
	if plan == 1 || plan == 3 || plan == 4 { unlim = 1; }
	if plan == 2 && share != 0 { unlim = 1; }
	var left = cap - used;
	if left < 0 { left = 0; }
	if ok == 0 { return pack(1, 0, unlim, 5, left); }
	if unlim != 0 { return pack(1, 0, 1, 2, cap); }
	if used >= cap { return pack(0, 0, 0, 4, 0); }
	return pack(1, 1, 0, 0, left - 1);
}
