use std
into mold_prep.amni
dialect js

This file is a library built for the web as a wasm module; its `main()` does nothing. JavaScript drives it through its exported functions (every name starting with ip_ is exported). It is a port of `prep` from cad/injmold.js, the mesh preparation for the injection-molding simulator, with its helpers `bvh`, `tri3`, `dist`, `angAt`, `refine`, `flips`, `vtri`, `featV`, `compactT`, `collapse`, `smooth`, `remesh` and `ballOf`. Results are compared bit for bit with the JavaScript version, so every floating-point formula keeps the JavaScript evaluation order exactly: arithmetic is f64, each sum starts at 0.0 and adds its terms one at a time in loop order, products and quotients group left to right as written, `a-b-c` is `(a-b)-c`, a compound addition adds the finished product, and nothing is fused, reordered or vectorized across terms. Math.atan2, Math.cos and Math.sin always go through the externs `ip_atan2`, `ip_cos` and `ip_sin`, never a Helium math function; square root and absolute value are the plain f64 operations; `x**2` is `x*x`. Wherever this file says max or min of reals it means `jmax` and `jmin`. Where this file writes "v or 1" for a real v it means 1 when v is 0 or NaN, otherwise v.

```amni
extern fn ip_view_f64(id i32, xs real[:]) = "ip_view_f64";
extern fn ip_view_i32(id i32, xs i32[:]) = "ip_view_i32";
extern fn ip_view_u8(id i32, xs u8[:]) = "ip_view_u8";
extern fn ip_atan2(y real, x real) real = "ip_atan2";
extern fn ip_cos(x real) real = "ip_cos";
extern fn ip_sin(x real) real = "ip_sin";
extern fn ip_onp(ph i32) = "ip_onp";
extern fn ip_hmid(x real, y real) real = "ip_hmid";
const KEY int = 4194304;
const PI real = 3.141592653589793;
var SRC real[>..];
var IDX i32[>..];
var TF0 i32[>..];
var CFG real[>..];
var P real[>..];
var T i32[>..];
var F i32[>..];
var TG real[>..];
var BP real[>..];
var BT i32[>..];
var CEN real[>..];
var ORD i32[>..];
var BLO real[>..];
var BHI real[>..];
var BLC i32[>..];
var BRC i32[>..];
var BS0 i32[>..];
var BC0 i32[>..];
var BST i32[>..];
var BNN int = 0;
var HT real = 0.0;
var HTRI int = -1;
var HU real = 0.0;
var HV real = 0.0;
var HQ real[>..];
var HD2 real = 0.0;
var CQ real[>..];
var VC i32[>..];
var VL i32[>..];
var FE u8[>..];
var FC u8[>..];
var FN i32[>..];
var LOCK u8[>..];
var MK1 i32[>..];
var MK2 i32[>..];
var STAMP int = 0;
var RK i32[>..];
var RR i32[>..];
var EKS int[>..];
var EVS i32[>..];
var ECAP int = 0;
var NE int = 0;
var EL0 real[>..];
var ET0 real[>..];
var EM0 u8[>..];
var EMID i32[>..];
var EOC i32[>..];
var EA0 i32[>..];
var EB0 i32[>..];
var EA1 i32[>..];
var EB1 i32[>..];
var TE i32[>..];
var NT2 i32[>..];
var NF2 i32[>..];
var NG2 real[>..];
var USED u8[>..];
var CURV u8[>..];
var FNX real[>..];
var FHAS u8[>..];
var P0 real[>..];
var OLD real[>..];
var SEEN i32[>..];
var DK0 int[>..];
var DK1 int[>..];
var DK2 int[>..];
var DVS i32[>..];
var RM i32[>..];
var FA real[>..];
var FB real[>..];
var CS real[>..];
var AR real[>..];
var BALL real[>..];
var TI i32[>..];
var PF real[>..];
var PM real[>..];
var AA real[>..];
var AE real[>..];
var NN real[>..];
var HH real[>..];
var HE real[>..];
var WW real[>..];
var COSC real[>..];
var DRAY real[>..];
var RAP real[>..];
var ELK i32[>..];
var CT real[>..];
var LE i32[>..];
var LK real[>..];
var GPH real[>..];
var L0 i32[>..];
var L1 i32[>..];
var VV real[>..];
var HN real[>..];
var HNS real[>..];
var HW real[>..];
var ACV real[>..];
var NV3 real[>..];
var SKN u8[>..];
