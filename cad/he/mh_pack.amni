		let s = ww[v * 4] + ww[v * 4 + 1] + ww[v * 4 + 2] + ww[v * 4 + 3];
		var rem = 50000;
		for k in 4 { OUT.push(wj[v * 4 + k] as byte); }
		for k in 4 {
			let q = if k == 3 { rem } else { clamp(round((ww[v * 4 + k] / s * 50000.0) as real) as int, 0, rem) };
			rem -= q;
			put2b(OUT, q);
		}
	}
