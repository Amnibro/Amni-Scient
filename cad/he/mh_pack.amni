	zero_d(); for v in nv { if vgrp[v] == 7 { DZ[v] = 0.025; DY[v] = -0.004; } } emit_d();
	let gyaw f32[8] = [-0.35, 0.35, 0.0, 0.0, 0.0, 0.0, 0.35, -0.35];
	let gpit f32[8] = [0.0, 0.0, -0.30, 0.30, -0.30, 0.30, 0.0, 0.0];
	let geye int[8] = [1, 2, 2, 2, 1, 1, 1, 2];
	for g in 8 {
		zero_d();
		let eg = geye[g];
		let cx = if eg == 1 { elx } else { erx };
		let cy = if eg == 1 { ely } else { ery };
		let cz = if eg == 1 { elz } else { erz };
		let cyw = cos(gyaw[g] as real) as f32;
		let syw = sin(gyaw[g] as real) as f32;
		let cpt = cos(gpit[g] as real) as f32;
		let spt = sin(gpit[g] as real) as f32;
		for v in nv {
			if vgrp[v] == eg {
				let rx = VX[v] - cx;
				let ry = VY[v] - cy;
				let rz = VZ[v] - cz;
				let x1 = rx * cyw + rz * syw;
				let z1 = -rx * syw + rz * cyw;
				let y2 = ry * cpt - z1 * spt;
				let z2 = ry * spt + z1 * cpt;
				DX[v] = x1 - rx;
				DY[v] = y2 - ry;
				DZ[v] = z2 - rz;
			}
		}
		if gpit[g] < 0.0 { add_target(if eg == 1 { "expression/units/caucasian/eye-left-opened-up.target" } else { "expression/units/caucasian/eye-right-opened-up.target" }, 0.22); }
		if gpit[g] > 0.0 { add_target(if eg == 1 { "expression/units/caucasian/eye-left-closure.target" } else { "expression/units/caucasian/eye-right-closure.target" }, 0.25); }
		emit_d();
	}
	OUT[tgt_count_off] = (TGTS & 255) as byte;
	OUT[tgt_count_off + 1] = ((TGTS >> 8) & 255) as byte;
	OUT[tgt_count_off + 2] = (((TGTS >> 8) >> 8) & 255) as byte;
	OUT[tgt_count_off + 3] = ((TGTS >> 24) & 255) as byte;
	write_file(a[2], OUT[..]);
	print("mh_pack: nv=", nv, " body_v=", b2m.len, " body_q=", bq.len / 8, " targets=", TGTS, " miss=", MISS, " bytes=", OUT.len);
}
