export fn sc_views() { views(); }
export fn sc_g(k i32) i32 {
	match k {
		0 => NV as i32,
		1 => NT as i32,
		2 => CAPV as i32,
		3 => CAPT as i32,
		4 => NN as i32,
		5 => CAPN as i32,
		7 => QID as i32,
		8 => DQ as i32,
		9 => AK as i32,
		10 => LFG as i32,
		11 => SID as i32,
		12 => FA as i32,
		13 => OPN as i32,
		14 => HASM as i32,
		15 => HASS as i32,
		17 => SHOW as i32,
		18 => CAV as i32,
		19 => CAT as i32,
		20 => CAF as i32,
		21 => HIDC as i32,
		22 => GALL as i32,
		23 => NF as i32,
		24 => VEP as i32,
		25 => LCV.len as i32,
		27 => LCT.len as i32,
		28 => LCF.len as i32,
		29 => LGV.len as i32,
		30 => LGT.len as i32,
		31 => MV.len as i32,
		32 => LFL.len as i32,
		33 => CHK.len as i32,
		_ => 0,
	}
}
export fn sc_s(k i32, x i32) {
	match k {
		0 => { NV = x; },
