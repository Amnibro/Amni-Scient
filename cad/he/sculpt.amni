		20 => { CAF = x; },
		21 => { HIDC = x; },
		22 => { GALL = x; },
		23 => { NF = x; },
		24 => { VEP = x; },
		_ => {},
	}
}
export fn sc_lclear(k i32) {
	match k {
		0 => { LCV.clear(); },
		1 => { LCT.clear(); },
		2 => { LCF.clear(); },
		3 => { LGV.clear(); },
		4 => { LGT.clear(); },
		5 => { MV.clear(); },
		7 => { LFL.clear(); },
		_ => {},
	}
}
export fn sc_lpush(k i32, x i32) {
	match k {
		0 => { pi(LCV, x); },
		1 => { pi(LCT, x); },
		2 => { pi(LCF, x); },
		3 => { pi(LGV, x); },
		4 => { pi(LGT, x); },
		5 => { pi(MV, x); },
		7 => { pi(LFL, x); },
		_ => {},
	}
}
export fn sc_alloc(dy i32, nv i32, nt i32) {
	let nvi int = nv;
	let nti int = nt;
	DYN = dy;
	if dy == 1 {
		CAPV = (c_ceil((nvi as real) * 1.3) as int) + 70;
		CAPT = (c_ceil((nti as real) * 1.3) as int) + 70;
	} else {
		CAPV = max(1, nvi);
		CAPT = max(1, nti);
	}
	zr(CO, 3 * CAPV);
	zr(VN, 3 * CAPV);
	zr(POS, 3 * CAPV);
	zr(COL, 3 * CAPV);
	zr(MASK, CAPV);
	zr(VH, CAPV);
	zr(ST, CAPV);
	zr(ORIG, 3 * CAPV);
	zr(ON, 3 * CAPV);
	zr(LAY, CAPV);
	zr(VLEAF, CAPV);
	zr(VPOS, CAPV);
	zr(DS, CAPV);
	zr(NS, CAPV);
	zr(KS, CAPV);
	zr(VCHG, CAPV);
	zr(VGPU, CAPV);
	zr(TRI, 3 * CAPT);
	zr(IDX, 3 * CAPT);
	zr(TN, 3 * CAPT);
	zr(TLEAF, CAPT);
	zr(TPOS, CAPT);
	zr(TQ, CAPT);
	zr(TCHG, CAPT);
	zr(TGPU, CAPT);
	zr(TH, CAPT);
	if dy == 1 {
		zr(VC, CAPV);
		zr(VDEAD, CAPV);
		zr(VLOCK, CAPV);
		zr(OO, 3 * CAPT);
		zr(TDEAD, CAPT);
		zr(TF, CAPT);
		zr(TSET, CAPT);
	} else {
		VC.clear();
		VDEAD.clear();
		VLOCK.clear();
		OO.clear();
		TDEAD.clear();
		TF.clear();
		TSET.clear();
	}
	for i in 0..VLEAF.len { VLEAF[i] = -1; }
	for i in 0..TLEAF.len { TLEAF[i] = -1; }
	if dy == 1 {
		for i in 0..VC.len { VC[i] = -1; }
	}
	NV = 0;
	NT = 0;
	NN = 0;
	CAPN = 0;
	QID = 0;
	DQ = 0;
	AK = 0;
	SID = 0;
	FA = 0;
	OPN = 0;
	HASM = 0;
	HASS = 0;
	SHOW = 0;
	CAV = 0;
	CAT = 0;
	CAF = 0;
	HIDC = 0;
	GALL = 0;
	NF = 0;
	TOP = 0;
	STL = 0;
	RPG = 0;
	LFG = 1;
	zr(QV, 1100);
	zr(STK, 1100);
	zr(FB, 1100);
	zr(NB, 1100);
	zr(TB, 1100);
	zr(QD, 1100);
	zr(QW, 1100);
	zr(RS, 16);
	LCV.clear();
	LCV.reserve(CAPV);
	LGV.clear();
	LGV.reserve(CAPV);
	MV.clear();
	MV.reserve(CAPV);
	LCT.clear();
	LCT.reserve(CAPT);
	LGT.clear();
	LGT.reserve(CAPT);
	LCF.clear();
	LFL.clear();
	views();
}
fn grow(tri bool, n int) {
	let cap = if tri { CAPT } else { CAPV };
	if n <= cap { return; }
	let c = max(n, (c_ceil((cap as real) * 1.5) as int) + 70);
	if !tri {
		if TOP == 1 && STL == 0 {
			SNP.clear();
			SNP.reserve(CO.len);
			SNP.append(CO);
			STL = 1;
		}
		gw(CO, 3 * c);
		gw(VN, 3 * c);
		gw(POS, 3 * c);
		gw(COL, 3 * c);
		gw(MASK, c);
		gw(VH, c);
		gw(ST, c);
		gw(ORIG, 3 * c);
		gw(ON, 3 * c);
		gw(LAY, c);
		gw(VLEAF, c);
		gw(VPOS, c);
		gw(DS, c);
		gw(NS, c);
		gw(KS, c);
		gw(VCHG, c);
		gw(VGPU, c);
		if DYN == 1 {
			gw(VC, c);
			gw(VDEAD, c);
			gw(VLOCK, c);
		}
		for i in cap..c { VLEAF[i] = -1; }
		if DYN == 1 {
			for i in cap..c { VC[i] = -1; }
		}
		CAPV = c;
		cw(LCV, c);
		cw(LGV, c);
		cw(MV, c);
	} else {
		gw(TRI, 3 * c);
		gw(IDX, 3 * c);
		gw(TN, 3 * c);
		gw(TLEAF, c);
		gw(TPOS, c);
		gw(TQ, c);
		gw(TCHG, c);
		gw(TGPU, c);
		gw(TH, c);
		if DYN == 1 {
			gw(OO, 3 * c);
			gw(TDEAD, c);
			gw(TF, c);
			gw(TSET, c);
		}
		for i in cap..c { TLEAF[i] = -1; }
		CAPT = c;
		cw(LCT, c);
		cw(LGT, c);
	}
	sc_grow(if tri { 1 } else { 0 }, c as i32);
}
export fn sc_static(nf i32) {
	NF = nf;
	zr(FSET, nf);
	zr(FCHG, nf);
	zr(T2F, NT);
	LCF.clear();
	LCF.reserve(nf);
	views();
}
export fn sc_csrin(nfo i32, ncv i32, nle i32) {
	zr(FOI, nfo);
	zr(CVI, ncv);
	zr(LEI, nle);
	views();
}
export fn sc_csr() {
	var cnt i32[>..] = [];
	cnt.reserve(NV + 1);
	cnt.resize(NV + 1, 0);
	for f in 0..NF {
		let a int = FOI[f];
		let b int = FOI[f + 1];
		if b - a < 3 { continue; }
		for i in a..b {
			let j = if i + 1 < b { i + 1 } else { a };
			let ci int = CVI[i];
			let cj int = CVI[j];
			cnt[ci + 1] += 1;
			cnt[cj + 1] += 1;
		}
	}
	var li = 0;
	while li + 1 < LEI.len {
		let x int = LEI[li];
		let y int = LEI[li + 1];
		cnt[x + 1] += 1;
		cnt[y + 1] += 1;
		li += 2;
	}
	for v in 0..NV { cnt[v + 1] += cnt[v]; }
	zr(NBA, cnt[NV]);
	var w i32[>..] = [];
	w.reserve(NV);
	w.append(cnt[0..NV]);
	fn add(u int, x int) {
		let p int = w[u];
		NBA[p] = x as i32;
		w[u] += 1;
	}
	for f in 0..NF {
		let a int = FOI[f];
		let b int = FOI[f + 1];
		if b - a < 3 { continue; }
		for i in a..b {
			let j = if i + 1 < b { i + 1 } else { a };
			let u int = CVI[i];
			let x int = CVI[j];
			add(u, x);
			add(x, u);
		}
	}
	var lj = 0;
	while lj + 1 < LEI.len {
		let x int = LEI[lj];
		let y int = LEI[lj + 1];
		add(x, y);
		add(y, x);
		lj += 2;
	}
	zr(NBO, NV + 1);
	var m = 0;
	for v in 0..NV {
		let s int = cnt[v];
		let e int = cnt[v + 1];
		sort(NBA[s..e]) { a, b => a < b };
		NBO[v] = m as i32;
		for i in s..e {
			if i == s || NBA[i] != NBA[i - 1] {
				NBA[m] = NBA[i];
				m += 1;
			}
		}
	}
	NBO[NV] = m as i32;
	NBA.resize(m, 0);
	zr(VTO, NV + 1);
	for i in 0..(3 * NT) {
		let x int = TRI[i];
		VTO[x + 1] += 1;
	}
	for v in 0..NV { VTO[v + 1] += VTO[v]; }
	zr(VT, 3 * NT);
	var q i32[>..] = [];
	q.reserve(NV);
	q.append(VTO[0..NV]);
	for i in 0..(3 * NT) {
		let x int = TRI[i];
		let p int = q[x];
		VT[p] = (i / 3) as i32;
		q[x] += 1;
	}
	FOI.clear();
	CVI.clear();
	LEI.clear();
	views();
}
fn ltnew(nd int, cnt int) {
	LTS[nd] = LTP.len as i32;
	LTN[nd] = cnt as i32;
	LTC[nd] = cnt as i32;
	gw(LTP, LTP.len + cnt);
}
fn lvnew(nd int) {
	LVS[nd] = LVP.len as i32;
	LVN[nd] = 0;
	LVC[nd] = 0;
}
fn ltpush(nd int, x int) {
	if LTN[nd] == LTC[nd] {
		let cc int = LTC[nd];
		let nc = max(8, 2 * cc);
		if LTS[nd] + cc == LTP.len {
			gw(LTP, LTP.len + (nc - cc));
		} else {
			let s = LTP.len;
			gw(LTP, s + nc);
			let cn int = LTN[nd];
			let st int = LTS[nd];
			for i in 0..cn { LTP[s + i] = LTP[st + i]; }
			LTS[nd] = s as i32;
		}
		LTC[nd] = nc as i32;
	}
	LTP[LTS[nd] + LTN[nd]] = x as i32;
	LTN[nd] += 1;
}
fn lvpush(nd int, x int) {
	if LVN[nd] == LVC[nd] {
		let cc int = LVC[nd];
		let nc = max(8, 2 * cc);
		if LVS[nd] + cc == LVP.len {
			gw(LVP, LVP.len + (nc - cc));
		} else {
			let s = LVP.len;
			gw(LVP, s + nc);
			let cn int = LVN[nd];
			let st int = LVS[nd];
			for i in 0..cn { LVP[s + i] = LVP[st + i]; }
			LVS[nd] = s as i32;
		}
		LVC[nd] = nc as i32;
	}
	LVP[LVS[nd] + LVN[nd]] = x as i32;
	LVN[nd] += 1;
}
fn node(p int) int {
	let n = NN;
	NN += 1;
	if n >= CAPN {
		let c = (c_ceil((CAPN as real) * 1.5) as int) + 70;
		gw(NMIN, 3 * c);
		gw(NMAX, 3 * c);
		gw(NL, c);
		gw(NP, c);
		gw(LFS, c);
		gw(RPM, c);
		gw(LTS, c);
		gw(LTN, c);
		gw(LTC, c);
		gw(LVS, c);
		gw(LVN, c);
		gw(LVC, c);
		CAPN = c;
	}
	NP[n] = p as i32;
	NL[n] = -1;
	LFS[n] = 0;
	LTC[n] = -1;
	LVC[n] = -1;
	LTN[n] = 0;
	LVN[n] = 0;
	n
}
fn leafB(nd int) {
	var lo real[3] = [1e30; 3];
	var hi real[3] = [-1e30; 3];
	fn ad(v int) {
		for k in 0..3 {
			let x = CO[3 * v + k];
			if x < lo[k] { lo[k] = x; }
			if x > hi[k] { hi[k] = x; }
		}
	}
	let tn int = LTN[nd];
	for i in 0..tn {
		let t int = lt_at(nd, i);
		ad(TRI[3 * t]);
		ad(TRI[3 * t + 1]);
		ad(TRI[3 * t + 2]);
	}
	let vn int = LVN[nd];
	for i in 0..vn { ad(lv_at(nd, i)); }
	for k in 0..3 {
		NMIN[3 * nd + k] = lo[k] as f32;
		NMAX[3 * nd + k] = hi[k] as f32;
	}
}
fn nodeB(nd int) {
	let l int = 3 * NL[nd];
	let r = l + 3;
	let o = 3 * nd;
	for k in 0..3 {
		NMIN[o + k] = jmin(rv(NMIN[l + k]), rv(NMIN[r + k])) as f32;
		NMAX[o + k] = jmax(rv(NMAX[l + k]), rv(NMAX[r + k])) as f32;
	}
}
fn lfMark(nd int) {
	if nd >= 0 && LFS[nd] != LFG {
		LFS[nd] = LFG as i32;
		pi(LFL, nd);
	}
}
fn ownV(v int, lf int) {
	VLEAF[v] = lf as i32;
	VPOS[v] = LVN[lf];
	lvpush(lf, v);
	lfMark(lf);
}
fn rmT(t int) {
	let lf int = TLEAF[t];
	if lf < 0 { return; }
	let i int = TPOS[t];
	LTN[lf] -= 1;
	let last = lt_at(lf, LTN[lf]);
	if last != t {
		lt_set(lf, i, last);
		TPOS[last] = i as i32;
	}
	TLEAF[t] = -1;
	lfMark(lf);
}
fn rmV(v int) {
	let lf int = VLEAF[v];
	if lf < 0 { return; }
	let i int = VPOS[v];
	LVN[lf] -= 1;
	let last = lv_at(lf, LVN[lf]);
	if last != v {
		lv_set(lf, i, last);
		VPOS[last] = i as i32;
	}
	VLEAF[v] = -1;
	lfMark(lf);
}
fn ck(i int, ax int) real {
	let t int = IDS[i];
	rv(CEN[3 * t + ax])
}
fn sel(lo int, hi int, k int, ax int) {
	var l = lo;
	var h = hi - 1;
	while h > l {
		let p = ck((l + h) / 2, ax);
		var i = l;
		var j = h;
		while i <= j {
			while ck(i, ax) < p { i += 1; }
			while ck(j, ax) > p { j -= 1; }
			if i <= j {
				let w = IDS[i];
				IDS[i] = IDS[j];
				IDS[j] = w;
				i += 1;
				j -= 1;
			}
		}
		if k <= j {
			h = j;
		} else if k >= i {
			l = i;
		} else {
			break;
		}
	}
}
export fn sc_bvh() {
	zr(CEN, 3 * max(1, NT));
	zr(IDS, NT);
	var m = 0;
	for t in 0..NT {
		if DYN == 1 && TDEAD[t] != 0 { continue; }
		IDS[m] = t as i32;
		m += 1;
		let a int = 3 * TRI[3 * t];
		let b int = 3 * TRI[3 * t + 1];
		let c int = 3 * TRI[3 * t + 2];
		for k in 0..3 {
			CEN[3 * t + k] = (((CO[a + k] + CO[b + k]) + CO[c + k]) / 3.0) as f32;
		}
	}
	CAPN = max(7, 4 * ((m + 511) / 512) + 7);
	NN = 0;
	zr(NMIN, 3 * CAPN);
	zr(NMAX, 3 * CAPN);
	zr(NL, CAPN);
	zr(NP, CAPN);
	zr(LFS, CAPN);
	zr(RPM, CAPN);
	zr(LTS, CAPN);
	zr(LTN, CAPN);
	zr(LTC, CAPN);
	zr(LVS, CAPN);
	zr(LVN, CAPN);
	zr(LVC, CAPN);
	LTP.clear();
	LVP.clear();
	for i in 0..VLEAF.len { VLEAF[i] = -1; }
	BS.clear();
	let r0 = node(-1);
	pi(BS, r0);
	pi(BS, 0);
	pi(BS, m);
	while BS.len > 0 {
		let e int = BS.pop();
		let s int = BS.pop();
		let nd int = BS.pop();
		if e - s <= 512 {
			ltnew(nd, e - s);
			for i in 0..(e - s) { lt_set(nd, i, IDS[s + i]); }
			for i in 0..(e - s) {
				let t int = lt_at(nd, i);
				TLEAF[t] = nd as i32;
				TPOS[t] = i as i32;
			}
			lvnew(nd);
			continue;
		}
		var lo real[3] = [1e30; 3];
		var hi real[3] = [-1e30; 3];
		for i in s..e {
			for k in 0..3 {
				let x = ck(i, k);
				if x < lo[k] { lo[k] = x; }
				if x > hi[k] { hi[k] = x; }
			}
		}
		let ex0 = hi[0] - lo[0];
		let ex1 = hi[1] - lo[1];
		let ex2 = hi[2] - lo[2];
		var ax = 2;
		if ex0 >= ex1 && ex0 >= ex2 {
			ax = 0;
		} else if ex1 >= ex2 {
			ax = 1;
		}
		let k = (s + e) / 2;
		sel(s, e, k, ax);
		let l = node(nd);
		node(nd);
		NL[nd] = l as i32;
		pi(BS, l);
		pi(BS, s);
		pi(BS, k);
		pi(BS, l + 1);
		pi(BS, k);
		pi(BS, e);
	}
	for nd in 0..NN {
		if NL[nd] >= 0 { continue; }
		let tn int = LTN[nd];
		for i in 0..tn {
			let t int = lt_at(nd, i);
			for k in 0..3 {
				let v int = TRI[3 * t + k];
				if VLEAF[v] < 0 { ownV(v, nd); }
			}
		}
	}
	var q = NN - 1;
	while q >= 0 {
		if NL[q] < 0 { leafB(q); } else { nodeB(q); }
		q -= 1;
	}
	LFL.clear();
	LFL.reserve(CAPN);
	views();
}
fn skey(t int, k int) real {
	let a int = 3 * TRI[3 * t];
	let b int = 3 * TRI[3 * t + 1];
	let c int = 3 * TRI[3 * t + 2];
	(CO[a + k] + CO[b + k]) + CO[c + k]
}
fn splitLeaf(nd int) {
	let n int = LTN[nd];
	let s int = LTS[nd];
	var lo real[3] = [1e30; 3];
	var hi real[3] = [-1e30; 3];
	for i in 0..n {
		let t int = lt_at(nd, i);
		for k in 0..3 {
			let x = skey(t, k);
			if x < lo[k] { lo[k] = x; }
			if x > hi[k] { hi[k] = x; }
		}
	}
	let ex0 = hi[0] - lo[0];
	let ex1 = hi[1] - lo[1];
	let ex2 = hi[2] - lo[2];
	var ax = 2;
	if ex0 >= ex1 && ex0 >= ex2 {
		ax = 0;
	} else if ex1 >= ex2 {
		ax = 1;
	}
	stable_sort(LTP[s..(s + n)]) { a, b => skey(a, ax) < skey(b, ax) };
	let h = n / 2;
	let l = node(nd);
	let r = node(nd);
	NL[nd] = l as i32;
	ltnew(l, h);
	for i in 0..h { lt_set(l, i, LTP[s + i]); }
	ltnew(r, n - h);
	for i in 0..(n - h) { lt_set(r, i, LTP[s + h + i]); }
	lvnew(l);
	lvnew(r);
	for q in [l, r] {
		let tn int = LTN[q];
		for i in 0..tn {
			let t int = lt_at(q, i);
			TLEAF[t] = q as i32;
			TPOS[t] = i as i32;
		}
		leafB(q);
	}
	let mid = (rv(NMAX[3 * l + ax]) + rv(NMIN[3 * r + ax])) / 2.0;
	WL.clear();
	let vn int = LVN[nd];
	for i in 0..vn { pi(WL, lv_at(nd, i)); }
	LTC[nd] = -1;
	LVC[nd] = -1;
	LTN[nd] = 0;
	LVN[nd] = 0;
	for x in WL {
		let v int = x;
		if CO[3 * v + ax] <= mid { ownV(v, l); } else { ownV(v, r); }
	}
	leafB(l);
	leafB(r);
	LFS[l] = LFG as i32;
	LFS[r] = LFG as i32;
}
export fn sc_refit() {
	if LFL.len == 0 {
		views();
		return;
	}
	var L i32[>..] = [];
	L.reserve(LFL.len);
	L.append(LFL);
	LFL.clear();
	LFG += 1;
	RPG += 1;
	RPL.clear();
	fn up(nd int) {
		var p = nd;
		while p >= 0 && RPM[p] != RPG {
			RPM[p] = RPG as i32;
			pi(RPL, p);
			let np int = NP[p];
			p = np;
		}
	}
	for x in L {
		let nd int = x;
		if NL[nd] >= 0 { continue; }
		if DYN == 1 && LTN[nd] > 2048 {
			splitLeaf(nd);
			up(nd);
			continue;
		}
		leafB(nd);
		let pn int = NP[nd];
		up(pn);
	}
	sort(RPL) { a, b => a > b };
	for x in RPL {
		let p int = x;
		if NL[p] >= 0 { nodeB(p); }
	}
	views();
}
fn qgrow() {
	let n = 2 * QV.len;
	gw(QV, n);
	gw(QD, n);
	gw(QW, n);
}
fn range(x real, y real, z real, r real) int {
	let r2 = r * r;
	let pa real[3] = [x, y, z];
	STK[0] = 0;
	var sp = 1;
	var n = 0;
	while sp > 0 {
		sp -= 1;
		let nd int = STK[sp];
		let o = 3 * nd;
		var d = 0.0;
		for k in 0..3 {
			let pk = pa[k];
			let lo = rv(NMIN[o + k]);
			let hi = rv(NMAX[o + k]);
			let q = if pk < lo { lo - pk } else if pk > hi { pk - hi } else { 0.0 };
			d += q * q;
		}
		if d > r2 { continue; }
		let l int = NL[nd];
		if l >= 0 {
			STK[sp] = l as i32;
			STK[sp + 1] = (l + 1) as i32;
			sp += 2;
			continue;
		}
		let vn int = LVN[nd];
		for i in 0..vn {
			let v int = lv_at(nd, i);
			if VH[v] != 0 { continue; }
			let a = 3 * v;
			let dx = CO[a] - x;
			let dy = CO[a + 1] - y;
			let dz = CO[a + 2] - z;
			let e = (dx * dx + dy * dy) + dz * dz;
			if e <= r2 {
				if n >= QV.len { qgrow(); }
				QV[n] = v as i32;
				QD[n] = c_sqrt(e) as f32;
				n += 1;
			}
		}
	}
	n
}
export fn sc_range(x real, y real, z real, r real) i32 {
	let n = range(x, y, z, r);
	views();
	n as i32
}
export fn sc_ray(o0 real, o1 real, o2 real, d0 real, d1 real, d2 real, tmax real) i32 {
	let ix = 1.0 / d0;
	let iy = 1.0 / d1;
	let iz = 1.0 / d2;
	var bt = tmax;
	var bi = -1;
	var bu = 0.0;
	var bw = 0.0;
	STK[0] = 0;
	var sp = 1;
	while sp > 0 {
		sp -= 1;
		let nd int = STK[sp];
		let q = 3 * nd;
		var t0 = (rv(NMIN[q]) - o0) * ix;
		var t1 = (rv(NMAX[q]) - o0) * ix;
		if t0 > t1 {
			let w = t0;
			t0 = t1;
			t1 = w;
		}
		var a = (rv(NMIN[q + 1]) - o1) * iy;
		var b = (rv(NMAX[q + 1]) - o1) * iy;
		if a > b {
			let w = a;
			a = b;
			b = w;
		}
		t0 = jmax(t0, a);
		t1 = jmin(t1, b);
		a = (rv(NMIN[q + 2]) - o2) * iz;
		b = (rv(NMAX[q + 2]) - o2) * iz;
		if a > b {
			let w = a;
			a = b;
			b = w;
		}
		t0 = jmax(t0, a);
		t1 = jmin(t1, b);
		if t1 < jmax(t0, 0.0) || t0 > bt { continue; }
		let l int = NL[nd];
		if l >= 0 {
			STK[sp] = l as i32;
			STK[sp + 1] = (l + 1) as i32;
			sp += 2;
			continue;
		}
		let tn int = LTN[nd];
		for i in 0..tn {
			let t int = lt_at(nd, i);
			if TH[t] != 0 { continue; }
			let ta int = 3 * TRI[3 * t];
			let tb int = 3 * TRI[3 * t + 1];
			let te int = 3 * TRI[3 * t + 2];
			let ex = CO[tb] - CO[ta];
			let ey = CO[tb + 1] - CO[ta + 1];
			let ez = CO[tb + 2] - CO[ta + 2];
			let fx = CO[te] - CO[ta];
			let fy = CO[te + 1] - CO[ta + 1];
			let fz = CO[te + 2] - CO[ta + 2];
			let px = d1 * fz - d2 * fy;
			let py = d2 * fx - d0 * fz;
			let pz = d0 * fy - d1 * fx;
			let det = (ex * px + ey * py) + ez * pz;
			if abs(det) < 1e-30 { continue; }
			let id = 1.0 / det;
			let sx = o0 - CO[ta];
			let sy = o1 - CO[ta + 1];
			let sz = o2 - CO[ta + 2];
			let u = ((sx * px + sy * py) + sz * pz) * id;
			if u < 0.0 || u > 1.0 { continue; }
			let qx = sy * ez - sz * ey;
			let qy = sz * ex - sx * ez;
			let qz = sx * ey - sy * ex;
			let v = ((d0 * qx + d1 * qy) + d2 * qz) * id;
			if v < 0.0 || u + v > 1.0 { continue; }
			let tt = ((fx * qx + fy * qy) + fz * qz) * id;
			if tt > 0.0 && tt < bt {
				bt = tt;
				bi = t;
				bu = u;
				bw = v;
			}
		}
	}
	if bi < 0 { return 0; }
	let a int = 3 * TRI[3 * bi];
	let b int = 3 * TRI[3 * bi + 1];
	let c int = 3 * TRI[3 * bi + 2];
	let w0 = (1.0 - bu) - bw;
	nrm((rv(VN[a]) * w0 + rv(VN[b]) * bu) + rv(VN[c]) * bw, (rv(VN[a + 1]) * w0 + rv(VN[b + 1]) * bu) + rv(VN[c + 1]) * bw, (rv(VN[a + 2]) * w0 + rv(VN[b + 2]) * bu) + rv(VN[c + 2]) * bw);
	RS[0] = bt;
	RS[1] = bi as real;
	RS[2] = o0 + d0 * bt;
	RS[3] = o1 + d1 * bt;
	RS[4] = o2 + d2 * bt;
	RS[5] = U0;
	RS[6] = U1;
	RS[7] = U2;
	return 1;
}
fn cpt(p0 real, p1 real, p2 real, a int, b int, c int) {
	let a0 = CO[a];
	let a1 = CO[a + 1];
	let a2 = CO[a + 2];
	let b0 = CO[b];
	let b1 = CO[b + 1];
	let b2 = CO[b + 2];
	let c0 = CO[c];
	let c1 = CO[c + 1];
	let c2 = CO[c + 2];
	let ab0 = b0 - a0;
	let ab1 = b1 - a1;
	let ab2 = b2 - a2;
	let ac0 = c0 - a0;
	let ac1 = c1 - a1;
	let ac2 = c2 - a2;
	let ap0 = p0 - a0;
	let ap1 = p1 - a1;
	let ap2 = p2 - a2;
	let d1 = dot6(ab0, ab1, ab2, ap0, ap1, ap2);
	let d2 = dot6(ac0, ac1, ac2, ap0, ap1, ap2);
	if d1 <= 0.0 && d2 <= 0.0 {
		Q0 = a0;
		Q1 = a1;
		Q2 = a2;
		return;
	}
	let bp0 = p0 - b0;
	let bp1 = p1 - b1;
	let bp2 = p2 - b2;
	let d3 = dot6(ab0, ab1, ab2, bp0, bp1, bp2);
	let d4 = dot6(ac0, ac1, ac2, bp0, bp1, bp2);
	if d3 >= 0.0 && d4 <= d3 {
		Q0 = b0;
		Q1 = b1;
		Q2 = b2;
		return;
	}
	let vc = d1 * d4 - d3 * d2;
	if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
		let v = d1 / (d1 - d3);
		Q0 = a0 + ab0 * v;
		Q1 = a1 + ab1 * v;
		Q2 = a2 + ab2 * v;
		return;
	}
	let cp0 = p0 - c0;
	let cp1 = p1 - c1;
	let cp2 = p2 - c2;
	let d5 = dot6(ab0, ab1, ab2, cp0, cp1, cp2);
	let d7 = dot6(ac0, ac1, ac2, cp0, cp1, cp2);
	if d7 >= 0.0 && d5 <= d7 {
		Q0 = c0;
		Q1 = c1;
		Q2 = c2;
		return;
	}
	let vb = d5 * d2 - d1 * d7;
	if vb <= 0.0 && d2 >= 0.0 && d7 <= 0.0 {
		let w = d2 / (d2 - d7);
		Q0 = a0 + ac0 * w;
		Q1 = a1 + ac1 * w;
		Q2 = a2 + ac2 * w;
		return;
	}
	let va = d3 * d7 - d5 * d4;
	if va <= 0.0 && d4 - d3 >= 0.0 && d5 - d7 >= 0.0 {
		let w = (d4 - d3) / ((d4 - d3) + (d5 - d7));
		Q0 = b0 + (c0 - b0) * w;
		Q1 = b1 + (c1 - b1) * w;
		Q2 = b2 + (c2 - b2) * w;
		return;
	}
	let dn = 1.0 / ((va + vb) + vc);
	let v = vb * dn;
	let w = vc * dn;
	Q0 = (a0 + ab0 * v) + ac0 * w;
	Q1 = (a1 + ab1 * v) + ac1 * w;
	Q2 = (a2 + ab2 * v) + ac2 * w;
}
export fn sc_closest(p0 real, p1 real, p2 real) i32 {
	var bd = inf();
	var found = false;
	var bt = -1;
	var b0 = 0.0;
	var b1 = 0.0;
	var b2 = 0.0;
	let pa real[3] = [p0, p1, p2];
	STK[0] = 0;
	var sp = 1;
	while sp > 0 {
		sp -= 1;
		let nd int = STK[sp];
		let o = 3 * nd;
		var d = 0.0;
		for k in 0..3 {
			let pk = pa[k];
			let lo = rv(NMIN[o + k]);
			let hi = rv(NMAX[o + k]);
			let q = if pk < lo { lo - pk } else if pk > hi { pk - hi } else { 0.0 };
			d += q * q;
		}
		if d >= bd { continue; }
		let l int = NL[nd];
		if l >= 0 {
			STK[sp] = l as i32;
			STK[sp + 1] = (l + 1) as i32;
			sp += 2;
			continue;
		}
		let tn int = LTN[nd];
		for i in 0..tn {
			let t int = lt_at(nd, i);
			if TH[t] != 0 { continue; }
			cpt(p0, p1, p2, 3 * TRI[3 * t], 3 * TRI[3 * t + 1], 3 * TRI[3 * t + 2]);
			let e = ((Q0 - p0) * (Q0 - p0) + (Q1 - p1) * (Q1 - p1)) + (Q2 - p2) * (Q2 - p2);
			if e < bd {
				bd = e;
				found = true;
				b0 = Q0;
				b1 = Q1;
				b2 = Q2;
				bt = t;
			}
		}
	}
	if !found { return 0; }
