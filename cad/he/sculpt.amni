		let o = 3 * t;
		for k in 0..3 {
			let a int = 3 * TRI[o + k];
			VN[a] = (rv(VN[a]) + rv(TN[o])) as f32;
			VN[a + 1] = (rv(VN[a + 1]) + rv(TN[o + 1])) as f32;
			VN[a + 2] = (rv(VN[a + 2]) + rv(TN[o + 2])) as f32;
		}
	}
	for v in 0..NV {
		let a = 3 * v;
		var l = hyp3(rv(VN[a]), rv(VN[a + 1]), rv(VN[a + 2]));
		if bad(l) { l = 1.0; }
		VN[a] = (rv(VN[a]) / l) as f32;
		VN[a + 1] = (rv(VN[a + 1]) / l) as f32;
		VN[a + 2] = (rv(VN[a + 2]) / l) as f32;
	}
