		n += 1;
		let p int = OO[pv(c)];
		c = if p < 0 { -1 } else { pv(p) };
		if !(c >= 0 && c != c0 && n < 1000) { break; }
	}
	FA = n;
	if c < 0 {
		OPN = 1;
		let p int = OO[nx(c0)];
		c = if p < 0 { -1 } else { nx(p) };
		while c >= 0 && n < 1000 {
			FB[n] = c as i32;
			n += 1;
			let r int = OO[nx(c)];
			c = if r < 0 { -1 } else { nx(r) };
		}
	}
	n
}
fn nbr(v int) int {
	if DYN == 0 {
		let s int = NBO[v];
		let e int = NBO[v + 1];
		for i in s..e {
			if i - s < 1100 { NB[i - s] = NBA[i]; }
		}
		return e - s;
	}
	let n = fan(v);
	var m = 0;
	for i in 0..FA {
		NB[m] = TRI[nx(FB[i])];
		m += 1;
	}
	if OPN == 1 && n > 0 {
		NB[m] = TRI[pv(FB[0])];
		m += 1;
		for i in FA..n {
			NB[m] = TRI[pv(FB[i])];
			m += 1;
		}
	}
	m
}
fn vtris(v int) int {
	if DYN == 0 {
		let s int = VTO[v];
		let e int = VTO[v + 1];
		for i in s..e {
			if i - s < 1100 { TB[i - s] = VT[i]; }
