			e0 = d0;
			e1 = d1;
			e2 = d2;
		} else {
			perp(na0, na1, na2);
			e0 = U0;
			e1 = U1;
			e2 = U2;
		}
		let e = (e0 * na0 + e1 * na1) + e2 * na2;
		t0 = e0 - na0 * e;
		t1 = e1 - na1 * e;
		t2 = e2 - na2 * e;
		if hyp3(t0, t1, t2) > 1e-12 {
			nrm(t0, t1, t2);
		} else {
			perp(na0, na1, na2);
		}
		t0 = U0;
		t1 = U1;
		t2 = U2;
		b0 = na1 * t2 - na2 * t1;
		b1 = na2 * t0 - na0 * t2;
		b2 = na0 * t1 - na1 * t0;
		if sq {
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let x = ((CO[a] - c0) * t0 + (CO[a + 1] - c1) * t1) + (CO[a + 2] - c2) * t2;
				let y = ((CO[a] - c0) * b0 + (CO[a + 1] - c1) * b1) + (CO[a + 2] - c2) * b2;
				let q = (jmax(abs(x), abs(y)) * 1.4142135623730951) / R;
				if q >= 1.0 {
					QW[i] = 0.0;
				} else {
					QW[i] = (fall(fc, 1.0 - q) * (1.0 - rv(MASK[v]))) as f32;
				}
			}
		}
	}
	let k = (((R * S) * 0.5) * sf) * sg;
	tools(tool, n, c0, c1, c2, R, S, na0, na1, na2, ca0, ca1, ca2, b0, b1, b2, hl, l0, l1, l2, sg, k, ang, fsid);
	views();
}
fn tools(tool int, n int, c0 real, c1 real, c2 real, R real, S real, na0 real, na1 real, na2 real, ca0 real, ca1 real, ca2 real, b0 real, b1 real, b2 real, hl int, l0 real, l1 real, l2 real, sg real, k real, ang real, fsid int) {
	match tool {
		0, 1 => {
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]) * k;
				if bad(w) { continue; }
				set(v, CO[a] + na0 * w, CO[a + 1] + na1 * w, CO[a + 2] + na2 * w);
			}
		},
		2 => {
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]) * k;
				if bad(w) { continue; }
				set(v, CO[a] + rv(VN[a]) * w, CO[a + 1] + rv(VN[a + 1]) * w, CO[a + 2] + rv(VN[a + 2]) * w);
			}
		},
		3 => {
			let bx = c0 - (na0 * R) * 0.5;
			let by = c1 - (na1 * R) * 0.5;
			let bz = c2 - (na2 * R) * 0.5;
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]) * k;
				if bad(w) { continue; }
				nrm(CO[a] - bx, CO[a + 1] - by, CO[a + 2] - bz);
				let u0 = U0;
				let u1 = U1;
				let u2 = U2;
				set(v, CO[a] + u0 * w, CO[a + 1] + u1 * w, CO[a + 2] + u2 * w);
			}
		},
		4, 5 => {
			let isc = tool == 4;
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]);
				if bad(w) { continue; }
				let px = c0 - CO[a];
				let py = c1 - CO[a + 1];
				let pz = c2 - CO[a + 2];
				let pd = (px * na0 + py * na1) + pz * na2;
				let f = jmin(1.0, (w * S) * 0.5) * (if isc { 0.5 } else { sg });
				let h = if isc { (-w) * k } else { 0.0 };
				set(v, (CO[a] + (px - na0 * pd) * f) + na0 * h, (CO[a + 1] + (py - na1 * pd) * f) + na1 * h, (CO[a + 2] + (pz - na2 * pd) * f) + na2 * h);
			}
		},
		7, 8, 9, 10, 11 => {
			let off = if tool == 7 { R * 0.25 } else if tool == 8 { R * 0.35 } else { 0.0 };
			let px = ca0 + (na0 * off) * sg;
			let py = ca1 + (na1 * off) * sg;
			let pz = ca2 + (na2 * off) * sg;
			let side = if tool == 10 { -sg } else if tool == 11 { sg } else if tool == 9 { 0.0 } else { -sg };
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]);
				if bad(w) { continue; }
				let d = ((CO[a] - px) * na0 + (CO[a + 1] - py) * na1) + (CO[a + 2] - pz) * na2;
				if side != 0.0 && d * side <= 0.0 { continue; }
				let f = jmin(1.0, (w * S) * 0.5) * (if tool == 9 { sg } else { 1.0 });
				set(v, CO[a] - (na0 * d) * f, CO[a + 1] - (na1 * d) * f, CO[a + 2] - (na2 * d) * f);
			}
		},
		12 => {
			let h = ang / 2.0;
			let cs = sc_cos(h);
			let sn = sc_sin(h) * sg;
			let m0 = na0 * cs + b0 * sn;
			let m1 = na1 * cs + b1 * sn;
			let m2 = na2 * cs + b2 * sn;
			let g0 = na0 * cs - b0 * sn;
			let g1 = na1 * cs - b1 * sn;
			let g2 = na2 * cs - b2 * sn;
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]);
				if bad(w) { continue; }
				let rx = CO[a] - ca0;
				let ry = CO[a + 1] - ca1;
				let rz = CO[a + 2] - ca2;
				var P0 = g0;
				var P1 = g1;
				var P2 = g2;
				if (rx * b0 + ry * b1) + rz * b2 >= 0.0 {
					P0 = m0;
					P1 = m1;
					P2 = m2;
				}
				let d = (rx * P0 + ry * P1) + rz * P2;
				if d * sg <= 0.0 { continue; }
				let f = jmin(1.0, (w * S) * 0.5);
				set(v, CO[a] - (P0 * d) * f, CO[a + 1] - (P1 * d) * f, CO[a + 2] - (P2 * d) * f);
			}
		},
		13 => {
			zr(TMP, 3 * n);
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]);
				let m = nbr(v);
				var x = 0.0;
				var y = 0.0;
				var z = 0.0;
				for j in 0..m {
					let q int = 3 * NB[j];
					x += CO[q];
					y += CO[q + 1];
					z += CO[q + 2];
				}
				let f = if m > 0 { jmin(1.0, w * S) } else { 0.0 };
				let dv = if m > 0 { m as real } else { 1.0 };
				TMP[3 * i] = CO[a] + (x / dv - CO[a]) * f;
				TMP[3 * i + 1] = CO[a + 1] + (y / dv - CO[a + 1]) * f;
				TMP[3 * i + 2] = CO[a + 2] + (z / dv - CO[a + 2]) * f;
			}
			for i in 0..n {
				let v int = QV[i];
				let w = rv(QW[i]);
				if !bad(w) { set(v, TMP[3 * i], TMP[3 * i + 1], TMP[3 * i + 2]); }
			}
		},
		14 => {
			let h = R * 0.25;
			for i in 0..n {
				let v int = QV[i];
				let a = 3 * v;
				let w = rv(QW[i]);
				if bad(w) { continue; }
				let L = jmax(-1.0, jmin(1.0, rv(LAY[v]) + ((w * S) * 0.3) * sg));
				LAY[v] = L as f32;
				set(v, ORIG[a] + (rv(ON[a]) * L) * h, ORIG[a + 1] + (rv(ON[a + 1]) * L) * h, ORIG[a + 2] + (rv(ON[a + 2]) * L) * h);
			}
		},
		15 => {
			if hl == 1 {
				nrm(l0, l1, l2);
				let u0 = U0;
				let u1 = U1;
				let u2 = U2;
				for i in 0..n {
					let v int = QV[i];
					let a = 3 * v;
					let w = rv(QW[i]) * jmin(1.0, S);
					if bad(w) { continue; }
					let px = c0 - CO[a];
					let py = c1 - CO[a + 1];
					let pz = c2 - CO[a + 2];
					let pd = (px * u0 + py * u1) + pz * u2;
					set(v, (CO[a] + l0 * w) + ((px - u0 * pd) * w) * 0.3, (CO[a + 1] + l1 * w) + ((py - u1 * pd) * w) * 0.3, (CO[a + 2] + l2 * w) + ((pz - u2 * pd) * w) * 0.3);
				}
			}
		},
		17, 18 => {
			if hl == 1 {
				let e = (l0 * na0 + l1 * na1) + l2 * na2;
				let tx = l0 - na0 * e;
				let ty = l1 - na1 * e;
				let tz = l2 - na2 * e;
				for i in 0..n {
					let v int = QV[i];
					let a = 3 * v;
					let w = rv(QW[i]) * S;
					if bad(w) { continue; }
					let d = if tool == 18 { (((CO[a] - ca0) * na0 + (CO[a + 1] - ca1) * na1) + (CO[a + 2] - ca2) * na2) * jmin(1.0, w * 0.3) } else { 0.0 };
					set(v, (CO[a] + tx * w) - na0 * d, (CO[a + 1] + ty * w) - na1 * d, (CO[a + 2] + tz * w) - na2 * d);
				}
			}
		},
		19 => {
			for i in 0..n {
				let v int = QV[i];
				let w = jmin(1.0, rv(QW[i]) * S);
				if bad(w) { continue; }
				let m = rv(MASK[v]);
				let dm = if sg > 0.0 { 1.0 - m } else { -m };
				MASK[v] = jmax(0.0, jmin(1.0, m + dm * w)) as f32;
				maskV(v);
			}
		},
		20 => {
			zr(TMP, n);
			for i in 0..n {
				let v int = QV[i];
				let w = rv(QW[i]);
				let m = nbr(v);
				var x = 0.0;
				for j in 0..m {
					let nb int = NB[j];
					x += rv(MASK[nb]);
				}
				let mv = rv(MASK[v]);
				TMP[i] = if m > 0 { mv + (x / (m as real) - mv) * jmin(1.0, w * S) } else { mv };
			}
			for i in 0..n {
				let v int = QV[i];
				MASK[v] = TMP[i] as f32;
				maskV(v);
			}
		},
		21 => {
			for i in 0..n {
				let v int = QV[i];
				if rv(QD[i]) > R * 0.7 { continue; }
				let m = vtris(v);
				WL.clear();
				for j in 0..m { pi(WL, TB[j]); }
				for x in WL { setFS(x, fsid); }
			}
		},
		_ => {},
	}
}
fn edgeOk(e int, a int, b int) bool {
	TDEAD[e / 3] == 0 && TRI[nx(e)] == a && TRI[pv(e)] == b
}
fn triQ(a int, b int, d int) real {
	let A = 3 * a;
	let B = 3 * b;
	let D = 3 * d;
	let u0 = CO[B] - CO[A];
	let u1 = CO[B + 1] - CO[A + 1];
	let u2 = CO[B + 2] - CO[A + 2];
	let w0 = CO[D] - CO[A];
	let w1 = CO[D + 1] - CO[A + 1];
	let w2 = CO[D + 2] - CO[A + 2];
	let x0 = CO[D] - CO[B];
	let x1 = CO[D + 1] - CO[B + 1];
	let x2 = CO[D + 2] - CO[B + 2];
	let du = (u0 * u0 + u1 * u1) + u2 * u2;
	let dw = (w0 * w0 + w1 * w1) + w2 * w2;
	let dx = (x0 * x0 + x1 * x1) + x2 * x2;
	let L = (du + dw) + dx;
	if L > 0.0 {
		return ((2.0 * c_sqrt(3.0)) * hyp3(u1 * w2 - u2 * w1, u2 * w0 - u0 * w2, u0 * w1 - u1 * w0)) / L;
	}
	0.0
}
fn nn(x int, y int, z int) {
	let p = 3 * x;
	let q = 3 * y;
	let r = 3 * z;
	let e0 = CO[q] - CO[p];
	let e1 = CO[q + 1] - CO[p + 1];
	let e2 = CO[q + 2] - CO[p + 2];
	let f0 = CO[r] - CO[p];
	let f1 = CO[r + 1] - CO[p + 1];
	let f2 = CO[r + 2] - CO[p + 2];
	U0 = e1 * f2 - e2 * f1;
	U1 = e2 * f0 - e0 * f2;
	U2 = e0 * f1 - e1 * f0;
}
fn crs9(p real[9]) {
	let e0 = p[3] - p[0];
	let e1 = p[4] - p[1];
	let e2 = p[5] - p[2];
	let f0 = p[6] - p[0];
	let f1 = p[7] - p[1];
	let f2 = p[8] - p[2];
	U0 = e1 * f2 - e2 * f1;
	U1 = e2 * f0 - e0 * f2;
	U2 = e0 * f1 - e1 * f0;
}
fn ftg(x int) int {
	if VLOCK[x] != 0 { 4 } else { 6 }
}
fn fdev(n int, x int) int { abs(n - ftg(x)) }
fn flipE(c int, qm bool) bool {
	let o int = OO[c];
	if o < 0 { return false; }
	let c1 = nx(c);
	let c2 = pv(c);
	let o1 = nx(o);
	let o2 = pv(o);
	let a int = TRI[c];
	let b int = TRI[c1];
	let d int = TRI[c2];
	let e int = TRI[o];
	if a == e { return false; }
	if VLOCK[b] != 0 && VLOCK[d] != 0 { return false; }
	let va = nbr(a);
	for i in 0..va {
		if NB[i] == e { return false; }
	}
	let vb = nbr(b);
	let vd = nbr(d);
	let ve = nbr(e);
	if vb <= 3 || vd <= 3 { return false; }
	if qm {
		if jmin(triQ(a, b, e), triQ(e, d, a)) <= 1.2 * jmin(triQ(a, b, d), triQ(e, d, b)) { return false; }
	} else {
		let before = ((fdev(va, a) + fdev(ve, e)) + fdev(vb, b)) + fdev(vd, d);
		let after = ((fdev(va + 1, a) + fdev(ve + 1, e)) + fdev(vb - 1, b)) + fdev(vd - 1, d);
		if after >= before { return false; }
	}
	nn(a, b, d);
	let n00 = U0;
	let n01 = U1;
	let n02 = U2;
	nn(e, d, b);
	let m0 = n00 + U0;
	let m1 = n01 + U1;
	let m2 = n02 + U2;
	nn(a, b, e);
	let p00 = U0;
	let p01 = U1;
	let p02 = U2;
	nn(e, d, a);
	let p10 = U0;
	let p11 = U1;
	let p12 = U2;
	let lm = hyp3(m0, m1, m2);
	if lm < 1e-30 { return false; }
	if dot6(p00, p01, p02, m0, m1, m2) <= (0.3 * hyp3(p00, p01, p02)) * lm { return false; }
	if dot6(p10, p11, p12, m0, m1, m2) <= (0.3 * hyp3(p10, p11, p12)) * lm { return false; }
	let X2 int = OO[c1];
	let Y2 int = OO[o1];
	TRI[c2] = e as i32;
	TRI[o2] = a as i32;
	OO[c] = Y2 as i32;
	if Y2 >= 0 { OO[Y2] = c as i32; }
	OO[o] = X2 as i32;
	if X2 >= 0 { OO[X2] = o as i32; }
	OO[c1] = o1 as i32;
	OO[o1] = c1 as i32;
	VC[d] = o1 as i32;
	VC[b] = c1 as i32;
	chgT(c / 3);
	chgT(o / 3);
	for v in [a, b, d, e] {
		if DS[v] != DQ {
			DS[v] = DQ as i32;
			pi(MV, v);
		}
	}
	true
}
fn splitE(c int) int {
	let o int = OO[c];
	let t0 = c / 3;
	let t1 = if o >= 0 { o / 3 } else { -1 };
	let a0 int = TRI[c];
	let b int = TRI[nx(c)];
	let d int = TRI[pv(c)];
	let m = addV(b);
	let t2 = addT(t0);
	let t3 = if t1 >= 0 { addT(t1) } else { -1 };
	let c1 = nx(c);
	let c2 = pv(c);
	let k0 = 3 * t2;
	let k1 = k0 + 1;
	let k2 = k0 + 2;
	TRI[c2] = m as i32;
	TRI[k0] = a0 as i32;
	TRI[k1] = m as i32;
	TRI[k2] = d as i32;
	let x int = OO[c1];
	OO[k1] = x as i32;
	if x >= 0 { OO[x] = k1 as i32; }
	OO[c1] = k2 as i32;
	OO[k2] = c1 as i32;
	if o >= 0 {
		let o1 = nx(o);
		let o2 = pv(o);
		let e int = TRI[o];
		let j0 = 3 * t3;
		let j1 = j0 + 1;
		let j2 = j0 + 2;
		TRI[o1] = m as i32;
		TRI[j0] = e as i32;
		TRI[j1] = d as i32;
		TRI[j2] = m as i32;
		let y int = OO[o2];
		OO[j2] = y as i32;
		if y >= 0 { OO[y] = j2 as i32; }
		OO[o2] = j1 as i32;
		OO[j1] = o2 as i32;
		OO[k0] = j0 as i32;
		OO[j0] = k0 as i32;
		chgT(t1);
	} else {
		OO[k0] = -1;
	}
	VC[m] = c2 as i32;
	VC[d] = k2 as i32;
	chgT(t0);
	let bb = 3 * b;
	let dd = 3 * d;
	MASK[m] = ((rv(MASK[b]) + rv(MASK[d])) / 2.0) as f32;
	sc_vmid(m as i32, b as i32, d as i32);
	set(m, (CO[bb] + CO[dd]) / 2.0, (CO[bb + 1] + CO[dd + 1]) / 2.0, (CO[bb + 2] + CO[dd + 2]) / 2.0);
	ownV(m, TLEAF[t0]);
	colV(m);
	m
}
fn collapseE(c int) bool {
	let o int = OO[c];
	if o < 0 { return false; }
	let t0 = c / 3;
	let t1 = o / 3;
	let a int = TRI[c];
	let b int = TRI[nx(c)];
	let d int = TRI[pv(c)];
	let e int = TRI[o];
	if a == e || VLOCK[b] != 0 || VLOCK[d] != 0 || VH[b] != 0 || VH[d] != 0 { return false; }
	RB.clear();
	let nbb = nbr(b);
	for i in 0..nbb { pi(RB, NB[i]); }
	RD.clear();
	let nbd = nbr(d);
	for i in 0..nbd { pi(RD, NB[i]); }
	var sh = 0;
	for x in RB {
		for y in RD {
			if y == x {
				sh += 1;
				break;
			}
		}
	}
	if sh != 2 || nbr(a) <= 3 || nbr(e) <= 3 { return false; }
	let X1 int = OO[pv(c)];
	let X2 int = OO[nx(c)];
	let Y1 int = OO[pv(o)];
	let Y2 int = OO[nx(o)];
	if X1 < 0 || X2 < 0 || Y1 < 0 || Y2 < 0 { return false; }
	let B = 3 * b;
	let D = 3 * d;
	let P0 = (CO[B] + CO[D]) / 2.0;
	let P1 = (CO[B + 1] + CO[D + 1]) / 2.0;
	let P2 = (CO[B + 2] + CO[D + 2]) / 2.0;
	let pp real[3] = [P0, P1, P2];
	FBA.clear();
	let nfb = fan(b);
	for i in 0..nfb { pi(FBA, FB[i]); }
	FDA.clear();
	let nfd = fan(d);
	for i in 0..nfd { pi(FDA, FB[i]); }
	fn chk(k int) bool {
		let t = k / 3;
		if t == t0 || t == t1 { return true; }
		var qa real[9] = [0.0; 9];
		var ra real[9] = [0.0; 9];
		for kk in 0..3 {
			let vv int = TRI[3 * t + kk];
			for ax in 0..3 {
				ra[3 * kk + ax] = CO[3 * vv + ax];
				if vv == b || vv == d {
					qa[3 * kk + ax] = pp[ax];
				} else {
					qa[3 * kk + ax] = CO[3 * vv + ax];
				}
			}
		}
		crs9(qa);
		let n10 = U0;
		let n11 = U1;
		let n12 = U2;
		crs9(ra);
		let n00 = U0;
		let n01 = U1;
		let n02 = U2;
		let l1 = hyp3(n10, n11, n12);
		let l0 = hyp3(n00, n01, n02);
		if l1 < 1e-30 || dot6(n00, n01, n02, n10, n11, n12) <= (0.2 * l0) * l1 { return false; }
		true
	}
	for x in FBA {
		let k int = x;
		if !chk(k) { return false; }
	}
	for x in FDA {
		let k int = x;
		if !chk(k) { return false; }
	}
	OO[X1] = X2 as i32;
	OO[X2] = X1 as i32;
	OO[Y1] = Y2 as i32;
	OO[Y2] = Y1 as i32;
	for x in FDA {
		let k int = x;
		let t = k / 3;
		if t != t0 && t != t1 {
			TRI[k] = b as i32;
			chgT(t);
		}
	}
	VC[b] = nx(X1) as i32;
	VC[a] = pv(X1) as i32;
	VC[e] = nx(Y2) as i32;
	for t in [t0, t1] {
		TDEAD[t] = 1;
		rmT(t);
		chgT(t);
	}
	VDEAD[d] = 1;
	rmV(d);
	VC[d] = -1;
	VH[d] = 1;
	MASK[b] = ((rv(MASK[b]) + rv(MASK[d])) / 2.0) as f32;
	sc_vmid(b as i32, b as i32, d as i32);
	set(b, P0, P1, P2);
	colV(b);
	true
}
fn relax(c0 real, c1 real, c2 real, R real) {
	let R2 = R * R;
	WL.clear();
	for i in 0..MV.len {
		let v int = MV[i];
		if VDEAD[v] != 0 || VLOCK[v] != 0 || VH[v] != 0 { continue; }
		if ((CO[3 * v] - c0) * (CO[3 * v] - c0) + (CO[3 * v + 1] - c1) * (CO[3 * v + 1] - c1)) + (CO[3 * v + 2] - c2) * (CO[3 * v + 2] - c2) <= R2 { pi(WL, v); }
	}
	for wx in WL {
		let v int = wx;
		let m = nbr(v);
		if m < 3 { continue; }
		var x = 0.0;
		var y = 0.0;
		var z = 0.0;
		for j in 0..m {
			let q int = 3 * NB[j];
			x += CO[q];
			y += CO[q + 1];
			z += CO[q + 2];
		}
		let a = 3 * v;
		x = x / (m as real) - CO[a];
		y = y / (m as real) - CO[a + 1];
		z = z / (m as real) - CO[a + 2];
		let dd = (x * rv(VN[a]) + y * rv(VN[a + 1])) + z * rv(VN[a + 2]);
		let q0 = CO[a] + (x - rv(VN[a]) * dd) * 0.5;
		let q1 = CO[a + 1] + (y - rv(VN[a + 1]) * dd) * 0.5;
		let q2 = CO[a + 2] + (z - rv(VN[a + 2]) * dd) * 0.5;
		let qs real[3] = [q0, q1, q2];
		let k = vtris(v);
		var ok = true;
		for j in 0..k {
			if !ok { break; }
			let t int = TB[j];
			var r0 real[9] = [0.0; 9];
			var r1 real[9] = [0.0; 9];
			for kk in 0..3 {
				let vv int = TRI[3 * t + kk];
				for ax in 0..3 {
					r0[3 * kk + ax] = CO[3 * vv + ax];
					r1[3 * kk + ax] = CO[3 * vv + ax];
					if vv == v {
						r0[3 * kk + ax] = CO[a + ax];
						r1[3 * kk + ax] = qs[ax];
					}
				}
			}
			crs9(r1);
			let n10 = U0;
			let n11 = U1;
			let n12 = U2;
			crs9(r0);
			let n00 = U0;
			let n01 = U1;
			let n02 = U2;
			let l0 = hyp3(n00, n01, n02);
			let l1 = hyp3(n10, n11, n12);
			ok = l1 > 1e-30 && dot6(n00, n01, n02, n10, n11, n12) > (0.5 * l0) * l1 && (n10 * rv(VN[a]) + n11 * rv(VN[a + 1])) + n12 * rv(VN[a + 2]) > 0.5 * l1;
		}
		if ok { set(v, q0, q1, q2); }
	}
}
fn cr(i int) real {
	if STL == 0 { return CO[i]; }
	if i < SNP.len { SNP[i] } else { nan() }
}
fn elen(a int, b int) real {
	hyp3(cr(3 * a) - cr(3 * b), cr(3 * a + 1) - cr(3 * b + 1), cr(3 * a + 2) - cr(3 * b + 2))
}
fn edges(t int) {
	for k in 0..3 {
		let e = 3 * t + k;
		let o int = OO[e];
		if o >= 0 && o < e { continue; }
		let a int = TRI[nx(e)];
		let b int = TRI[pv(e)];
		pi(EE, e);
		pi(EE, a);
		pi(EE, b);
		pf(EL, elen(a, b));
	}
}
export fn sc_topo(c0 real, c1 real, c2 real, R real, L real, simp i32, budget i32) i32 {
	if DYN == 0 || !(L > 0.0) {
		views();
		return 0;
	}
	let n = range(c0, c1, c2, R);
	if n == 0 {
		views();
		return 0;
	}
	TOP = 1;
	STL = 0;
	let n0 = MV.len;
	QID += 1;
	let s = QID;
	EE.clear();
	EL.clear();
	let bud int = budget;
	let hi = L;
	let lo = L * (if simp != 0 { 0.8 } else { 0.4 });
	let R2 = (R * R) * 1.44;
	fn inR(a int, b int) bool {
		let x = (cr(3 * a) + cr(3 * b)) / 2.0 - c0;
		let y = (cr(3 * a + 1) + cr(3 * b + 1)) / 2.0 - c1;
		let z = (cr(3 * a + 2) + cr(3 * b + 2)) / 2.0 - c2;
		((x * x + y * y) + z * z) <= R2
	}
	VS.clear();
	for i in 0..n { pi(VS, QV[i]); }
	for x in VS {
		let v int = x;
		let m = vtris(v);
		for j in 0..m {
			let t int = TB[j];
			if TQ[t] != s {
				TQ[t] = s as i32;
				edges(t);
			}
		}
	}
	var ops = 0;
	if simp == 0 {
		QL.clear();
		for i in 0..EL.len {
			if EL[i] > hi { pi(QL, i); }
		}
		stable_sort(QL) { a, b => EL[a] > EL[b] };
		var ps = 0;
		while QL.len > 0 && ps < 7 && ops < bud {
			let ne = EL.len;
			for x in QL {
				if ops >= bud { break; }
				let i int = x;
				let e int = EE[3 * i];
				let a int = EE[3 * i + 1];
				let b int = EE[3 * i + 2];
				if !(edgeOk(e, a, b) && OO[e] >= 0 && elen(a, b) > hi && inR(a, b)) { continue; }
				let m = splitE(e);
				ops += 1;
				let k = vtris(m);
				WL.clear();
				for j in 0..k { pi(WL, TB[j]); }
				for y in WL { edges(y); }
			}
			QL.clear();
			for i in ne..EL.len {
				if EL[i] > hi { pi(QL, i); }
			}
			stable_sort(QL) { a, b => EL[a] > EL[b] };
			ps += 1;
		}
	}
	QL.clear();
	for i in 0..EL.len {
		if EL[i] < lo { pi(QL, i); }
	}
	stable_sort(QL) { a, b => EL[a] < EL[b] };
	for x in QL {
		if ops >= bud { break; }
		let i int = x;
		let e int = EE[3 * i];
		let a int = EE[3 * i + 1];
		let b int = EE[3 * i + 2];
		if !(edgeOk(e, a, b) && elen(a, b) < lo && inR(a, b)) { continue; }
		if collapseE(e) { ops += 1; }
	}
	for ps in 0..2 {
		QID += 1;
		let s2 = QID;
		FL.clear();
		let tn = MV.len;
		for i in 0..tn {
			let v int = MV[i];
			if VDEAD[v] != 0 { continue; }
			let m = vtris(v);
			let top = i >= n0;
			for j in 0..m {
				let t int = TB[j];
				if TQ[t] == s2 { continue; }
				TQ[t] = s2 as i32;
				let q = triQ(TRI[3 * t], TRI[3 * t + 1], TRI[3 * t + 2]);
				if q < 0.4 {
					var bk = 0;
					var bl = -1.0;
					for kk in 0..3 {
						let l = elen(TRI[3 * t + (kk + 1) % 3], TRI[3 * t + (kk + 2) % 3]);
						if l > bl {
							bl = l;
							bk = kk;
						}
					}
					pi(FL, 3 * t + bk);
					pi(FL, TRI[3 * t + (bk + 1) % 3]);
					pi(FL, TRI[3 * t + (bk + 2) % 3]);
					pi(FL, 1);
				}
				if top {
					for kk in 0..3 {
						let e = 3 * t + kk;
						let o int = OO[e];
						if o > e {
							pi(FL, e);
							pi(FL, TRI[nx(e)]);
							pi(FL, TRI[pv(e)]);
							pi(FL, 0);
						}
					}
				}
			}
		}
		var f = 0;
		let cnt = FL.len / 4;
		for r in 0..cnt {
			let e int = FL[4 * r];
			let a int = FL[4 * r + 1];
			let b int = FL[4 * r + 2];
			let q int = FL[4 * r + 3];
			if edgeOk(e, a, b) && flipE(e, q == 1) { f += 1; }
		}
		if f == 0 { break; }
	}
	if ops > 0 { relax(c0, c1, c2, R); }
	TOP = 0;
	STL = 0;
	SNP.clear();
	views();
	ops as i32
}
fn moveT(s int, d int) {
	for k in 0..3 {
		let cs = 3 * s + k;
		let cd = 3 * d + k;
		let v int = TRI[cs];
		let o int = OO[cs];
		TRI[cd] = v as i32;
		OO[cd] = o as i32;
		if o >= 0 { OO[o] = cd as i32; }
		if VC[v] == cs { VC[v] = cd as i32; }
		TN[cd] = TN[cs];
	}
	TF[d] = TF[s];
	TSET[d] = TSET[s];
	TH[d] = TH[s];
	TDEAD[d] = 0;
	TDEAD[s] = 1;
	sc_fcp(d as i32, s as i32);
	let lf int = TLEAF[s];
	let i int = TPOS[s];
	if lf >= 0 {
		lt_set(lf, i, d);
		TPOS[d] = i as i32;
	}
	TLEAF[d] = lf as i32;
	TLEAF[s] = -1;
	chgT(d);
}
fn moveV(s int, d int) {
	let n = fan(s);
	for i in 0..n {
		let cc int = FB[i];
		TRI[cc] = d as i32;
		chgT(cc / 3);
	}
	for k in 0..3 {
		CO[3 * d + k] = CO[3 * s + k];
		POS[3 * d + k] = POS[3 * s + k];
		VN[3 * d + k] = VN[3 * s + k];
		COL[3 * d + k] = COL[3 * s + k];
	}
	MASK[d] = MASK[s];
	VH[d] = VH[s];
	VLOCK[d] = VLOCK[s];
	VC[d] = VC[s];
	sc_vcp(d as i32, s as i32);
	let lf int = VLEAF[s];
	if lf >= 0 {
		let i int = VPOS[s];
		lv_set(lf, i, d);
		VPOS[d] = i as i32;
	}
	VLEAF[d] = lf as i32;
	VLEAF[s] = -1;
	VDEAD[d] = 0;
	VDEAD[s] = 1;
	VC[s] = -1;
	chgV(d);
}
export fn sc_compact() {
	if DYN == 1 {
		var t = NT - 1;
		while t >= 0 {
			if TDEAD[t] != 0 {
				let l = NT - 1;
				if l != t { moveT(l, t); }
				TDEAD[l] = 0;
				NT -= 1;
			}
			t -= 1;
		}
		var v = NV - 1;
		while v >= 0 {
			if VDEAD[v] != 0 {
				let l = NV - 1;
				if l != v { moveV(l, v); }
				VDEAD[l] = 0;
				NV -= 1;
			}
			v -= 1;
		}
	}
	views();
}
export fn sc_buildO() {
	let nt = NT;
	let nv = NV;
	var cnt i32[>..] = [];
	cnt.reserve(nv + 1);
	cnt.resize(nv + 1, 0);
	for c in 0..(3 * nt) {
		let x int = TRI[c];
		cnt[x + 1] += 1;
	}
	for v in 0..nv { cnt[v + 1] += cnt[v]; }
	var L i32[>..] = [];
	L.reserve(3 * nt);
	L.resize(3 * nt, 0);
	var q i32[>..] = [];
	q.reserve(nv);
	q.append(cnt[0..nv]);
	for c in 0..(3 * nt) {
		let x int = TRI[c];
		let p int = q[x];
		L[p] = c as i32;
		q[x] += 1;
	}
	for c in 0..(3 * nt) { OO[c] = -1; }
	for c in 0..(3 * nt) {
		let u int = TRI[nx(c)];
		let w int = TRI[pv(c)];
		var hit = -1;
		var k = 0;
		var s = 0;
		let ws int = cnt[w];
		let we int = cnt[w + 1];
		for i in ws..we {
			let dd int = L[i];
			if TRI[nx(dd)] == u {
				hit = pv(dd);
				k += 1;
			}
		}
		let us int = cnt[u];
		let ue int = cnt[u + 1];
		for i in us..ue {
			let ll int = L[i];
			if TRI[nx(ll)] == w { s += 1; }
		}
		if k == 1 && s == 1 { OO[c] = hit as i32; }
	}
	var vis u8[>..] = [];
	vis.reserve(3 * nt);
	vis.resize(3 * nt, 0);
	for v in 0..nv {
		var g = 0;
		let s0 int = cnt[v];
		let e0 int = cnt[v + 1];
		for i in s0..e0 {
			let c0 int = L[i];
			if vis[c0] != 0 { continue; }
			let uu = if g == 0 { v } else { addV(v) };
			g += 1;
			WL.clear();
			var c = c0;
			var open = false;
			loop {
				vis[c] = 1;
				pi(WL, c);
				let p int = OO[pv(c)];
				c = if p < 0 { -1 } else { pv(p) };
				if !(c >= 0 && vis[c] == 0) { break; }
			}
			if c < 0 {
				open = true;
				let p int = OO[nx(c0)];
				c = if p < 0 { -1 } else { nx(p) };
				while c >= 0 && vis[c] == 0 {
					vis[c] = 1;
					pi(WL, c);
					let r int = OO[nx(c)];
					c = if r < 0 { -1 } else { nx(r) };
				}
			}
			for x in WL {
				let k int = x;
				TRI[k] = uu as i32;
			}
			VC[uu] = c0 as i32;
			VLOCK[uu] = if open { 1 } else { 0 };
		}
		if g == 0 { VLOCK[v] = 1; }
	}
	CAV = 1;
	CAT = 1;
	views();
}
export fn sc_check() i32 {
	CHK.clear();
	if DYN == 0 { return 0; }
	fn msg(k int, x int, y int) {
		pi(CHK, k);
		pi(CHK, x);
		pi(CHK, y);
	}
	var c = 0;
	while c < 3 * NT && CHK.len / 3 < 20 {
		let t = c / 3;
		if TDEAD[t] != 0 {
			msg(1, t, 0);
			c += 1;
			continue;
		}
		let o int = OO[c];
		if o >= 0 && (OO[o] != c || TRI[nx(o)] != TRI[pv(c)] || TRI[pv(o)] != TRI[nx(c)]) { msg(2, c, 0); }
		let x int = TRI[c];
		if x < 0 || x >= NV || VDEAD[x] != 0 { msg(3, c, 0); }
		c += 1;
	}
	var v = 0;
	while v < NV && CHK.len / 3 < 20 {
		if VDEAD[v] != 0 {
			msg(4, v, 0);
			v += 1;
			continue;
		}
		let cc int = VC[v];
		if cc >= 0 && TRI[cc] != v { msg(5, v, 0); }
		v += 1;
	}
	var lt = 0;
	for nd in 0..NN {
		if NL[nd] < 0 && LTC[nd] >= 0 { lt += LTN[nd]; }
	}
	if lt != NT { msg(7, lt, NT); }
	views();
	(CHK.len / 3) as i32
}
