extern fn c_sqrt(x real) real = "sqrt";
extern fn c_ceil(x real) real = "ceil";
fn bad(x real) bool { x == 0.0 || x != x }
fn inf() real { var z = 0.0; 1.0 / z }
fn nan() real { var z = 0.0; z / z }
fn jmin(a real, b real) real {
	if a != a || b != b { return a + b; }
	if a == b {
		if 1.0 / a < 0.0 { return a; }
		return b;
	}
	if a < b { a } else { b }
}
fn jmax(a real, b real) real {
	if a != a || b != b { return a + b; }
	if a == b {
		if 1.0 / a < 0.0 { return b; }
		return a;
	}
	if a > b { a } else { b }
}
fn hyp3(a real, b real, c real) real {
	var mx = 0.0;
	if a == a && abs(a) > mx { mx = abs(a); }
	if b == b && abs(b) > mx { mx = abs(b); }
	if c == c && abs(c) > mx { mx = abs(c); }
	if mx > 1.7976931348623157e308 { return mx; }
	if a != a || b != b || c != c { return a + b + c; }
	if mx == 0.0 { return 0.0; }
	var sum = 0.0;
	var comp = 0.0;
	for v in [abs(a), abs(b), abs(c)] {
		let nv = v / mx;
		let su = nv * nv - comp;
		let pre = sum + su;
		comp = (pre - sum) - su;
		sum = pre;
	}
	c_sqrt(sum) * mx
}
fn nx(c int) int { if c % 3 == 2 { c - 2 } else { c + 1 } }
fn pv(c int) int { if c % 3 == 0 { c + 2 } else { c - 1 } }
fn nrm(a real, b real, c real) {
	var l = hyp3(a, b, c);
	if bad(l) { l = 1.0; }
	U0 = a / l;
	U1 = b / l;
	U2 = c / l;
}
fn perp(n0 real, n1 real, n2 real) {
	var e0 = 0.0;
	var e1 = 0.0;
	var e2 = 0.0;
	if abs(n0) < 0.9 { e0 = 1.0; } else { e1 = 1.0; }
	let x = n1 * e2 - n2 * e1;
	let y = n2 * e0 - n0 * e2;
	let z = n0 * e1 - n1 * e0;
	nrm(x, y, z);
}
fn dot6(a0 real, a1 real, a2 real, b0 real, b1 real, b2 real) real { (a0 * b0 + a1 * b1) + a2 * b2 }
fn gw(xs real[>..]&, m int) {
	if m > xs.cap {
		SF.clear();
		SF.reserve(xs.len);
		SF.append(xs);
		xs.clear();
		xs.reserve((m + m / 2) + 64);
		xs.append(SF);
		SF.clear();
	}
	if m > xs.len { xs.resize(m, 0.0); }
}
