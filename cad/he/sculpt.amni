		ca0 = cx / sw;
		ca1 = cy / sw;
		ca2 = cz / sw;
	}
	var t0 = 0.0;
	var t1 = 0.0;
	var t2 = 0.0;
	var b0 = 0.0;
	var b1 = 0.0;
	var b2 = 0.0;
	if sq || tool == 12 {
		var e0 = 0.0;
		var e1 = 0.0;
		var e2 = 0.0;
