		let n0 = if ua { rv(ON[a]) } else { rv(VN[a]) };
		let n1 = if ua { rv(ON[a + 1]) } else { rv(VN[a + 1]) };
		let n2 = if ua { rv(ON[a + 2]) } else { rv(VN[a + 2]) };
		ax += n0 * f;
		ay += n1 * f;
		az += n2 * f;
		cx += CO[a] * f;
		cy += CO[a + 1] * f;
		cz += CO[a + 2] * f;
		sw += f;
