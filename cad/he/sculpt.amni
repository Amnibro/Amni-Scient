fn triN(t int) {
	let a int = 3 * TRI[3 * t];
	let b int = 3 * TRI[3 * t + 1];
	let c int = 3 * TRI[3 * t + 2];
	let ux = CO[b] - CO[a];
	let uy = CO[b + 1] - CO[a + 1];
	let uz = CO[b + 2] - CO[a + 2];
	let wx = CO[c] - CO[a];
	let wy = CO[c + 1] - CO[a + 1];
	let wz = CO[c + 2] - CO[a + 2];
	let o = 3 * t;
	TN[o] = (uy * wz - uz * wy) as f32;
	TN[o + 1] = (uz * wx - ux * wz) as f32;
	TN[o + 2] = (ux * wy - uy * wx) as f32;
}
fn vertN(v int) {
	let n = vtris(v);
	var x = 0.0;
	var y = 0.0;
	var z = 0.0;
	for i in 0..n {
		let o int = 3 * TB[i];
		x += rv(TN[o]);
		y += rv(TN[o + 1]);
		z += rv(TN[o + 2]);
	}
	var l = hyp3(x, y, z);
	if bad(l) { l = 1.0; }
	let a = 3 * v;
	VN[a] = (x / l) as f32;
	VN[a + 1] = (y / l) as f32;
	VN[a + 2] = (z / l) as f32;
}
export fn sc_normAll() {
	for i in 0..(3 * NV) { VN[i] = 0.0; }
	for t in 0..NT {
		if DYN == 1 && TDEAD[t] != 0 { continue; }
