}
fn fall(code int, x real) real {
	match code {
		1 => c_sqrt(jmax(0.0, 2.0 * x - x * x)),
		2 => c_sqrt(x),
		3 => x * (2.0 - x),
		4 => x * x,
		5 => x,
		7 => 1.0,
		8 => x * sc_rand(),
		9 => ((x * x) * x) * (x * (x * 6.0 - 15.0) + 10.0),
		_ => (x * x) * (3.0 - 2.0 * x),
	}
}
export fn sc_one(tool i32, c0 real, c1 real, c2 real, R real, S real, w0 real, w1 real, w2 real, hd i32, d0 real, d1 real, d2 real, hl i32, l0 real, l1 real, l2 real, fc i32, inv i32, sf real, ang real, front i32, auto i32, fsid i32) {
	let sq = tool == 8;
	let rr = if sq { R * 1.4142135623730951 } else { R };
	let n = pick(c0, c1, c2, rr, w0, w1, w2, front, auto);
	if n == 0 {
		views();
		return;
	}
	let ua = tool == 1;
	let sg = if inv != 0 { -1.0 } else { 1.0 };
	let mk = tool == 19 || tool == 20;
	var ax = 0.0;
	var ay = 0.0;
	var az = 0.0;
	var cx = 0.0;
	var cy = 0.0;
	var cz = 0.0;
	var sw = 0.0;
