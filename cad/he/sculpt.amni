}
fn pick(c0 real, c1 real, c2 real, r real, w0 real, w1 real, w2 real, front int, auto int) int {
	var n = range(c0, c1, c2, r);
	if front != 0 {
		var m = 0;
		for i in 0..n {
			let a int = 3 * QV[i];
			if (rv(VN[a]) * w0 + rv(VN[a + 1]) * w1) + rv(VN[a + 2]) * w2 < 0.05 {
				QV[m] = QV[i];
				QD[m] = QD[i];
				m += 1;
			}
		}
		n = m;
