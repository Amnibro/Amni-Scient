		COL[a + 1] = (m * (0.45 + 0.55 * ((((h >> 8) & 255) as real) / 255.0))) as f32;
		COL[a + 2] = (m * (0.45 + 0.55 * ((((h >> 16) & 255) as real) / 255.0))) as f32;
	} else {
