	let al = hyp3(ax, ay, az);
	var na0 = 0.0;
	var na1 = 0.0;
	var na2 = 0.0;
	if al > 1e-12 {
		na0 = ax / al;
		na1 = ay / al;
		na2 = az / al;
	} else {
