}
fn pi(xs i32[>..]&, x int) {
	if xs.len >= xs.cap { cw(xs, 2 * xs.len + 64); }
	xs.push(x as i32);
}
fn pf(xs real[>..]&, x real) {
	if xs.len >= xs.cap { cw(xs, 2 * xs.len + 64); }
	xs.push(x);
}
