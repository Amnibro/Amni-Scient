}
fn hold(q i32, mx real) int {
    var qq int = q as int;
    var tq int = TOP[qq] as int;
    var pq int = CP[qq] as int;
    var r int = tq;
    while (r < qq) {
        KV[pq + r - tq] = 0.0;
        GV[pq + r - tq] = 0.0;
        r += 1;
    }
    var c int = qq + 1;
    while (c < NQ) {
        var tc int = TOP[c] as int;
        if (tc <= qq) {
            var at int = (CP[c] as int) + qq - tc;
            KV[at] = 0.0;
            GV[at] = 0.0;
        }
        c += 1;
    }
    KV[pq + qq - tq] = mx;
    GV[pq + qq - tq] = 0.0;
    FV[qq] = 0.0;
    return 0;
}
fn fix() int {
    var mx real = 0.000000000000000000000000000001;
    var q int = 0;
    while (q < NQ) {
        mx = rmax(mx, KV[(CP[q] as int) + q - (TOP[q] as int)]);
        q += 1;
    }
    var j int = 0;
    while (j < NJ) {
        var k int = 0;
        while (k < 6) {
            if ((SU[6 * j + k] as int) == 1) {
                hold((6 * (POS[j] as int) + k) as i32, mx);
            }
            k += 1;
        }
        j += 1;
    }
    var cnt int = 0;
    zi(RC, at_least1(NJ), 0);
    zi(EC, at_least1(NJ), 0);
    var m int = 0;
    while (m < NMB) {
        var a int = MB[4 * m] as int;
        var b int = MB[4 * m + 1] as int;
        var rb int = MB[4 * m + 3] as int;
        EC[a] = ((EC[a] as int) + 1) as i32;
        EC[b] = ((EC[b] as int) + 1) as i32;
        if ((rb & 1) == 0) {
            RC[a] = ((RC[a] as int) + 1) as i32;
        }
        if ((rb & 2) == 0) {
            RC[b] = ((RC[b] as int) + 1) as i32;
        }
        m += 1;
    }
    var p int = 0;
    while (p < NJ) {
        if ((EC[p] as int) > 0 && (RC[p] as int) == 0) {
            var d int = 3;
            while (d < 6) {
                if ((SU[6 * p + d] as int) == 0) {
                    hold((6 * (POS[p] as int) + d) as i32, mx);
                    cnt += 1;
                }
                d += 1;
            }
        }
        p += 1;
    }
    var n int = 0;
    while (n < NT) {
        var h int = 3;
        while (h < 6) {
            var e int = 6 * (POS[n] as int) + h;
            var loose bool = true;
            if (n < NJ) {
                loose = (SU[6 * n + h] as int) == 0;
            }
            var at int = (CP[e] as int) + e - (TOP[e] as int);
            if (loose && KV[at] <= mx * 0.000000001) {
                KV[at] = mx;
                cnt += 1;
            }
            h += 1;
        }
        n += 1;
    }
    return cnt;
}
fn factor() int {
    var j int = 0;
    while (j < NQ) {
        var tj int = TOP[j] as int;
        var pj int = CP[j] as int;
        var i int = tj + 1;
        while (i < j) {
            var ti int = TOP[i] as int;
            var start_i int = CP[i] as int;
            var k0 int = ti;
            if (tj > k0) {
                k0 = tj;
            }
            var count int = i - k0;
            var base_a int = start_i + k0 - ti;
            var base_b int = pj + k0 - tj;
            var s real = 0.0;
            var k int = 0;
            while (k < count) {
                s += KV[base_a + k] * KV[base_b + k];
                k += 1;
            }
            KV[pj + i - tj] -= s;
            i += 1;
        }
        var ds real = 0.0;
        var r int = tj;
        while (r < j) {
            var g real = KV[pj + r - tj];
            var lv real = g / KV[(CP[r] as int) + r - (TOP[r] as int)];
            ds += g * lv;
            KV[pj + r - tj] = lv;
            r += 1;
        }
        var av real = KV[pj + j - tj];
        var dv real = av - ds;
        if (av <= 0.0 || dv <= 0.0000000001 * av) {
            return j + 1;
        }
        KV[pj + j - tj] = dv;
        j += 1;
    }
    return 0;
}
fn sky_into(src const real[:], dst real[:]) int {
    var c int = 0;
    while (c < NQ) {
        dst[c] = src[c];
        c += 1;
    }
    var j int = 0;
    while (j < NQ) {
        var tj int = TOP[j] as int;
        var pj int = CP[j] as int;
        var m int = j - tj;
        var s real = 0.0;
        var k int = 0;
        while (k < m) {
            s += KV[pj + k] * dst[tj + k];
            k += 1;
        }
        dst[j] -= s;
        j += 1;
    }
    var d int = 0;
    while (d < NQ) {
        dst[d] = dst[d] / KV[(CP[d] as int) + d - (TOP[d] as int)];
        d += 1;
    }
    var b int = NQ - 1;
    while (b >= 0) {
        var bt int = TOP[b] as int;
        var bp int = CP[b] as int;
        var bm int = b - bt;
        var xj real = dst[b];
        var i int = 0;
        while (i < bm) {
            dst[bt + i] -= KV[bp + i] * xj;
            i += 1;
        }
        b -= 1;
    }
    return 0;
}
fn mv(g i32, src const real[:], dst real[:]) int {
    var z int = 0;
    while (z < NQ) {
        dst[z] = 0.0;
        z += 1;
    }
    var use_g bool = (g as int) == 1;
    var j int = 0;
    while (j < NQ) {
        var tj int = TOP[j] as int;
        var pj int = CP[j] as int;
        var i int = tj;
        while (i <= j) {
            var v real = 0.0;
            if (use_g) {
                v = GV[pj + i - tj];
            } else {
                v = KS[pj + i - tj];
            }
            dst[i] += v * src[j];
            if (i != j) {
                dst[j] += v * src[i];
            }
            i += 1;
        }
        j += 1;
    }
    return 0;
}
fn stress(k i32, s i32) int {
    var o int = 8 * (k as int);
    var q int = 8 * (s as int);
    var N real = ST[o];
    var T real = ST[o + 3];
    var My real = ST[o + 4];
    var Mz real = ST[o + 5];
    var A real = SP[q];
    var Iy real = SP[q + 1];
    var Iz real = SP[q + 2];
    var cy real = SP[q + 4];
    var cz real = SP[q + 5];
    var Zt real = SP[q + 6];
    var rnd real = SP[q + 7];
    var sg real = 0.0;
    if (A != 0.0) {
        sg = rabs(N / A);
    }
    if (rnd > 0.5) {
        if (Iy != 0.0) {
            sg += sqrt_r(My * My + Mz * Mz) * cz / Iy;
        }
    } else {
        if (Iy != 0.0) {
            sg += rabs(My * cz / Iy);
        }
        if (Iz != 0.0) {
            sg += rabs(Mz * cy / Iz);
        }
    }
    var tau real = 0.0;
    if (Zt > 0.0) {
        tau = rabs(T / Zt);
    }
    ST[o + 6] = sg;
    ST[o + 7] = sqrt_r(sg * sg + 3.0 * (tau * tau));
    return 0;
}
fn forces() int {
    var z int = 0;
    while (z < RJ.len) {
        RJ[z] = 0.0;
        z += 1;
    }
    var y int = 0;
    while (y < ST.len) {
        ST[y] = 0.0;
        y += 1;
    }
    var x int = 0;
    while (x < SD.len) {
        SD[x] = 0.0;
        x += 1;
    }
    var e int = 0;
    while (e < NE) {
        var m int = EN[3 * e + 2] as int;
        var na int = EN[3 * e] as int;
        var nb int = EN[3 * e + 1] as int;
