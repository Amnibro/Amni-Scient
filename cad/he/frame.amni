        var ey real = (b * b * tf + hc * (tw * tw) / 2.0) / A;
        Iy = (b * (h * h * h) - (b - tw) * (hc * hc * hc)) / 12.0;
        Iz = 2.0 * (tf * (b * b * b) / 12.0 + b * tf * ((b / 2.0 - ey) * (b / 2.0 - ey))) + hc * (tw * tw * tw) / 12.0 + hc * tw * ((tw / 2.0 - ey) * (tw / 2.0 - ey));
        J = (2.0 * b * (tf * tf * tf) + hc * (tw * tw * tw)) / 3.0;
