}
fn node_of(m i32, s i32) int {
    var mm int = m as int;
    var ss int = s as int;
    if (ss == 0) {
        return MB[4 * mm] as int;
    }
    if (ss == NS) {
        return MB[4 * mm + 1] as int;
    }
    return NJ + mm * (NS - 1) + ss - 1;
}
fn build() int {
    NT = NJ + NMB * (NS - 1);
    NE = NMB * NS;
    zf(XN, at_least1(3 * NT), 0.0);
    zf(LAM, at_least1(9 * NMB), 0.0);
    zi(EN, at_least1(3 * NE), 0);
    zi(RL, at_least1(NE), 0);
    zf(PE, at_least1(NE), 0.0);
    var q int = 0;
    while (q < 3 * NJ) {
        XN[q] = XJ[q];
        q += 1;
    }
    var m int = 0;
    while (m < NMB) {
        MS[8 * m] = axes(m as i32);
        var i int = MB[4 * m] as int;
        var j int = MB[4 * m + 1] as int;
        var rb int = MB[4 * m + 3] as int;
        var k int = 1;
        while (k < NS) {
            var nd int = NJ + m * (NS - 1) + k - 1;
            var c int = 0;
            while (c < 3) {
                XN[3 * nd + c] = XJ[3 * i + c] + (XJ[3 * j + c] - XJ[3 * i + c]) * (k as real) / (NS as real);
                c += 1;
            }
            k += 1;
        }
        var s int = 0;
        while (s < NS) {
            var e int = m * NS + s;
            EN[3 * e] = node_of(m as i32, s as i32) as i32;
            EN[3 * e + 1] = node_of(m as i32, (s + 1) as i32) as i32;
            EN[3 * e + 2] = m as i32;
            var fl int = 0;
            if (s == 0 && (rb & 1) != 0) {
                fl += 1;
            }
            if (s == NS - 1 && (rb & 2) != 0) {
                fl += 2;
            }
            if (s == NS - 1 && rb == 3) {
                fl += 4;
            }
            RL[e] = fl as i32;
            s += 1;
        }
        m += 1;
    }
    return 0;
}
fn bfs(s i32, c0 i32) int {
    var start int = s as int;
    var first int = c0 as int;
    ORD[first] = s;
    SEEN[start] = 1 as i32;
    var hd int = first;
    var tl int = first + 1;
    while (hd < tl) {
        var n int = ORD[hd] as int;
        hd += 1;
        var t0 int = tl;
        var p int = AS[n] as int;
        var pend int = AS[n + 1] as int;
        while (p < pend) {
            var q int = AJ[p] as int;
            if ((SEEN[q] as int) == 0) {
                SEEN[q] = 1 as i32;
                ORD[tl] = q as i32;
                tl += 1;
            }
            p += 1;
        }
        var i int = t0 + 1;
        while (i < tl) {
            var v int = ORD[i] as int;
            var key int = DEG[v] as int;
            var j int = i - 1;
            while (j >= t0 && (DEG[ORD[j] as int] as int) > key) {
                ORD[j + 1] = ORD[j];
                j -= 1;
            }
            ORD[j + 1] = v as i32;
            i += 1;
        }
    }
    return tl;
}
fn order() int {
    zi(DEG, at_least1(NT), 0);
    zi(SEEN, at_least1(NT), 0);
    zi(ORD, at_least1(NT), 0);
    zi(POS, at_least1(NT), 0);
    zi(CUR, at_least1(NT), 0);
    zi(AS, NT + 1, 0);
    zi(AJ, at_least1(2 * NE), 0);
    var e int = 0;
    while (e < NE) {
        var a int = EN[3 * e] as int;
        var b int = EN[3 * e + 1] as int;
        if (a != b) {
            DEG[a] = ((DEG[a] as int) + 1) as i32;
            DEG[b] = ((DEG[b] as int) + 1) as i32;
        }
        e += 1;
    }
    var n int = 0;
    while (n < NT) {
        AS[n + 1] = ((AS[n] as int) + (DEG[n] as int)) as i32;
        CUR[n] = AS[n];
        n += 1;
    }
    var f int = 0;
    while (f < NE) {
        var fa int = EN[3 * f] as int;
        var fb int = EN[3 * f + 1] as int;
        if (fa != fb) {
            AJ[CUR[fa] as int] = fb as i32;
            CUR[fa] = ((CUR[fa] as int) + 1) as i32;
            AJ[CUR[fb] as int] = fa as i32;
            CUR[fb] = ((CUR[fb] as int) + 1) as i32;
        }
        f += 1;
    }
    var cnt int = 0;
    while (cnt < NT) {
        var st int = -1;
        var u int = 0;
        while (u < NT) {
            if ((SEEN[u] as int) == 0) {
                if (st < 0) {
                    st = u;
                } else if ((DEG[u] as int) < (DEG[st] as int)) {
                    st = u;
                }
            }
            u += 1;
        }
        var e1 int = bfs(st as i32, cnt as i32);
        var la int = ORD[e1 - 1] as int;
        var k int = cnt;
        while (k < e1) {
            SEEN[ORD[k] as int] = 0 as i32;
            k += 1;
        }
        cnt = bfs(la as i32, cnt as i32);
    }
    var w int = 0;
    while (w < NT) {
        POS[ORD[w] as int] = (NT - 1 - w) as i32;
        w += 1;
    }
    return 0;
}
fn profile() int {
    NQ = 6 * NT;
    zi(TOP, at_least1(NQ), 0);
    zi(CP, NQ + 1, 0);
    var q int = 0;
    while (q < NQ) {
        TOP[q] = q as i32;
        q += 1;
    }
    var e int = 0;
    while (e < NE) {
        var a int = EN[3 * e] as int;
        var b int = EN[3 * e + 1] as int;
        var pa int = POS[a] as int;
        var pb int = POS[b] as int;
        var lo int = 6 * pa;
        if (pb < pa) {
            lo = 6 * pb;
        }
        var k int = 0;
        while (k < 6) {
            if (lo < (TOP[6 * pa + k] as int)) {
                TOP[6 * pa + k] = lo as i32;
            }
            if (lo < (TOP[6 * pb + k] as int)) {
                TOP[6 * pb + k] = lo as i32;
            }
            k += 1;
        }
        e += 1;
    }
    var r int = 0;
    while (r < NQ) {
        CP[r + 1] = ((CP[r] as int) + r - (TOP[r] as int) + 1) as i32;
        r += 1;
    }
    NV = CP[NQ] as int;
    zf(KV, at_least1(NV), 0.0);
    zf(KS, at_least1(NV), 0.0);
    zf(GV, at_least1(NV), 0.0);
    zf(FV, at_least1(NQ), 0.0);
    zf(UV, at_least1(NQ), 0.0);
    zf(XV, at_least1(NQ), 0.0);
    zf(YV, at_least1(NQ), 0.0);
    zf(ZV, at_least1(NQ), 0.0);
    zf(WV, at_least1(NQ), 0.0);
    return 0;
}
fn bend_add(r int, c int, k real, g real) {
    KE[r * 12 + c] += k;
    GE[r * 12 + c] += g;
}
fn bend(a i32, b i32, c i32, d i32, sg real, ei real, l real, p real) int {
    var ia int = a as int;
    var ib int = b as int;
    var ic int = c as int;
    var id int = d as int;
    var k1 real = ei * 12.0 / (l * l * l);
    var k2 real = ei * 6.0 * sg / (l * l);
    var k3 real = ei * 4.0 / l;
    var k4 real = ei * 2.0 / l;
    var g1 real = p * 6.0 / (5.0 * l);
    var g2 real = p * sg / 10.0;
    var g3 real = p * 2.0 * l / 15.0;
    var g4 real = p * l / 30.0;
    bend_add(ia, ia, k1, g1);
    bend_add(ia, ib, k2, g2);
    bend_add(ia, ic, -k1, -g1);
    bend_add(ia, id, k2, g2);
    bend_add(ib, ia, k2, g2);
    bend_add(ib, ib, k3, g3);
    bend_add(ib, ic, -k2, -g2);
    bend_add(ib, id, k4, -g4);
    bend_add(ic, ia, -k1, -g1);
    bend_add(ic, ib, -k2, -g2);
    bend_add(ic, ic, k1, g1);
    bend_add(ic, id, -k2, -g2);
    bend_add(id, ia, k2, g2);
    bend_add(id, ib, k4, -g4);
    bend_add(id, ic, -k2, -g2);
    bend_add(id, id, k3, g3);
    return 0;
}
fn condense(r i32) int {
    var rr int = r as int;
    var kr real = KE[rr * 12 + rr];
    if (kr <= 0.0) {
        return 0;
    }
    if (CV.len != 12) {
        zf(CV, 12, 0.0);
    }
    var a int = 0;
    while (a < 12) {
        CV[a] = -KE[rr * 12 + a] / kr;
        a += 1;
    }
    var i int = 0;
    while (i < 12) {
        var j int = 0;
        while (j < 12) {
            if (i != rr && j != rr) {
                GE[i * 12 + j] += CV[i] * GE[rr * 12 + j] + GE[i * 12 + rr] * CV[j] + CV[i] * CV[j] * GE[rr * 12 + rr];
                KE[i * 12 + j] -= KE[i * 12 + rr] * KE[rr * 12 + j] / kr;
            }
            j += 1;
        }
        i += 1;
    }
