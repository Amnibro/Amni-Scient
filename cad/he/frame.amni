        Iz = (2.0 * tf * (b * b * b) + hw * (tw * tw * tw)) / 12.0;
        J = (2.0 * b * (tf * tf * tf) + hw * (tw * tw * tw)) / 3.0;
        cy = b / 2.0;
        cz = h / 2.0;
        Zt = J / rmax(tf, tw);
        rnd = 0.0;
