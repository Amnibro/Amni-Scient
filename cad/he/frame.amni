}
export fn fr_sections() i32 {
    var s int = 0;
    while (s < NSC) {
        sec_props(s as i32);
        s += 1;
    }
    return 0;
}
fn axes(m i32) real {
    var mm int = m as int;
    var i int = MB[4 * mm] as int;
    var j int = MB[4 * mm + 1] as int;
    var dx real = XJ[3 * j] - XJ[3 * i];
    var dy real = XJ[3 * j + 1] - XJ[3 * i + 1];
    var dz real = XJ[3 * j + 2] - XJ[3 * i + 2];
    var L real = sqrt_r(dx * dx + dy * dy + dz * dz);
    var o int = 9 * mm;
    if (L == 0.0) {
        var c int = 0;
        while (c < 9) {
            LAM[o + c] = 0.0;
            c += 1;
        }
        LAM[o] = 1.0;
        LAM[o + 4] = 1.0;
        LAM[o + 8] = 1.0;
        return 0.0;
    }
    var exx real = dx / L;
    var exy real = dy / L;
    var exz real = dz / L;
    var rx real = 0.0;
    var ry real = 0.0;
    var rz real = 1.0;
    if (rabs(exz) > 0.999) {
        rx = 1.0;
        rz = 0.0;
    }
    var rd real = rx * exx + ry * exy + rz * exz;
    var ax real = rx - rd * exx;
    var ay real = ry - rd * exy;
    var az real = rz - rd * exz;
    var al real = sqrt_r(ax * ax + ay * ay + az * az);
    ax = ax / al;
    ay = ay / al;
    az = az / al;
    var bx real = ay * exz - az * exy;
    var by real = az * exx - ax * exz;
    var bz real = ax * exy - ay * exx;
    var bt real = MW[4 * mm] * pi_r() / 180.0;
    var cb real = cos_r(bt);
    var sb real = sin_r(bt);
    LAM[o] = exx;
    LAM[o + 1] = exy;
    LAM[o + 2] = exz;
    LAM[o + 3] = cb * bx + sb * ax;
    LAM[o + 4] = cb * by + sb * ay;
    LAM[o + 5] = cb * bz + sb * az;
    LAM[o + 6] = cb * ax - sb * bx;
    LAM[o + 7] = cb * ay - sb * by;
    LAM[o + 8] = cb * az - sb * bz;
