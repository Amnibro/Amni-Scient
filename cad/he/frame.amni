fn log_r(x real) real {
    var z real = 0.0;
    if (x != x) {
        return x;
    }
    if (x < 0.0) {
        return z / z;
    }
    if (x == 0.0) {
        return -1.0 / z;
    }
    if (x > 1.0e308) {
        return x;
    }
    var v real = x;
    var e int = 0;
    while (v >= 2.0) {
        v = v / 2.0;
        e += 1;
