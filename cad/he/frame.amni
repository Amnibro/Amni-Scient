            d += 1;
        }
        jn += 1;
    }
    return 0;
}
fn summary() int {
    var m int = 0;
    while (m < NMB) {
        var base int = m * (NS + 1);
        var lo real = ST[8 * base];
        var hi real = ST[8 * base];
        var vm real = 0.0;
        var tm real = 0.0;
        var bm real = 0.0;
        var sm real = ST[8 * base + 6];
        var em real = ST[8 * base + 7];
        var k int = base;
        while (k <= base + NS) {
            lo = rmin(lo, ST[8 * k]);
            hi = rmax(hi, ST[8 * k]);
            vm = rmax(vm, sqrt_r(ST[8 * k + 1] * ST[8 * k + 1] + ST[8 * k + 2] * ST[8 * k + 2]));
            tm = rmax(tm, rabs(ST[8 * k + 3]));
            bm = rmax(bm, sqrt_r(ST[8 * k + 4] * ST[8 * k + 4] + ST[8 * k + 5] * ST[8 * k + 5]));
            sm = rmax(sm, ST[8 * k + 6]);
            em = rmax(em, ST[8 * k + 7]);
            k += 1;
        }
        MS[8 * m + 1] = lo;
        MS[8 * m + 2] = hi;
        MS[8 * m + 3] = vm;
        MS[8 * m + 4] = tm;
        MS[8 * m + 5] = bm;
        MS[8 * m + 6] = sm;
        MS[8 * m + 7] = em;
        m += 1;
    }
    var best real = 0.0;
    var who int = 0;
    var s int = 0;
    while (s < NMB * (NS + 1)) {
        var len real = sqrt_r(SD[3 * s] * SD[3 * s] + SD[3 * s + 1] * SD[3 * s + 1] + SD[3 * s + 2] * SD[3 * s + 2]);
        if (len > best) {
            best = len;
            who = s / (NS + 1);
        }
        s += 1;
    }
    OUT[1] = best;
    OUT[2] = who as real;
    var top_s real = 0.0;
    var top_m int = 0;
    var mass real = 0.0;
    var a int = 0;
    while (a < NMB) {
        if (MS[8 * a + 7] > top_s) {
            top_s = MS[8 * a + 7];
            top_m = a;
        }
        mass += IN[5] * 0.000000001 * SP[8 * (MB[4 * a + 2] as int)] * MS[8 * a];
        a += 1;
    }
    OUT[3] = top_s;
    OUT[4] = top_m as real;
    OUT[9] = mass;
    var fx real = 0.0;
    var fy real = 0.0;
    var fz real = 0.0;
    var j int = 0;
    while (j < NJ) {
        fx += RJ[6 * j];
        fy += RJ[6 * j + 1];
        fz += RJ[6 * j + 2];
        j += 1;
    }
    OUT[10] = fx;
    OUT[11] = fy;
    OUT[12] = fz;
    if (IN[10] > 0.0 && OUT[3] > 0.0) {
        OUT[14] = IN[10] / OUT[3];
    } else {
        OUT[14] = 0.0;
    }
    return 0;
}
fn buckle() int {
    assemble();
    fix();
    var c int = 0;
    while (c < KV.len) {
        KS[c] = KV[c];
        c += 1;
    }
    if (factor() > 0) {
        OUT[5] = 0.0;
        return 0;
    }
    var mi int = 2000;
    if (IN[12] > 0.0) {
        mi = IN[12] as int;
    }
    var sh real = 0.0;
    var mu real = 0.0;
    var tot int = 0;
    var pass int = 0;
    var again bool = true;
    while (again) {
        var q int = 0;
        while (q < NQ) {
            XV[q] = sin_r(0.7 * (q as real) + 1.3) + 0.5 * cos_r(0.37 * (q as real));
            q += 1;
        }
        var j int = 0;
        while (j < NJ) {
            var k int = 0;
            while (k < 6) {
                if ((SU[6 * j + k] as int) == 1) {
                    XV[6 * (POS[j] as int) + k] = 0.0;
                }
                k += 1;
            }
            j += 1;
        }
        var pv real = 0.0;
        var it int = 0;
        while (it < mi) {
            mv(1 as i32, XV, ZV);
            mv(0 as i32, XV, WV);
            var num real = 0.0;
            var den real = 0.0;
            var a int = 0;
            while (a < NQ) {
                num += XV[a] * ZV[a];
                den += XV[a] * WV[a];
                a += 1;
            }
            mu = 0.0;
            if (den > 0.0) {
                mu = num / den;
            }
            sky_into(ZV, YV);
            var mx real = 0.0;
            var b int = 0;
            while (b < NQ) {
                YV[b] += sh * XV[b];
                mx = rmax(mx, rabs(YV[b]));
                b += 1;
            }
            if (mx == 0.0) {
                break;
            }
            var d int = 0;
            while (d < NQ) {
                XV[d] = YV[d] / mx;
                d += 1;
            }
            tot += 1;
            if (tot >= 7 && rabs(mu - pv) <= 0.0000000001 * rabs(mu)) {
                break;
            }
            pv = mu;
            it += 1;
        }
        pass += 1;
        if (mu < 0.0 && pass == 1) {
            sh = -mu;
        } else {
            again = false;
        }
    }
    if (mu > 0.000000000000001) {
        OUT[5] = 1.0 / mu;
    } else {
        OUT[5] = 0.0;
    }
    var m int = 0;
    while (m < NMB) {
        var s0 int = 0;
        while (s0 <= NS) {
            var n int = node_of(m as i32, s0 as i32);
            var e int = 0;
            while (e < 3) {
                SB[3 * (m * (NS + 1) + s0) + e] = XV[6 * (POS[n] as int) + e];
                e += 1;
            }
            s0 += 1;
        }
        m += 1;
    }
    var big real = 0.0;
    var t int = 0;
    while (t < NMB * (NS + 1)) {
        big = rmax(big, sqrt_r(SB[3 * t] * SB[3 * t] + SB[3 * t + 1] * SB[3 * t + 1] + SB[3 * t + 2] * SB[3 * t + 2]));
        t += 1;
    }
    if (big > 0.0) {
        var u int = 0;
        while (u < SB.len) {
            SB[u] = SB[u] / big;
            u += 1;
        }
    }
    return tot;
}
export fn fr_solve() i32 {
    build();
    order();
    profile();
    assemble();
    OUT[13] = fix() as real;
    var c int = 0;
    while (c < KV.len) {
        KS[c] = KV[c];
        c += 1;
    }
    var f int = factor();
    if (f > 0) {
        OUT[0] = 2.0;
        OUT[15] = (ORD[NT - 1 - (f - 1) / 6] as int) as real;
        OUT[16] = ((f - 1) % 6) as real;
        return 2;
    }
    sky_into(FV, UV);
    forces();
    summary();
    OUT[7] = NQ as real;
    OUT[8] = NV as real;
    OUT[5] = 0.0;
    OUT[6] = 0.0;
    if (IN[11] > 0.5) {
        OUT[6] = buckle() as real;
    }
    OUT[0] = 0.0;
    return 0;
}
export fn fr_bolt() i32 {
    var pi real = pi_r();
    var d real = IN[20];
    var pt real = IN[21];
    var rp real = IN[22];
    var rm real = IN[23];
    var mg real = IN[24];
    var mk real = IN[25];
    var dw real = 1.45 * d;
    if (IN[26] > 0.0) {
        dw = IN[26];
    }
    var dh real = 1.1 * d;
    if (IN[27] > 0.0) {
        dh = IN[27];
    }
    var lk real = IN[28];
    var es real = 205000.0;
    if (IN[29] > 0.0) {
        es = IN[29];
    }
    var ep real = es;
    if (IN[30] > 0.0) {
        ep = IN[30];
    }
    var ma real = IN[31];
    var nu real = 0.9;
    if (IN[32] > 0.0) {
        nu = IN[32];
    }
    var aa real = 1.5;
    if (IN[33] > 0.0) {
        aa = IN[33];
    }
    var fa real = IN[34];
    var fq real = IN[35];
    var mt real = 0.15;
    if (IN[36] > 0.0) {
        mt = IN[36];
    }
    var qf real = 1.0;
    if (IN[37] > 0.0) {
        qf = IN[37];
    }
    var fz real = 9.0 + 2.0 * qf;
    if (IN[38] > 0.0) {
        fz = IN[38];
    }
    var n real = 0.5;
    if (IN[39] > 0.0) {
        n = IN[39];
    }
    var da real = 3.0 * dw;
    if (IN[40] > 0.0) {
        da = IN[40];
    }
    var pg real = IN[41];
    var le real = IN[42];
    var rmi real = IN[43];
    var ls real = rmin(rmax(IN[44], 0.0), lk);
    var d2 real = d - 0.649519 * pt;
    var d3 real = d - 1.226869 * pt;
    var d0 real = (d2 + d3) / 2.0;
    var ast real = pi * (d0 * d0) / 4.0;
    var an real = pi * (d * d) / 4.0;
    var a3 real = pi * (d3 * d3) / 4.0;
    var kk real = 1.5 * d2 / d0 * (pt / (pi * d2) + 1.155 * mg);
    var fm0 real = ast * nu * rp / sqrt_r(1.0 + 3.0 * (kk * kk));
    var kt real = 0.16 * pt + 0.58 * d2 * mg + mk * (dw + dh) / 4.0;
    var ma0 real = fm0 * kt;
    var fmx real = fm0;
    if (ma > 0.0) {
        fmx = ma / kt;
    }
    var fmn real = fmx / aa;
    var ds real = (0.5 * d + ls + 0.4 * d) / (es * an) + (lk - ls + 0.5 * d) / (es * a3);
    var tp real = 0.362 + 0.032 * log_r(rmax(lk / dw, 0.002) / 2.0) + 0.153 * log_r(da / dw);
    var dg real = dw + lk * tp;
    var dp real = 0.0;
    if (da >= dg) {
        dp = 2.0 * log_r(((dw + dh) * (dw + lk * tp - dh)) / ((dw - dh) * (dw + lk * tp + dh))) / (ep * pi * dh * tp);
    } else {
        dp = (2.0 / (dh * tp) * log_r(((dw + dh) * (da - dh)) / ((dw - dh) * (da + dh))) + 4.0 / (da * da - dh * dh) * (lk - (da - dw) / tp)) / (ep * pi);
    }
    var ph real = n * dp / (ds + dp);
    var fsa real = ph * fa;
    var fpa real = fa - fsa;
    var fzl real = fz * 0.001 / (ds + dp);
    var fkr real = fmn - fzl - fpa;
    var fsm real = fmx + fsa;
    var sz real = fsm / ast;
    var mgt real = fmx * d2 / 2.0 * (pt / (pi * d2) + 1.155 * mg);
    var tau real = mgt / (pi * (d0 * d0 * d0) / 16.0);
    var sred real = sqrt_r(sz * sz + 3.0 * ((0.5 * tau) * (0.5 * tau)));
    var sa real = fsa / (2.0 * ast);
    var sasv real = 0.85 * (150.0 / d + 45.0);
    var ap real = pi * (dw * dw - dh * dh) / 4.0;
    var pr real = fsm / ap;
    var fke real = 0.0;
    if (fq > 0.0) {
        fke = fq / (qf * mt);
    }
    var lrq real = 0.0;
    if (rmi > 0.0) {
        lrq = rm * ast / (0.6 * rmi * 0.75 * pi * d);
    }
    var safe_a real = 0.0;
    if (sa != 0.0) {
        safe_a = sasv / sa;
    }
    var safe_p real = 0.0;
    if (pg != 0.0) {
        safe_p = pg / pr;
    }
    var safe_q real = 0.0;
    if (fq != 0.0) {
        safe_q = fkr * qf * mt / fq;
    }
    var safe_l real = 0.0;
    if (lrq != 0.0 && le != 0.0) {
        safe_l = le / lrq;
    }
    var open_flag real = 0.0;
    if (fkr <= 0.0) {
        open_flag = 1.0;
    }
    OUT[20] = d2;
    OUT[21] = d3;
    OUT[22] = ast;
    OUT[23] = fm0;
    OUT[24] = ma0;
    OUT[25] = fmx;
    OUT[26] = fmn;
    OUT[27] = ds;
    OUT[28] = dp;
    OUT[29] = ph;
    OUT[30] = fsa;
    OUT[31] = fpa;
    OUT[32] = fzl;
    OUT[33] = fkr;
    OUT[34] = fsm;
    OUT[35] = sred;
    OUT[36] = rp / sred;
    OUT[37] = sa;
    OUT[38] = sasv;
    OUT[39] = safe_a;
    OUT[40] = pr;
    OUT[41] = safe_p;
    OUT[42] = fke;
    OUT[43] = safe_q;
    OUT[44] = lrq;
    OUT[45] = safe_l;
    OUT[46] = tau;
    OUT[47] = tp;
    OUT[48] = dg;
    OUT[49] = kt;
    OUT[50] = open_flag;
    return 0;
}
