        }
        e += 1;
    }
    var jn int = 0;
    while (jn < NJ) {
        var d int = 0;
        while (d < 6) {
            if ((SU[6 * jn + d] as int) == 1) {
                RJ[6 * jn + d] = RJ[6 * jn + d] - FJ[6 * jn + d];
            } else {
                RJ[6 * jn + d] = 0.0;
            }
