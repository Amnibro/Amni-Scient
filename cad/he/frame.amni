fn sec_props(s i32) int {
    var o int = 8 * (s as int);
    var k int = SC[o] as int;
    var b real = SC[o + 1];
    var h real = SC[o + 2];
    var t real = SC[o + 3];
    var tf real = SC[o + 4];
    var tw real = SC[o + 5];
    var pi real = pi_r();
    var A real = 0.0;
    var Iy real = 0.0;
    var Iz real = 0.0;
    var J real = 0.0;
    var cy real = 0.0;
    var cz real = 0.0;
    var Zt real = 0.0;
    var rnd real = 0.0;
    if (k == 0) {
        A = b * h;
        Iy = b * (h * h * h) / 12.0;
        Iz = h * (b * b * b) / 12.0;
        var ra real = rmax(b, h) / 2.0;
        var rc real = rmin(b, h) / 2.0;
        J = ra * (rc * rc * rc) * (16.0 / 3.0 - 3.36 * rc / ra * (1.0 - (rc * rc * rc * rc) / (12.0 * (ra * ra * ra * ra))));
        cy = b / 2.0;
        cz = h / 2.0;
        Zt = 8.0 * (ra * ra) * (rc * rc) / (3.0 * ra + 1.8 * rc);
        rnd = 0.0;
    } else if (k == 1) {
        var r real = b / 2.0;
        A = pi * (r * r);
        Iy = pi * (r * r * r * r) / 4.0;
        Iz = Iy;
        J = pi * (r * r * r * r) / 2.0;
        cy = r;
        cz = r;
        Zt = J / r;
        rnd = 1.0;
    } else if (k == 2) {
        var ro real = b / 2.0;
        var ri real = rmax(ro - t, 0.0);
        A = pi * (ro * ro - ri * ri);
        Iy = pi * (ro * ro * ro * ro - ri * ri * ri * ri) / 4.0;
        Iz = Iy;
        J = 2.0 * Iy;
        cy = ro;
        cz = ro;
        Zt = J / ro;
        rnd = 1.0;
