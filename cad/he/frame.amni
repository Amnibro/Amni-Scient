    SP[o] = A;
    SP[o + 1] = Iy;
    SP[o + 2] = Iz;
    SP[o + 3] = J;
    SP[o + 4] = cy;
    SP[o + 5] = cz;
    SP[o + 6] = Zt;
    SP[o + 7] = rnd;
