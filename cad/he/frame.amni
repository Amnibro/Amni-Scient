        var bi real = rmax(b - 2.0 * t, 0.0);
        var hi real = rmax(h - 2.0 * t, 0.0);
        A = b * h - bi * hi;
        Iy = (b * (h * h * h) - bi * (hi * hi * hi)) / 12.0;
        Iz = (h * (b * b * b) - hi * (bi * bi * bi)) / 12.0;
