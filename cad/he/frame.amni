            }
            r += 1;
        }
        var sl int = e - m * NS;
        var k0 int = m * (NS + 1) + sl;
        var u int = 0;
        while (u < 6) {
            ST[8 * k0 + u] = -QE[u];
            u += 1;
        }
        var v int = 0;
        while (v < 3) {
            SD[3 * k0 + v] = UV[6 * (POS[na] as int) + v];
            v += 1;
        }
        stress(k0 as i32, s as i32);
        if (sl == NS - 1) {
            var k1 int = k0 + 1;
            var u1 int = 0;
            while (u1 < 6) {
                ST[8 * k1 + u1] = QE[6 + u1];
                u1 += 1;
            }
            var v1 int = 0;
            while (v1 < 3) {
                SD[3 * k1 + v1] = UV[6 * (POS[nb] as int) + v1];
                v1 += 1;
