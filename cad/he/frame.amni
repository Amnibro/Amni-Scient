            FE[f] += CV[f] * FE[rr];
        }
        f += 1;
    }
    var z int = 0;
    while (z < 12) {
        KE[rr * 12 + z] = 0.0;
        KE[z * 12 + rr] = 0.0;
        GE[rr * 12 + z] = 0.0;
        GE[z * 12 + rr] = 0.0;
        z += 1;
    }
    FE[rr] = 0.0;
    return 0;
}
fn local(e i32) int {
    var ee int = e as int;
    zf(KE, 144, 0.0);
    zf(GE, 144, 0.0);
    if (FE.len != 12) {
        zf(FE, 12, 0.0);
    }
    if (FG.len != 12) {
        zf(FG, 12, 0.0);
    }
    if (DE.len != 12) {
        zf(DE, 12, 0.0);
    }
    if (QE.len != 12) {
        zf(QE, 12, 0.0);
    }
    var m int = EN[3 * ee + 2] as int;
    var s int = MB[4 * m + 2] as int;
    var A real = SP[8 * s];
    var Iy real = SP[8 * s + 1];
    var Iz real = SP[8 * s + 2];
    var J real = SP[8 * s + 3];
    var l real = MS[8 * m] / (NS as real);
    var E real = IN[3];
    var G real = E / (2.0 * (1.0 + IN[4]));
    var p real = PE[ee];
    var ea real = E * A / l;
    KE[0] = ea;
    KE[6 * 12 + 6] = ea;
    KE[6] = -ea;
    KE[6 * 12] = -ea;
    var gj real = G * J / l;
    KE[3 * 12 + 3] = gj;
    KE[9 * 12 + 9] = gj;
    KE[3 * 12 + 9] = -gj;
    KE[9 * 12 + 3] = -gj;
    if (A > 0.0) {
        var gt real = p * (Iy + Iz) / (A * l);
        GE[3 * 12 + 3] = gt;
        GE[9 * 12 + 9] = gt;
        GE[3 * 12 + 9] = -gt;
        GE[9 * 12 + 3] = -gt;
    }
    bend(1 as i32, 5 as i32, 7 as i32, 11 as i32, 1.0, E * Iz, l, p);
    bend(2 as i32, 4 as i32, 8 as i32, 10 as i32, -1.0, E * Iy, l, p);
    var gx real = MW[4 * m + 1] + IN[5] * 0.000000001 * A * IN[6];
    var gy real = MW[4 * m + 2] + IN[5] * 0.000000001 * A * IN[7];
    var gz real = MW[4 * m + 3] + IN[5] * 0.000000001 * A * IN[8];
    var wx real = LAM[9 * m] * gx + LAM[9 * m + 1] * gy + LAM[9 * m + 2] * gz;
    var wy real = LAM[9 * m + 3] * gx + LAM[9 * m + 4] * gy + LAM[9 * m + 5] * gz;
    var wz real = LAM[9 * m + 6] * gx + LAM[9 * m + 7] * gy + LAM[9 * m + 8] * gz;
    FE[0] = wx * l / 2.0;
    FE[1] = wy * l / 2.0;
    FE[2] = wz * l / 2.0;
    FE[3] = 0.0;
    FE[4] = -wz * (l * l) / 12.0;
    FE[5] = wy * (l * l) / 12.0;
    FE[6] = wx * l / 2.0;
    FE[7] = wy * l / 2.0;
    FE[8] = wz * l / 2.0;
    FE[9] = 0.0;
    FE[10] = wz * (l * l) / 12.0;
    FE[11] = -wy * (l * l) / 12.0;
    var rb int = RL[ee] as int;
    if ((rb & 1) != 0) {
        condense(4 as i32);
        condense(5 as i32);
    }
    if ((rb & 2) != 0) {
        condense(10 as i32);
        condense(11 as i32);
    }
    if ((rb & 4) != 0) {
        condense(9 as i32);
    }
    return 0;
}
fn rot_one(xs f64[>..]&, m int) {
    var bi int = 0;
    while (bi < 4) {
        var bj int = 0;
        while (bj < 4) {
            var p int = 0;
            while (p < 3) {
                var q int = 0;
                while (q < 3) {
                    var sum real = 0.0;
                    var a int = 0;
                    while (a < 3) {
                        var b int = 0;
                        while (b < 3) {
                            sum += LAM[9 * m + 3 * a + p] * xs[(3 * bi + a) * 12 + 3 * bj + b] * LAM[9 * m + 3 * b + q];
                            b += 1;
                        }
                        a += 1;
                    }
                    TE[(3 * bi + p) * 12 + 3 * bj + q] = sum;
                    q += 1;
                }
                p += 1;
            }
            bj += 1;
        }
        bi += 1;
    }
    var i int = 0;
    while (i < 144) {
        xs[i] = TE[i];
        i += 1;
    }
}
fn rot(m i32) int {
    if (TE.len != 144) {
        zf(TE, 144, 0.0);
    }
    rot_one(KE, m as int);
    rot_one(GE, m as int);
    return 0;
}
fn eqn(e i32, k i32) int {
    var ee int = e as int;
    var kk int = k as int;
    var nd int = EN[3 * ee + 1] as int;
    if (kk < 6) {
        nd = EN[3 * ee] as int;
    }
    return 6 * (POS[nd] as int) + kk % 6;
}
fn assemble() int {
    var z int = 0;
    while (z < KV.len) {
        KV[z] = 0.0;
        z += 1;
    }
    var y int = 0;
    while (y < GV.len) {
        GV[y] = 0.0;
        y += 1;
    }
    var x int = 0;
    while (x < FV.len) {
        FV[x] = 0.0;
        x += 1;
    }
    var e int = 0;
    while (e < NE) {
        var m int = EN[3 * e + 2] as int;
        local(e as i32);
        var h int = 0;
        while (h < 2) {
            var t int = 0;
            while (t < 2) {
                var c int = 0;
                while (c < 3) {
                    var sum real = 0.0;
                    var a int = 0;
                    while (a < 3) {
                        sum += LAM[9 * m + 3 * a + c] * FE[6 * h + 3 * t + a];
                        a += 1;
                    }
                    FG[6 * h + 3 * t + c] = sum;
                    c += 1;
                }
                t += 1;
            }
            h += 1;
        }
        var k int = 0;
        while (k < 12) {
            FV[eqn(e as i32, k as i32)] += FG[k];
            k += 1;
        }
        rot(m as i32);
        var i int = 0;
        while (i < 12) {
            var j int = 0;
            while (j < 12) {
                var r int = eqn(e as i32, i as i32);
                var cc int = eqn(e as i32, j as i32);
                if (r <= cc) {
                    var at int = (CP[cc] as int) + r - (TOP[cc] as int);
                    KV[at] += KE[i * 12 + j];
                    GV[at] -= GE[i * 12 + j];
                }
                j += 1;
            }
            i += 1;
        }
        e += 1;
    }
    var jn int = 0;
    while (jn < NJ) {
        var d int = 0;
        while (d < 6) {
            FV[6 * (POS[jn] as int) + d] += FJ[6 * jn + d];
            d += 1;
        }
        jn += 1;
    }
