    if (x <= 0.0) {
        return 0.0;
    }
    if (x > 1.0e308) {
        return x;
    }
    var v real = x;
    var f real = 1.0;
    while (v > 4.0) {
        v = v / 4.0;
        f = f * 2.0;
    }
    while (v < 0.25) {
        v = v * 4.0;
        f = f / 2.0;
    }
    var y real = 1.0;
    var i int = 0;
    while (i < 10) {
        y = 0.5 * (y + v / y);
        i += 1;
    }
    return y * f;
}
fn sin_k(r real) real {
