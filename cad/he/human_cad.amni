								}
							}
							if moles > 0.02 {
								let dm1 = sqrt(((rx - 0.025) * (rx - 0.025) + (ry - (mth_y + 0.011)) * (ry - (mth_y + 0.011))) as real) as f32;
								let dm2 = sqrt(((rx + 0.038) * (rx + 0.038) + (ry - (ey0 - 0.018)) * (ry - (ey0 - 0.018))) as real) as f32;
								if dm1 < 0.0018 || (moles > 0.45 && dm2 < 0.0015) {
