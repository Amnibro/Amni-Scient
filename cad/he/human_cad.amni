							}
							if freck > 0.01 && ry > mth_y + 0.012 && ry < ey0 + 0.008 && ax < ex0 * 1.70 {
								let band_f = clf(1.0 - abs(ry - nos_y - 0.008) / 0.025, 0.0, 1.0) * clf(1.0 - ax / (ex0 * 1.59), 0.0, 1.0);
								let cell_x = (rx * 420.0) as int;
								let cell_y = (ry * 420.0) as int;
								let fh = hash2f(cell_x, cell_y, 73);
								if fh < band_f * freck * 0.28 {
