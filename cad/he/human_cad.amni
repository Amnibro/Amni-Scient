fn h_shades() HShade[>..] {
	var r HShade[>..] = [];
	r.push(HShade{"black", 0.04, 0.035, 0.032, 0.45, 0.0});
	r.push(HShade{"soft black", 0.08, 0.07, 0.055, 0.7, 0.0});
	r.push(HShade{"dark brown", 0.15, 0.095, 0.058, 1.0, 0.0});
	r.push(HShade{"brown", 0.25, 0.155, 0.085, 1.2, 0.0});
	r.push(HShade{"chestnut", 0.34, 0.175, 0.085, 1.3, 0.0});
	r.push(HShade{"auburn", 0.40, 0.15, 0.075, 1.4, 0.0});
	r.push(HShade{"copper", 0.58, 0.25, 0.085, 1.58, 0.0});
	r.push(HShade{"strawberry", 0.59, 0.44, 0.25, 1.7, 0.0});
	r.push(HShade{"dark blonde", 0.48, 0.34, 0.18, 1.5, 0.0});
	r.push(HShade{"blonde", 0.72, 0.54, 0.30, 1.8, 0.0});
	r.push(HShade{"golden", 0.78, 0.59, 0.28, 1.8, 0.0});
	r.push(HShade{"platinum", 0.89, 0.81, 0.70, 1.9, 0.0});
	r.push(HShade{"gray", 0.48, 0.48, 0.49, 1.4, 0.0});
	r.push(HShade{"silver", 0.74, 0.75, 0.78, 1.7, 0.0});
	r.push(HShade{"white", 0.92, 0.92, 0.90, 1.9, 0.0});
	r.push(HShade{"pink", 0.87, 0.40, 0.58, 1.4, 1.0});
	r.push(HShade{"red", 0.72, 0.08, 0.09, 1.1, 1.0});
	r.push(HShade{"blue", 0.14, 0.30, 0.78, 1.1, 1.0});
	r.push(HShade{"teal", 0.10, 0.58, 0.54, 1.2, 1.0});
	r.push(HShade{"green", 0.18, 0.59, 0.24, 1.1, 1.0});
	r.push(HShade{"purple", 0.44, 0.18, 0.70, 1.1, 1.0});
	r.push(HShade{"lavender", 0.70, 0.58, 0.87, 1.5, 1.0});
	r
}
fn hr_rnd() f32 {
	HR_RS = HR_RS * (1664525 as uint) + (1013904223 as uint);
	((HR_RS >> 8) & (16777215 as uint)) as f32 / 16777216.0
}
fn hr_measure() {
	let mw = 72;
	let mh = 32;
	var sx f32 = 0.0; var sy f32 = 0.0; var sz f32 = 0.0; var sn = 0;
	for q in NS_Q {
		for k in 4 {
			let vi = SQ[q * 8 + k] as int;
			sx += PVX[vi]; sy += PVY[vi]; sz += PVZ[vi]; sn += 1;
		}
	}
	let inv = 1.0 / (max(sn, 1) as f32);
	let cy_head = (J_HY[22] as f32) * 0.45 + (sy * inv) * 0.55;
	HR_CTR[0] = sx * inv;
	HR_CTR[1] = cy_head;
	HR_CTR[2] = (J_HZ[22] as f32) * 0.5 + (sz * inv) * 0.5;
	var rsum f32 = 0.0; var rcnt = 0;
	HR_MAP.clear(); HR_MAP.resize(mw * mh, 0.0);
	var wsum f32[>..] = []; wsum.resize(mw * mh, 0.0);
	for bv in NB_V {
		let r = VREG[bv] as int;
		if r >= 7 && r <= 14 {
			let mv = B2M[bv] as int;
			let dx = PVX[mv] - HR_CTR[0];
			let dy = PVY[mv] - HR_CTR[1];
			let dz = PVZ[mv] - HR_CTR[2];
			let d = len3f(dx, dy, dz);
			if d > 0.02 {
				if dy > 0.0 { rsum += d; rcnt += 1; }
				let u = ((atan2(dx as real, dz as real) / TWO_PI + 0.5) * (mw as real)) as int;
				let v = ((atan2((dy / d) as real, sqrt(max(1.0 - ((dy / d) * (dy / d)) as real, 0.0))) / PI + 0.5) * (mh as real)) as int;
				let xi = ((u % mw) + mw) % mw;
				let yi = clamp(v, 0, mh - 1);
				let idx = yi * mw + xi;
				if d > HR_MAP[idx] { HR_MAP[idx] = d; wsum[idx] = 1.0; }
			}
		}
	}
	HR_UNIT = if rcnt > 0 { rsum / (rcnt as f32) } else { 0.10 };
	for i in mw * mh { if wsum[i] < 0.5 { HR_MAP[i] = HR_UNIT; } }
	for pass in 3 {
		var cp f32[>..] = []; cp.append(HR_MAP);
		for y in mh {
			for x in mw {
				let xl = (x + mw - 1) % mw;
				let xr = (x + 1) % mw;
				let yd = max(y - 1, 0);
				let yu = min(y + 1, mh - 1);
				HR_MAP[y * mw + x] = (cp[y * mw + x] * 4.0 + cp[y * mw + xl] + cp[y * mw + xr] + cp[yd * mw + x] + cp[yu * mw + x]) * 0.125;
			}
		}
	}
	HR_SOL.clear();
	HR_SOL.push(J_HX[21] as f32); HR_SOL.push(J_HY[21] as f32); HR_SOL.push(J_HZ[21] as f32);
	HR_SOL.push(0.58 * HR_UNIT); HR_SOL.push(0.95 * HR_UNIT); HR_SOL.push(0.58 * HR_UNIT);
	let sh_x = abs(J_HX[15] as f32) + 0.45 * HR_UNIT;
	HR_SOL.push(0.0); HR_SOL.push((J_HY[15] as f32) - 0.15 * HR_UNIT); HR_SOL.push(J_HZ[12] as f32);
	HR_SOL.push(sh_x); HR_SOL.push(0.85 * HR_UNIT); HR_SOL.push(0.95 * HR_UNIT);
	HR_SOL.push(0.0); HR_SOL.push((J_HY[12] as f32) - 0.35 * HR_UNIT); HR_SOL.push((J_HZ[12] as f32) + 0.1 * HR_UNIT);
	HR_SOL.push(sh_x * 0.88); HR_SOL.push(2.1 * HR_UNIT); HR_SOL.push(1.15 * HR_UNIT);
}
fn hr_radius(dx f32, dy f32, dz f32) f32 {
	let mw = 72;
	let mh = 32;
	let fx = (atan2(dx as real, dz as real) / TWO_PI + 0.5) * (mw as real) - 0.5;
	let fy = (atan2(dy as real, sqrt(max(1.0 - (dy * dy) as real, 0.0))) / PI + 0.5) * (mh as real) - 0.5;
	let x0 = floor(fx);
	let y0 = floor(fy);
	let tx = (fx - x0) as f32;
	let ty = (fy - y0) as f32;
	let xa = (((x0 as int) % mw) + mw) % mw;
	let xb = (((x0 as int) + 1) % mw + mw) % mw;
	let ya = clamp(y0 as int, 0, mh - 1);
	let yb = clamp((y0 as int) + 1, 0, mh - 1);
	let r0 = lrpf(HR_MAP[ya * mw + xa], HR_MAP[ya * mw + xb], tx);
	let r1 = lrpf(HR_MAP[yb * mw + xa], HR_MAP[yb * mw + xb], tx);
	lrpf(r0, r1, ty)
}
fn hr_line(dx f32, dy f32, dz f32) f32 {
	let _ = dy;
	let cz = dz / (sqrt((dx * dx + dz * dz) as real) as f32 + 0.0001);
	let kz f32[15] = [-1.0, -0.58, -0.45, -0.35, -0.25, -0.14, 0.0, 0.07, 0.14, 0.24, 0.37, 0.48, 0.58, 0.75, 1.0];
	let kv f32[15] = [-0.75, -0.55, -0.3, -0.02, 0.24, 0.35, 0.38, 0.11, -0.04, 0.05, 0.17, 0.31, 0.44, 0.55, 0.59];
	if cz <= kz[0] { return -0.75; }
	if cz >= kz[14] { return 0.59; }
	for i in 14 {
		if cz <= kz[i + 1] {
			let t = (cz - kz[i]) / (kz[i + 1] - kz[i]);
			return kv[i] + (kv[i + 1] - kv[i]) * t;
		}
	}
	0.59
}
fn hr_keep(px f32, py f32, pz f32, gap f32) f32, f32, f32 {
	var qx = px; var qy = py; var qz = pz;
	let dx = qx - HR_CTR[0];
	let dy = qy - HR_CTR[1];
	let dz = qz - HR_CTR[2];
	let l = len3f(dx, dy, dz);
	if l > 1.0e-5 && dy / l > -0.82 {
		let rr = hr_radius(dx / l, dy / l, dz / l) + gap;
		if l < rr {
			let k = rr / l;
			qx = HR_CTR[0] + dx * k;
			qy = HR_CTR[1] + dy * k;
			qz = HR_CTR[2] + dz * k;
		}
	}
	for i in HR_SOL.len / (3 * 2) {
		let o = i * (3 * 2);
		let sx = HR_SOL[o]; let sy = HR_SOL[o + 1]; let sz = HR_SOL[o + 2];
		let rx = HR_SOL[o + 3] + gap; let ry = HR_SOL[o + 4] + gap; let rz = HR_SOL[o + 5] + gap;
		let ux = (qx - sx) / rx;
		let uy = (qy - sy) / ry;
		let uz = (qz - sz) / rz;
		let m = len3f(ux, uy, uz);
		if m < 1.0 && m > 1.0e-5 {
			let k = 1.0 / m;
			qx = sx + ux * k * rx;
			qy = sy + uy * k * ry;
			qz = sz + uz * k * rz;
		}
	}
	return qx, qy, qz;
}
fn emit_card_strip(pts const f32[:], k int, ax f32, ay f32, az f32, w0 f32, y_pos f32[>..]&, y_nrm f32[>..]&, uv_out f32[>..]&, tri_out i32[>..]&, with_skin bool) {
	let base = y_pos.len / 3;
	let last = max(k - 1, 1) as f32;
	for s in k {
		let t = (s as f32) / last;
		let cx = pts[s * 3]; let cy = pts[s * 3 + 1]; let cz = pts[s * 3 + 2];
		let s0 = max(s - 1, 0);
		let s1 = min(s + 1, k - 1);
		let tgx = pts[s1 * 3] - pts[s0 * 3];
		let tgy = pts[s1 * 3 + 1] - pts[s0 * 3 + 1];
		let tgz = pts[s1 * 3 + 2] - pts[s0 * 3 + 2];
		var crx = tgy * az - tgz * ay;
		var cry = tgz * ax - tgx * az;
		var crz = tgx * ay - tgy * ax;
		var clen = len3f(crx, cry, crz);
		if clen < 1.0e-5 {
			crx = 0.0; cry = tgz; crz = -tgy;
			clen = max(len3f(crx, cry, crz), 1.0e-5);
		}
		let taper = w0 * (1.0 - 0.42 * t * t);
		let sdx = crx / clen * taper;
		let sdy = cry / clen * taper;
		let sdz = crz / clen * taper;
		var nmx = tgy * sdz - tgz * sdy;
		var nmy = tgz * sdx - tgx * sdz;
		var nmz = tgx * sdy - tgy * sdx;
		let nlen = max(len3f(nmx, nmy, nmz), 1.0e-5);
		nmx /= nlen; nmy /= nlen; nmz /= nlen;
		for e in 2 {
			let sg f32 = if e == 0 { -1.0 } else { 1.0 };
			let qx = cx + sdx * sg;
			let qy = cy + sdy * sg;
			let qz = cz + sdz * sg;
			y_pos.push(qx); y_pos.push(qy); y_pos.push(qz);
			y_nrm.push(nmx); y_nrm.push(nmy); y_nrm.push(nmz);
			uv_out.push(e as f32); uv_out.push(t);
			if with_skin {
				let ny = J_HY[21] as f32;
				let sy = J_HY[12] as f32;
				let w_sp = clf((ny - qy) / max(ny - sy + 0.08, 0.05), 0.0, 0.85) * clf(t * 1.4, 0.0, 1.0);
				let w_nk = clf((HR_CTR[1] - 0.55 * HR_UNIT - qy) / max(0.75 * HR_UNIT, 0.04), 0.0, 0.55) * (1.0 - w_sp);
				let w_hd = max(1.0 - w_sp - w_nk, 0.0 as f32);
				H_JW.push(22); H_JW.push(21); H_JW.push(12); H_JW.push(0);
				H_WW.push(w_hd); H_WW.push(w_nk); H_WW.push(w_sp); H_WW.push(0.0);
			}
		}
		if s < k - 1 {
			let x = base + s * 2;
			tri_out.push(x as i32); tri_out.push((x + 1) as i32); tri_out.push((x + 2) as i32);
			tri_out.push((x + 1) as i32); tri_out.push((x + 3) as i32); tri_out.push((x + 2) as i32);
		}
	}
}
fn add_torus_tie(cx f32, cy f32, cz f32, nx f32, ny f32, nz f32, rmaj f32, rmin f32) {
	var ux f32 = 0.0; var uy f32 = 1.0; var uz f32 = 0.0;
	if abs(ny) > 0.88 { ux = 1.0; uy = 0.0; uz = 0.0; }
	var b1x = uy * nz - uz * ny;
	var b1y = uz * nx - ux * nz;
	var b1z = ux * ny - uy * nx;
	let l1 = max(len3f(b1x, b1y, b1z), 1.0e-5);
	b1x /= l1; b1y /= l1; b1z /= l1;
	let b2x = ny * b1z - nz * b1y;
	let b2y = nz * b1x - nx * b1z;
	let b2z = nx * b1y - ny * b1x;
	let nu = 14;
	let nv = 8;
	let v0 = T_YP.len / 3;
	for i in nu {
		let a = (TWO_PI * (i as real) / (nu as real)) as f32;
		let ca = cos(a as real) as f32;
		let sa = sin(a as real) as f32;
		let rx = b1x * ca + b2x * sa;
		let ry = b1y * ca + b2y * sa;
		let rz = b1z * ca + b2z * sa;
		for j in nv {
			let b = (TWO_PI * (j as real) / (nv as real)) as f32;
			let cb = cos(b as real) as f32;
			let sb = sin(b as real) as f32;
			let px = cx + rx * (rmaj + rmin * cb) + nx * (rmin * sb);
			let py = cy + ry * (rmaj + rmin * cb) + ny * (rmin * sb);
			let pz = cz + rz * (rmaj + rmin * cb) + nz * (rmin * sb);
			let pnx = rx * cb + nx * sb;
			let pny = ry * cb + ny * sb;
			let pnz = rz * cb + nz * sb;
			T_YP.push(px); T_YP.push(py); T_YP.push(pz);
			T_YN.push(pnx); T_YN.push(pny); T_YN.push(pnz);
		}
	}
	for i in nu {
		let i1 = (i + 1) % nu;
		for j in nv {
			let j1 = (j + 1) % nv;
			let a = v0 + i * nv + j;
			let b = v0 + i1 * nv + j;
			let c = v0 + i1 * nv + j1;
			let d = v0 + i * nv + j1;
			T_TRI.push(a as i32); T_TRI.push(b as i32); T_TRI.push(c as i32);
			T_TRI.push(a as i32); T_TRI.push(c as i32); T_TRI.push(d as i32);
		}
	}
}
export fn hc_build_hair() i32 {
	HPOS.clear(); HNRM.clear(); HUV.clear(); HTRI.clear();
	H_YP.clear(); H_YN.clear(); H_JW.clear(); H_WW.clear();
	B_YP.clear(); B_YN.clear(); B_UV.clear(); B_TRI.clear();
	T_YP.clear(); T_YN.clear(); T_TRI.clear(); TZ_POS.clear(); TZ_NRM.clear();
	HNV = 0; HNT = 0;
	if PK_OK == 0 { refresh_views(); return 0; }
	hr_measure();
	let st_idx = round(MP[102]) as int;
	let styles = h_styles();
	let lmul = cl(MP[104], 0.35, 2.0) as f32;
	let seed = max(round(MP[111]) as int, 1);
	HR_RS = seed as uint;
	if st_idx >= 0 && st_idx < styles.len {
		var st = styles[st_idx];
		st.length *= lmul;
		st.tail *= lmul;
		if MP[109] > -5.0 { st.part = cl(MP[109], -0.7, 0.7) as f32; }
		let k = clamp(st.points, 4, 24);
		let card_w = st.width * 0.001 * (HR_UNIT / 0.1);
		var roots f32[>..] = [];
		let cols = 38;
		let rows = 22;
		for j in rows {
			for i in cols {
				let a = hr_rnd();
				let b = hr_rnd();
				let c = hr_rnd();
				let az = ((i as f32 + a) / (cols as f32)) * (TWO_PI as f32) - (PI as f32);
				let dy = -0.70 + ((j as f32 + b) / (rows as f32)) * 1.70;
				let rr = sqrt(max(1.0 - (dy * dy) as real, 0.0)) as f32;
				let dx = sin(az as real) as f32 * rr;
				let dz = cos(az as real) as f32 * rr;
				let ln = hr_line(dx, dy, dz);
				let sc_w = sstep(ln - 0.02, ln + 0.03, dy);
				if c < sc_w {
					roots.push(dx); roots.push(dy); roots.push(dz);
				}
			}
		}
		let nr = roots.len / 3;
		var raw_pts f32[>..] = [];
		var s_grp int[>..] = [];
		var path f32[>..] = [];
		for i in nr {
			let dx = roots[i * 3]; let dy = roots[i * 3 + 1]; let dz = roots[i * 3 + 2];
			let lay = hr_rnd();
			let lv = hr_rnd();
			let ph = hr_rnd() * (TWO_PI as f32);
			let rad0 = hr_radius(dx, dy, dz);
			var rx0 = HR_CTR[0] + dx * rad0;
			var ry0 = HR_CTR[1] + dy * rad0;
			var rz0 = HR_CTR[2] + dz * rad0;
			let side_s f32 = if (rx0 - HR_CTR[0]) / HR_UNIT > st.part { 1.0 } else { -1.0 };
			let fr = st.fringe > 0.0 && dz > 0.28 && abs(dx) < 0.70 && dy < hr_line(dx, dy, dz) + 0.24;
			path.clear();
			if st.tie > 0 && !fr {
				let sg f32 = if (st.tie == 2 || st.tie == 4) && dx < 0.0 { -1.0 } else { 1.0 };
				let ta = (st.tie_az as real) * D2R * (sg as real);
				let th = sqrt(max(1.0 - (st.tie_y * st.tie_y) as real, 0.0)) as f32;
				let gx = sin(ta) as f32 * th;
				let gy = st.tie_y;
				let gz = cos(ta) as f32 * th;
				let gr = hr_radius(gx, gy, gz);
				let tx = HR_CTR[0] + gx * (gr + 0.20 * HR_UNIT);
				let ty = HR_CTR[1] + gy * (gr + 0.20 * HR_UNIT);
				let tz = HR_CTR[2] + gz * (gr + 0.20 * HR_UNIT);
				let na = 9;
				for s in na + 1 {
					let tt = (s as f32) / (na as f32);
					var mx = lrpf(dx, gx, tt);
					var my = lrpf(dy, gy, tt);
					var mz = lrpf(dz, gz, tt);
					let ml = max(len3f(mx, my, mz), 1.0e-5);
					mx /= ml; my /= ml; mz /= ml;
					let mr = hr_radius(mx, my, mz) + HR_UNIT * (0.015 + st.lift * lay * (sin((PI * (tt as real))) as f32));
					let w = sstep(0.58, 1.0, tt);
					let ww = w * w;
					path.push(lrpf(HR_CTR[0] + mx * mr, tx, ww));
					path.push(lrpf(HR_CTR[1] + my * mr, ty, ww));
					path.push(lrpf(HR_CTR[2] + mz * mr, tz, ww));
				}
				if st.tie == 3 || st.tie == 4 {
					let rb = st.tail * HR_UNIT;
					var b1x = gy; var b1y = -gx; var b1z f32 = 0.0;
					let bl = max(len3f(b1x, b1y, b1z), 1.0e-5);
					b1x /= bl; b1y /= bl;
					let b2x = gy * b1z - gz * b1y;
					let b2y = gz * b1x - gx * b1z;
					let b2z = gx * b1y - gy * b1x;
					for s in 1..15 {
						let tt = (s as f32) / 14.0;
						let an = (ph + 13.8 * tt) as real;
						let ca = cos(an) as f32; let sa = sin(an) as f32;
						let rad_b = rb * (0.55 + 0.42 * lv) * (1.0 - 0.48 * tt);
						path.push(tx + gx * rb * (0.4 * tt + 0.2) + (b1x * ca + b2x * sa) * rad_b);
						path.push(ty + gy * rb * (0.4 * tt + 0.2) + (b1y * ca + b2y * sa) * rad_b);
						path.push(tz + gz * rb * (0.4 * tt + 0.2) + (b1z * ca + b2z * sa) * rad_b);
					}
				} else {
					let ntail = clamp((st.tail / 0.14) as int, 4, 48);
					var px = tx; var py = ty; var pz = tz;
					var vx = gx * 0.85; var vy = gy * 0.55 + 0.32; var vz = gz * 0.85;
					let vl = max(len3f(vx, vy, vz), 1.0e-5);
					vx /= vl; vy /= vl; vz /= vl;
					let ox = cos(ph as real) as f32 * 0.17 * HR_UNIT * sqrt(lay as real) as f32;
					let oz = sin(ph as real) as f32 * 0.17 * HR_UNIT * sqrt(lay as real) as f32;
					for s in 1..ntail + 1 {
						let tt = (s as f32) / (ntail as f32);
						if tt <= 1.0 - st.vary * lv * 0.5 {
							vx = vx * 0.85;
							vy = vy * 0.85 - 0.18;
							vz = vz * 0.85;
							let dl = max(len3f(vx, vy, vz), 1.0e-5);
							vx /= dl; vy /= dl; vz /= dl;
							let fan = 0.35 + 1.8 * st.fan * tt;
							let wamp = st.wave * HR_UNIT * tt;
							let wx = sin((ph + 9.5 * tt) as real) as f32 * wamp;
							let wz = cos((ph + 7.5 * tt) as real) as f32 * wamp * 0.5;
							let kx, ky, kz = hr_keep(px + vx * (0.14 * HR_UNIT) + ox * fan * 0.12 + wx * 0.22, py + vy * (0.14 * HR_UNIT), pz + vz * (0.14 * HR_UNIT) + oz * fan * 0.12 + wz * 0.22, 0.08 * HR_UNIT);
							px = kx; py = ky; pz = kz;
							path.push(px); path.push(py); path.push(pz);
						}
					}
				}
				s_grp.push(if dx < 0.0 { 0 } else { 1 });
			} else {
				let cm = if fr { 2 } else { st.comb };
				let len_u = if fr { st.fringe * 1.9 } else { st.length * lrpf(st.sides, 1.0, sstep(-0.2, 0.55, dy)) * (1.0 - st.vary * lv) };
				let nst = clamp((len_u / 0.11) as int, 3, 58);
				var px = rx0; var py = ry0; var pz = rz0;
				var vx = dx; var vy = dy; var vz = dz;
				path.push(px); path.push(py); path.push(pz);
				for s in 1..nst + 1 {
					let ex0 = px - HR_CTR[0]; let ey0 = py - HR_CTR[1]; let ez0 = pz - HR_CTR[2];
					let el = max(len3f(ex0, ey0, ez0), 1.0e-5);
					let ex = ex0 / el; let ey = ey0 / el; let ez = ez0 / el;
					if cm == 3 {
						vx = vx * 0.70 + (ex * st.stiff) * 0.30;
						vy = vy * 0.70 + (ey * st.stiff - (1.0 - st.stiff)) * 0.30;
						vz = vz * 0.70 + (ez * st.stiff) * 0.30;
					} else {
						var wx = ex; var wy f32 = -0.7; var wz = ez;
						if cm == 0 { wx = side_s * (0.35 + 1.4 * clf(ey * 1.5, 0.0, 1.0)) * sstep(-0.55, 0.25, ez); wy = -1.0; wz = -0.12; }
						if cm == 1 { wx = 0.15 * side_s; wy = -0.28; wz = -1.0; }
						if cm == 2 { wx = st.sweep * 0.75 + ex * 0.25; wy = -0.55; wz = 0.9; }
						let dt = wx * ex + wy * ey + wz * ez;
						var tgx = wx - ex * dt; var tgy = wy - ey * dt; var tgz = wz - ez * dt;
						let tl = max(len3f(tgx, tgy, tgz), 1.0e-5);
						tgx /= tl; tgy /= tl; tgz /= tl;
						let hrl = hr_line(ex, ey, ez);
						let o = sstep(hrl - 0.25, hrl + 0.05, ey);
						let gx = tgx * o; let gy = tgy * o - (1.0 - o); let gz = tgz * o;
						if s == 1 { vx = dx * (0.18 + 1.8 * st.lift) + gx; vy = dy * (0.18 + 1.8 * st.lift) + gy; vz = dz * (0.18 + 1.8 * st.lift) + gz; }
						else { vx = vx * 0.59 + gx * 0.41; vy = vy * 0.59 + gy * 0.41; vz = vz * 0.59 + gz * 0.41; }
					}
					let vl = max(len3f(vx, vy, vz), 1.0e-5);
					vx /= vl; vy /= vl; vz /= vl;
					let tt = (s as f32) / (nst as f32);
					let wv = (st.wave + st.curl * 0.8) * HR_UNIT * tt;
					let wvx = sin((ph + (st.waves + st.turns) * 5.9 * tt) as real) as f32 * wv * 0.22;
					let wvz = cos((ph + (st.waves + st.turns) * 5.9 * tt) as real) as f32 * wv * 0.22;
					var qx = px + vx * (0.11 * HR_UNIT) + wvx;
					var qy = py + vy * (0.11 * HR_UNIT);
					var qz = pz + vz * (0.11 * HR_UNIT) + wvz;
					if !fr && st.face > 0.0 && qz > HR_CTR[2] + 0.1 * HR_UNIT && qy > HR_CTR[1] - 1.5 * HR_UNIT && qy < HR_CTR[1] + 0.45 * HR_UNIT {
						let ax = abs(qx - HR_CTR[0]);
						let lim = st.face * HR_UNIT * (1.0 - sstep(0.1, 0.5, (qy - HR_CTR[1]) / HR_UNIT));
						if ax < lim { qx = HR_CTR[0] + side_s * (ax + (lim - ax) * 0.72); }
					}
					if cm != 3 {
						let kx, ky, kz = hr_keep(qx, qy, qz, HR_UNIT * (0.015 + st.lift * (0.3 + 0.58 * lay)));
						qx = kx; qy = ky; qz = kz;
					}
					px = qx; py = qy; pz = qz;
					path.push(px); path.push(py); path.push(pz);
					if st.cut > 0.0 && !fr && py < HR_CTR[1] - st.cut * HR_UNIT { break; }
					if fr && py < HR_CTR[1] + (0.55 - st.fringe) * HR_UNIT { break; }
				}
				s_grp.push(if fr { 2 } else { if side_s < 0.0 { 0 } else { 1 } });
			}
			let np = path.len / 3;
			var tot f32 = 0.0;
			for s in max(np - 1, 0) {
				tot += len3f(path[(s + 1) * 3] - path[s * 3], path[(s + 1) * 3 + 1] - path[s * 3 + 1], path[(s + 1) * 3 + 2] - path[s * 3 + 2]);
			}
			var seg = 0; var acc f32 = 0.0;
			for e in k {
				if np <= 1 || tot <= 1.0e-5 {
					raw_pts.push(path[0]); raw_pts.push(path[1]); raw_pts.push(path[2]);
				} else if e == k - 1 {
					raw_pts.push(path[(np - 1) * 3]); raw_pts.push(path[(np - 1) * 3 + 1]); raw_pts.push(path[(np - 1) * 3 + 2]);
				} else {
					let tgt = tot * (e as f32) / ((k - 1) as f32);
					while seg < np - 2 {
						let sl = len3f(path[(seg + 1) * 3] - path[seg * 3], path[(seg + 1) * 3 + 1] - path[seg * 3 + 1], path[(seg + 1) * 3 + 2] - path[seg * 3 + 2]);
						if acc + sl >= tgt { break; }
						acc += sl; seg += 1;
					}
					let sl = max(len3f(path[(seg + 1) * 3] - path[seg * 3], path[(seg + 1) * 3 + 1] - path[seg * 3 + 1], path[(seg + 1) * 3 + 2] - path[seg * 3 + 2]), 1.0e-5);
					let u = clf((tgt - acc) / sl, 0.0, 1.0);
					raw_pts.push(lrpf(path[seg * 3], path[(seg + 1) * 3], u));
					raw_pts.push(lrpf(path[seg * 3 + 1], path[(seg + 1) * 3 + 1], u));
					raw_pts.push(lrpf(path[seg * 3 + 2], path[(seg + 1) * 3 + 2], u));
				}
			}
		}
		var clumped f32[>..] = []; clumped.append(raw_pts);
		let nlocks = clamp(st.locks, 1, max(nr, 1));
		if st.clump > 0.01 && nr > 4 {
			for i in nr {
				var best = i; var bd f32 = 1.0e9;
				for j in nlocks {
					let l = (j * nr) / nlocks;
					if s_grp[l] == s_grp[i] {
						let dd = len3f(raw_pts[l * k * 3] - raw_pts[i * k * 3], raw_pts[l * k * 3 + 1] - raw_pts[i * k * 3 + 1], raw_pts[l * k * 3 + 2] - raw_pts[i * k * 3 + 2]);
						if dd < bd { bd = dd; best = l; }
					}
				}
				if best != i {
					for e in 1..k {
						let amt = st.clump * 0.72 * (sqrt((e as real) / (max(k - 1, 1) as real)) as f32);
						let oi = (i * k + e) * 3;
						let ol = (best * k + e) * 3;
						let mx = lrpf(raw_pts[oi], raw_pts[ol], amt);
						let my = lrpf(raw_pts[oi + 1], raw_pts[ol + 1], amt);
						let mz = lrpf(raw_pts[oi + 2], raw_pts[ol + 2], amt);
						var kx = mx; var ky = my; var kz = mz;
						if st.comb != 3 { let qx, qy, qz = hr_keep(mx, my, mz, 0.01 * HR_UNIT); kx = qx; ky = qy; kz = qz; }
						clumped[oi] = kx; clumped[oi + 1] = ky; clumped[oi + 2] = kz;
					}
				}
			}
		}
		for i in nr {
			emit_card_strip(clumped[i * k * 3..(i + 1) * k * 3], k, roots[i * 3], roots[i * 3 + 1], roots[i * 3 + 2], card_w, H_YP, H_YN, HUV, HTRI, true);
		}
		if st.tie == 1 || st.tie == 2 {
			let nties = if st.tie == 2 { 2 } else { 1 };
			for ti in nties {
				let sg f32 = if st.tie == 2 && ti == 1 { -1.0 } else { 1.0 };
				let ta = (st.tie_az as real) * D2R * (sg as real);
				let th = sqrt(max(1.0 - (st.tie_y * st.tie_y) as real, 0.0)) as f32;
				let gx = sin(ta) as f32 * th;
				let gy = st.tie_y;
				let gz = cos(ta) as f32 * th;
				let gr = hr_radius(gx, gy, gz) + 0.18 * HR_UNIT;
				add_torus_tie(HR_CTR[0] + gx * gr, HR_CTR[1] + gy * gr, HR_CTR[2] + gz * gr, gx, gy, gz, 0.17 * HR_UNIT, 0.048 * HR_UNIT);
			}
		}
	}
	let fh = round(MP[110]) as int;
	if fh >= 1 && fh <= 5 {
		let bk = if fh == 1 { 3 } else { if fh == 5 { 7 } else { 5 } };
		let blen = (if fh == 1 { 0.004 } else { if fh == 2 { 0.012 } else { if fh == 3 { 0.024 } else { if fh == 4 { 0.022 } else { 0.055 } } } }) * MH_SC;
		let bw = (if fh == 1 { 0.0028 } else { 0.0048 }) * MH_SC;
		let mouth_y = LM[9 * 3 + 2] as f32;
		let nose_y = LM[8 * 3 + 2] as f32;
		var step_f = 0;
		for bv in NB_V {
			let r = VREG[bv] as int;
			if r == 7 || r == 8 {
				let mv = B2M[bv] as int;
				let px = PVX[mv]; let py = PVY[mv]; let pz = PVZ[mv];
				let ax = abs(px);
				let is_must = py > mouth_y + 0.002 * MH_SC && py < nose_y - 0.003 * MH_SC && ax < 0.028 * MH_SC && pz > (J_HZ[22] as f32) + 0.058 * MH_SC;
				let is_chin = py < mouth_y - 0.004 * MH_SC && ax < 0.025 * MH_SC && pz > (J_HZ[22] as f32) + 0.04 * MH_SC;
				let is_jaw = r == 7 && py < mouth_y + 0.015 * MH_SC && pz > (J_HZ[22] as f32) - 0.01 * MH_SC && MNZ[mv] > -0.15 && MNY[mv] < 0.25;
				let want = if fh == 2 { is_must } else { if fh == 3 { is_must || is_chin } else { is_must || is_chin || is_jaw } };
				if want {
					step_f += 1;
					if (step_f % 2) == 0 {
						var bpts f32[>..] = [];
						var cx = px; var cy = py; var cz = pz;
						var dx = MNX[mv]; var dy = MNY[mv]; var dz = MNZ[mv];
						for s in bk {
							bpts.push(cx); bpts.push(cy); bpts.push(cz);
							dx = dx * 0.70;
							dy = dy * 0.70 - 0.45;
							dz = dz * 0.70 + 0.12;
							let dl = max(len3f(dx, dy, dz), 1.0e-5);
							dx /= dl; dy /= dl; dz /= dl;
							let ds = blen / (max(bk - 1, 1) as f32);
							cx += dx * ds; cy += dy * ds; cz += dz * ds;
						}
						emit_card_strip(bpts, bk, MNX[mv], MNY[mv], MNZ[mv], bw, B_YP, B_YN, B_UV, B_TRI, false);
					}
				}
			}
		}
	}
	let nh = H_YP.len / 3;
	let nb = B_YP.len / 3;
	HNV = nh + nb;
	for i in nh {
		HPOS.push(H_YP[i * 3]); HPOS.push(-H_YP[i * 3 + 2]); HPOS.push(H_YP[i * 3 + 1]);
		HNRM.push(H_YN[i * 3]); HNRM.push(-H_YN[i * 3 + 2]); HNRM.push(H_YN[i * 3 + 1]);
	}
	for i in nb {
		HPOS.push(B_YP[i * 3]); HPOS.push(-B_YP[i * 3 + 2]); HPOS.push(B_YP[i * 3 + 1]);
		HNRM.push(B_YN[i * 3]); HNRM.push(-B_YN[i * 3 + 2]); HNRM.push(B_YN[i * 3 + 1]);
		HUV.push(B_UV[i * 2]); HUV.push(B_UV[i * 2 + 1]);
	}
	for i in B_TRI.len { HTRI.push(B_TRI[i] + (nh as i32)); }
	HNT = HTRI.len / 3;
	let ntv = T_YP.len / 3;
	for i in ntv {
		TZ_POS.push(T_YP[i * 3]); TZ_POS.push(-T_YP[i * 3 + 2]); TZ_POS.push(T_YP[i * 3 + 1]);
		TZ_NRM.push(T_YN[i * 3]); TZ_NRM.push(-T_YN[i * 3 + 2]); TZ_NRM.push(T_YN[i * 3 + 1]);
	}
	refresh_views();
	return HNV as i32;
}
fn fab_spec(fab int) FabP {
	if fab == 1 { return FabP{0.42, 0.00008, 0.04, 0.58, 0.0042, 0.84, 0.0, 0}; }
	if fab == 2 { return FabP{0.29, 0.00022, 0.09, 0.52, 0.0038, 0.80, 0.0, 0}; }
	if fab == 3 { return FabP{0.21, 0.0022, 0.45, 0.45, 0.0034, 0.74, 0.0, 0}; }
	if fab == 4 { return FabP{0.55, 0.00004, 0.015, 0.55, 0.0045, 0.38, 0.05, 0}; }
	if fab == 5 { return FabP{0.11, 0.0005, 1.25, 0.22, 0.0028, 0.28, 0.04, 0}; }
	if fab == 5 + 1 { return FabP{0.09, 0.0014, 0.95, 0.38, 0.0028, 0.70, 0.0, 1}; }
	if fab == 7 { return FabP{0.19, 0.0048, 0.85, 0.42, 0.0029, 0.44, 0.02, 0}; }
	FabP{0.18, 0.0004, 0.18, 0.48, 0.0032, 0.78, 0.0, 0}
}
fn add_ctri(ax f32, ay f32, az f32, bx f32, by f32, bz f32, cx f32, cy f32, cz f32, hint_nx f32, hint_ny f32, hint_nz f32, clr f32) {
	let ux = bx - ax; let uy = by - ay; let uz = bz - az;
	let wx = cx - ax; let wy = cy - ay; let wz = cz - az;
	var nx = uy * wz - uz * wy;
	var ny = uz * wx - ux * wz;
	var nz = ux * wy - uy * wx;
	let l = len3f(nx, ny, nz);
	if l < 1.0e-8 { return; }
	nx /= l; ny /= l; nz /= l;
	if nx * hint_nx + ny * hint_ny + nz * hint_nz < 0.0 { nx = -nx; ny = -ny; nz = -nz; }
	CT_AX.push(ax); CT_AY.push(ay); CT_AZ.push(az);
	CT_BX.push(bx); CT_BY.push(by); CT_BZ.push(bz);
	CT_CX.push(cx); CT_CY.push(cy); CT_CZ.push(cz);
	CT_NX.push(nx); CT_NY.push(ny); CT_NZ.push(nz);
	CT_CLR.push(clr);
}
fn build_bgrid(include_worn bool) {
	CT_AX.clear(); CT_AY.clear(); CT_AZ.clear();
	CT_BX.clear(); CT_BY.clear(); CT_BZ.clear();
	CT_CX.clear(); CT_CY.clear(); CT_CZ.clear();
	CT_NX.clear(); CT_NY.clear(); CT_NZ.clear();
	CT_CLR.clear();
	var lx f32 = 1.0e9; var ly f32 = 1.0e9; var lz f32 = 1.0e9;
	var hx f32 = -1.0e9; var hy f32 = -1.0e9; var hz f32 = -1.0e9;
	for bv in NB_V {
		let mv = B2M[bv] as int;
		let x = PVX[mv]; let y = PVY[mv]; let z = PVZ[mv];
		if x < lx { lx = x; } if x > hx { hx = x; }
		if y < ly { ly = y; } if y > hy { hy = y; }
		if z < lz { lz = z; } if z > hz { hz = z; }
	}
	for q in NB_Q {
		let m0 = B2M[M2B[BQ[q * 8] as int] as int] as int;
		let m1 = B2M[M2B[BQ[q * 8 + 1] as int] as int] as int;
		let m2 = B2M[M2B[BQ[q * 8 + 2] as int] as int] as int;
		let m3 = B2M[M2B[BQ[q * 8 + 3] as int] as int] as int;
		let hnx = MNX[m0] + MNX[m1] + MNX[m2];
		let hny = MNY[m0] + MNY[m1] + MNY[m2];
		let hnz = MNZ[m0] + MNZ[m1] + MNZ[m2];
		add_ctri(PVX[m0], PVY[m0], PVZ[m0], PVX[m1], PVY[m1], PVZ[m1], PVX[m2], PVY[m2], PVZ[m2], hnx, hny, hnz, 0.0034);
		let hnx2 = MNX[m0] + MNX[m2] + MNX[m3];
		let hny2 = MNY[m0] + MNY[m2] + MNY[m3];
		let hnz2 = MNZ[m0] + MNZ[m2] + MNZ[m3];
		add_ctri(PVX[m0], PVY[m0], PVZ[m0], PVX[m2], PVY[m2], PVZ[m2], PVX[m3], PVY[m3], PVZ[m3], hnx2, hny2, hnz2, 0.0034);
	}
	if include_worn && W_TRI.len >= 3 {
		for t in W_TRI.len / 3 {
			let a = W_TRI[t * 3] as int;
			let b = W_TRI[t * 3 + 1] as int;
			let c = W_TRI[t * 3 + 2] as int;
			let ax = W_YP[a * 3]; let ay = W_YP[a * 3 + 1]; let az = W_YP[a * 3 + 2];
			let bx = W_YP[b * 3]; let by = W_YP[b * 3 + 1]; let bz = W_YP[b * 3 + 2];
			let cx = W_YP[c * 3]; let cy = W_YP[c * 3 + 1]; let cz = W_YP[c * 3 + 2];
			if ax < lx { lx = ax; } if ax > hx { hx = ax; }
			if ay < ly { ly = ay; } if ay > hy { hy = ay; }
			if az < lz { lz = az; } if az > hz { hz = az; }
			let hnx = W_YN[a * 3] + W_YN[b * 3] + W_YN[c * 3];
			let hny = W_YN[a * 3 + 1] + W_YN[b * 3 + 1] + W_YN[c * 3 + 1];
			let hnz = W_YN[a * 3 + 2] + W_YN[b * 3 + 2] + W_YN[c * 3 + 2];
			add_ctri(ax, ay, az, bx, by, bz, cx, cy, cz, hnx, hny, hnz, 0.0028);
		}
	}
	let gpad f32 = 0.08;
	BG_O[0] = (lx - gpad) as real; BG_O[1] = (ly - gpad) as real; BG_O[2] = (lz - gpad) as real;
	let gx = 20; let gy = 32; let gz = 20;
	BG_S[0] = max(((hx - lx + 2.0 * gpad) as real) / (gx as real), 0.01);
	BG_S[1] = max(((hy - ly + 2.0 * gpad) as real) / (gy as real), 0.01);
	BG_S[2] = max(((hz - lz + 2.0 * gpad) as real) / (gz as real), 0.01);
	BG_HEAD.clear(); BG_HEAD.resize(gx * gy * gz, -1);
	BG_TRI.clear(); BG_NEXT.clear();
	let mrg = 0.038;
	for t in CT_AX.len {
		let x0 = clamp(floor(((min(CT_AX[t], min(CT_BX[t], CT_CX[t])) as real) - mrg - BG_O[0]) / BG_S[0]) as int, 0, gx - 1);
		let x1 = clamp(floor(((max(CT_AX[t], max(CT_BX[t], CT_CX[t])) as real) + mrg - BG_O[0]) / BG_S[0]) as int, 0, gx - 1);
		let y0 = clamp(floor(((min(CT_AY[t], min(CT_BY[t], CT_CY[t])) as real) - mrg - BG_O[1]) / BG_S[1]) as int, 0, gy - 1);
		let y1 = clamp(floor(((max(CT_AY[t], max(CT_BY[t], CT_CY[t])) as real) + mrg - BG_O[1]) / BG_S[1]) as int, 0, gy - 1);
		let z0 = clamp(floor(((min(CT_AZ[t], min(CT_BZ[t], CT_CZ[t])) as real) - mrg - BG_O[2]) / BG_S[2]) as int, 0, gz - 1);
		let z1 = clamp(floor(((max(CT_AZ[t], max(CT_BZ[t], CT_CZ[t])) as real) + mrg - BG_O[2]) / BG_S[2]) as int, 0, gz - 1);
		for iz in z0..z1 + 1 {
			for iy in y0..y1 + 1 {
				for ix in x0..x1 + 1 {
					let ci = (iz * gy + iy) * gx + ix;
					let nd = BG_TRI.len as i32;
					BG_TRI.push(t as i32);
					BG_NEXT.push(BG_HEAD[ci]);
					BG_HEAD[ci] = nd;
				}
			}
		}
	}
}
fn cp_tri(px f32, py f32, pz f32, ax f32, ay f32, az f32, bx f32, by f32, bz f32, cx f32, cy f32, cz f32) f32, f32, f32 {
	let abx = bx - ax; let aby = by - ay; let abz = bz - az;
	let acx = cx - ax; let acy = cy - ay; let acz = cz - az;
	let apx = px - ax; let apy = py - ay; let apz = pz - az;
	let d1 = abx * apx + aby * apy + abz * apz;
	let d2 = acx * apx + acy * apy + acz * apz;
	if d1 <= 0.0 && d2 <= 0.0 { return ax, ay, az; }
	let bpx = px - bx; let bpy = py - by; let bpz = pz - bz;
	let d3 = abx * bpx + aby * bpy + abz * bpz;
	let d4 = acx * bpx + acy * bpy + acz * bpz;
	if d3 >= 0.0 && d4 <= d3 { return bx, by, bz; }
	let vc = d1 * d4 - d3 * d2;
	if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
		let v = d1 / max(d1 - d3, 1.0e-9);
		return ax + abx * v, ay + aby * v, az + abz * v;
	}
	let cpx = px - cx; let cpy = py - cy; let cpz = pz - cz;
	let d5 = abx * cpx + aby * cpy + abz * cpz;
	let d7 = acx * cpx + acy * cpy + acz * cpz;
	if d7 >= 0.0 && d5 <= d7 { return cx, cy, cz; }
	let vb = d5 * d2 - d1 * d7;
	if vb <= 0.0 && d2 >= 0.0 && d7 <= 0.0 {
		let w = d2 / max(d2 - d7, 1.0e-9);
		return ax + acx * w, ay + acy * w, az + acz * w;
	}
	let va = d3 * d7 - d5 * d4;
	if va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d7) >= 0.0 {
		let w = (d4 - d3) / max((d4 - d3) + (d5 - d7), 1.0e-9);
		return bx + (cx - bx) * w, by + (cy - by) * w, bz + (cz - bz) * w;
	}
	let den = 1.0 / max(va + vb + vc, 1.0e-9);
	let v = vb * den;
	let w = vc * den;
	return ax + abx * v + acx * w, ay + aby * v + acy * w, az + abz * v + acz * w;
}
fn bgrid_nearest(px f32, py f32, pz f32) int, f32, f32, f32, f32 {
	let gx = 20; let gy = 32; let gz = 20;
	let ix = clamp(floor(((px as real) - BG_O[0]) / BG_S[0]) as int, 0, gx - 1);
	let iy = clamp(floor(((py as real) - BG_O[1]) / BG_S[1]) as int, 0, gy - 1);
	let iz = clamp(floor(((pz as real) - BG_O[2]) / BG_S[2]) as int, 0, gz - 1);
	var bt = -1;
	var bd2 f32 = 1.0e9;
	var bqx = px; var bqy = py; var bqz = pz;
	var nd = BG_HEAD[(iz * gy + iy) * gx + ix] as int;
	while nd >= 0 {
		let t = BG_TRI[nd] as int;
		let qx, qy, qz = cp_tri(px, py, pz, CT_AX[t], CT_AY[t], CT_AZ[t], CT_BX[t], CT_BY[t], CT_BZ[t], CT_CX[t], CT_CY[t], CT_CZ[t]);
		let dx = px - qx; let dy = py - qy; let dz = pz - qz;
		let d2 = dx * dx + dy * dy + dz * dz;
		if d2 < bd2 { bd2 = d2; bt = t; bqx = qx; bqy = qy; bqz = qz; }
		nd = BG_NEXT[nd] as int;
	}
	if bt < 0 || bd2 > 0.0004 {
		for z2 in max(iz - 1, 0)..min(iz + 2, gz) {
			for y2 in max(iy - 1, 0)..min(iy + 2, gy) {
				for x2 in max(ix - 1, 0)..min(ix + 2, gx) {
					var nd2 = BG_HEAD[(z2 * gy + y2) * gx + x2] as int;
					while nd2 >= 0 {
						let t = BG_TRI[nd2] as int;
						let qx, qy, qz = cp_tri(px, py, pz, CT_AX[t], CT_AY[t], CT_AZ[t], CT_BX[t], CT_BY[t], CT_BZ[t], CT_CX[t], CT_CY[t], CT_CZ[t]);
						let dx = px - qx; let dy = py - qy; let dz = pz - qz;
						let d2 = dx * dx + dy * dy + dz * dz;
						if d2 < bd2 { bd2 = d2; bt = t; bqx = qx; bqy = qy; bqz = qz; }
						nd2 = BG_NEXT[nd2] as int;
					}
				}
			}
		}
	}
	if bt < 0 {
		for t in CT_AX.len {
			let qx, qy, qz = cp_tri(px, py, pz, CT_AX[t], CT_AY[t], CT_AZ[t], CT_BX[t], CT_BY[t], CT_BZ[t], CT_CX[t], CT_CY[t], CT_CZ[t]);
			let dx = px - qx; let dy = py - qy; let dz = pz - qz;
			let d2 = dx * dx + dy * dy + dz * dz;
			if d2 < bd2 { bd2 = d2; bt = t; bqx = qx; bqy = qy; bqz = qz; }
		}
	}
	return bt, bqx, bqy, bqz, bd2;
}
fn bgrid_push_pt(px f32, py f32, pz f32, extra f32) f32, f32, f32 {
	let bt, qx, qy, qz, d2 = bgrid_nearest(px, py, pz);
	if bt < 0 { return px, py, pz; }
	let nx = CT_NX[bt]; let ny = CT_NY[bt]; let nz = CT_NZ[bt];
	let clr = CT_CLR[bt] + extra;
	let dx = px - qx; let dy = py - qy; let dz = pz - qz;
	let sd = dx * nx + dy * ny + dz * nz;
	if sd < 0.0 {
		return qx + nx * clr, qy + ny * clr, qz + nz * clr;
	}
	let d = sqrt(d2 as real) as f32;
	if d < clr {
		if d > 1.0e-5 && dx * nx + dy * ny + dz * nz > 0.25 * d {
			let k = clr / d;
			return qx + dx * k, qy + dy * k, qz + dz * k;
		}
		return qx + nx * clr, qy + ny * clr, qz + nz * clr;
	}
	return px, py, pz;
}
fn setup_body_colliders(extra real) {
	cloth::clear_colliders();
	let links int[18] = [1, 10, 10, 11, 11, 12, 12, 21, 15, 15 + 1, 15 + 1, 17, 18, 19, 19, 20, 2, 3];
	let rads real[9] = [0.095, 0.088, 0.092, 0.048, 0.038, 0.030, 0.038, 0.030, 0.058];
	let sc = MH_SC as real;
	for i in 9 {
		let a = links[i * 2]; let b = links[i * 2 + 1];
		cloth::pill(J_HX[a], J_HY[a], J_HZ[a], J_HX[b], J_HY[b], J_HZ[b], rads[i] * sc + extra);
	}
	cloth::pill(J_HX[7 - 1], J_HY[7 - 1], J_HZ[7 - 1], J_HX[7], J_HY[7], J_HZ[7], 0.058 * sc + extra);
	cloth::pill(J_HX[3], J_HY[3], J_HZ[3], J_HX[4], J_HY[4], J_HZ[4], 0.042 * sc + extra);
	cloth::pill(J_HX[7], J_HY[7], J_HZ[7], J_HX[8], J_HY[8], J_HZ[8], 0.042 * sc + extra);
	cloth::ball(J_HX[22], J_HY[22] + 0.05 * sc, J_HZ[22], 0.085 * sc + extra);
}
fn smooth_profile(rs f32[>..]&, n int, r_def f32) {
	var any = false;
	var s f32 = 0.0; var cnt = 0;
	for i in n { if rs[i] > 0.001 { any = true; s += rs[i]; cnt += 1; } }
	if !any { for i in n { rs[i] = r_def; } return; }
	let avg = s / (cnt as f32);
	for pass in 4 {
		for i in n {
			if rs[i] <= 0.001 {
				let l = rs[(i + n - 1) % n];
				let r = rs[(i + 1) % n];
				if l > 0.001 && r > 0.001 { rs[i] = (l + r) * 0.5; }
				else if l > 0.001 { rs[i] = l; }
				else if r > 0.001 { rs[i] = r; }
			}
		}
	}
	for i in n { if rs[i] <= 0.001 { rs[i] = avg; } }
	for pass in 2 {
		var cp f32[>..] = []; cp.append(rs);
		for i in n {
			let l = cp[(i + n - 1) % n];
			let r = cp[(i + 1) % n];
			rs[i] = max(cp[i], cp[i] * 0.5 + (l + r) * 0.25);
		}
	}
}
fn torso_ring(y0 f32, band f32, cx f32, cz f32, n int, x_lim f32, rs f32[>..]&) {
	rs.clear(); rs.resize(n, 0.0);
	for bv in NB_V {
		let r = VREG[bv] as int;
		if (r >= 1 && r <= 5) || r == 23 || r == 27 {
			let mv = B2M[bv] as int;
			let px = PVX[mv]; let py = PVY[mv]; let pz = PVZ[mv];
			if abs(py - y0) <= band && abs(px - cx) <= x_lim {
				let dx = px - cx; let dz = pz - cz;
				let d = sqrt((dx * dx + dz * dz) as real) as f32;
				let ai = (((atan2(dx as real, dz as real) / TWO_PI + 0.5) * (n as real)) as int + n) % n;
				if d > rs[ai] { rs[ai] = d; }
			}
		}
	}
	smooth_profile(rs, n, 0.11 * MH_SC);
}
fn limb_frame(ax f32, ay f32, az f32, bx f32, by f32, bz f32) f32, f32, f32, f32, f32, f32, f32, f32, f32, f32 {
	var ux = bx - ax; var uy = by - ay; var uz = bz - az;
	let L = max(len3f(ux, uy, uz), 1.0e-5);
	ux /= L; uy /= L; uz /= L;
	var rx f32 = 0.0; var ry f32 = 0.0; var rz f32 = 1.0;
	if abs(uz) > 0.85 { rx = 1.0; ry = 0.0; rz = 0.0; }
	var e1x = uy * rz - uz * ry;
	var e1y = uz * rx - ux * rz;
	var e1z = ux * ry - uy * rx;
	let l1 = max(len3f(e1x, e1y, e1z), 1.0e-5);
	e1x /= l1; e1y /= l1; e1z /= l1;
	let e2x = uy * e1z - uz * e1y;
	let e2y = uz * e1x - ux * e1z;
	let e2z = ux * e1y - uy * e1x;
	return ux, uy, uz, e1x, e1y, e1z, e2x, e2y, e2z, L;
}
fn limb_ring(ax f32, ay f32, az f32, bx f32, by f32, bz f32, t f32, band f32, reg_lo int, reg_hi int, n int, rs f32[>..]&) {
	rs.clear(); rs.resize(n, 0.0);
	let ux, uy, uz, e1x, e1y, e1z, e2x, e2y, e2z, L = limb_frame(ax, ay, az, bx, by, bz);
	let ox = ax + ux * (L * t);
	let oy = ay + uy * (L * t);
	let oz = az + uz * (L * t);
	for bv in NB_V {
		let r = VREG[bv] as int;
		if r >= reg_lo && r <= reg_hi {
			let mv = B2M[bv] as int;
			let dx = PVX[mv] - ox; let dy = PVY[mv] - oy; let dz = PVZ[mv] - oz;
			let al = dx * ux + dy * uy + dz * uz;
			if abs(al) <= band {
				let c1 = dx * e1x + dy * e1y + dz * e1z;
				let c2 = dx * e2x + dy * e2y + dz * e2z;
				let d = sqrt((c1 * c1 + c2 * c2) as real) as f32;
				if d < 0.19 * MH_SC {
					let ai = (((atan2(c1 as real, c2 as real) / TWO_PI + 0.5) * (n as real)) as int + n) % n;
					if d > rs[ai] { rs[ai] = d; }
				}
			}
		}
	}
	smooth_profile(rs, n, 0.042 * MH_SC);
}
fn add_panel_grid(gp f32[>..]&, guv f32[>..]&, gq i32[>..]&, gt u32[>..]&, gpin u8[>..]&, cols int, rows int, wrap bool, px const f32[:], py const f32[:], pz const f32[:], pu const f32[:], pv const f32[:], pin_rows int) {
	let v0 = gp.len / 3;
	for r in rows {
		for c in cols {
			let idx = r * cols + c;
			gp.push(px[idx]); gp.push(py[idx]); gp.push(pz[idx]);
			guv.push(pu[idx]); guv.push(pv[idx]);
			gpin.push(if r < pin_rows { 1 as u8 } else { 0 as u8 });
		}
	}
	let clim = if wrap { cols } else { cols - 1 };
	for r in rows - 1 {
		for c in clim {
			let c1 = (c + 1) % cols;
			let a = v0 + r * cols + c;
			let b = v0 + r * cols + c1;
			let d = v0 + (r + 1) * cols + c1;
			let e = v0 + (r + 1) * cols + c;
			gq.push(a as i32); gq.push(b as i32); gq.push(d as i32); gq.push(e as i32);
			gt.push(a as u32); gt.push(b as u32); gt.push(d as u32);
			gt.push(a as u32); gt.push(d as u32); gt.push(e as u32);
		}
	}
}
fn build_sewn_tube(gp f32[>..]&, guv f32[>..]&, gq i32[>..]&, gt u32[>..]&, gpin u8[>..]&, ys const f32[:], cxs const f32[:], czs const f32[:], n_az int, ease_r f32, flare_bot f32, pin_rows int, neck_scoop f32, x_lim f32) {
	let rows = ys.len;
	let half = n_az / 2;
	var rs f32[>..] = [];
	for pan in 2 {
		let cols = half + 1;
		var px f32[>..] = []; var py f32[>..] = []; var pz f32[>..] = [];
		var pu f32[>..] = []; var pv f32[>..] = [];
		for r in rows {
			let vf = (r as f32) / (max(rows - 1, 1) as f32);
			torso_ring(ys[r], 0.025 * MH_SC, cxs[r], czs[r], n_az, x_lim, rs);
			for c in cols {
				let ai = (pan * half + c) % n_az;
				let az = ((ai as real) / (n_az as real) - 0.5) * TWO_PI;
				let s = sin(az) as f32;
				let cs = cos(az) as f32;
				let rad = rs[ai] + ease_r + flare_bot * vf * vf;
				var yy = ys[r];
				if neck_scoop > 0.0 && r == 0 && cs > 0.15 {
					yy -= neck_scoop * (cs - 0.15) * (1.0 - vf);
				}
				px.push(cxs[r] + s * rad);
				py.push(yy);
				pz.push(czs[r] + cs * rad);
				pu.push((c as f32) / (cols - 1) as f32);
				pv.push(vf);
			}
		}
		add_panel_grid(gp, guv, gq, gt, gpin, cols, rows, false, px, py, pz, pu, pv, pin_rows);
	}
}
fn build_limb_panels(gp f32[>..]&, guv f32[>..]&, gq i32[>..]&, gt u32[>..]&, gpin u8[>..]&, ax f32, ay f32, az f32, bx f32, by f32, bz f32, t0 f32, t1 f32, rows int, n_az int, reg_lo int, reg_hi int, ease_r f32, flare f32, pin_rows int) {
	let ux, uy, uz, e1x, e1y, e1z, e2x, e2y, e2z, L = limb_frame(ax, ay, az, bx, by, bz);
	let half = n_az / 2;
	var rs f32[>..] = [];
	for pan in 2 {
		let cols = half + 1;
		var px f32[>..] = []; var py f32[>..] = []; var pz f32[>..] = [];
		var pu f32[>..] = []; var pv f32[>..] = [];
		for r in rows {
			let vf = (r as f32) / (max(rows - 1, 1) as f32);
			let tt = lrpf(t0, t1, vf);
			limb_ring(ax, ay, az, bx, by, bz, tt, 0.024 * MH_SC, reg_lo, reg_hi, n_az, rs);
			let ox = ax + ux * (L * tt);
			let oy = ay + uy * (L * tt);
			let oz = az + uz * (L * tt);
			for c in cols {
				let ai = (pan * half + c) % n_az;
				let an = ((ai as real) / (n_az as real) - 0.5) * TWO_PI;
				let s = sin(an) as f32;
				let cs = cos(an) as f32;
				let rad = rs[ai] + ease_r + flare * vf;
				px.push(ox + (e1x * s + e2x * cs) * rad);
				py.push(oy + (e1y * s + e2y * cs) * rad);
				pz.push(oz + (e1z * s + e2z * cs) * rad);
				pu.push((c as f32) / ((cols - 1) as f32));
				pv.push(vf);
			}
		}
		add_panel_grid(gp, guv, gq, gt, gpin, cols, rows, false, px, py, pz, pu, pv, pin_rows);
	}
}
fn add_box_part(gp f32[>..]&, guv f32[>..]&, gq i32[>..]&, gt u32[>..]&, gpin u8[>..]&, cx f32, cy f32, cz f32, hx f32, hy f32, hz f32) {
	let v0 = gp.len / 3;
	let xs f32[8] = [-hx, hx, hx, -hx, -hx, hx, hx, -hx];
	let ys f32[8] = [-hy, -hy, hy, hy, -hy, -hy, hy, hy];
	let zs f32[8] = [hz, hz, hz, hz, -hz, -hz, -hz, -hz];
	for i in 8 {
		gp.push(cx + xs[i]); gp.push(cy + ys[i]); gp.push(cz + zs[i]);
		guv.push(if xs[i] > 0.0 { 0.95 } else { 0.85 });
		guv.push(if ys[i] > 0.0 { 0.95 } else { 0.85 });
		gpin.push(1 as u8);
	}
	let fs int[24] = [0,1,2,3, 5,4,7,5+1, 4,0,3,7, 1,5,5+1,2, 3,2,5+1,7, 4,5,1,0];
	for f in 5 + 1 {
		let a = v0 + fs[f * 4]; let b = v0 + fs[f * 4 + 1]; let c = v0 + fs[f * 4 + 2]; let d = v0 + fs[f * 4 + 3];
		gq.push(a as i32); gq.push(b as i32); gq.push(c as i32); gq.push(d as i32);
		gt.push(a as u32); gt.push(b as u32); gt.push(c as u32);
		gt.push(a as u32); gt.push(c as u32); gt.push(d as u32);
	}
}
fn transfer_weights(px f32, py f32, pz f32, jw_out i32[>..]&, ww_out f32[>..]&) {
	var bi = 0; var bd f32 = 1.0e9;
	for bv in NB_V {
		let mv = B2M[bv] as int;
		let dx = px - PVX[mv]; let dy = py - PVY[mv]; let dz = pz - PVZ[mv];
		let d2 = dx * dx + dy * dy + dz * dz;
		if d2 < bd { bd = d2; bi = mv; }
	}
	for k in 4 {
		jw_out.push(MJW[bi * 4 + k]);
		ww_out.push(MWW[bi * 4 + k]);
	}
}
fn refresh_garment_views() {
	GNV = W_YP.len / 3;
	GNQ = W_QUAD.len / 4;
	GNT = W_TRI.len / 3;
	GPOS.clear(); GNRM.clear(); GUV.clear(); GQUAD.clear(); GTRI.clear(); GJW.clear(); GWW.clear();
	for v in GNV {
		GPOS.push(W_YP[v * 3]); GPOS.push(-W_YP[v * 3 + 2]); GPOS.push(W_YP[v * 3 + 1]);
		GNRM.push(W_YN[v * 3]); GNRM.push(-W_YN[v * 3 + 2]); GNRM.push(W_YN[v * 3 + 1]);
	}
	GUV.append(W_UV);
	GQUAD.append(W_QUAD);
	GTRI.append(W_TRI);
	GJW.append(W_JW);
	GWW.append(W_WW);
	build_bgrid(false);
	var poke = 0;
	var worst f32 = 0.0;
	for v in GNV {
		let px = W_YP[v * 3]; let py = W_YP[v * 3 + 1]; let pz = W_YP[v * 3 + 2];
		let bt, qx, qy, qz, _ = bgrid_nearest(px, py, pz);
		if bt >= 0 {
			let sd = (px - qx) * CT_NX[bt] + (py - qy) * CT_NY[bt] + (pz - qz) * CT_NZ[bt];
			if sd < -0.0001 {
				poke += 1;
				let mm = -sd * 1000.0;
				if mm > worst { worst = mm; }
			}
		}
	}
	AUD[11] = poke as real;
	AUD[12] = worst as real;
	refresh_views();
}
export fn hc_clear_outfit() {
	WORN.clear();
	W_YP.clear(); W_YN.clear(); W_UV.clear(); W_JW.clear(); W_WW.clear(); W_QUAD.clear(); W_TRI.clear();
	GNV = 0; GNQ = 0; GNT = 0;
	GPOS.clear(); GNRM.clear(); GUV.clear(); GQUAD.clear(); GTRI.clear(); GJW.clear(); GWW.clear();
	AUD[11] = 0.0; AUD[12] = 0.0;
	refresh_views();
}
export fn hc_worn_meta(idx i32, field i32) real {
	let i = idx as int;
	if i < 0 || i >= WORN.len { return 0.0; }
	let w = WORN[i];
	if field == 0 { return w.kind as real; }
	if field == 1 { return w.fab as real; }
	if field == 2 { return w.pat as real; }
	if field == 3 { return w.v0 as real; }
	if field == 4 { return w.nv as real; }
	if field == 5 { return w.t0 as real; }
	if field == 5 + 1 { return w.nt as real; }
	if field == 7 { return w.alpha as real; }
	if field == 8 { return w.r1 as real; }
	if field == 9 { return w.g1 as real; }
	if field == 10 { return w.b1 as real; }
	if field == 11 { return w.r2 as real; }
	if field == 12 { return w.g2 as real; }
	if field == 13 { return w.b2 as real; }
	if field == 14 { return w.rough as real; }
	w.metal as real
}
export fn hc_garment_ex(kind i32, fab i32, fit i32, ease_cm real, pat i32, r1 real, g1 real, b1 real, r2 real, g2 real, b2 real) i32 {
	if PK_OK == 0 || NV == 0 { return 0; }
	let kd = clamp(kind as int, 0, 12);
	let fb = fab_spec(clamp(fab as int, 0, 7));
	let fit_cm = if fit == 0 { -0.4 } else { if fit == 2 { 4.2 } else { 1.5 } };
	let ease_r = max(0.0045, (0.0055 + (fit_cm + ease_cm) * 0.01 / TWO_PI)) as f32 * MH_SC;
	let layered = kd == 2 || kd == 8 || kd == 10;
	build_bgrid(layered);
	var gp f32[>..] = []; var guv f32[>..] = []; var gq i32[>..] = []; var gt u32[>..] = []; var gpin u8[>..] = [];
	let H = MP[2] as f32;
	let y_waist = LM[25 * 3 + 2] as f32;
	let y_hips = LM[27 * 3 + 2] as f32;
	let y_crotch = LM[28 * 3 + 2] as f32;
	let y_chest = LM[22 * 3 + 2] as f32;
	let y_sh = (J_HY[15] as f32 + J_HY[18] as f32) * 0.5;
	let x_arm = max(abs(J_HX[15] as f32) - 0.015 * H, 0.10 * H);
	if kd == 0 || kd == 1 || kd == 2 {
		let y_top = if kd == 0 { y_chest + 0.045 * H } else { y_sh + 0.015 * H };
		let y_bot = if kd == 0 { y_waist - 0.035 * H } else { if kd == 1 { y_hips - 0.02 * H } else { y_hips - 0.045 * H } };
		let nr = 10;
		var ys f32[>..] = []; var cxs f32[>..] = []; var czs f32[>..] = [];
		for r in nr {
			let t = (r as f32) / ((nr - 1) as f32);
			ys.push(lrpf(y_top, y_bot, t)); cxs.push(0.0); czs.push((J_HZ[11] as f32) * 0.4);
		}
		let scoop = if kd == 0 { 0.035 * H } else { 0.012 * H };
		let flr = if kd == 2 { 0.012 * H } else { 0.004 * H };
		build_sewn_tube(gp, guv, gq, gt, gpin, ys, cxs, czs, 28, ease_r + (if kd == 2 { 0.005 * H } else { 0.0 }), flr, 2, scoop, x_arm);
		if kd == 0 {
			for sd in 2 {
				let sg f32 = if sd == 0 { 1.0 } else { -1.0 };
				let sx = sg * (abs(J_HX[13] as f32) * 0.45 + abs(J_HX[15] as f32) * 0.42);
				var spx f32[>..] = []; var spy f32[>..] = []; var spz f32[>..] = []; var spu f32[>..] = []; var spv f32[>..] = [];
				for r in 7 {
					let tf = (r as f32) / (7 - 1) as f32;
					let ang = lrpf(0.35, 2.79, tf);
					let yy = y_top + sin(ang as real) as f32 * 0.052 * H;
					let zz = (J_HZ[12] as f32) + cos(ang as real) as f32 * 0.075 * H;
					for c in 2 {
						let w = (if c == 0 { -0.012 } else { 0.012 }) * H;
						let bx, by, bz = bgrid_push_pt(sx + w, yy, zz, 0.0025);
						spx.push(bx); spy.push(by); spz.push(bz);
						spu.push(c as f32 * 0.15); spv.push(tf);
					}
				}
				add_panel_grid(gp, guv, gq, gt, gpin, 2, 7, false, spx, spy, spz, spu, spv, 7);
			}
		}
		if kd == 1 || kd == 2 {
			for sd in 2 {
				let ua = if sd == 0 { 15 } else { 18 };
				let la = if sd == 0 { 15 + 1 } else { 19 };
				let ha = if sd == 0 { 17 } else { 20 };
				let reg0 = if sd == 0 { 15 } else { 19 };
				if kd == 1 {
					build_limb_panels(gp, guv, gq, gt, gpin, J_HX[ua] as f32, J_HY[ua] as f32, J_HZ[ua] as f32, J_HX[la] as f32, J_HY[la] as f32, J_HZ[la] as f32, 0.04, 0.54, 5, 14, reg0, reg0 + 1, ease_r + 0.003 * H, 0.004 * H, 2);
				} else {
					build_limb_panels(gp, guv, gq, gt, gpin, J_HX[ua] as f32, J_HY[ua] as f32, J_HZ[ua] as f32, J_HX[ha] as f32, J_HY[ha] as f32, J_HZ[ha] as f32, 0.04, 0.94, 9, 14, reg0, reg0 + 2, ease_r + 0.005 * H, 0.002 * H, 2);
				}
			}
		}
		if kd == 2 {
			var hys f32[>..] = []; var hcxs f32[>..] = []; var hczs f32[>..] = [];
			for r in 5 {
				let t = (r as f32) / 4.0;
				hys.push(lrpf(y_sh + 0.075 * H, y_sh + 0.012 * H, t));
				hcxs.push(0.0); hczs.push((J_HZ[21] as f32) - 0.015 * H);
			}
			build_sewn_tube(gp, guv, gq, gt, gpin, hys, hcxs, hczs, 18, ease_r + 0.018 * H, 0.004 * H, 1, 0.025 * H, 0.14 * H);
		}
	} else if kd == 3 || kd == 4 || kd == 5 {
		let y_top = y_waist - 0.02 * H;
		let y_split = y_crotch + 0.008 * H;
		var pys f32[>..] = []; var pcx f32[>..] = []; var pcz f32[>..] = [];
		for r in 5 {
			let t = (r as f32) / 4.0;
			pys.push(lrpf(y_top, y_split, t)); pcx.push(0.0); pcz.push(J_HZ[1] as f32 * 0.4);
		}
		build_sewn_tube(gp, guv, gq, gt, gpin, pys, pcx, pcz, 24, ease_r, 0.002 * H, 2, 0.0, 0.25 * H);
		for sd in 2 {
			let th = if sd == 0 { 2 } else { 7 - 1 };
			let cf = if sd == 0 { 3 } else { 7 };
			let ft = if sd == 0 { 4 } else { 8 };
			let reg0 = if sd == 0 { 23 } else { 27 };
			if kd == 3 {
				build_limb_panels(gp, guv, gq, gt, gpin, J_HX[th] as f32, y_split, J_HZ[th] as f32, J_HX[cf] as f32, J_HY[cf] as f32, J_HZ[cf] as f32, 0.02, 1.0, 7, 15 + 1, reg0, reg0 + 2, ease_r + 0.002 * H, 0.001 * H, 2);
				build_limb_panels(gp, guv, gq, gt, gpin, J_HX[cf] as f32, J_HY[cf] as f32, J_HZ[cf] as f32, J_HX[ft] as f32, J_HY[ft] as f32 + 0.02 * H, J_HZ[ft] as f32, 0.0, 0.98, 7, 15 + 1, reg0 + 1, reg0 + 3, ease_r + 0.003 * H, 0.003 * H, 2);
			} else {
				let t_end f32 = if kd == 5 { 0.30 } else { 0.44 };
				let fl f32 = if kd == 5 { 0.008 * H } else { 0.005 * H };
				build_limb_panels(gp, guv, gq, gt, gpin, J_HX[th] as f32, y_split, J_HZ[th] as f32, J_HX[cf] as f32, J_HY[cf] as f32, J_HZ[cf] as f32, 0.02, t_end, 5, 15 + 1, reg0, reg0 + 1, ease_r + 0.002 * H, fl, 2);
			}
		}
	} else if kd == 5 + 1 {
		let y_top = y_waist - 0.032 * H;
		let y_hem = y_crotch - 0.052 * H;
		let npl = 18;
		let cols = npl * 3;
		let rows = 9;
		var rs f32[>..] = [];
		var px f32[>..] = []; var py f32[>..] = []; var pz f32[>..] = []; var pu f32[>..] = []; var pv f32[>..] = [];
		for r in rows {
			let vf = (r as f32) / ((rows - 1) as f32);
			let yy = lrpf(y_top, y_hem, vf);
			torso_ring(max(yy, y_crotch + 0.01 * H), 0.028 * H, 0.0, J_HZ[1] as f32 * 0.35, cols, 0.25 * H, rs);
			let flare = 0.052 * H * vf * pow(vf as real, 0.35) as f32;
			let p_amp = (0.002 + 0.0085 * vf) * H;
			for p in npl {
				for sub in 3 {
					let c = p * 3 + sub;
					let base_u = (p as real + (if sub == 0 { 0.0 } else { if sub == 1 { 0.78 } else { 0.54 } })) / (npl as real);
					let az = (base_u - 0.5) * TWO_PI;
					let s = sin(az) as f32;
					let cs = cos(az) as f32;
					let p_off = if sub == 1 { p_amp } else { if sub == 2 { 0.0015 * H } else { 0.0035 * H } };
					let rad = rs[c] + ease_r + flare + p_off;
					px.push(s * rad);
					py.push(yy);
					pz.push((J_HZ[1] as f32 * 0.35) + cs * rad);
					pu.push(((p * 3 + sub) as f32) / (cols as f32) * 2.5);
					pv.push(vf);
				}
			}
		}
		add_panel_grid(gp, guv, gq, gt, gpin, cols, rows, true, px, py, pz, pu, pv, 2);
	} else if kd == 7 || kd == 8 {
		for sd in 2 {
			let cf = if sd == 0 { 3 } else { 7 };
			let ft = if sd == 0 { 4 } else { 8 };
			let bl = if sd == 0 { 5 } else { 9 };
			let reg0 = if sd == 0 { 24 } else { 28 };
			let t_start f32 = if kd == 7 { 0.14 } else { 0.54 };
			let ex_r = ease_r + (if kd == 8 { 0.0055 * H } else { 0.001 * H });
			build_limb_panels(gp, guv, gq, gt, gpin, J_HX[cf] as f32, J_HY[cf] as f32, J_HZ[cf] as f32, J_HX[ft] as f32, J_HY[ft] as f32, J_HZ[ft] as f32, t_start, 1.0, 7, 14, reg0, reg0 + 2, ex_r, 0.0, if kd == 7 { 2 } else { 7 });
			let toe_x = J_HX[bl] as f32;
			let toe_y = max(J_HY[bl] as f32 * 0.5, 0.012 * H);
			let toe_z = J_HZ[bl] as f32 + 0.038 * H;
			build_limb_panels(gp, guv, gq, gt, gpin, J_HX[ft] as f32, J_HY[ft] as f32, J_HZ[ft] as f32 - 0.02 * H, toe_x, toe_y, toe_z, 0.0, 1.0, 5, 14, reg0 + 1, reg0 + 2, ex_r + (if kd == 8 { 0.004 * H } else { 0.0 }), 0.0, 5);
		}
	} else if kd == 9 {
		for sd in 2 {
			let la = if sd == 0 { 15 + 1 } else { 19 };
			let ha = if sd == 0 { 17 } else { 20 };
			let md = if sd == 0 { 29 } else { 30 };
			let reg0 = if sd == 0 { 15 + 1 } else { 20 };
			let kx = lrpf(J_HX[ha] as f32, J_HX[md] as f32, 0.92);
			let ky = lrpf(J_HY[ha] as f32, J_HY[md] as f32, 0.92);
			let kz = lrpf(J_HZ[ha] as f32, J_HZ[md] as f32, 0.92);
			let wx0 = lrpf(J_HX[la] as f32, J_HX[ha] as f32, 0.72);
			let wy0 = lrpf(J_HY[la] as f32, J_HY[ha] as f32, 0.72);
			let wz0 = lrpf(J_HZ[la] as f32, J_HZ[ha] as f32, 0.72);
			build_limb_panels(gp, guv, gq, gt, gpin, wx0, wy0, wz0, kx, ky, kz, 0.0, 1.0, 5, 14, reg0, reg0 + 1, ease_r * 0.55 + 0.0015 * H, 0.0, 5);
		}
	} else if kd == 10 {
		let y_b = y_waist - 0.038 * H;
		var bys f32[>..] = []; var bcx f32[>..] = []; var bcz f32[>..] = [];
		for r in 3 {
			bys.push(y_b - (r as f32) * 0.014 * H); bcx.push(0.0); bcz.push(J_HZ[1] as f32 * 0.35);
		}
		build_sewn_tube(gp, guv, gq, gt, gpin, bys, bcx, bcz, 28, ease_r + 0.008 * H, 0.0, 3, 0.0, 0.25 * H);
		let _, qx, qy, qz, _ = bgrid_nearest(0.0, y_b - 0.014 * H, 0.25 * H);
		add_box_part(gp, guv, gq, gt, gpin, qx, qy, qz + 0.009 * H, 0.022 * H, 0.018 * H, 0.005 * H);
	} else if kd == 11 {
		let nk_a = J_HY[21] as f32;
		let nk_b = J_HY[22] as f32;
		let y_c = lrpf(nk_a, nk_b, 0.42);
		build_limb_panels(gp, guv, gq, gt, gpin, J_HX[21] as f32, nk_a, J_HZ[21] as f32, J_HX[22] as f32, nk_b, J_HZ[22] as f32, 0.30, 0.54, 3, 20, 5, 7, 0.0032 * H, 0.0, 3);
		let _, qx, qy, qz, _ = bgrid_nearest(0.0, y_c, 0.15 * H);
		add_box_part(gp, guv, gq, gt, gpin, qx, qy, qz + 0.0055 * H, 0.013 * H, 0.009 * H, 0.003 * H);
	} else {
		var m2g int[>..] = []; m2g.resize(NV_ALL, -1);
		for q in NS_Q {
			var qv int[4] = [0; 4];
			for k in 4 {
				let vi = SQ[q * 8 + k] as int;
				let ti = SQ[q * 8 + 4 + k] as int;
				if m2g[vi] < 0 {
					m2g[vi] = gp.len / 3;
					gp.push(PVX[vi] + MNX[vi] * 0.002 * H);
					gp.push(PVY[vi] + MNY[vi] * 0.002 * H);
					gp.push(PVZ[vi] + MNZ[vi] * 0.002 * H);
					guv.push(BTU[ti]); guv.push(1.0 - BTV[ti]);
					gpin.push(1 as u8);
				}
				qv[k] = m2g[vi];
			}
			gq.push(qv[0] as i32); gq.push(qv[1] as i32); gq.push(qv[2] as i32); gq.push(qv[3] as i32);
			gt.push(qv[0] as u32); gt.push(qv[1] as u32); gt.push(qv[2] as u32);
			gt.push(qv[0] as u32); gt.push(qv[2] as u32); gt.push(qv[3] as u32);
		}
	}
	let gnv = gp.len / 3;
	if gnv == 0 { return 0; }
	for v in gnv {
		let px, py, pz = bgrid_push_pt(gp[v * 3], gp[v * 3 + 1], gp[v * 3 + 2], 0.0012);
		gp[v * 3] = px; gp[v * 3 + 1] = py; gp[v * 3 + 2] = pz;
	}
	var any_free = false;
	for v in gnv { if gpin[v] == 0 { any_free = true; } }
	if any_free && gt.len >= 3 {
		cloth::reset();
		setup_body_colliders(fb.thick);
		let cid = cloth::make(gp, 3, 0, gnv, gt);
		cloth::cloths[cid].density = fb.density;
		cloth::cloths[cid].stretch = fb.stretch;
		cloth::cloths[cid].bend = fb.bend;
		cloth::cloths[cid].friction = fb.friction;
		cloth::cloths[cid].thickness = fb.thick;
		cloth::cloths[cid].damping = 2.4;
		cloth::cloths[cid].substeps = 5;
		cloth::cloths[cid].limit = false;
		for v in gnv {
			if gpin[v] != 0 {
				cloth::pin(cid, v, gp[v * 3] as real, gp[v * 3 + 1] as real, gp[v * 3 + 2] as real);
			}
		}
		for st in 10 {
			cloth::step(cid, 0.012, 0.0, 0.0, 0.0);
			let p0 = cloth::cloths[cid].p0;
			let np = cloth::cloths[cid].np;
			for pi in p0..p0 + np {
				if !cloth::held[pi] {
					let px, py, pz = bgrid_push_pt(cloth::pos[pi * 3] as f32, cloth::pos[pi * 3 + 1] as f32, cloth::pos[pi * 3 + 2] as f32, 0.0014);
					cloth::pos[pi * 3] = px as real;
					cloth::pos[pi * 3 + 1] = py as real;
					cloth::pos[pi * 3 + 2] = pz as real;
				}
			}
		}
		for v in gnv {
			let pi = cloth::particle(cid, v);
			gp[v * 3] = cloth::pos[pi * 3] as f32;
			gp[v * 3 + 1] = cloth::pos[pi * 3 + 1] as f32;
			gp[v * 3 + 2] = cloth::pos[pi * 3 + 2] as f32;
		}
	}
	for pass in 3 {
		for v in gnv {
			let px, py, pz = bgrid_push_pt(gp[v * 3], gp[v * 3 + 1], gp[v * 3 + 2], 0.0015);
			gp[v * 3] = px; gp[v * 3 + 1] = py; gp[v * 3 + 2] = pz;
		}
		for t in gt.len / 3 {
			let a = gt[t * 3] as int; let b = gt[t * 3 + 1] as int; let c = gt[t * 3 + 2] as int;
			let mx = (gp[a * 3] + gp[b * 3] + gp[c * 3]) / 3.0;
			let my = (gp[a * 3 + 1] + gp[b * 3 + 1] + gp[c * 3 + 1]) / 3.0;
			let mz = (gp[a * 3 + 2] + gp[b * 3 + 2] + gp[c * 3 + 2]) / 3.0;
			let bt, qx, qy, qz, _ = bgrid_nearest(mx, my, mz);
			if bt >= 0 {
				let nx = CT_NX[bt]; let ny = CT_NY[bt]; let nz = CT_NZ[bt];
				let sd = (mx - qx) * nx + (my - qy) * ny + (mz - qz) * nz;
				if sd < 0.0022 {
					let push = 0.0025 - sd;
					gp[a * 3] += nx * push; gp[a * 3 + 1] += ny * push; gp[a * 3 + 2] += nz * push;
					gp[b * 3] += nx * push; gp[b * 3 + 1] += ny * push; gp[b * 3 + 2] += nz * push;
					gp[c * 3] += nx * push; gp[c * 3 + 1] += ny * push; gp[c * 3 + 2] += nz * push;
				}
			}
		}
	}
	if layered { build_bgrid(false); }
	for bpass in 5 {
		let _ = bpass;
		for v in gnv {
			let px, py, pz = bgrid_push_pt(gp[v * 3], gp[v * 3 + 1], gp[v * 3 + 2], 0.0020);
			gp[v * 3] = px; gp[v * 3 + 1] = py; gp[v * 3 + 2] = pz;
		}
		for t in gt.len / 3 {
			let a = gt[t * 3] as int; let b = gt[t * 3 + 1] as int; let c = gt[t * 3 + 2] as int;
			for sub in 4 {
				let mx = if sub == 0 { (gp[a * 3] + gp[b * 3] + gp[c * 3]) / 3.0 } else { if sub == 1 { (gp[a * 3] + gp[b * 3]) * 0.5 } else { if sub == 2 { (gp[b * 3] + gp[c * 3]) * 0.5 } else { (gp[c * 3] + gp[a * 3]) * 0.5 } } };
				let my = if sub == 0 { (gp[a * 3 + 1] + gp[b * 3 + 1] + gp[c * 3 + 1]) / 3.0 } else { if sub == 1 { (gp[a * 3 + 1] + gp[b * 3 + 1]) * 0.5 } else { if sub == 2 { (gp[b * 3 + 1] + gp[c * 3 + 1]) * 0.5 } else { (gp[c * 3 + 1] + gp[a * 3 + 1]) * 0.5 } } };
				let mz = if sub == 0 { (gp[a * 3 + 2] + gp[b * 3 + 2] + gp[c * 3 + 2]) / 3.0 } else { if sub == 1 { (gp[a * 3 + 2] + gp[b * 3 + 2]) * 0.5 } else { if sub == 2 { (gp[b * 3 + 2] + gp[c * 3 + 2]) * 0.5 } else { (gp[c * 3 + 2] + gp[a * 3 + 2]) * 0.5 } } };
				let bt, qx, qy, qz, _ = bgrid_nearest(mx, my, mz);
				if bt >= 0 {
					let nx = CT_NX[bt]; let ny = CT_NY[bt]; let nz = CT_NZ[bt];
					let sd = (mx - qx) * nx + (my - qy) * ny + (mz - qz) * nz;
					if sd < 0.0028 {
						let push = 0.0032 - sd;
						gp[a * 3] += nx * push; gp[a * 3 + 1] += ny * push; gp[a * 3 + 2] += nz * push;
						gp[b * 3] += nx * push; gp[b * 3 + 1] += ny * push; gp[b * 3 + 2] += nz * push;
						gp[c * 3] += nx * push; gp[c * 3 + 1] += ny * push; gp[c * 3 + 2] += nz * push;
					}
				}
			}
		}
	}
	for fpass in 3 {
		let _ = fpass;
		for v in gnv {
			let px, py, pz = bgrid_push_pt(gp[v * 3], gp[v * 3 + 1], gp[v * 3 + 2], 0.0022);
			gp[v * 3] = px; gp[v * 3 + 1] = py; gp[v * 3 + 2] = pz;
		}
	}
	var gn f32[>..] = []; gn.resize(gnv * 3, 0.0);
	for t in gt.len / 3 {
		let a = gt[t * 3] as int; let b = gt[t * 3 + 1] as int; let c = gt[t * 3 + 2] as int;
		let ux = gp[b * 3] - gp[a * 3]; let uy = gp[b * 3 + 1] - gp[a * 3 + 1]; let uz = gp[b * 3 + 2] - gp[a * 3 + 2];
		let wx = gp[c * 3] - gp[a * 3]; let wy = gp[c * 3 + 1] - gp[a * 3 + 1]; let wz = gp[c * 3 + 2] - gp[a * 3 + 2];
		let nx = uy * wz - uz * wy; let ny = uz * wx - ux * wz; let nz = ux * wy - uy * wx;
		gn[a * 3] += nx; gn[a * 3 + 1] += ny; gn[a * 3 + 2] += nz;
		gn[b * 3] += nx; gn[b * 3 + 1] += ny; gn[b * 3 + 2] += nz;
		gn[c * 3] += nx; gn[c * 3 + 1] += ny; gn[c * 3 + 2] += nz;
	}
	for v in gnv {
		let l = len3f(gn[v * 3], gn[v * 3 + 1], gn[v * 3 + 2]);
		if l > 1.0e-8 { gn[v * 3] /= l; gn[v * 3 + 1] /= l; gn[v * 3 + 2] /= l; }
		else { gn[v * 3] = 0.0; gn[v * 3 + 1] = 1.0; gn[v * 3 + 2] = 0.0; }
	}
	let v0 = W_YP.len / 3;
	let t0 = W_TRI.len / 3;
	W_YP.append(gp);
	W_YN.append(gn);
	W_UV.append(guv);
	for v in gnv { transfer_weights(gp[v * 3], gp[v * 3 + 1], gp[v * 3 + 2], W_JW, W_WW); }
	for i in gq.len { W_QUAD.push(gq[i] + (v0 as i32)); }
	for i in gt.len { W_TRI.push((gt[i] as i32) + (v0 as i32)); }
	let is_alpha = if fb.alpha != 0 || kd == 5 { 1 } else { 0 };
	WORN.push(WornG{kd, clamp(fab as int, 0, 7), pat as int, v0, gnv, t0, gt.len / 3, r1 as f32, g1 as f32, b1 as f32, r2 as f32, g2 as f32, b2 as f32, fb.rough, fb.metal, is_alpha});
	refresh_garment_views();
	gnv as i32
}
export fn hc_garment(kind i32, offset real, z_lo real, z_hi real, flare real, drape_iters i32) i32 {
	let _ = z_lo; let _ = z_hi; let _ = flare; let _ = drape_iters;
	hc_clear_outfit();
	let ease_cm = (offset - 0.005) * 400.0;
	let def_fab = if kind == 3 { 1 } else { if kind == 5 + 1 { 2 } else { if kind == 8 || kind == 10 { 4 } else { if kind == 5 { 5 + 1 } else { 0 } } } };
	let def_pat = if kind == 5 + 1 { 1 } else { if kind == 7 { 4 } else { 0 } };
	hc_garment_ex(kind, def_fab as i32, 1, ease_cm, def_pat as i32, 0.22, 0.28, 0.38, 0.78, 0.18, 0.22)
}
export fn hc_drag_region(reg i32, dx real, dy real, mirror i32) i32 {
	let r = reg as int;
	var h_idx = -1;
	var v_idx = -1;
	var asym_slot = -1;
	var side = 0;
	if r == 4 { h_idx = 20; v_idx = 35; asym_slot = 0; }
	else if r == 3 { h_idx = 21; v_idx = 35; asym_slot = 1; }
	else if r == 2 { h_idx = 25; v_idx = 35; asym_slot = 2; }
	else if r == 1 { h_idx = 25 + 1; v_idx = 34; asym_slot = 3; }
	else if r >= 23 && r <= 24 { h_idx = 29; v_idx = 34; asym_slot = 4; side = 1; }
	else if r >= 27 && r <= 28 { h_idx = 29; v_idx = 34; asym_slot = 4; side = -1; }
	else if r >= 25 && r <= 25 + 1 { h_idx = 30; v_idx = 34; asym_slot = 5; side = 1; }
	else if r >= 29 && r <= 30 { h_idx = 30; v_idx = 34; asym_slot = 5; side = -1; }
	else if r == 15 { h_idx = 31; v_idx = 33; asym_slot = 5 + 1; side = 1; }
	else if r == 19 { h_idx = 31; v_idx = 33; asym_slot = 5 + 1; side = -1; }
	else if r == 15 + 1 { h_idx = 32; v_idx = 33; asym_slot = 7; side = 1; }
	else if r == 20 { h_idx = 32; v_idx = 33; asym_slot = 7; side = -1; }
	else if r == 17 || r == 18 || r == 21 || r == 22 { h_idx = 38; v_idx = 33; }
	else if r == 5 { h_idx = 37; v_idx = 35 + 1; }
	else if r >= 7 && r <= 14 { h_idx = 75 + 1; v_idx = 74; }
	if mirror == 0 && asym_slot >= 0 && side != 0 {
		let k = if side > 0 { asym_slot } else { 10 + asym_slot };
		ASYM[k] = cl(ASYM[k] + dx, -1.4, 1.4);
		let vk = if side > 0 { (if v_idx == 33 { 8 } else { 9 }) } else { 10 + (if v_idx == 33 { 8 } else { 9 }) };
		ASYM[vk] = cl(ASYM[vk] + dy, -1.4, 1.4);
	} else {
		if h_idx >= 20 { MP[h_idx] = cl(MP[h_idx] + dx, -1.4, 1.4); }
		if v_idx >= 20 { MP[v_idx] = cl(MP[v_idx] + dy, -1.4, 1.4); }
	}
	hc_build(1)
}
export fn hc_alloc_deform(nv i32, nt i32) {
	SNV = max(nv as int, 0);
	SNT = max(nt as int, 0);
	SPOS.clear(); SPOS.resize(SNV * 3, 0.0);
	STRI.clear(); STRI.resize(SNT * 3, 0);
	TPOS.clear(); TPOS.resize(SNV * 3, 0.0);
	SMASK.clear(); SMASK.resize(SNV, 0);
	refresh_views();
}
fn snap_deform_vert(v int, off real) {
	let px = TPOS[v * 3]; let py = TPOS[v * 3 + 1]; let pz = TPOS[v * 3 + 2];
	if SNT > 0 {
		var bd f32 = 1.0e9;
		var bqx = px; var bqy = py; var bqz = pz;
		var bnx f32 = 0.0; var bny f32 = 0.0; var bnz f32 = 1.0;
		for t in SNT {
			let a = STRI[t * 3] as int; let b = STRI[t * 3 + 1] as int; let c = STRI[t * 3 + 2] as int;
			let ax = SPOS[a * 3]; let ay = SPOS[a * 3 + 1]; let az = SPOS[a * 3 + 2];
			let bx = SPOS[b * 3]; let by = SPOS[b * 3 + 1]; let bz = SPOS[b * 3 + 2];
			let cx = SPOS[c * 3]; let cy = SPOS[c * 3 + 1]; let cz = SPOS[c * 3 + 2];
			let qx, qy, qz = cp_tri(px, py, pz, ax, ay, az, bx, by, bz, cx, cy, cz);
			let dx = px - qx; let dy = py - qy; let dz = pz - qz;
			let d2 = dx * dx + dy * dy + dz * dz;
			if d2 < bd {
				bd = d2; bqx = qx; bqy = qy; bqz = qz;
				let ux = bx - ax; let uy = by - ay; let uz = bz - az;
				let wx = cx - ax; let wy = cy - ay; let wz = cz - az;
				bnx = uy * wz - uz * wy; bny = uz * wx - ux * wz; bnz = ux * wy - uy * wx;
			}
		}
		let nl = max(len3f(bnx, bny, bnz), 1.0e-7);
		bnx /= nl; bny /= nl; bnz /= nl;
		if (px - bqx) * bnx + (py - bqy) * bny + (pz - bqz) * bnz < 0.0 { bnx = -bnx; bny = -bny; bnz = -bnz; }
		TPOS[v * 3] = bqx + bnx * (off as f32);
		TPOS[v * 3 + 1] = bqy + bny * (off as f32);
		TPOS[v * 3 + 2] = bqz + bnz * (off as f32);
	} else if NV > 0 {
		var bi = 0; var bd f32 = 1.0e9;
		for u in NV {
			let dx = px - POS[u * 3]; let dy = py - POS[u * 3 + 1]; let dz = pz - POS[u * 3 + 2];
			let d2 = dx * dx + dy * dy + dz * dz;
			if d2 < bd { bd = d2; bi = u; }
		}
		TPOS[v * 3] = POS[bi * 3] + NRM[bi * 3] * (off as f32);
		TPOS[v * 3 + 1] = POS[bi * 3 + 1] + NRM[bi * 3 + 1] * (off as f32);
		TPOS[v * 3 + 2] = POS[bi * 3 + 2] + NRM[bi * 3 + 2] * (off as f32);
	}
}
export fn hc_shrinkwrap(offset real, relax_iters i32) i32 {
	var moved = 0;
	for v in SNV {
		if SMASK[v] != 0 { snap_deform_vert(v, offset); moved += 1; }
	}
	let _ = relax_iters;
	refresh_views();
	moved as i32
}
export fn hc_prop_edit(mode i32, cx real, cy real, cz real, dx real, dy real, dz real, rad real, deg real, falloff i32, sym_x i32) i32 {
	if rad <= 0.0 { return 0; }
	var count = 0;
	for v in SNV {
		if SMASK[v] == 0 { continue; }
		let px = TPOS[v * 3] as real;
		let py = TPOS[v * 3 + 1] as real;
		let pz = TPOS[v * 3 + 2] as real;
		var d = len3(px - cx, py - cy, pz - cz);
		var mir = false;
		if sym_x != 0 {
			let d2 = len3(px + cx, py - cy, pz - cz);
			if d2 < d { d = d2; mir = true; }
		}
		if d < rad {
			let u = 1.0 - d / rad;
			let w = if falloff == 0 { u * u * (3.0 - 2.0 * u) } else { if falloff == 1 { sqrt(cl(2.0 * u - u * u, 0.0, 1.0)) } else { if falloff == 2 { u * u } else { u } } };
			let ccx = if mir { -cx } else { cx };
			if mode == 0 {
				let tx = if mir { -dx } else { dx };
				TPOS[v * 3] = (px + w * tx) as f32;
				TPOS[v * 3 + 1] = (py + w * dy) as f32;
				TPOS[v * 3 + 2] = (pz + w * dz) as f32;
			} else if mode == 1 {
				TPOS[v * 3] = (ccx + (px - ccx) * (1.0 + w * (dx - 1.0))) as f32;
				TPOS[v * 3 + 1] = (cy + (py - cy) * (1.0 + w * (dy - 1.0))) as f32;
				TPOS[v * 3 + 2] = (cz + (pz - cz) * (1.0 + w * (dz - 1.0))) as f32;
			} else {
				let al = len3(dx, dy, dz);
				if al > 1.0e-12 {
					let kx = dx / al;
					let ky = (if mir { -dy } else { dy }) / al;
					let kz = (if mir { -dz } else { dz }) / al;
					let ang = w * deg * D2R;
					let ca = cos(ang); let sa = sin(ang);
					let rx = px - ccx; let ry = py - cy; let rz = pz - cz;
					let kd = kx * rx + ky * ry + kz * rz;
					let crx = ky * rz - kz * ry; let cry = kz * rx - kx * rz; let crz = kx * ry - ky * rx;
					TPOS[v * 3] = (ccx + rx * ca + crx * sa + kx * kd * (1.0 - ca)) as f32;
					TPOS[v * 3 + 1] = (cy + ry * ca + cry * sa + ky * kd * (1.0 - ca)) as f32;
					TPOS[v * 3 + 2] = (cz + rz * ca + crz * sa + kz * kd * (1.0 - ca)) as f32;
				}
			}
			count += 1;
		}
	}
	refresh_views();
	count as i32
}
fn crc32_slice(b const u8[:]) u32 {
	var c u32 = 4294967295;
	for i in b.len {
		c = c ^ (b[i] as u32);
		for k in 8 {
			if (c & 1) != 0 { c = (c >> 1) ^ 3988292384; }
			else { c = c >> 1; }
		}
	}
	c ^ 4294967295
}
fn png_chunk(out u8[>..]&, tag const byte[:], data const u8[:]) {
	put32be(out, data.len);
	let c0 = out.len;
	for i in 4 { out.push(tag[i] as u8); }
	out.append(data);
	let crc = crc32_slice(out[c0..out.len]);
	put32be(out, crc as int);
}
fn encode_png_rgba(rgba const u8[:], w int, h int, out u8[>..]&) {
	out.clear();
	let sig int[8] = [137, 80, 78, 71, 13, 10, 26, 10];
	for i in 8 { out.push(sig[i] as u8); }
	var ihdr u8[>..] = [];
	put32be(ihdr, w);
	put32be(ihdr, h);
	ihdr.push(8); ihdr.push((2 + 4) as u8); ihdr.push(0); ihdr.push(0); ihdr.push(0);
	png_chunk(out, "IHDR", ihdr);
	var raw u8[>..] = [];
	for y in h {
		raw.push(0);
		let r0 = y * w * 4;
		raw.append(rgba[r0..r0 + w * 4]);
	}
	var zdat u8[>..] = [];
	zdat.push(120); zdat.push(1);
	var pos = 0;
	let blk = 32000;
	while pos < raw.len {
		let rem = raw.len - pos;
		let n = if rem > blk { blk } else { rem };
		let last = if pos + n >= raw.len { 1 } else { 0 };
		zdat.push(last as u8);
		put2le(zdat, n);
		put2le(zdat, n ^ 65535);
		zdat.append(raw[pos..pos + n]);
		pos += n;
	}
	var s1 u32 = 1;
	var s2 u32 = 0;
	for i in raw.len {
		s1 = (s1 + (raw[i] as u32)) % 65521;
		s2 = (s2 + s1) % 65521;
	}
	let adler = (s2 << (8 + 8)) | s1;
	put32be(zdat, adler as int);
	png_chunk(out, "IDAT", zdat);
	var iend u8[>..] = [];
	png_chunk(out, "IEND", iend);
}
fn hash2f(x int, y int, seed int) f32 {
	var h uint = ((x * 374761393 + y * 668265263 + seed * 1442695041) as uint) ^ 2166136261;
	h = (h ^ (h >> 13)) * 1274126177;
	((h ^ (h >> 15)) & 32767) as f32 / ((1 << 15) as f32)
}
fn hair_rgb() f32, f32, f32 {
	if MP[101] < 0.5 {
		return clf(MP[98] as f32, 0.02, 0.98), clf(MP[99] as f32, 0.02, 0.98), clf(MP[100] as f32, 0.02, 0.98);
	}
	let sh = h_shades();
	let idx = clamp(round(MP[103]) as int, 0, sh.len - 1);
	let s = sh[idx];
	return s.r, s.g, s.b;
}
fn finish_tex(w int, h int, enc int) i32 {
	TEX_W = w; TEX_H = h;
	EXP_BUF.clear();
	if enc == 1 {
		var jb byte[>..] = [];
		var rb byte[>..] = [];
		for i in TEX_RGBA.len { rb.push(TEX_RGBA[i] as! byte); }
		let _ = codec_jpeg_enc::encode(rb, w, h, 90, jb);
		for i in jb.len { EXP_BUF.push(jb[i] as! u8); }
	} else if enc == 2 {
		encode_png_rgba(TEX_RGBA, w, h, EXP_BUF);
	}
	refresh_views();
	EXP_BUF.len as i32
}
export fn hc_paint_skin(size i32, enc i32) i32 {
	let S = clamp(size as int, 32, 1024);
