	let under = cl(MP[81], -1.0, 1.0) as f32;
	let base_r = lrpf(0.95, 0.27, pow(tone as real, 0.88) as f32) + under * 0.028;
	let base_g = lrpf(0.80, 0.18, pow(tone as real, 0.95) as f32) + under * 0.008;
	let base_b = lrpf(0.73, 0.13, pow(tone as real, 1.02) as f32) - under * 0.032;
	let br0 = (clamp(round((base_r * 255.0) as real) as int, 0, 255)) as u8;
	let bg0 = (clamp(round((base_g * 255.0) as real) as int, 0, 255)) as u8;
	let bb0 = (clamp(round((base_b * 255.0) as real) as int, 0, 255)) as u8;
	TEX_RGBA.resize(S * S * 4, 255);
	for i in S * S {
		TEX_RGBA[i * 4] = br0; TEX_RGBA[i * 4 + 1] = bg0; TEX_RGBA[i * 4 + 2] = bb0; TEX_RGBA[i * 4 + 3] = 255;
	}
	if PK_OK == 0 { return finish_tex(S, S, enc as int); }
	var mask u8[>..] = []; mask.resize(S * S, 0);
	let freck = cl(MP[82], 0.0, 1.0) as f32;
	let moles = cl(MP[83], 0.0, 1.0) as f32;
	let blush = cl(MP[84], 0.0, 1.0) as f32;
	let bl_r = clf(MP[85] as f32, 0.0, 1.0); let bl_g = clf(MP[85 + 1] as f32, 0.0, 1.0); let bl_b = clf(MP[87] as f32, 0.0, 1.0);
	let lip_w = cl(MP[88], 0.0, 1.0) as f32;
	let lp_r = clf(MP[89] as f32, 0.0, 1.0); let lp_g = clf(MP[90] as f32, 0.0, 1.0); let lp_b = clf(MP[91] as f32, 0.0, 1.0);
	let liner = cl(MP[92], 0.0, 1.0) as f32;
	let hr, hg, hb = hair_rgb();
	let brw_r = if MP[105 + 1] >= 0.0 { clf(MP[105 + 1] as f32, 0.0, 1.0) } else { hr * 0.55 };
	let brw_g = if MP[107] >= 0.0 { clf(MP[107] as f32, 0.0, 1.0) } else { hg * 0.52 };
	let brw_b = if MP[108] >= 0.0 { clf(MP[108] as f32, 0.0, 1.0) } else { hb * 0.50 };
	let brw_th = cl(if MP[105] > 0.01 { MP[105] } else { 1.0 }, 0.25, 1.8) as f32;
	let ex0 = abs(J_HX[53] as f32) / max(MH_SC, 0.1);
	let ey0 = (J_HY[53] as f32) / max(MH_SC, 0.1) + MH_Y0;
	let ez0 = (J_HZ[53] as f32) / max(MH_SC, 0.1);
	var mth_y f32 = ey0 - 0.070;
	var nos_y f32 = ey0 - 0.032;
	var lip_cnt = 0; var lip_sy f32 = 0.0;
	for bv in NB_V {
		let mv = B2M[bv] as int;
		if (MVREG[mv] as int) == 8 { lip_sy += BVY[mv]; lip_cnt += 1; }
	}
	if lip_cnt > 0 { mth_y = lip_sy / (lip_cnt as f32); nos_y = lrpf(ey0, mth_y, 0.52); }
	let sf = S as f32;
	for q in NB_Q {
		for tr in 2 {
			let i0 = 0; let i1 = if tr == 0 { 1 } else { 2 }; let i2 = if tr == 0 { 2 } else { 3 };
			let v0 = BQ[q * 8 + i0] as int; let v1 = BQ[q * 8 + i1] as int; let v2 = BQ[q * 8 + i2] as int;
			let t0 = BQ[q * 8 + 4 + i0] as int; let t1 = BQ[q * 8 + 4 + i1] as int; let t2 = BQ[q * 8 + 4 + i2] as int;
			let u0 = BTU[t0] * sf; let w0 = (1.0 - BTV[t0]) * sf;
			let u1 = BTU[t1] * sf; let w1 = (1.0 - BTV[t1]) * sf;
			let u2 = BTU[t2] * sf; let w2 = (1.0 - BTV[t2]) * sf;
			let den = (w1 - w2) * (u0 - u2) + (u2 - u1) * (w0 - w2);
			if abs(den) < 1.0e-5 { continue; }
			let inv_d = 1.0 / den;
			let xlo = clamp(floor(min(u0, min(u1, u2)) as real) as int, 0, S - 1);
			let xhi = clamp(ceil(max(u0, max(u1, u2)) as real) as int, 0, S - 1);
			let ylo = clamp(floor(min(w0, min(w1, w2)) as real) as int, 0, S - 1);
			let yhi = clamp(ceil(max(w0, max(w1, w2)) as real) as int, 0, S - 1);
