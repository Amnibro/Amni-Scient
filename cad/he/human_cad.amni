						var cg = base_g + grain * 0.85;
						var cb = base_b + grain * 0.75;
						if rz > ez0 - 0.03 && ry > mth_y - 0.05 && ry < ey0 + 0.09 {
							let d_chk = sqrt(((ax - ex0 * 1.18) * (ax - ex0 * 1.18) + (ry - (ey0 - 0.025)) * (ry - (ey0 - 0.025))) as real) as f32;
							let w_nat = clf(1.0 - d_chk / 0.038, 0.0, 1.0);
