							}
							let bx_rel = (ax - ex0 * 0.38) / max(ex0 * 1.15, 0.01);
							if bx_rel >= 0.0 && bx_rel <= 1.0 {
								let arch = ey0 + 0.019 + sin((bx_rel * 2.35) as real) as f32 * 0.0070 - bx_rel * 0.003;
								let half_t = 0.0042 * brw_th * (1.0 - 0.52 * bx_rel * bx_rel);
								let dy_b = abs(ry - arch);
								if dy_b < half_t && rz > ez0 - 0.005 {
									let strk = 0.70 + 0.30 * sin(((ax * 950.0) + (ry * 320.0)) as real) as f32;
									let wb = clf(1.0 - dy_b / max(half_t, 0.0005), 0.0, 1.0) * strk * 0.85;
									cr = lrpf(cr, brw_r, wb); cg = lrpf(cg, brw_g, wb); cb = lrpf(cb, brw_b, wb);
								}
							}
