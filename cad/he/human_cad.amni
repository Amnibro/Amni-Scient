			let is_lip0 = max(if rg0 == 8 { 0.85 as f32 } else { 0.0 as f32 }, (MVMASK[v0 * 4] as f32) / 255.0);
			let is_lip1 = max(if rg1 == 8 { 0.85 as f32 } else { 0.0 as f32 }, (MVMASK[v1 * 4] as f32) / 255.0);
			let is_lip2 = max(if rg2 == 8 { 0.85 as f32 } else { 0.0 as f32 }, (MVMASK[v2 * 4] as f32) / 255.0);
