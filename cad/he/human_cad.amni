fn cl(x real, a real, b real) real { if x < a { a } else { if x > b { b } else { x } } }
fn clf(x f32, a f32, b f32) f32 { if x < a { a } else { if x > b { b } else { x } } }
fn lrp(a real, b real, t real) real { a + (b - a) * t }
fn lrpf(a f32, b f32, t f32) f32 { a + (b - a) * t }
fn sstep(a f32, b f32, x f32) f32 {
	let t = clf((x - a) / (b - a), 0.0, 1.0);
	t * t * (3.0 - 2.0 * t)
}
fn len3(x real, y real, z real) real { sqrt(x * x + y * y + z * z) }
fn len3f(x f32, y f32, z f32) f32 { sqrt((x * x + y * y + z * z) as real) as f32 }
fn ru2b(at int) int { (PK[at] as int) | ((PK[at + 1] as int) << 8) }
fn ri2b(at int) int {
	let u = ru2b(at);
	if u >= (1 << 15) { u - (1 << (8 + 8)) } else { u }
}
fn ri32(at int) int { (PK[at] as int) | ((PK[at + 1] as int) << 8) | ((PK[at + 2] as int) << (8 + 8)) | ((PK[at + 3] as int) << 24) }
fn rf32(at int) f32 { binary::f32_from_bits(ri32(at) as u32) }
fn put2le(b u8[>..]&, v int) {
	b.push((v & 255) as u8);
	b.push(((v >> 8) & 255) as u8);
}
fn put32le(b u8[>..]&, v int) {
	b.push((v & 255) as u8);
	b.push(((v >> 8) & 255) as u8);
	b.push((((v >> 8) >> 8) & 255) as u8);
	b.push(((v >> 24) & 255) as u8);
}
fn put32be(b u8[>..]&, v int) {
	b.push(((v >> 24) & 255) as u8);
	b.push((((v >> 8) >> 8) & 255) as u8);
	b.push(((v >> 8) & 255) as u8);
	b.push((v & 255) as u8);
}
fn putf32(b u8[>..]&, v f32) { put32le(b, binary::f32_bits(v) as int); }
fn put_int_ascii(b u8[>..]&, v int) {
	if v == 0 { b.push('0' as u8); return; }
	var x = v;
	if x < 0 { b.push('-' as u8); x = -x; }
	var dg u8[15] = [0; 15];
	var n = 0;
	while x > 0 { dg[n] = ('0' as int + (x % 10)) as u8; x /= 10; n += 1; }
	for i in n { b.push(dg[n - 1 - i]); }
}
fn put_f4_ascii(b u8[>..]&, v real) {
	var x = v;
	if !(x == x) { b.push('0' as u8); return; }
	if x < 0.0 { b.push('-' as u8); x = -x; }
	let sc = round(x * 10000.0) as int;
	put_int_ascii(b, sc / 10000);
	let fr = sc % 10000;
	if fr > 0 {
		b.push('.' as u8);
		b.push(('0' as int + ((fr / 1000) % 10)) as u8);
		b.push(('0' as int + ((fr / 100) % 10)) as u8);
		b.push(('0' as int + ((fr / 10) % 10)) as u8);
		b.push(('0' as int + (fr % 10)) as u8);
	}
}
fn refresh_views() {
	hc_view_f64(1, MP);
	hc_view_f64(2, FC);
	hc_view_f64(3, BP);
	hc_view_f64(4, BH);
	hc_view_f64(5, BT);
	hc_view_i32(7, BPAR);
	hc_view_f64(8, LM);
	hc_view_f64(9, AUD);
	hc_view_f32(10, POS);
	hc_view_f32(11, REST);
	hc_view_f32(12, NRM);
	hc_view_f32(13, LUV);
	hc_view_i32(14, QUAD);
	hc_view_i32(15, TRI);
	hc_view_u8(17, VREG);
	hc_view_u8(18, FREG);
	hc_view_i32(19, JW);
	hc_view_f32(20, WW);
	hc_view_f32(21, GPOS);
	hc_view_f32(22, GNRM);
	hc_view_f32(23, GUV);
	hc_view_i32(24, GQUAD);
	hc_view_i32(25, GTRI);
	hc_view_i32(27, GJW);
	hc_view_f32(28, GWW);
	hc_view_f32(29, SPOS);
	hc_view_i32(30, STRI);
	hc_view_f32(31, TPOS);
	hc_view_u8(32, SMASK);
	hc_view_f32(33, HPOS);
	hc_view_f32(34, HNRM);
	hc_view_f32(35, HUV);
	hc_view_i32(37, HTRI);
	hc_view_f32(38, EPOS);
	hc_view_f32(39, ENRM);
	hc_view_f32(41, EUVB);
	hc_view_i32(42, ETRI);
	hc_view_u8(43, EMAT);
	hc_view_u8(40, PK);
	hc_view_u8(44, TEX_RGBA);
	hc_view_u8(45, EXP_BUF);
	hc_view_f64(47, ASYM);
	hc_view_f32(48, TZ_POS);
	hc_view_f32(49, TZ_NRM);
	hc_view_i32(50, T_TRI);
}
export fn hc_alloc_pack(n i32) {
	PK.clear();
	PK.resize(n as int, 0);
	PK_OK = 0;
	refresh_views();
}
fn read_quads(dst i32[>..]&, nq int, off int) int {
	dst.clear();
	var p = off;
	for i in nq * 8 { dst.push(ru2b(p) as i32); p += 2; }
	p
}
export fn hc_init_pack() i32 {
	if PK.len < 44 { return 0; }
	if PK[0] != ('M' as u8) || PK[1] != ('H' as u8) || PK[2] != ('C' as u8) || PK[3] != ('C' as u8) { return 0; }
	NV_ALL = ri32(4);
	NT_UV = ri32(8);
	NB_V = ri32(12);
	NB_Q = ri32(15 + 1);
	NE_Q = ri32(20);
	NL_Q = ri32(24);
	NT_Q = ri32(28);
	NG_Q = ri32(32);
	NS_Q = ri32(35 + 1);
	N_TGT = ri32(40);
	var p = 44;
	BVX.clear(); BVY.clear(); BVZ.clear();
	for v in NV_ALL {
		BVX.push(rf32(p));
		BVY.push(rf32(p + 4));
		BVZ.push(rf32(p + 8));
		p += 12;
	}
	BTU.clear(); BTV.clear();
	for t in NT_UV {
		BTU.push(rf32(p));
		BTV.push(rf32(p + 4));
		p += 8;
	}
	B2M.clear(); for i in NB_V { B2M.push(ru2b(p) as i32); p += 2; }
	M2B.clear(); for i in NV_ALL { M2B.push(ri2b(p) as i32); p += 2; }
	p = read_quads(BQ, NB_Q, p);
	p = read_quads(EQ, NE_Q, p);
	p = read_quads(LQ, NL_Q, p);
	p = read_quads(TQ, NT_Q, p);
	p = read_quads(GQ, NG_Q, p);
	p = read_quads(SQ, NS_Q, p);
	EUV.clear(); for i in NE_Q * 8 { EUV.push(rf32(p)); p += 4; }
	BPAR.clear(); for b in 53 { BPAR.push(ri2b(p) as i32); p += 2; }
	JOFF.clear(); JCNT.clear(); JVERTS.clear();
	for b in 55 {
		let c = ru2b(p);
		p += 2;
		JOFF.push(JVERTS.len as i32);
		JCNT.push(c as i32);
		for k in c { JVERTS.push(ru2b(p) as i32); p += 2; }
	}
	MJW.clear(); MWW.clear();
	for v in NV_ALL {
		for k in 4 { MJW.push((PK[p + k] as int) as i32); }
		p += 4;
		var ws f32 = 0.0;
		var w4 f32[4] = [0.0; 4];
		for k in 4 { w4[k] = (ru2b(p) as f32) / 50000.0; p += 2; ws += w4[k]; }
		if ws > 0.0001 { for k in 4 { MWW.push(w4[k] / ws); } }
		else { MWW.push(1.0); MWW.push(0.0); MWW.push(0.0); MWW.push(0.0); }
	}
	MVREG.clear(); MVREG.append(PK[p..p + NV_ALL]); p += NV_ALL;
	MVMASK.clear(); MVMASK.append(PK[p..p + NV_ALL * 4]); p += NV_ALL * 4;
	TOFF.clear(); TCNT.clear();
	for t in N_TGT {
		let cnt = ri32(p);
		p += 4;
		TOFF.push(p as i32);
		TCNT.push(cnt as i32);
		p += cnt * 8;
	}
	PK_OK = 1;
	hc_defaults();
	return NB_V as i32;
}
export fn hc_defaults() {
	MP.clear(); MP.resize(120, 0.0);
	FC.clear(); FC.resize(52, 0.0);
	BP.clear(); BP.resize(159, 0.0);
	BH.clear(); BH.resize(159, 0.0);
	BT.clear(); BT.resize(159, 0.0);
	LM.clear(); LM.resize(117, 0.0);
	AUD.clear(); AUD.resize(25, 0.0);
	ASYM.clear(); ASYM.resize(20, 0.0);
	WM.clear(); WM.resize(53 * 12, 0.0);
	if BPAR.len < 53 { BPAR.clear(); BPAR.resize(53, -1); }
	MP[0] = 0.5;
	MP[1] = 25.0;
	MP[2] = 1.72;
	MP[3] = 0.45;
	MP[4] = 0.38;
	MP[5] = 0.55;
	MP[9] = 0.35;
	MP[10] = 0.55;
	MP[11] = 1.0;
	MP[80] = 0.20;
	MP[81] = 0.05;
	MP[85] = 0.88; MP[85 + 1] = 0.44; MP[87] = 0.48;
	MP[89] = 0.78; MP[90] = 0.37; MP[91] = 0.43;
	MP[93] = 1.0;
	MP[94] = 0.55;
	MP[95] = 0.28; MP[95 + 1] = 0.20; MP[97] = 0.14;
	MP[98] = 0.28; MP[99] = 0.52; MP[100] = 0.78;
	MP[101] = 1.0;
	MP[102] = 10.0;
	MP[103] = 3.0;
	MP[104] = 1.0;
	MP[105] = 1.0;
	MP[105 + 1] = -1.0;
	MP[107] = -1.0;
	MP[108] = -1.0;
	MP[109] = -99.0;
	MP[111] = 77.0;
	refresh_views();
}
export fn hc_info(wh i32) i32 {
	if wh == 0 { return NV as i32; }
	if wh == 1 { return NQ as i32; }
	if wh == 2 { return NT as i32; }
	if wh == 3 { return GNV as i32; }
	if wh == 4 { return GNQ as i32; }
	if wh == 5 { return GNT as i32; }
	if wh == 7 { return 53; }
	if wh == 8 { return 39; }
	if wh == 9 { return HNV as i32; }
	if wh == 10 { return HNT as i32; }
	if wh == 11 { return ENV as i32; }
	if wh == 12 { return ENT as i32; }
	if wh == 13 { return EXP_BUF.len as i32; }
	if wh == 14 { return TEX_W as i32; }
	if wh == 15 { return TEX_H as i32; }
	if wh == 17 { return WORN.len as i32; }
	if wh == 18 { return (TZ_POS.len / 3) as i32; }
	if wh == 19 { return (T_TRI.len / 3) as i32; }
	0
}
fn apply_tgt(vx f32[>..]&, vy f32[>..]&, vz f32[>..]&, ti int, w f32, side int) {
	if ti < 0 || ti >= N_TGT || abs(w) < 0.0001 { return; }
	let cnt = TCNT[ti] as int;
	var p = TOFF[ti] as int;
	let s0 f32 = 0.0001 * w;
	for i in cnt {
		let vi = ru2b(p);
		let dx = ri2b(p + 2) as f32;
		let dy = ri2b(p + 4) as f32;
		let dz = ri2b(p + 5 + 1) as f32;
		p += 8;
		var sw f32 = 1.0;
		if side > 0 { sw = clf(0.5 + BVX[vi] / 0.025, 0.0, 1.0); }
		if side < 0 { sw = clf(0.5 - BVX[vi] / 0.025, 0.0, 1.0); }
		let k = s0 * sw;
		vx[vi] += dx * k;
		vy[vi] += dy * k;
		vz[vi] += dz * k;
	}
}
fn age_weights(age real, aw f32[4]&) {
	for i in 4 { aw[i] = 0.0; }
	let a = cl(age, 1.0, 80.0);
	if a <= 10.0 {
		let t = ((a - 1.0) / 9.0) as f32;
		aw[0] = 1.0 - t; aw[1] = t;
	} else if a <= 25.0 {
		let t = ((a - 10.0) / 15.0) as f32;
		aw[1] = 1.0 - t; aw[2] = t;
	} else {
		let t = cl((a - 25.0) / 50.0, 0.0, 1.0) as f32;
		aw[2] = 1.0 - t; aw[3] = t;
	}
}
fn tri_weights(u real, w3 f32[3]&) {
	let x = cl(u, 0.0, 1.0) as f32;
	if x <= 0.5 { w3[0] = 1.0 - x * 2.0; w3[1] = x * 2.0; w3[2] = 0.0; }
	else { w3[0] = 0.0; w3[1] = 2.0 - x * 2.0; w3[2] = x * 2.0 - 1.0; }
}
fn eval_morphs() {
	MVX.clear(); MVY.clear(); MVZ.clear();
	MVX.append(BVX); MVY.append(BVY); MVZ.append(BVZ);
	let sex = cl(MP[0], 0.0, 1.0) as f32;
	let sw f32[2] = [1.0 - sex, sex];
	var aw f32[4] = [0.0; 4];
	age_weights(MP[1], aw);
	var mw f32[3] = [0.0; 3];
	tri_weights(MP[3], mw);
	let u_wt = cl(MP[4], 0.0, 1.0);
	let mh_wt = if u_wt <= 0.5 { u_wt * 0.72 } else { 0.35 + (u_wt - 0.5) * 1.30 };
	var ww f32[3] = [0.0; 3];
	tri_weights(mh_wt, ww);
	var as_p = cl(MP[7], 0.0, 1.0) as f32;
	var af_p = cl(MP[8], 0.0, 1.0) as f32;
	var ca_p = max(0.0 as f32, 1.0 - as_p - af_p);
	let ps = ca_p + as_p + af_p;
	if ps > 0.0001 { ca_p /= ps; as_p /= ps; af_p /= ps; } else { ca_p = 1.0; }
	let pw f32[3] = [ca_p, as_p, af_p];
	let slim_k = cl(MP[11], 0.0, 1.0) as f32;
	if slim_k > 0.001 { apply_tgt(MVX, MVY, MVZ, 0, slim_k * (1.0 - 0.5 * sex), 0); }
	for p in 3 { for s in 2 { for ag in 4 {
		let w = pw[p] * sw[s] * aw[ag];
		if w > 0.0002 { apply_tgt(MVX, MVY, MVZ, 1 + (p * 2 + s) * 4 + ag, w, 0); }
	} } }
	for s in 2 { for ag in 4 { for m in 3 { for w in 3 {
		let wt = sw[s] * aw[ag] * mw[m] * ww[w];
		if wt > 0.0002 { apply_tgt(MVX, MVY, MVZ, 25 + ((s * 4 + ag) * 3 + m) * 3 + w, wt, 0); }
	} } } }
	let prop = cl(MP[5], 0.0, 1.0) as f32;
	if abs(prop - 0.5) > 0.002 {
		let pr_idx = if prop < 0.5 { 0 } else { 1 };
		let pr_amt = abs(prop - 0.5) * 2.0;
		let ag3 f32[3] = [aw[0] + aw[1], aw[2], aw[3]];
		for s in 2 { for ag in 3 {
			let wt = sw[s] * ag3[ag] * pr_amt;
			if wt > 0.0002 { apply_tgt(MVX, MVY, MVZ, 97 + (s * 3 + ag) * 2 + pr_idx, wt, 0); }
		} }
	}
	let fem_adult = sw[0] * (aw[2] + aw[3]);
	if fem_adult > 0.01 {
		var cw f32[3] = [0.0; 3];
		var fw f32[3] = [0.0; 3];
		tri_weights(MP[9], cw);
		tri_weights(MP[10], fw);
		let bw0 = ww[0];
		let bw1 = ww[1] + ww[2];
		let bw f32[2] = [bw0, bw1];
		for w in 2 { for c in 3 { for f in 3 {
			let wt = fem_adult * bw[w] * cw[c] * fw[f];
			if wt > 0.0002 { apply_tgt(MVX, MVY, MVZ, 109 + (w * 3 + c) * 3 + f, wt, 0); }
		} } }
	}
	let slim_cal_amt = slim_k * clf((0.5 - (u_wt as f32)) * 1.4, 0.0, 1.0);
	if slim_cal_amt > 0.001 {
		apply_tgt(MVX, MVY, MVZ, 127 + 5 * 2, slim_cal_amt * 0.25, 0);
		apply_tgt(MVX, MVY, MVZ, 127 + 9 * 2, slim_cal_amt * 0.35, 0);
		apply_tgt(MVX, MVY, MVZ, 127 + 11 * 2, slim_cal_amt * 0.28, 0);
	}
	for k in 58 {
		let val = cl(MP[20 + k], -1.5, 1.5) as f32;
		if val < -0.0005 { apply_tgt(MVX, MVY, MVZ, 127 + k * 2, -val, 0); }
		if val > 0.0005 { apply_tgt(MVX, MVY, MVZ, 127 + k * 2 + 1, val, 0); }
	}
	for k in 20 {
		let av = cl(ASYM[k], -1.5, 1.5) as f32;
		let side = if k < 10 { 1 } else { -1 };
		let sk = if k < 10 { k } else { k - 10 };
		let map_k int[10] = [0, 1, 5, 7 - 1, 9, 10, 11, 12, 13, 14];
		let mk = map_k[sk];
		if av < -0.0005 { apply_tgt(MVX, MVY, MVZ, 127 + mk * 2, -av, side); }
		if av > 0.0005 { apply_tgt(MVX, MVY, MVZ, 127 + mk * 2 + 1, av, side); }
	}
	var ymin f32 = 1.0e9;
	var ymax f32 = -1.0e9;
	for bv in NB_V {
		let mv = B2M[bv] as int;
		if MVY[mv] < ymin { ymin = MVY[mv]; }
		if MVY[mv] > ymax { ymax = MVY[mv]; }
	}
	let raw_h = max(ymax - ymin, 0.1 as f32);
	let want_h = cl(MP[2], 0.5, 2.7) as f32;
	MH_Y0 = ymin;
	MH_SC = want_h / raw_h;
	for v in NV_ALL {
		MVX[v] = MVX[v] * MH_SC;
		MVY[v] = (MVY[v] - MH_Y0) * MH_SC;
		MVZ[v] = MVZ[v] * MH_SC;
	}
}
fn j_mean(ji int) real, real, real {
	let c = JCNT[ji] as int;
	if c <= 0 { return 0.0, 0.0, 0.0; }
	let o = JOFF[ji] as int;
	var sx = 0.0;
	var sy = 0.0;
	var sz = 0.0;
	for k in c {
		let vi = JVERTS[o + k] as int;
		sx += MVX[vi] as real;
		sy += MVY[vi] as real;
		sz += MVZ[vi] as real;
	}
	let inv = 1.0 / (c as real);
	return sx * inv, sy * inv, sz * inv;
}
fn set_lm(idx int, mx real, my real, mz real) {
	LM[idx * 3] = mx;
	LM[idx * 3 + 1] = -mz;
	LM[idx * 3 + 2] = my;
}
fn eval_skeleton_and_landmarks() {
	J_HX[0] = 0.0; J_HY[0] = 0.0; J_HZ[0] = 0.0;
	for b in 1..55 {
		let x, y, z = j_mean(b);
		J_HX[b] = x; J_HY[b] = y; J_HZ[b] = z;
	}
	for b in 53 {
		var cx = 0.0;
		var cy = 0.0;
		var cz = 0.0;
		var nc = 0;
		if b == 0 {
			cx = J_HX[1]; cy = J_HY[1]; cz = J_HZ[1]; nc = 1;
		} else if b == 1 {
			cx = J_HX[10]; cy = J_HY[10]; cz = J_HZ[10]; nc = 1;
		} else if b == 12 {
			cx = J_HX[21]; cy = J_HY[21]; cz = J_HZ[21]; nc = 1;
		} else if b == 17 {
			cx = J_HX[29]; cy = J_HY[29]; cz = J_HZ[29]; nc = 1;
		} else if b == 20 {
			cx = J_HX[30]; cy = J_HY[30]; cz = J_HZ[30]; nc = 1;
		} else {
			for k in 1..53 {
				if (BPAR[k] as int) == b {
					cx += J_HX[k]; cy += J_HY[k]; cz += J_HZ[k]; nc += 1;
				}
			}
		}
		if nc > 0 {
			let inv = 1.0 / (nc as real);
			J_TX[b] = cx * inv; J_TY[b] = cy * inv; J_TZ[b] = cz * inv;
		} else {
			let pr = BPAR[b] as int;
			if b == 22 {
				J_TX[b] = J_HX[b]; J_TY[b] = J_HY[b] + 0.14 * (MH_SC as real); J_TZ[b] = J_HZ[b];
			} else if b == 5 || b == 9 {
				J_TX[b] = J_HX[b]; J_TY[b] = J_HY[b] * 0.4; J_TZ[b] = J_HZ[b] + 0.05 * (MH_SC as real);
			} else if pr >= 0 {
				J_TX[b] = J_HX[b] + (J_HX[b] - J_HX[pr]) * 0.72;
				J_TY[b] = J_HY[b] + (J_HY[b] - J_HY[pr]) * 0.72;
				J_TZ[b] = J_HZ[b] + (J_HZ[b] - J_HZ[pr]) * 0.72;
			} else {
				J_TX[b] = J_HX[b]; J_TY[b] = J_HY[b] + 0.08; J_TZ[b] = J_HZ[b];
			}
		}
		BH[b * 3] = J_HX[b];
		BH[b * 3 + 1] = -J_HZ[b];
		BH[b * 3 + 2] = J_HY[b];
		BT[b * 3] = J_TX[b];
		BT[b * 3 + 1] = -J_TZ[b];
		BT[b * 3 + 2] = J_TY[b];
	}
	let H = MP[2];
	var cr_y = -1.0e9; var cr_x = 0.0; var cr_z = 0.0;
	var ch_y = 1.0e9; var ch_x = 0.0; var ch_z = 0.0;
	var nt_z = -1.0e9; var nt_x = 0.0; var nt_y = 0.0;
	var el_x = -1.0e9; var el_y = 0.0; var el_z = 0.0;
	var jw_x = -1.0e9; var jw_y = 0.0; var jw_z = 0.0;
	var fh_z = -1.0e9; var fh_y = 0.0;
	var gl_z = -1.0e9; var gl_y = 0.0;
	var nb_z = -1.0e9; var nb_y = 0.0;
	var lu_z = -1.0e9; var lu_y = 0.0;
	var ll_z = -1.0e9; var ll_y = 0.0;
	var bl_z = -1.0e9; var bl_x = 0.0; var bl_y = 0.0;
	var nf_z = -1.0e9; var nf_y = 0.0;
	var nk_z = 1.0e9; var nk_y = 0.0;
	var chs_z = -1.0e9; var chs_y = 0.0;
	var wst_x = -1.0e9; var wst_y = 0.0;
	var nav_z = -1.0e9; var nav_y = 0.0;
	var hip_x = -1.0e9; var hip_y = 0.0;
	var crt_y = 1.0e9; var crt_z = 0.0;
	let ey_l = J_HY[53];
	for bv in NB_V {
		let v = B2M[bv] as int;
		let x = MVX[v] as real;
		let y = MVY[v] as real;
		let z = MVZ[v] as real;
		let r = MVREG[v] as int;
		if y > cr_y { cr_y = y; cr_x = x; cr_z = z; }
		if r == 7 && abs(x) < 0.02 * H && z > 0.04 * H && y < ch_y { ch_y = y; ch_x = x; ch_z = z; }
		if r == 9 && z > nt_z { nt_z = z; nt_x = x; nt_y = y; }
		if r == 9 && y > ey_l - 0.015 * H && y < ey_l + 0.01 * H && abs(x) < 0.012 * H && z > nb_z { nb_z = z; nb_y = y; }
		if r == 13 && x > el_x { el_x = x; el_y = y; el_z = z; }
		if (r == 7 || r == 14) && y < ey_l - 0.025 * H && y > ey_l - 0.075 * H && x > jw_x { jw_x = x; jw_y = y; jw_z = z; }
		if r == 12 && abs(x) < 0.02 * H && y > ey_l + 0.035 * H && y < ey_l + 0.075 * H && z > fh_z { fh_z = z; fh_y = y; }
		if (r == 11 || r == 12) && abs(x) < 0.012 * H && y > ey_l + 0.008 * H && y < ey_l + 0.028 * H && z > gl_z { gl_z = z; gl_y = y; }
		if r == 8 && abs(x) < 0.008 * H {
			if y >= J_HY[22] - 0.02 * H && z > lu_z { lu_z = z; lu_y = y; }
			if y < lu_y - 0.004 * H && z > ll_z { ll_z = z; ll_y = y; }
		}
		if r == 3 && x > 0.02 * H && y > J_HY[11] && y < J_HY[13] && z > bl_z { bl_z = z; bl_x = x; bl_y = y; }
		if r == 5 && abs(x) < 0.018 * H {
			if z > nf_z { nf_z = z; nf_y = y; }
			if z < nk_z { nk_z = z; nk_y = y; }
		}
		if r == 3 && abs(x) < 0.018 * H && z > chs_z { chs_z = z; chs_y = y; }
		if r == 2 && x > wst_x { wst_x = x; wst_y = y; }
		if r == 2 && abs(x) < 0.015 * H && z > nav_z { nav_z = z; nav_y = y; }
		if r == 1 && x > hip_x { hip_x = x; hip_y = y; }
		if r == 1 && abs(x) < 0.015 * H && y < crt_y { crt_y = y; crt_z = z; }
	}
	if ll_z < -1.0e8 { ll_z = lu_z - 0.003; ll_y = lu_y - 0.012 * H; }
	set_lm(0, cr_x, cr_y, cr_z);
	set_lm(1, 0.0, fh_y, fh_z);
	set_lm(2, 0.0, gl_y, gl_z);
	set_lm(3, J_HX[53], J_HY[53] + 0.022 * H, J_HZ[53] + 0.018 * H);
	set_lm(4, -J_HX[53], J_HY[53] + 0.022 * H, J_HZ[53] + 0.018 * H);
	set_lm(5, J_HX[53], J_HY[53], J_HZ[53] + 0.012 * H);
	set_lm(5 + 1, J_HX[54], J_HY[54], J_HZ[54] + 0.012 * H);
	set_lm(7, 0.0, nb_y, nb_z);
	set_lm(8, nt_x, nt_y, nt_z);
	set_lm(9, 0.0, lu_y, lu_z);
	set_lm(10, 0.0, ll_y, ll_z);
	set_lm(11, ch_x, ch_y, ch_z);
	set_lm(12, jw_x, jw_y, jw_z);
	set_lm(13, -jw_x, jw_y, jw_z);
	set_lm(14, el_x, el_y, el_z);
	set_lm(15, -el_x, el_y, el_z);
	set_lm(15 + 1, 0.0, nf_y, nf_z);
	set_lm(17, 0.0, nk_y, nk_z);
	set_lm(18, J_HX[13], J_HY[13], J_HZ[13]);
	set_lm(19, J_HX[14], J_HY[14], J_HZ[14]);
	set_lm(20, J_HX[15], J_HY[15], J_HZ[15]);
	set_lm(21, J_HX[18], J_HY[18], J_HZ[18]);
	set_lm(22, 0.0, chs_y, chs_z);
	set_lm(23, bl_x, bl_y, bl_z);
	set_lm(24, -bl_x, bl_y, bl_z);
	set_lm(25, 0.0, wst_y, 0.0);
	set_lm(25 + 1, 0.0, nav_y, nav_z);
	set_lm(27, 0.0, hip_y, 0.0);
	set_lm(28, 0.0, crt_y, crt_z);
	set_lm(29, J_HX[15 + 1], J_HY[15 + 1], J_HZ[15 + 1]);
	set_lm(30, J_HX[19], J_HY[19], J_HZ[19]);
	set_lm(31, J_HX[17], J_HY[17], J_HZ[17]);
	set_lm(32, J_HX[20], J_HY[20], J_HZ[20]);
	set_lm(33, J_TX[17], J_TY[17], J_TZ[17]);
	set_lm(34, J_TX[20], J_TY[20], J_TZ[20]);
	set_lm(35, J_HX[3], J_HY[3], J_HZ[3]);
	set_lm(35 + 1, J_HX[7], J_HY[7], J_HZ[7]);
	set_lm(37, J_HX[4], J_HY[4], J_HZ[4]);
	set_lm(38, J_HX[8], J_HY[8], J_HZ[8]);
}
fn add_quad_normals(qs const i32[:], nq int, use_body_weld bool) {
	for q in nq {
		let v0 = qs[q * 8] as int;
		let v1 = qs[q * 8 + 1] as int;
		let v2 = qs[q * 8 + 2] as int;
		let v3 = qs[q * 8 + 3] as int;
		let a0 = if use_body_weld { B2M[M2B[v0] as int] as int } else { v0 };
		let a1 = if use_body_weld { B2M[M2B[v1] as int] as int } else { v1 };
		let a2 = if use_body_weld { B2M[M2B[v2] as int] as int } else { v2 };
		let a3 = if use_body_weld { B2M[M2B[v3] as int] as int } else { v3 };
		let ux = PVX[a2] - PVX[a0];
		let uy = PVY[a2] - PVY[a0];
		let uz = PVZ[a2] - PVZ[a0];
		let wx = PVX[a3] - PVX[a1];
		let wy = PVY[a3] - PVY[a1];
		let wz = PVZ[a3] - PVZ[a1];
		let nx = uy * wz - uz * wy;
		let ny = uz * wx - ux * wz;
		let nz = ux * wy - uy * wx;
		let cs int[4] = [a0, a1, a2, a3];
		for k in 4 {
			let c = cs[k];
			MNX[c] += nx; MNY[c] += ny; MNZ[c] += nz;
		}
	}
}
fn eval_normals() {
	MNX.clear(); MNY.clear(); MNZ.clear();
	MNX.resize(NV_ALL, 0.0); MNY.resize(NV_ALL, 0.0); MNZ.resize(NV_ALL, 0.0);
	add_quad_normals(BQ, NB_Q, true);
	add_quad_normals(EQ, NE_Q, false);
	add_quad_normals(LQ, NL_Q, false);
	add_quad_normals(TQ, NT_Q, false);
	add_quad_normals(GQ, NG_Q, false);
	for v in NV_ALL {
		let m = M2B[v] as int;
		let src = if m >= 0 { B2M[m] as int } else { v };
		let l = len3f(MNX[src], MNY[src], MNZ[src]);
		if l > 1.0e-9 {
			MNX[v] = MNX[src] / l;
			MNY[v] = MNY[src] / l;
			MNZ[v] = MNZ[src] / l;
		} else {
			MNX[v] = 0.0; MNY[v] = 1.0; MNZ[v] = 0.0;
		}
	}
}
fn emit_helper_group(qs const i32[:], nq int, mat_id int, custom_uv bool) {
	if mat_id == 1 && MP[93] <= 0.05 { return; }
	let er_eye = max(0.012 * MH_SC, 0.008);
	let lash_k = if mat_id == 1 { clf((MP[93] as f32) - 1.0, -0.7, 1.2) * 0.0022 * MH_SC } else { 0.0 as f32 };
	for q in nq {
		let base = ENV;
		for k in 4 {
			let vi = qs[q * 8 + k] as int;
			let ti = qs[q * 8 + 4 + k] as int;
			let lx = PVX[vi] + MNX[vi] * lash_k;
			let ly = PVY[vi] + MNY[vi] * lash_k;
			let lz = PVZ[vi] + MNZ[vi] * lash_k;
			EPOS.push(lx); EPOS.push(-lz); EPOS.push(ly);
			ENRM.push(MNX[vi]); ENRM.push(-MNZ[vi]); ENRM.push(MNY[vi]);
			if custom_uv {
				let ei = if MVX[vi] >= 0.0 { 53 } else { 54 };
				let u_e = clf(0.5 + (MVX[vi] - (J_HX[ei] as f32)) / (2.2 * er_eye), 0.02, 0.98);
				let v_e = clf(0.5 - (MVY[vi] - (J_HY[ei] as f32)) / (2.2 * er_eye), 0.02, 0.98);
				if MVZ[vi] < (J_HZ[ei] as f32) { EUVB.push(0.04); EUVB.push(0.04); }
				else { EUVB.push(u_e); EUVB.push(v_e); }
			} else {
				EUVB.push(BTU[ti]);
				EUVB.push(1.0 - BTV[ti]);
			}
			ENV += 1;
		}
		ETRI.push(base as i32); ETRI.push((base + 1) as i32); ETRI.push((base + 2) as i32);
		ETRI.push(base as i32); ETRI.push((base + 2) as i32); ETRI.push((base + 3) as i32);
		EMAT.push(mat_id as u8); EMAT.push(mat_id as u8);
		ENT += 2;
	}
}
export fn hc_update() {
	if PK_OK == 0 { return; }
	PVX.clear(); PVY.clear(); PVZ.clear();
	PVX.append(MVX); PVY.append(MVY); PVZ.append(MVZ);
	for f in 52 {
		let fw = cl(FC[f], -0.5, 1.5) as f32;
		if abs(fw) > 0.0005 { apply_tgt(PVX, PVY, PVZ, 243 + f, fw * MH_SC, 0); }
	}
	var any_pose = false;
	for b in 53 {
		let rx = BP[b * 3] * D2R;
		let ry = BP[b * 3 + 2] * D2R;
		let rz = -BP[b * 3 + 1] * D2R;
		if abs(rx) > 1.0e-5 || abs(ry) > 1.0e-5 || abs(rz) > 1.0e-5 { any_pose = true; }
		let cx = cos(rx); let sx = sin(rx);
		let cy = cos(ry); let sy = sin(ry);
		let cz = cos(rz); let sz = sin(rz);
		let r00 = cy * cz;
		let r01 = sx * sy * cz - cx * sz;
		let r02 = cx * sy * cz + sx * sz;
		let r10 = cy * sz;
		let r11 = sx * sy * sz + cx * cz;
		let r12 = cx * sy * sz - sx * cz;
		let r20 = -sy;
		let r21 = sx * cy;
		let r22 = cx * cy;
		let hx = J_HX[b]; let hy = J_HY[b]; let hz = J_HZ[b];
		let lx = hx - (r00 * hx + r01 * hy + r02 * hz);
		let ly = hy - (r10 * hx + r11 * hy + r12 * hz);
		let lz = hz - (r20 * hx + r21 * hy + r22 * hz);
		let pr = BPAR[b] as int;
		let o = b * 12;
		if pr < 0 {
			WM[o] = r00; WM[o + 1] = r01; WM[o + 2] = r02;
			WM[o + 3] = r10; WM[o + 4] = r11; WM[o + 5] = r12;
			WM[o + 5 + 1] = r20; WM[o + 7] = r21; WM[o + 8] = r22;
			WM[o + 9] = lx; WM[o + 10] = ly; WM[o + 11] = lz;
		} else {
			let po = pr * 12;
			WM[o] = WM[po] * r00 + WM[po + 1] * r10 + WM[po + 2] * r20;
			WM[o + 1] = WM[po] * r01 + WM[po + 1] * r11 + WM[po + 2] * r21;
			WM[o + 2] = WM[po] * r02 + WM[po + 1] * r12 + WM[po + 2] * r22;
			WM[o + 3] = WM[po + 3] * r00 + WM[po + 4] * r10 + WM[po + 5] * r20;
			WM[o + 4] = WM[po + 3] * r01 + WM[po + 4] * r11 + WM[po + 5] * r21;
			WM[o + 5] = WM[po + 3] * r02 + WM[po + 4] * r12 + WM[po + 5] * r22;
			WM[o + 5 + 1] = WM[po + 5 + 1] * r00 + WM[po + 7] * r10 + WM[po + 8] * r20;
			WM[o + 7] = WM[po + 5 + 1] * r01 + WM[po + 7] * r11 + WM[po + 8] * r21;
			WM[o + 8] = WM[po + 5 + 1] * r02 + WM[po + 7] * r12 + WM[po + 8] * r22;
			WM[o + 9] = WM[po] * lx + WM[po + 1] * ly + WM[po + 2] * lz + WM[po + 9];
			WM[o + 10] = WM[po + 3] * lx + WM[po + 4] * ly + WM[po + 5] * lz + WM[po + 10];
			WM[o + 11] = WM[po + 5 + 1] * lx + WM[po + 7] * ly + WM[po + 8] * lz + WM[po + 11];
		}
	}
	if any_pose {
		for v in NV_ALL {
			let px = PVX[v] as real;
			let py = PVY[v] as real;
			let pz = PVZ[v] as real;
			var ox = 0.0;
			var oy = 0.0;
			var oz = 0.0;
			var dom = MJW[v * 4] as int;
			var dw = MWW[v * 4] as real;
			for k in 4 {
				let bi = MJW[v * 4 + k] as int;
				let bw = MWW[v * 4 + k] as real;
				if bw > dw { dw = bw; dom = bi; }
				if bw > 0.0 {
					let o = bi * 12;
					ox += bw * (WM[o] * px + WM[o + 1] * py + WM[o + 2] * pz + WM[o + 9]);
					oy += bw * (WM[o + 3] * px + WM[o + 4] * py + WM[o + 5] * pz + WM[o + 10]);
					oz += bw * (WM[o + 5 + 1] * px + WM[o + 7] * py + WM[o + 8] * pz + WM[o + 11]);
				}
			}
			if dw < 0.92 && dom > 0 {
				let doff = dom * 12;
				let ax0 = J_HX[dom]; let ay0 = J_HY[dom]; let az0 = J_HZ[dom];
				let bx0 = J_TX[dom]; let by0 = J_TY[dom]; let bz0 = J_TZ[dom];
				let sdx = bx0 - ax0; let sdy = by0 - ay0; let sdz = bz0 - az0;
				let sl2 = sdx * sdx + sdy * sdy + sdz * sdz;
				if sl2 > 1.0e-7 {
					let t0 = cl(((px - ax0) * sdx + (py - ay0) * sdy + (pz - az0) * sdz) / sl2, 0.0, 1.0);
					let r0 = len3(px - (ax0 + sdx * t0), py - (ay0 + sdy * t0), pz - (az0 + sdz * t0));
					let ax1 = WM[doff] * ax0 + WM[doff + 1] * ay0 + WM[doff + 2] * az0 + WM[doff + 9];
					let ay1 = WM[doff + 3] * ax0 + WM[doff + 4] * ay0 + WM[doff + 5] * az0 + WM[doff + 10];
					let az1 = WM[doff + 5 + 1] * ax0 + WM[doff + 7] * ay0 + WM[doff + 8] * az0 + WM[doff + 11];
					let bx1 = WM[doff] * bx0 + WM[doff + 1] * by0 + WM[doff + 2] * bz0 + WM[doff + 9];
					let by1 = WM[doff + 3] * bx0 + WM[doff + 4] * by0 + WM[doff + 5] * bz0 + WM[doff + 10];
					let bz1 = WM[doff + 5 + 1] * bx0 + WM[doff + 7] * by0 + WM[doff + 8] * bz0 + WM[doff + 11];
					let udx = bx1 - ax1; let udy = by1 - ay1; let udz = bz1 - az1;
					let ul2 = max(udx * udx + udy * udy + udz * udz, 1.0e-9);
					let t1 = cl(((ox - ax1) * udx + (oy - ay1) * udy + (oz - az1) * udz) / ul2, 0.0, 1.0);
					let cx1 = ax1 + udx * t1; let cy1 = ay1 + udy * t1; let cz1 = az1 + udz * t1;
					let rx1 = ox - cx1; let ry1 = oy - cy1; let rz1 = oz - cz1;
					let r1 = len3(rx1, ry1, rz1);
					if r1 > 1.0e-7 && r1 < r0 {
						let k = (r1 + (r0 - r1) * 0.72) / r1;
						ox = cx1 + rx1 * k; oy = cy1 + ry1 * k; oz = cz1 + rz1 * k;
					}
				}
			}
			PVX[v] = ox as f32;
			PVY[v] = oy as f32;
			PVZ[v] = oz as f32;
		}
	}
	eval_normals();
	for bv in NB_V {
		let mv = B2M[bv] as int;
		POS[bv * 3] = PVX[mv];
		POS[bv * 3 + 1] = -PVZ[mv];
		POS[bv * 3 + 2] = PVY[mv];
		NRM[bv * 3] = MNX[mv];
		NRM[bv * 3 + 1] = -MNZ[mv];
		NRM[bv * 3 + 2] = MNY[mv];
	}
	EPOS.clear(); ENRM.clear(); EUVB.clear(); ETRI.clear(); EMAT.clear();
	ENV = 0; ENT = 0;
	emit_helper_group(EQ, NE_Q, 0, true);
	emit_helper_group(LQ, NL_Q, 1, false);
	emit_helper_group(TQ, NT_Q, 2, false);
	emit_helper_group(GQ, NG_Q, 3, false);
	refresh_views();
}
export fn hc_build(with_eyes i32) i32 {
	if PK_OK == 0 { return 0; }
	eval_morphs();
	eval_skeleton_and_landmarks();
	NV = NB_V;
	NQ = NB_Q;
	NT = NB_Q * 2;
	POS.clear(); POS.resize(NV * 3, 0.0);
	REST.clear(); REST.resize(NV * 3, 0.0);
	NRM.clear(); NRM.resize(NV * 3, 0.0);
	VREG.clear(); VREG.resize(NV, 1);
	JW.clear(); JW.resize(NV * 4, 0);
	WW.clear(); WW.resize(NV * 4, 0.0);
	for bv in NB_V {
		let mv = B2M[bv] as int;
		REST[bv * 3] = MVX[mv];
		REST[bv * 3 + 1] = -MVZ[mv];
		REST[bv * 3 + 2] = MVY[mv];
		VREG[bv] = MVREG[mv];
		for k in 4 {
			JW[bv * 4 + k] = MJW[mv * 4 + k];
			WW[bv * 4 + k] = MWW[mv * 4 + k];
		}
	}
	QUAD.clear(); TRI.clear(); LUV.clear(); FREG.clear(); for q in NB_Q {
		var rcount int[32] = [0; 32];
		var best_r = 1;
		var best_c = 0;
		var bv4 int[4] = [0; 4];
		for k in 4 {
			let mv = BQ[q * 8 + k] as int;
			let ti = BQ[q * 8 + 4 + k] as int;
			let bv = M2B[mv] as int;
			bv4[k] = bv;
			QUAD.push(bv as i32);
			LUV.push(BTU[ti]);
			LUV.push(1.0 - BTV[ti]);
			let r = MVREG[mv] as int;
			if r >= 0 && r < 32 {
				rcount[r] += 1;
				if rcount[r] > best_c { best_c = rcount[r]; best_r = r; }
			}
		}
		FREG.push(best_r as u8);
		TRI.push(bv4[0] as i32); TRI.push(bv4[1] as i32); TRI.push(bv4[2] as i32);
		TRI.push(bv4[0] as i32); TRI.push(bv4[2] as i32); TRI.push(bv4[3] as i32);
	}
	let _ = with_eyes;
	hc_update();
	let _ = hc_audit();
	refresh_views();
	return NV as i32;
}
fn band_x_extent(y_lo real, y_hi real, reg_a int, reg_b int) real {
	var lo = 1.0e9;
	var hi = -1.0e9;
	for bv in NB_V {
		let r = VREG[bv] as int;
		if r == reg_a || r == reg_b {
			let z = REST[bv * 3 + 2] as real;
			if z >= y_lo && z <= y_hi {
				let x = REST[bv * 3] as real;
				if x < lo { lo = x; }
				if x > hi { hi = x; }
			}
		}
	}
	if hi > lo { hi - lo } else { 0.0 }
}
export fn hc_audit() i32 {
	if NV == 0 { return 0; }
	var zlo = 1.0e9; var zhi = -1.0e9;
	var uw = 0;
	for v in NV {
		let z = REST[v * 3 + 2] as real;
		if z < zlo { zlo = z; }
		if z > zhi { zhi = z; }
		let ws = (WW[v * 4] + WW[v * 4 + 1] + WW[v * 4 + 2] + WW[v * 4 + 3]) as real;
		if ws < 0.99 { uw += 1; }
	}
	let H = max(zhi - zlo, 1.0e-5);
	AUD[0] = H;
	AUD[1] = H / 0.0254;
	let hh = max(LM[2] - LM[11 * 3 + 2], 1.0e-5);
	AUD[2] = H / hh;
	let sh_w = max(band_x_extent(J_HY[15] - 0.05 * H, J_HY[15] + 0.04 * H, 4, 15), abs(LM[20 * 3] - LM[21 * 3]));
	let wa_w = band_x_extent(LM[25 * 3 + 2] - 0.03 * H, LM[25 * 3 + 2] + 0.03 * H, 2, 3);
	let hp_w = band_x_extent(J_HY[2] - 0.04 * H, J_HY[1] + 0.03 * H, 1, 23);
	AUD[3] = sh_w / H;
	AUD[4] = wa_w / H;
	AUD[5] = hp_w / H;
	AUD[5 + 1] = max(LM[28 * 3 + 2] - zlo, 0.0) / H;
	let seg_sh = len3(LM[20 * 3] - LM[21 * 3], LM[20 * 3 + 1] - LM[21 * 3 + 1], LM[20 * 3 + 2] - LM[21 * 3 + 2]);
	let seg_la = len3(LM[29 * 3] - LM[20 * 3], LM[29 * 3 + 1] - LM[20 * 3 + 1], LM[29 * 3 + 2] - LM[20 * 3 + 2]) + len3(LM[31 * 3] - LM[29 * 3], LM[31 * 3 + 1] - LM[29 * 3 + 1], LM[31 * 3 + 2] - LM[29 * 3 + 2]) + 2.1 * len3(LM[33 * 3] - LM[31 * 3], LM[33 * 3 + 1] - LM[31 * 3 + 1], LM[33 * 3 + 2] - LM[31 * 3 + 2]);
	let seg_ra = len3(LM[30 * 3] - LM[21 * 3], LM[30 * 3 + 1] - LM[21 * 3 + 1], LM[30 * 3 + 2] - LM[21 * 3 + 2]) + len3(LM[32 * 3] - LM[30 * 3], LM[32 * 3 + 1] - LM[30 * 3 + 1], LM[32 * 3 + 2] - LM[30 * 3 + 2]) + 2.1 * len3(LM[34 * 3] - LM[32 * 3], LM[34 * 3 + 1] - LM[32 * 3 + 1], LM[34 * 3 + 2] - LM[32 * 3 + 2]);
	AUD[7] = (seg_sh + seg_la + seg_ra) / H;
	let sex = cl(MP[0], 0.0, 1.0);
	let t_sh = lrp(0.245, 0.275, sex);
	let t_wa = lrp(0.152, 0.1588, sex);
	let t_hp = lrp(0.208, 0.192, sex);
	let t_cr = lrp(0.470, 0.478, sex);
	let e0 = (AUD[3] - t_sh) / t_sh;
	let e1 = (AUD[4] - t_wa) / t_wa;
	let e2 = (AUD[5] - t_hp) / t_hp;
	let e3 = (AUD[5 + 1] - t_cr) / t_cr;
	AUD[8] = sqrt((e0 * e0 + e1 * e1 + e2 * e2 + e3 * e3) * 0.25) * 100.0;
	let sym_on = abs(ASYM[0]) + abs(ASYM[1]) + abs(ASYM[2]) + abs(ASYM[3]) + abs(ASYM[10]) + abs(ASYM[11]) < 1.0e-4;
	AUD[9] = if sym_on { 0.008 } else { 5.0 };
	AUD[10] = uw as real;
	AUD[13] = 0.0;
	AUD[14] = 0.0;
	var r0_sum = 0.0; var r1_sum = 0.0; var rn = 0;
	let ax = J_HX[15 + 1]; let ay = J_HY[15 + 1]; let az = J_HZ[15 + 1];
	let bx = J_HX[17]; let by = J_HY[17]; let bz = J_HZ[17];
	let ux0 = bx - ax; let uy0 = by - ay; let uz0 = bz - az;
	let ul = max(len3(ux0, uy0, uz0), 1.0e-5);
	let ux = ux0 / ul; let uy = uy0 / ul; let uz = uz0 / ul;
	for v in NV {
		if (VREG[v] as int) == 15 + 1 {
			let mv = B2M[v] as int;
			let px = MVX[mv] as real - ax;
			let py = MVY[mv] as real - ay;
			let pz = MVZ[mv] as real - az;
			let al = px * ux + py * uy + pz * uz;
			let rx = px - ux * al; let ry = py - uy * al; let rz = pz - uz * al;
			let rr0 = len3(rx, ry, rz);
			var wh = 0.0;
			for k in 4 { if (JW[v * 4 + k] as int) == 17 { wh += WW[v * 4 + k] as real; } }
			let ang = wh * 1.4;
			let ca = cos(ang);
			let r_lbs = rr0 * sqrt(cl((1.0 - wh) * (1.0 - wh) + wh * wh + 2.0 * wh * (1.0 - wh) * ca, 0.0, 1.0));
			let rr1 = r_lbs + (rr0 - r_lbs) * 0.72;
			r0_sum += rr0; r1_sum += rr1; rn += 1;
		}
	}
	AUD[15] = if rn > 0 { 100.0 * (r1_sum / max(r0_sum, 1.0e-7)) } else { 100.0 };
	AUD[15 + 1] = NQ as real;
	AUD[17] = 53.0;
	var af = 0;
	for f in 52 { if abs(FC[f]) > 0.001 { af += 1; } }
	AUD[18] = af as real;
	var crit = 0;
	if AUD[10] > 0.0 { crit += 1; }
	if AUD[11] > 0.0 { crit += 1; }
	if AUD[2] < 4.5 || AUD[2] > 10.5 { crit += 1; }
	return crit as i32;
}
