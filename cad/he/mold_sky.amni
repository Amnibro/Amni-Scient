	ri(SO, NV, 0);
	rr(TL, NV * NL, Tm);
	let av = if lsr { a0v } else { 0.0 };
	rr(AL, NV * NL, av);
	rr(IN, NV * NL, 0.0);
	rr(PHN, NV * NL, 0.0);
	rr(P, N1, 0.0);
	rr(DG, N1, 0.0);
