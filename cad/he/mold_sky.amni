	NG = ng as int;
	MID = mid as int;
	MN = NV;
	N1 = NV + 1;
	ri(LA, NK, 0);
	ri(LB, NK, 0);
	ri(NA0, NV + 1, 0);
	ri(NAL, 2 * NK, 0);
	ri(NE0, NV + 1, 0);
	ri(NEL, 3 * NT, 0);
	ri(EL, 3 * NT, 0);
	rr(CT, 3 * NT, 0.0);
	ri(LE, 2 * NK, 0);
	rr(LK, 2 * NK, 0.0);
	rr(VV, NV, 0.0);
	rr(HE, NT, 0.0);
	rr(AE, NT, 0.0);
	rr(GPH, 9 * NT, 0.0);
	ri(TT, 3 * NT, 0);
	ri(CI, NC, 0);
	ri(CJ, 3 * NC, 0);
	rr(CW, 3 * NC, 0.0);
	rr(CC, NC, 0.0);
	rr(HN, NV, 0.0);
	rr(SKW, NT, 0.0);
	rb(SKIN, NV, 0);
	rr(NRM, 3 * NT, 0.0);
	ri(GT, NG, 0);
	rr(CF, 64, 0.0);
	rr(MV, 32, 0.0);
	rr(CU, 16, 0.0);
	rr(TP, 16, 0.0);
	rr(PMV, 3 * NV, 0.0);
	rr(RNO, 3, 0.0);
	im_view_i32(20, LA);
	im_view_i32(21, LB);
	im_view_i32(22, NA0);
	im_view_i32(23, NAL);
	im_view_i32(24, NE0);
	im_view_i32(25, NEL);
	im_view_i32(26, EL);
	im_view_f64(27, CT);
	im_view_i32(28, LE);
