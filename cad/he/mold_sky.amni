extern fn hsqrt(x real) real = "sqrt";
let NAN real = 0.0 / 0.0;
let INF real = 1.0 / 0.0;
fn jmax(a real, b real) real {
	if a != a { return a; }
	if b != b { return b; }
	if a > b { return a; }
	if b > a { return b; }
	if a == 0.0 && 1.0 / a < 0.0 { return b; }
	a
}
fn jmin(a real, b real) real {
	if a != a { return a; }
	if b != b { return b; }
	if a < b { return a; }
	if b < a { return b; }
	if a == 0.0 && 1.0 / a > 0.0 { return b; }
	a
}
fn hypot3(a real, b real, c real) real {
	let x = abs(a);
	let y = abs(b);
	let z = abs(c);
	var mx = 0.0;
	if x > mx { mx = x; }
	if y > mx { mx = y; }
	if z > mx { mx = z; }
	if mx == INF { return INF; }
	if x != x || y != y || z != z { return NAN; }
	if mx == 0.0 { return 0.0; }
	var sm = 0.0;
	var comp = 0.0;
	fn kah(v real) {
		let q = v / mx;
		let summand = q * q - comp;
		let prelim = sm + summand;
		comp = (prelim - sm) - summand;
		sm = prelim;
	}
	kah(x);
	kah(y);
	kah(z);
	hsqrt(sm) * mx
}
var ZE real[>..];
var OM real[>..];
var SW real[>..];
fn lay_init() {
	rr(ZE, NL, 0.0);
	rr(OM, NL, 0.0);
	rr(SW, NL, 0.0);
	for k in NL {
		ZE[k] = (k as real) / 12.0;
		OM[k] = if k == 0 || k == 12 { 0.5 / 12.0 } else { 1.0 / 12.0 };
		var w = 2.0;
		if k == 0 || k == 12 { w = 1.0; } else if k % 2 == 1 { w = 4.0; }
		SW[k] = w / 36.0;
	}
}
var SL real = 0.0;
var XF real = NAN;
var XN real = NAN;
var XT real[>..];
fn xtab() {
	let form = MV[1];
	let n = MV[2];
	if XF == form && XN == n { return; }
	rr(XT, LSN, 0.0);
	for i in LSN {
		let u = -40.0 + (i as real) * 0.02;
		var lo = -400.0;
		var hi = 0.0;
		for s in 120 {
			let m = (lo + hi) / 2.0;
			var f = 0.0;
			if form == 1.0 { f = m + (1.0 - n) * im_log1p(im_exp(u - m)); } else { f = im_exp(m) + im_exp((1.0 - n) * u + n * m) - 1.0; }
			if f > 0.0 { hi = m; } else { lo = m; }
		}
		XT[i] = (lo + hi) / 2.0;
	}
	XF = form;
	XN = n;
}
fn xlook(u real) real {
	let n = MV[2];
	let q = (u + 40.0) / 0.02;
	if q != q { SL = NAN; return NAN; }
	if q <= 0.0 { SL = 0.0; return 0.0; }
	if q >= 4000.0 {
		SL = (1.0 - n) / n;
		return XT[4000] - (u - (-40.0 + 4000.0 * 0.02)) * (1.0 - n) / n;
	}
	let i = q as int;
	let f = q - (i as real);
	SL = -(XT[i + 1] - XT[i]) / 0.02;
	XT[i] + (XT[i + 1] - XT[i]) * f
}
fn fluid(t real, tau real, a real, p real) real {
	let model = MV[0];
	if model == 0.0 { SL = 0.0; return 1.0 / MV[3]; }
	if model == 1.0 {
		let n = MV[2];
		let m = MV[4];
		let b = MV[5];
		let t0 = MV[6];
		let e = 1.0 / n - 1.0;
		SL = e;
		var mm = m;
		if b != 0.0 { mm = m * im_exp(-b * (t - t0)); }
		if tau > 0.0 { return im_pow(tau, e) / im_pow(mm, 1.0 / n); }
		if e > 0.0 { return 0.0; }
		return 1.0 / mm;
	}
	let tk = t + K0;
	let aa = if a > 0.0 { a } else { 0.0 };
	var ph = 1.0;
	var e0 = 0.0;
	if model == 3.0 {
		let ag = MV[20];
		if aa >= ag { SL = 0.0; return 0.0; }
		if MV[14] != 0.0 {
			e0 = MV[13] * im_pow(10.0, (-MV[15]) * (t - MV[16]) / ((MV[17] + t) - MV[16]));
		} else {
			e0 = MV[18] * im_exp(MV[19] / tk);
		}
		ph = im_pow(ag / (ag - aa), MV[21] + MV[22] * aa);
	} else {
		let pp = if p > 0.0 { p } else { 0.0 };
		let d = (tk - MV[9]) - MV[10] * pp;
		if d <= 0.0 { SL = 0.0; return 0.0; }
		e0 = MV[8] * im_exp((-MV[11]) * d / ((MV[12] + MV[10] * pp) + d));
	}
	if !(tau > 0.0) { SL = 0.0; return 1.0 / (ph * e0); }
	let lx = xlook(im_log(tau / (ph * MV[7])));
	1.0 / ((ph * e0) * im_exp(lx))
}
var Tm real = 0.0;
var spD real = 0.0;
var spL real = 0.0;
fn pipe_dp(t real, q real, d real, l real, a real) real {
	if !(q > 0.0) || !(l > 0.0) || !(d > 0.0) { return 0.0; }
	let r = d / 2.0;
	fn qf(tw real) real {
		var s = 0.0;
		for i in 33 {
			let tau = tw * (i as real) / 32.0;
			var wt = 2.0;
			if i == 0 || i == 32 { wt = 1.0; } else if i % 2 == 1 { wt = 4.0; }
			s += wt * tau * tau * tau * fluid(t, tau, a, 0.0);
		}
		3.141592653589793 * im_pow(r, 3.0) / im_pow(tw, 3.0) * s * tw / 96.0
	}
	var lo = im_log(1e-3);
	var hi = im_log(1e10);
	for n in 90 {
		let m = (lo + hi) / 2.0;
		if qf(im_exp(m)) < q { lo = m; } else { hi = m; }
	}
	2.0 * l * im_exp((lo + hi) / 2.0) / r
}
fn dps(q real) real {
	if spD > 0.0 { pipe_dp(Tm, q, spD, spL, 0.0) } else { 0.0 }
}
var DVP real = 0.0;
fn kamal(tk real, a real) real {
	let k1 = CU[0] * im_exp((-CU[1]) / (RG * tk));
	let k2 = CU[2] * im_exp((-CU[3]) / (RG * tk));
	let x = if a > 0.0 { a } else { 0.0 };
	if x >= 1.0 { return 0.0; }
	(k1 + k2 * im_pow(x, CU[4])) * im_pow(1.0 - x, CU[5])
}
fn cure_step(tk real, a0 real, dt real) real {
	var a = a0;
	var t = 0.0;
	while t < dt {
		let r = kamal(tk, a);
		let h0 = if r > 0.0 { 0.004 / r } else { dt };
		let h = jmin(dt - t, h0);
		let k1 = r;
		let k2 = kamal(tk, a + h * k1 / 2.0);
		let k3 = kamal(tk, a + h * k2 / 2.0);
		let k4 = kamal(tk, a + h * k3);
		a = jmin(1.0, a + h * (((k1 + 2.0 * k2) + 2.0 * k3) + k4) / 6.0);
		t += h;
		if a >= 1.0 { break; }
	}
	a
}
fn induct(tk real, s real, dt real) real {
	if CU[6] != 0.0 { s + dt / (CU[6] * im_exp(CU[7] / tk)) } else { 1.0 }
}
fn tait(tk real, p real) real {
	let pp = if p > 0.0 { p } else { 0.0 };
	let tt = TP[8] + TP[9] * pp;
	let dt = tk - TP[8];
	let melt = tk > tt;
	var v0 = 0.0;
	var b = 0.0;
	var vt = 0.0;
	if melt {
		v0 = TP[0] + TP[1] * dt;
		b = TP[2] * im_exp((-TP[3]) * dt);
	} else {
		v0 = TP[4] + TP[5] * dt;
		b = TP[6] * im_exp((-TP[7]) * dt);
		vt = TP[10] * im_exp(TP[11] * dt - TP[12] * pp);
	}
	DVP = (-v0) * 0.0894 / (b + pp) - TP[12] * vt;
	v0 * (1.0 - 0.0894 * im_log(1.0 + pp / b)) + vt
}
