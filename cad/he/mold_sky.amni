fn load_cf() {
	Tm = CF[0];
	Tw = CF[1];
	hF = CF[2];
	hP = CF[3];
	rho = CF[4];
	cp = CF[5];
	alf = CF[6];
	Tnf = CF[7];
	cag = CF[8];
	Teje = CF[9];
	dH = CF[10];
	lsr = CF[11] != 0.0;
	iso = CF[12] != 0.0;
	curef = CF[13] != 0.0;
	indf = CF[14] != 0.0;
	a0v = CF[15];
	tinj = CF[17];
	pMax = CF[18];
	fracq = CF[19];
	picTol = CF[20];
	pcgTol = CF[21];
	vpf = CF[23];
	packf = CF[24] != 0.0;
	taitf = CF[25] != 0.0;
