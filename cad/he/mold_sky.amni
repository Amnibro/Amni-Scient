	spD = CF[33];
	spL = CF[34];
	Troom = CF[36];
	holdT = CF[39];
	holdf = CF[40] != 0.0;
	let extra = if CF[10] > 0.0 { CF[10] / CF[5] } else { 0.0 };
	THI = ((jmax(CF[0], CF[1]) + CF[18] / (CF[4] * CF[5])) + extra) + 1.0;
	CAPT = 0.0;
	CAPP = 1.0;
}
fn size_state() {
	rr(F, NV, 0.0);
	rr(FO, NV, 0.0);
	rr(TF, NV, INF);
	rr(TFF, NV, NAN);
	rr(PMX, NV, 0.0);
